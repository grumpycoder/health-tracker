@page "/exercises"
@using Microsoft.AspNetCore.Authorization
@using FitRecoveryLog.Data
@attribute [Authorize]
@inject AppState State
@inject WebSyncClient Sync

<PageTitle>Exercise Library — Fit Log</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <div class="dash-date">Exercise Library</div>
        <div class="dash-date-sub">Reusable exercises for your routines</div>
    </header>

    @if (_loading)
    {
        <section class="card"><p class="muted">Loading…</p></section>
    }
    else if (_error is not null)
    {
        <section class="card"><p class="warn-msg" style="margin:0">@_error</p><button class="save-btn" @onclick="Load">Retry</button></section>
    }
    else
    {
        <div class="routine-head">
            <h2 style="margin:0;color:var(--text)">@_items.Count(e => !e.Retired) active</h2>
            <button class="link-btn" @onclick="AddNew" disabled="@(_edit is not null)">+ Add exercise</button>
        </div>

        @if (_edit is not null)
        {
            <section class="card">
                <div class="field"><label>Name</label><input @bind="_edit.Name" placeholder="e.g. Incline push-ups" /></div>
                <div class="inline-fields">
                    <div class="field"><label>Tracked by</label>
                        <select @bind="_edit.Measure">@foreach (var v in Enum.GetValues<ExerciseMeasure>()) { <option value="@v">@v</option> }</select>
                    </div>
                    <div class="field"><label>Muscle groups (comma-separated)</label><input @bind="_edit.MuscleGroups" placeholder="Chest, Triceps" /></div>
                </div>
                <div class="field"><label>Equipment notes</label><input @bind="_edit.EquipmentNotes" placeholder="e.g. dumbbells, band" /></div>
                <div class="field"><label>How-to video URL</label><input @bind="_edit.VideoUrl" /></div>
                <label class="chip-row" style="align-items:center;gap:0.5rem"><input type="checkbox" @bind="_edit.Retired" /> <span>Retired (hidden from routine pickers)</span></label>
                <div class="routine-actions">
                    <button class="save-btn" @onclick="Save" disabled="@_busy">@(_busy ? "Saving…" : "Save")</button>
                    <button class="link-btn" @onclick="() => _edit = null" disabled="@_busy">Cancel</button>
                </div>
            </section>
        }

        <section class="card">
            @if (_items.Count == 0) { <p class="muted">No exercises yet.</p> }
            <ul class="timeline">
                @foreach (var e in _items.OrderBy(x => x.Retired).ThenBy(x => x.Name))
                {
                    <li style="@(e.Retired ? "opacity:0.55" : "")">
                        <div>
                            <span class="entry"><strong>@e.Name</strong>
                                <span class="muted"> · @(e.Measure == ExerciseMeasure.Duration ? "time" : "reps")@(string.IsNullOrWhiteSpace(e.MuscleGroups) ? "" : $" · {e.MuscleGroups}")@(e.Retired ? " · retired" : "")</span>
                            </span>
                        </div>
                        <div class="routine-actions"><button class="icon-action" title="Edit" @onclick="() => Edit(e)">✏️</button></div>
                    </li>
                }
            </ul>
        </section>
    }
</div>

@code {
    private bool _loading = true, _busy;
    private string? _error;
    private List<ExerciseDefinition> _items = new();
    private ExerciseDefinition? _edit;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true; _error = null;
        try { _items = WebSyncClient.Rows<ExerciseDefinition>(await State.DataAsync()); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void AddNew() { _edit = new ExerciseDefinition(); }
    private void Edit(ExerciseDefinition e) { _edit = WebSyncClient.Clone(e); }

    private async Task Save()
    {
        if (_edit is null || string.IsNullOrWhiteSpace(_edit.Name)) return;
        _busy = true;
        try
        {
            _edit.Name = _edit.Name.Trim();
            await Sync.PushAsync(_edit);
            State.Invalidate();
            _edit = null;
            await Load();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
