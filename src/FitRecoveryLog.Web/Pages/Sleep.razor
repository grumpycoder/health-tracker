@page "/sleep"
@using Microsoft.AspNetCore.Authorization
@using FitRecoveryLog.Application.Recovery
@using FitRecoveryLog.Domain.Common
@using FitRecoveryLog.Domain.Recovery
@attribute [Authorize]
@inject SleepService SleepSvc
@inject RecoveryService RecoverySvc

<PageTitle>Sleep & Recovery — Fit Log</PageTitle>

<div class="content">
    <div class="page-head">
        <div>
            <div class="eyebrow">Recovery</div>
            <h1 class="dash-date">Sleep &amp; Recovery</h1>
        </div>
        @if (!_loading && _error is null)
        {
            <div class="segmented">
                <button class="seg @(_tab == "sleep" ? "active" : "")" @onclick='() => _tab = "sleep"'>😴 Sleep</button>
                <button class="seg @(_tab == "recovery" ? "active" : "")" @onclick='() => _tab = "recovery"'>❤️ Recovery</button>
            </div>
        }
    </div>

    @if (_loading)
    {
        <section class="card"><p class="muted">Loading…</p></section>
    }
    else if (_error is not null)
    {
        <section class="card"><p class="warn-msg" style="margin:0">@_error</p><button class="save-btn" @onclick="Load">Retry</button></section>
    }
    else
    {
        @if (_msg is not null) { <section class="card"><p class="warn-msg" style="margin:0">@_msg</p></section> }

        <div class="stats">
            <div class="stat">
                <div class="s-top"><span class="ic sky"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg></span>Avg sleep · 7 days</div>
                <div class="s-num num">@_avgSleepText</div>
                <div class="s-sub">@_sleeps.Count total night@(_sleeps.Count == 1 ? "" : "s") logged</div>
            </div>
            <div class="stat">
                <div class="s-top"><span class="ic teal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z" /></svg></span>Latest recovery</div>
                <div class="s-num num" style="color:@_lastRecColor">@_lastRecText</div>
                <div class="s-sub">@_lastRecSub</div>
            </div>
            <div class="stat">
                <div class="s-top"><span class="ic rose"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2 6 4-14 2 8h6" /></svg></span>Latest fatigue</div>
                <div class="s-num num">@_lastFatigueText</div>
                <div class="s-sub">lower is better</div>
            </div>
        </div>

        @if (_tab == "sleep")
        {
            <div class="routine-head">
                <h2 style="margin:0;color:var(--text)">Sleep log</h2>
                <button class="link-btn" @onclick="AddSleep" disabled="@(_sleep is not null)">+ Add night</button>
            </div>
            @if (_sleep is not null)
            {
                <section class="card">
                    <div class="inline-fields">
                        <div class="field"><label>Date</label><input type="date" @bind="_sleep.Date" /></div>
                        <div class="field"><label>Hours</label><input type="number" step="0.1" @bind="_sleep.Hours" /></div>
                        <div class="field"><label>Score</label><input type="number" @bind="_sleep.Score" /></div>
                        <div class="field"><label>Wake-ups</label><input type="number" @bind="_sleep.Interruptions" /></div>
                    </div>
                    <div class="field"><label>Notes</label><input @bind="_sleep.Notes" /></div>
                    <div class="routine-actions">
                        <button class="save-btn" @onclick="SaveSleep" disabled="@_busy">@(_busy ? "Saving…" : "Save")</button>
                        <button class="link-btn" @onclick="() => _sleep = null" disabled="@_busy">Cancel</button>
                        @if (_sleep.Id is Guid) { <button class="link-btn danger" style="margin-left:auto" @onclick="DeleteSleep" disabled="@_busy">Delete</button> }
                    </div>
                </section>
            }
            <section class="card">
                @if (_sleeps.Count == 0) { <p class="empty">No sleep entries yet.</p> }
                else
                {
                    <table class="history">
                        <thead><tr><th>Date</th><th class="num">Hours</th><th class="num">Score</th><th class="num">Wake-ups</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var s in _sleeps.OrderByDescending(x => x.Date))
                            {
                                <tr>
                                    <td>@s.Date.ToString("ddd, MMM d")</td>
                                    <td class="num">@(s.DurationHours?.ToString("0.#") ?? "—")</td>
                                    <td class="num">@(s.Score?.ToString() ?? "—")@(s.ScoreEstimated ? " est" : "")</td>
                                    <td class="num">@(s.Interruptions?.ToString() ?? "—")</td>
                                    <td class="num"><button class="icon-action" title="Edit" @onclick="() => EditSleep(s)">✏️</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        }
        else
        {
            <div class="routine-head">
                <h2 style="margin:0;color:var(--text)">Recovery check-ins</h2>
                <button class="link-btn" @onclick="AddRec" disabled="@(_rec is not null)">+ Add check-in</button>
            </div>
            @if (_rec is not null)
            {
                <section class="card">
                    <div class="inline-fields">
                        <div class="field"><label>Date</label><input type="date" @bind="_rec.Date" /></div>
                        <div class="field"><label>Recovery (1-10)</label><input type="number" @bind="_rec.Recovery" /></div>
                        <div class="field"><label>Fatigue (1-10)</label><input type="number" @bind="_rec.Fatigue" /></div>
                    </div>
                    <div class="inline-fields">
                        <div class="field"><label>Soreness locations (comma-separated)</label><input @bind="_rec.Soreness" placeholder="Lower back, Shoulders" /></div>
                        <div class="field"><label>Severity</label>
                            <select @bind="_rec.Severity">@foreach (var v in Enum.GetValues<SorenessSeverity>()) { <option value="@v">@v</option> }</select>
                        </div>
                    </div>
                    <div class="field"><label>Notes</label><input @bind="_rec.Notes" /></div>
                    <div class="routine-actions">
                        <button class="save-btn" @onclick="SaveRec" disabled="@_busy">@(_busy ? "Saving…" : "Save")</button>
                        <button class="link-btn" @onclick="() => _rec = null" disabled="@_busy">Cancel</button>
                        @if (_rec.Id is Guid) { <button class="link-btn danger" style="margin-left:auto" @onclick="DeleteRec" disabled="@_busy">Delete</button> }
                    </div>
                </section>
            }
            <section class="card">
                @if (_recs.Count == 0) { <p class="empty">No recovery check-ins yet.</p> }
                else
                {
                    <table class="history">
                        <thead><tr><th>Date</th><th class="num">Recovery</th><th class="num">Fatigue</th><th>Soreness</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var r in _recs.OrderByDescending(x => x.Date))
                            {
                                <tr>
                                    <td>@r.Date.ToString("ddd, MMM d")</td>
                                    <td class="num" style="color:@RatingColor(r.RecoveryRating)">@(r.RecoveryRating?.ToString() ?? "—")</td>
                                    <td class="num">@(r.FatigueRating?.ToString() ?? "—")</td>
                                    <td>@(r.SorenessLocations.Values.Count == 0 ? "—" : $"{r.Severity}: {r.SorenessLocations.ToCsv()}")</td>
                                    <td class="num"><button class="icon-action" title="Edit" @onclick="() => EditRec(r)">✏️</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        }
    }
</div>

@code {
    private bool _loading = true, _busy;
    private string? _error, _msg;
    private string _tab = "sleep";
    private IReadOnlyList<SleepLog> _sleeps = Array.Empty<SleepLog>();
    private IReadOnlyList<RecoveryLog> _recs = Array.Empty<RecoveryLog>();
    private SleepDraft? _sleep;
    private RecDraft? _rec;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    // ---- summary widgets ----
    private string _avgSleepText = "—", _lastRecText = "—", _lastRecSub = "", _lastRecColor = "var(--text)", _lastFatigueText = "—";

    private void BuildSummary()
    {
        var cutoff = Today.AddDays(-7);
        var recent = _sleeps.Where(s => s.Date >= cutoff && s.DurationHours is not null).Select(s => s.DurationHours!.Value).ToList();
        if (recent.Count > 0)
        {
            var avg = recent.Average();
            _avgSleepText = $"{(int)avg}:{(int)Math.Round((avg - (int)avg) * 60):00}";
        }
        else { _avgSleepText = "—"; }

        var lastRec = _recs.OrderByDescending(r => r.Date).FirstOrDefault();
        if (lastRec?.RecoveryRating is int r)
        {
            _lastRecText = $"{r}/10";
            _lastRecColor = RatingColor(r);
            _lastRecSub = lastRec.Date.ToString("MMM d");
        }
        else { _lastRecText = "—"; _lastRecSub = "no check-in yet"; _lastRecColor = "var(--text)"; }

        _lastFatigueText = lastRec?.FatigueRating is int f ? $"{f}/10" : "—";
    }

    private static string RatingColor(int? rating) => rating is not int r ? "var(--text)"
        : r >= 7 ? "var(--good)" : r >= 4 ? "var(--caution)" : "var(--critical)";

    private sealed class SleepDraft
    {
        public Guid? Id; public DateOnly Date = Today; public double? Hours; public int? Score, Interruptions; public string? Notes;
        public static SleepDraft From(SleepLog s) => new() { Id = s.Id, Date = s.Date, Hours = s.DurationHours, Score = s.Score, Interruptions = s.Interruptions, Notes = s.Notes };
        public SleepData ToData() => new(Date, Hours, Score, Interruptions, Notes);
    }

    private sealed class RecDraft
    {
        public Guid? Id; public DateOnly Date = Today; public int? Recovery, Fatigue; public string? Soreness, Notes; public SorenessSeverity Severity = SorenessSeverity.None;
        public static RecDraft From(RecoveryLog r) => new() { Id = r.Id, Date = r.Date, Recovery = r.RecoveryRating, Fatigue = r.FatigueRating, Soreness = r.SorenessLocations.ToCsv(), Severity = r.Severity, Notes = r.Notes };
        public RecoveryData ToData() => new(Date, Recovery, Fatigue, Tags.FromCsv(Soreness), Severity, Notes);
    }

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true; _error = null;
        try { _sleeps = await SleepSvc.ListAsync(); _recs = await RecoverySvc.ListAsync(); BuildSummary(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    // Sleep
    private void AddSleep() { _sleep = new SleepDraft(); _msg = null; }
    private void EditSleep(SleepLog s) { _sleep = SleepDraft.From(s); _msg = null; }
    private async Task SaveSleep()
    {
        if (_sleep is null) return;
        _busy = true; _msg = null;
        try
        {
            var ok = _sleep.Id is Guid id ? (await SleepSvc.UpdateAsync(id, _sleep.ToData())).IsSuccess
                                          : (await SleepSvc.CreateAsync(_sleep.ToData())).IsSuccess;
            if (!ok) { _msg = "Sleep save failed."; return; }
            _sleep = null; await Load();
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }
    private async Task DeleteSleep()
    {
        if (_sleep?.Id is not Guid id) return;
        _busy = true; try { await SleepSvc.DeleteAsync(id); _sleep = null; await Load(); } catch (Exception ex) { _msg = ex.Message; } finally { _busy = false; }
    }

    // Recovery
    private void AddRec() { _rec = new RecDraft(); _msg = null; }
    private void EditRec(RecoveryLog r) { _rec = RecDraft.From(r); _msg = null; }
    private async Task SaveRec()
    {
        if (_rec is null) return;
        _busy = true; _msg = null;
        try
        {
            var ok = _rec.Id is Guid id ? (await RecoverySvc.UpdateAsync(id, _rec.ToData())).IsSuccess
                                        : (await RecoverySvc.CreateAsync(_rec.ToData())).IsSuccess;
            if (!ok) { _msg = "Recovery save failed."; return; }
            _rec = null; await Load();
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }
    private async Task DeleteRec()
    {
        if (_rec?.Id is not Guid id) return;
        _busy = true; try { await RecoverySvc.DeleteAsync(id); _rec = null; await Load(); } catch (Exception ex) { _msg = ex.Message; } finally { _busy = false; }
    }
}
