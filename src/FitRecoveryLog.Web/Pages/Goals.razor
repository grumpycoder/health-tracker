@page "/goals"
@using Microsoft.AspNetCore.Authorization
@using FitRecoveryLog.Data
@attribute [Authorize]
@inject AppState State
@inject WebSyncClient Sync

<PageTitle>Goals — Fit Log</PageTitle>

<div class="content">
    <div class="page-head">
        <div>
            <div class="eyebrow">Targets</div>
            <h1 class="dash-date">Goals</h1>
        </div>
        @if (!_loading && _error is null)
        {
            <button class="btn primary" @onclick="SaveGoals" disabled="@_busy">@(_busy ? "Saving…" : "Save goals")</button>
        }
    </div>

    @if (_loading)
    {
        <section class="card"><p class="muted">Loading…</p></section>
    }
    else if (_error is not null)
    {
        <section class="card"><p class="warn-msg" style="margin:0">@_error</p><button class="save-btn" @onclick="Load">Retry</button></section>
    }
    else
    {
        <section class="card">
            <div class="card-head">
                <h2>Coaching &amp; nutrition</h2>
                @if (_goalsSaved) { <span class="saved-msg">Saved ✓</span> }
            </div>
            <p class="muted" style="font-size:.85rem;margin:0 0 .6rem">The AI coach, day-fit advice, and Trends targets all use these; leave a range at 0 to keep it unset. Calories, carbs, and water split by rest vs workout day.</p>

            <div class="field">
                <label>Coaching goals (one per line)</label>
                <textarea class="note" rows="3" @bind="_goals.CoachingGoals" placeholder="e.g. Lose ~1 lb/week&#10;Hit 150g+ protein&#10;Keep sweet tea to ~16 oz/day"></textarea>
            </div>
            <label class="chip-row" style="align-items:center;gap:.5rem;margin:.2rem 0 .8rem"><input type="checkbox" @bind="_goals.IncludeCessationData" /> <span>Include cessation data in AI check-ins</span></label>

            <div class="inline-fields">
                <div class="field"><label>Protein (g) min–max</label><div class="inline-fields"><input type="number" @bind="_goals.ProteinMin" /><input type="number" @bind="_goals.ProteinMax" /></div></div>
                <div class="field"><label>Fat (g) min–max</label><div class="inline-fields"><input type="number" @bind="_goals.FatMin" /><input type="number" @bind="_goals.FatMax" /></div></div>
                <div class="field"><label>Fiber (g) min–max</label><div class="inline-fields"><input type="number" @bind="_goals.FiberMin" /><input type="number" @bind="_goals.FiberMax" /></div></div>
                <div class="field"><label>Added sugar max (g)</label><input type="number" @bind="_goals.AddedSugarMax" /></div>
            </div>
            <div class="inline-fields">
                <div class="field"><label>Calories — rest day min–max</label><div class="inline-fields"><input type="number" @bind="_goals.CaloriesRestMin" /><input type="number" @bind="_goals.CaloriesRestMax" /></div></div>
                <div class="field"><label>Calories — workout day min–max</label><div class="inline-fields"><input type="number" @bind="_goals.CaloriesActiveMin" /><input type="number" @bind="_goals.CaloriesActiveMax" /></div></div>
            </div>
            <div class="inline-fields">
                <div class="field"><label>Carbs (g) — rest min–max</label><div class="inline-fields"><input type="number" @bind="_goals.CarbsRestMin" /><input type="number" @bind="_goals.CarbsRestMax" /></div></div>
                <div class="field"><label>Carbs (g) — workout min–max</label><div class="inline-fields"><input type="number" @bind="_goals.CarbsActiveMin" /><input type="number" @bind="_goals.CarbsActiveMax" /></div></div>
            </div>
            <div class="inline-fields">
                <div class="field"><label>Water (oz) — rest min–max</label><div class="inline-fields"><input type="number" @bind="_goals.WaterRestMin" /><input type="number" @bind="_goals.WaterRestMax" /></div></div>
                <div class="field"><label>Water (oz) — workout min–max</label><div class="inline-fields"><input type="number" @bind="_goals.WaterActiveMin" /><input type="number" @bind="_goals.WaterActiveMax" /></div></div>
            </div>
        </section>

        <section class="card">
            <div class="card-head"><h2>Body measurements</h2></div>
            <p class="muted" style="font-size:.85rem;margin:0 0 .6rem">Target values for weight and measurements — leave blank for none; reduce vs gain is inferred from where you are now. Shown on Measurements and as goal lines on Trends.</p>
            <div class="inline-fields">
                <div class="field"><label>Goal weight (lb)</label><input type="number" step="0.1" @bind="_goals.GoalWeightLbs" /></div>
                <div class="field"><label>Goal waist (in)</label><input type="number" step="0.1" @bind="_goals.GoalWaistInches" /></div>
                <div class="field"><label>Goal body fat (%)</label><input type="number" step="0.1" @bind="_goals.GoalBodyFatPercent" /></div>
            </div>
            <div class="inline-fields">
                <div class="field"><label>Goal chest (in)</label><input type="number" step="0.1" @bind="_goals.GoalChestInches" /></div>
                <div class="field"><label>Goal shoulders (in)</label><input type="number" step="0.1" @bind="_goals.GoalShouldersInches" /></div>
                <div class="field"><label>Goal arms (in)</label><input type="number" step="0.1" @bind="_goals.GoalArmsInches" /></div>
            </div>
            <div class="inline-fields">
                <div class="field"><label>Goal thighs (in)</label><input type="number" step="0.1" @bind="_goals.GoalThighsInches" /></div>
                <div class="field"><label>Goal calves (in)</label><input type="number" step="0.1" @bind="_goals.GoalCalvesInches" /></div>
            </div>
            <div class="routine-actions" style="margin-top:.4rem">
                <button class="save-btn" @onclick="SaveGoals" disabled="@_busy">@(_busy ? "Saving…" : "Save goals")</button>
                @if (_goalsSaved) { <span class="saved-msg">Saved ✓</span> }
            </div>
        </section>
    }
</div>

@code {
    private bool _loading = true, _busy, _goalsSaved;
    private string? _error;
    private GoalSettings _goals = new();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true; _error = null; _goalsSaved = false;
        try
        {
            var pull = await State.DataAsync();
            var existing = WebSyncClient.Rows<GoalSettings>(pull).OrderByDescending(g => g.UpdatedAt).FirstOrDefault();
            _goals = existing is not null ? WebSyncClient.Clone(existing) : new GoalSettings();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task SaveGoals()
    {
        _busy = true; _goalsSaved = false; _error = null;
        try
        {
            _goals.CoachingGoals = string.IsNullOrWhiteSpace(_goals.CoachingGoals) ? null : _goals.CoachingGoals.Trim();
            await Sync.PushAsync(_goals);
            State.Invalidate();
            await Load();
            _goalsSaved = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
