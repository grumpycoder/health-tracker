@page "/routines"
@using Microsoft.AspNetCore.Authorization
@using FitRecoveryLog.Application.Common
@using FitRecoveryLog.Application.Workouts
@using FitRecoveryLog.Application.Ai
@using FitRecoveryLog.Domain.Workouts
@using ExDef = FitRecoveryLog.Data.ExerciseDefinition
@using ExerciseMeasure = FitRecoveryLog.Data.ExerciseMeasure
@attribute [Authorize]
@inject RoutineService RoutineSvc
@inject IAiCoach Coach
@inject AppState State
@inject WebSyncClient Sync

<PageTitle>Routines — Fit Log</PageTitle>

<div class="content">
    <div class="page-head">
        <div>
            <div class="eyebrow">Training</div>
            <h1 class="dash-date">Routines</h1>
        </div>
        @if (!_loading && _error is null)
        {
            <div class="chip-row" style="gap:8px">
                <input class="form-control" style="max-width:16rem" @bind="_newRoutineName" placeholder="New routine name" />
                <button class="btn primary" @onclick="CreateRoutine" disabled="@(_busy || string.IsNullOrWhiteSpace(_newRoutineName))">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>Create
                </button>
            </div>
        }
    </div>

@if (_loading)
{
    <section class="card"><p class="muted">Loading…</p></section>
}
else if (_error is not null)
{
    <section class="card"><p class="warn-msg" style="margin:0">@_error</p><button class="save-btn" @onclick="() => LoadAll()">Retry</button></section>
}
else
{
    @if (_msg is not null) { <section class="card"><p class="warn-msg" style="margin:0">@_msg</p></section> }

    @if (_hasAiKey && _aiDraft is null && Open is null)
    {
        <section class="card">
            <div class="card-head"><h2>✨ Suggest a routine</h2></div>
            <p class="muted" style="margin:0 0 0.6rem">Drafts a routine from your last 8 weeks — targeting the muscle
            groups your current workouts under-train, mixing library exercises with a few new ones.</p>
            <div class="field"><input class="form-control" @bind="_aiHint" placeholder="Optional: e.g. upper body, 20 min, something new" /></div>
            <div class="chip-row" style="margin:0.5rem 0 0.7rem;gap:8px">
                <button type="button" class="chip @(_aiBodyweightOnly ? "selected" : "")" @onclick="() => _aiBodyweightOnly = true">🏠 Bodyweight only</button>
                <button type="button" class="chip @(!_aiBodyweightOnly ? "selected" : "")" @onclick="() => _aiBodyweightOnly = false">🏋️ Equipment OK</button>
            </div>
            <button class="btn primary" @onclick="SuggestRoutine" disabled="@_aiBusy">@(_aiBusy ? "Designing…" : "Generate draft")</button>
            @if (_aiError is not null) { <p class="warn-msg" style="display:block;margin:0.6rem 0 0">@_aiError</p> }
        </section>
    }

    @if (_aiDraft is not null)
    {
        <section class="card" style="border-color:var(--accent)">
            <div class="card-head"><h2>🤖 @_aiDraft.Name <span class="muted" style="font-size:0.8rem;font-weight:400">draft — not saved</span></h2></div>
            <p class="muted" style="margin:0 0 0.5rem">@_aiDraft.Rationale</p>
            @if (_aiNote is not null) { <p class="muted" style="margin:0 0 0.6rem">⚠️ @_aiNote</p> }
            <ul class="timeline">
                @foreach (var ex in _aiExercises)
                {
                    <li class="ex-row" @key="ex">
                        <div>
                            <span class="ex-name">@ex.Name @if (ex.IsNew) { <span class="pill good">NEW</span> }</span>
                            <span class="ex-target">
                                @(ex.Measure == "duration" ? $"{ex.DurationSeconds ?? 30}s" : $"{ex.Reps ?? 10} reps") × @ex.Sets · @(ex.RestSeconds ?? 60)s rest
                                @if (!string.IsNullOrWhiteSpace(ex.Muscles)) { <span class="muted"> · @ex.Muscles</span> }
                            </span>
                        </div>
                        <div class="routine-actions">
                            <button class="link-btn" @onclick="() => _aiExercises.Remove(ex)" disabled="@_aiBusy">Remove</button>
                        </div>
                    </li>
                }
            </ul>
            <div class="routine-actions" style="margin-top:0.7rem">
                <button class="btn primary" @onclick="SaveAiDraft" disabled="@(_aiBusy || _aiExercises.Count == 0)">Save routine</button>
                <button class="link-btn" @onclick="DiscardAiDraft" disabled="@_aiBusy">Discard</button>
            </div>
            <p class="muted" style="font-size:0.76rem;margin:0.5rem 0 0">Targets are editable after saving (Open the routine).
            New exercises join the library on save.</p>
        </section>
    }

    @if (Open is Routine open)
    {
        <div class="card p-3 mb-4" style="border-color:var(--accent)">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0">Editing: @open.Name</h5>
                <button class="btn btn-sm btn-secondary" @onclick="Close">Close</button>
            </div>

            <div class="row g-2 mb-2">
                <div class="col-md-8">
                    <label class="form-label mb-0"><small>Name</small></label>
                    <div class="input-group input-group-sm">
                        <input class="form-control" @bind="_nameDraft" />
                        <button class="btn btn-outline-primary" @onclick="SaveName" disabled="@_busy">Save</button>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label mb-0"><small>Notes</small></label>
                    <div class="input-group input-group-sm">
                        <input class="form-control" @bind="_notesDraft" />
                        <button class="btn btn-outline-primary" @onclick="SaveNotes" disabled="@_busy">Save</button>
                    </div>
                </div>
                <div class="col-md-8">
                    <label class="form-label mb-0"><small>Set order</small></label>
                    <select class="form-select form-select-sm" value="@open.ExecutionMode" @onchange="SetMode" disabled="@_busy">
                        <option value="@RoutineExecutionMode.StraightSets">Straight sets — all sets, then next exercise</option>
                        <option value="@RoutineExecutionMode.Circuit">Circuit — one set of each, rotating</option>
                    </select>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr><th></th><th>Exercise</th><th>Sets</th><th>Reps</th><th>Dur(s)</th><th>Weight</th><th>Rest(s)</th><th>Note</th><th></th></tr></thead>
                    <tbody>
                        @for (var i = 0; i < _exDrafts.Count; i++)
                        {
                            var d = _exDrafts[i];
                            var pos = i + 1;
                            <tr>
                                <td class="text-nowrap">
                                    <button class="btn btn-sm btn-link p-0" title="Up" disabled="@(_busy || pos == 1)" @onclick="() => MoveExercise(d.Id, pos - 1)">↑</button>
                                    <button class="btn btn-sm btn-link p-0" title="Down" disabled="@(_busy || pos == _exDrafts.Count)" @onclick="() => MoveExercise(d.Id, pos + 1)">↓</button>
                                </td>
                                <td>@ExName(d.ExerciseDefinitionId)</td>
                                <td style="width:4.5rem"><input type="number" class="form-control form-control-sm" @bind="d.Sets" /></td>
                                <td style="width:4.5rem"><input type="number" class="form-control form-control-sm" @bind="d.Reps" /></td>
                                <td style="width:5rem"><input type="number" class="form-control form-control-sm" @bind="d.Dur" /></td>
                                <td style="width:5.5rem"><input type="number" step="0.5" class="form-control form-control-sm" @bind="d.Weight" /></td>
                                <td style="width:5rem"><input type="number" class="form-control form-control-sm" @bind="d.Rest" /></td>
                                <td style="min-width:8rem"><input class="form-control form-control-sm" @bind="d.Note" /></td>
                                <td class="text-nowrap">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => SaveExercise(d)" disabled="@_busy">Save</button>
                                    <button class="btn btn-sm btn-outline-danger" title="Remove" @onclick="() => RemoveExercise(d.Id)" disabled="@_busy">✕</button>
                                </td>
                            </tr>
                        }
                        @if (_exDrafts.Count == 0) { <tr><td colspan="9" class="text-muted">No exercises.</td></tr> }
                    </tbody>
                </table>
            </div>

            <div class="d-flex gap-2 align-items-end mb-2">
                <div>
                    <label class="form-label mb-0"><small>Add exercise</small></label>
                    <select class="form-select form-select-sm" @bind="_addExId" style="min-width:13rem">
                        @foreach (var ex in _exercises) { <option value="@ex.Id">@ex.Name</option> }
                    </select>
                </div>
                <button class="btn btn-sm btn-outline-primary" @onclick="AddExercise" disabled="@(_busy || _addExId == Guid.Empty)">+ Add</button>
                <button class="btn btn-sm btn-link" @onclick="() => _newExOpen = !_newExOpen">＋ New exercise</button>
            </div>
            @if (_newExOpen)
            {
                <div class="card p-2 mb-2">
                    <div class="row g-2 align-items-end">
                        <div class="col-sm-6"><label class="form-label mb-0"><small>Name</small></label><input class="form-control form-control-sm" @bind="_newEx.Name" /></div>
                        <div class="col-sm-4"><label class="form-label mb-0"><small>Muscle groups</small></label><input class="form-control form-control-sm" @bind="_newEx.MuscleGroups" /></div>
                        <div class="col-sm-2"><button class="btn btn-sm btn-primary w-100" @onclick="CreateNewExercise" disabled="@(_busy || string.IsNullOrWhiteSpace(_newEx.Name))">Create</button></div>
                    </div>
                </div>
            }

            <div class="d-flex gap-2 mt-2">
                @if (open.Archived)
                {
                    <button class="btn btn-sm btn-outline-success" @onclick="() => Restore(open.Id)" disabled="@_busy">Restore</button>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => Archive(open.Id)" disabled="@_busy">Archive</button>
                }
                <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="() => Delete(open.Id)" disabled="@_busy">Delete routine</button>
            </div>
        </div>
    }

    <section class="card">
        <div class="card-head"><h2>Active routines</h2></div>
        @if (!_routines.Any(x => !x.Archived)) { <p class="empty">No active routines yet.</p> }
        <ul class="timeline">
            @foreach (var r in _routines.Where(x => !x.Archived).OrderBy(x => x.Name))
            {
                <li class="ex-row">
                    <div>
                        <span class="ex-name">@r.Name</span>
                        <span class="ex-target">@r.Exercises.Count exercise@(r.Exercises.Count == 1 ? "" : "s")</span>
                    </div>
                    <div class="routine-actions">
                        <button class="link-btn" @onclick="() => Archive(r.Id)" disabled="@_busy">Archive</button>
                        <button class="link-btn" @onclick="() => OpenRoutine(r.Id)" disabled="@_busy">Open</button>
                    </div>
                </li>
            }
        </ul>
    </section>

    @if (ArchivedRoutines.Count > 0)
    {
        <section class="card">
            <button class="link-btn" style="padding:0" @onclick="() => _showArchived = !_showArchived">
                @(_showArchived ? "▾" : "▸") Archived (@ArchivedRoutines.Count)
            </button>
            @if (_showArchived)
            {
                <ul class="timeline" style="margin-top:0.5rem">
                    @foreach (var r in ArchivedRoutines)
                    {
                        <li class="ex-row" style="opacity:0.7">
                            <div><span class="ex-name">@r.Name</span></div>
                            <div class="routine-actions">
                                <button class="link-btn" @onclick="() => Restore(r.Id)" disabled="@_busy">Restore</button>
                                <button class="link-btn" @onclick="() => OpenRoutine(r.Id)" disabled="@_busy">Open</button>
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>
    }
}
</div>

@code {
    private bool _loading = true, _busy, _showArchived, _newExOpen;
    private string? _error, _msg;
    private IReadOnlyList<Routine> _routines = Array.Empty<Routine>();
    private List<ExDef> _exercises = new();
    private Dictionary<Guid, string> _exNames = new();

    private Guid? _openId;
    private string _nameDraft = "";
    private string? _notesDraft;
    private List<ExDraft> _exDrafts = new();
    private Guid _addExId;
    private ExDef _newEx = new();
    private string _newRoutineName = "";

    // ✨ AI routine designer
    private bool _hasAiKey, _aiBusy;
    private bool _aiBodyweightOnly = true;
    private string? _aiHint, _aiError, _aiNote;
    private RoutineSuggestion? _aiDraft;
    private List<SuggestedExercise> _aiExercises = new();

    private Routine? Open => _openId is Guid id ? _routines.FirstOrDefault(r => r.Id == id) : null;
    private List<Routine> ArchivedRoutines => _routines.Where(x => x.Archived).OrderBy(x => x.Name).ToList();

    private sealed class ExDraft
    {
        public Guid Id;
        public Guid ExerciseDefinitionId;
        public int? Sets, Reps, Dur, Rest;
        public double? Weight;
        public string? Note;
    }

    protected override async Task OnInitializedAsync()
    {
        try { _hasAiKey = await Coach.IsConfiguredAsync(); } catch { _hasAiKey = false; }
        await LoadAll();
    }

    private async Task SuggestRoutine()
    {
        _aiBusy = true; _aiError = null; _aiNote = null;
        try
        {
            var easy = (await Coach.RecentlyEasyExercisesAsync()).ToHashSet(StringComparer.OrdinalIgnoreCase);
            _aiDraft = await Coach.SuggestRoutineAsync(_aiHint, _aiBodyweightOnly)
                ?? throw new InvalidOperationException("The AI returned nothing usable — try again.");
            // Backstop the Easy rule in code: drop reused exercises rated Easy last time.
            _aiExercises = _aiDraft.Exercises.Where(e => e.IsNew || !easy.Contains(e.Name)).ToList();
            var dropped = _aiDraft.Exercises.Count - _aiExercises.Count;
            _aiNote = dropped > 0 ? $"Removed {dropped} exercise(s) you rated Easy last time." : null;
        }
        catch (Exception ex) { _aiError = ex.Message; _aiDraft = null; }
        finally { _aiBusy = false; }
    }

    private void DiscardAiDraft() { _aiDraft = null; _aiExercises.Clear(); _aiNote = null; }

    // Persist the reviewed draft: pick-or-create each exercise in the library (case-insensitive),
    // then add it to the new routine with per-exercise targets — mirrors the phone's save path.
    private async Task SaveAiDraft()
    {
        if (_aiDraft is null || _aiExercises.Count == 0) return;
        _aiBusy = true; _msg = null;
        try
        {
            var baseName = _aiDraft.Name.Trim();
            var name = baseName;
            for (var i = 2; _routines.Any(r => string.Equals(r.Name, name, StringComparison.OrdinalIgnoreCase)); i++)
                name = $"{baseName} {i}";

            var create = await RoutineSvc.CreateAsync(name);
            if (!create.IsSuccess) { _msg = create.Error; return; }
            var routineId = create.Value;

            var resolved = new Dictionary<string, (Guid Id, ExerciseMeasure Measure)>(StringComparer.OrdinalIgnoreCase);
            var createdAny = false;
            foreach (var ex in _aiExercises)
            {
                if (!resolved.TryGetValue(ex.Name, out var def))
                {
                    var existing = _exercises.FirstOrDefault(e => string.Equals(e.Name, ex.Name, StringComparison.OrdinalIgnoreCase));
                    if (existing is null)
                    {
                        var entity = new ExDef
                        {
                            Name = ex.Name,
                            Measure = ex.Measure == "duration" ? ExerciseMeasure.Duration : ExerciseMeasure.Reps,
                            // Seed muscle groups from the suggestion so volume tracking works without manual tagging.
                            MuscleGroups = string.IsNullOrWhiteSpace(ex.Muscles) ? null : ex.Muscles
                        };
                        await Sync.PushAsync(entity);   // exercise library isn't a domain aggregate yet
                        createdAny = true;
                        def = (entity.Id, entity.Measure);
                    }
                    else def = (existing.Id, existing.Measure);
                    resolved[ex.Name] = def;
                }

                var prescription = new ExercisePrescription(
                    ex.Sets,
                    def.Measure == ExerciseMeasure.Reps ? (ex.Reps ?? 10) : null,
                    def.Measure == ExerciseMeasure.Duration ? (ex.DurationSeconds ?? 30) : null,
                    ex.RestSeconds ?? 60, null, null);
                var add = await RoutineSvc.AddExerciseAsync(routineId, def.Id, prescription);
                if (!add.IsSuccess) { _msg = add.Error; return; }
            }

            if (createdAny) State.Invalidate();
            DiscardAiDraft();
            _aiHint = "";
            await LoadAll();
            OpenRoutine(routineId);
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _aiBusy = false; }
    }

    private async Task LoadAll()
    {
        _loading = true; _error = null;
        try
        {
            var pull = await State.DataAsync();
            var defs = WebSyncClient.Rows<ExDef>(pull);
            _exNames = defs.ToDictionary(d => d.Id, d => d.Name);
            _exercises = defs.Where(d => !d.Retired).OrderBy(d => d.Name).ToList();
            _routines = await RoutineSvc.ListAsync(includeArchived: true);
            if (_openId is Guid id) BuildDrafts(id);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private string ExName(Guid id) => _exNames.GetValueOrDefault(id, "(exercise)");

    private void OpenRoutine(Guid id) { _openId = id; _newExOpen = false; _msg = null; BuildDrafts(id); }
    private void Close() => _openId = null;

    private void BuildDrafts(Guid id)
    {
        var r = _routines.FirstOrDefault(x => x.Id == id);
        if (r is null) { _openId = null; return; }
        _nameDraft = r.Name;
        _notesDraft = r.Notes;
        _exDrafts = r.Exercises.Select(e => new ExDraft
        {
            Id = e.Id, ExerciseDefinitionId = e.ExerciseDefinitionId,
            Sets = e.Prescription.TargetSets, Reps = e.Prescription.TargetReps,
            Dur = e.Prescription.TargetDurationSeconds, Rest = e.Prescription.RestSeconds,
            Weight = e.Prescription.TargetWeight, Note = e.Prescription.TargetNote,
        }).ToList();
        _addExId = _exDrafts.FirstOrDefault()?.ExerciseDefinitionId ?? _exercises.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private static ExercisePrescription Rx(ExDraft d) => new(d.Sets, d.Reps, d.Dur, d.Rest, d.Weight, d.Note);

    // Run a granular use case, surface failures, reload.
    private async Task Run(Func<Task<Result>> action)
    {
        _busy = true; _msg = null;
        try
        {
            var result = await action();
            if (!result.IsSuccess) _msg = result.Error;
            await LoadAll();
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    private async Task CreateRoutine()
    {
        _busy = true; _msg = null;
        try
        {
            var result = await RoutineSvc.CreateAsync(_newRoutineName);
            if (!result.IsSuccess) { _msg = result.Error; return; }
            _newRoutineName = "";
            await LoadAll();
            OpenRoutine(result.Value);
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    private Task SaveName() => Run(() => RoutineSvc.RenameAsync(_openId!.Value, _nameDraft));
    private Task SaveNotes() => Run(() => RoutineSvc.SetNotesAsync(_openId!.Value, _notesDraft));
    private Task SetMode(ChangeEventArgs e) =>
        Enum.TryParse<RoutineExecutionMode>(e.Value?.ToString(), out var mode)
            ? Run(() => RoutineSvc.SetExecutionModeAsync(_openId!.Value, mode))
            : Task.CompletedTask;
    private Task Archive(Guid id) => Run(() => RoutineSvc.ArchiveAsync(id));
    private Task Restore(Guid id) => Run(() => RoutineSvc.RestoreAsync(id));
    private Task RemoveExercise(Guid reId) => Run(() => RoutineSvc.RemoveExerciseAsync(_openId!.Value, reId));
    private Task SaveExercise(ExDraft d) => Run(() => RoutineSvc.UpdateExerciseAsync(_openId!.Value, d.Id, Rx(d)));
    private Task MoveExercise(Guid reId, int pos) => Run(() => RoutineSvc.MoveExerciseAsync(_openId!.Value, reId, pos));

    private async Task Delete(Guid id)
    {
        await Run(() => RoutineSvc.DeleteAsync(id));
        if (_openId == id) _openId = null;
    }

    private async Task AddExercise()
    {
        if (_addExId == Guid.Empty || _openId is null) return;
        _busy = true; _msg = null;
        try
        {
            var result = await RoutineSvc.AddExerciseAsync(_openId.Value, _addExId, ExercisePrescription.None);
            if (!result.IsSuccess) _msg = result.Error;
            await LoadAll();
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    private async Task CreateNewExercise()
    {
        var name = _newEx.Name?.Trim();
        if (string.IsNullOrWhiteSpace(name)) return;
        var existing = _exercises.FirstOrDefault(e => string.Equals(e.Name, name, StringComparison.OrdinalIgnoreCase));
        if (existing is null)
        {
            _newEx.Name = name;
            await Sync.PushAsync(_newEx);   // exercise library not yet migrated into the domain
            State.Invalidate();
            _addExId = _newEx.Id;
            _newEx = new();
        }
        else _addExId = existing.Id;
        _newExOpen = false;
        await AddExercise();
    }
}
