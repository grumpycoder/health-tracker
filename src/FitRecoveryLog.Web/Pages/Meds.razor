@page "/meds"
@using Microsoft.AspNetCore.Authorization
@using FitRecoveryLog.Application.Labs
@using FitRecoveryLog.Application.Meds
@using FitRecoveryLog.Domain.Labs
@using FitRecoveryLog.Domain.Meds
@using MedicationSchedule = FitRecoveryLog.Data.MedicationSchedule
@using MedicationForm = FitRecoveryLog.Data.MedicationForm
@attribute [Authorize]
@inject MedicationService MedSvc
@inject LabService LabSvc
@inject AppState State

<PageTitle>Medication & Labs — Fit Log</PageTitle>

<div class="content">
    <div class="page-head">
        <div>
            <div class="eyebrow">Health</div>
            <h1 class="dash-date">Medication &amp; Labs</h1>
        </div>
        @if (!_loading && _error is null)
        {
            <div class="segmented">
                <button class="seg @(_tab == "meds" ? "active" : "")" @onclick='() => _tab = "meds"'>💊 Medication</button>
                <button class="seg @(_tab == "labs" ? "active" : "")" @onclick='() => _tab = "labs"'>🧪 Labs</button>
            </div>
        }
    </div>

    @if (_loading)
    {
        <section class="card"><p class="muted">Loading…</p></section>
    }
    else if (_error is not null)
    {
        <section class="card"><p class="warn-msg" style="margin:0">@_error</p><button class="save-btn" @onclick="Load">Retry</button></section>
    }
    else
    {
        @if (_msg is not null) { <section class="card"><p class="warn-msg" style="margin:0">@_msg</p></section> }

        @if (_tab == "meds")
        {
            <div class="routine-head">
                <h2 style="margin:0;color:var(--text)">Medication log</h2>
                <button class="link-btn" @onclick="AddMed" disabled="@(_med is not null)">+ Add dose</button>
            </div>
            @if (_schedules.Count > 0)
            {
                <p class="muted" style="font-size:.85rem;margin:0.2rem 0 0.5rem">Log one of your medications — it fills in the name and dose, same as tapping a phone reminder.</p>
                <div class="chip-row" style="margin:0 0 0.9rem">
                    @foreach (var s in _schedules)
                    {
                        <button class="chip" @onclick="() => PickMed(s)" disabled="@(_med is not null)">
                            @(s.Form == MedicationForm.Injection ? "💉" : "💊") @s.Name@(string.IsNullOrWhiteSpace(s.Dose) ? "" : $" · {s.Dose}")
                        </button>
                    }
                </div>
            }
            else
            {
                <p class="muted" style="font-size:.85rem;margin:0.2rem 0 0.6rem">Medication <em>schedules</em> (reminders) are set up on the phone; once you have some, they'll appear here as one-tap log buttons.</p>
            }
            @if (_med is not null)
            {
                <section class="card">
                    <div class="inline-fields">
                        <div class="field"><label>Name</label><input @bind="_med.Name" /></div>
                        <div class="field"><label>Dose</label><input @bind="_med.Dose" /></div>
                        <div class="field"><label>Frequency</label><input @bind="_med.Frequency" /></div>
                    </div>
                    <div class="inline-fields">
                        <div class="field"><label>Taken at</label><input type="datetime-local" @bind="_med.TakenAt" /></div>
                        <div class="field"><label>Injection site</label><input @bind="_med.InjectionSite" /></div>
                    </div>
                    <div class="field"><label>Reaction notes</label><input @bind="_med.ReactionNotes" /></div>
                    <div class="routine-actions">
                        <button class="save-btn" @onclick="SaveMed" disabled="@_busy">@(_busy ? "Saving…" : "Save")</button>
                        <button class="link-btn" @onclick="() => _med = null" disabled="@_busy">Cancel</button>
                        @if (_med.Id is Guid) { <button class="link-btn danger" style="margin-left:auto" @onclick="DeleteMed" disabled="@_busy">Delete</button> }
                    </div>
                </section>
            }
            <section class="card">
                @if (_meds.Count == 0) { <p class="empty">No doses logged yet.</p> }
                else
                {
                    <table class="history">
                        <thead><tr><th>When</th><th>Name</th><th>Dose</th><th>Site</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var m in _meds.OrderByDescending(x => x.TakenAt))
                            {
                                <tr>
                                    <td>@m.TakenAt.ToLocalTime().ToString("g")</td>
                                    <td>@m.Name</td><td>@(m.Dose ?? "—")</td><td>@(m.InjectionSite ?? "—")</td>
                                    <td class="num"><button class="icon-action" title="Edit" @onclick="() => EditMed(m)">✏️</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        }
        else
        {
            <div class="routine-head">
                <h2 style="margin:0;color:var(--text)">Lab results</h2>
                <button class="link-btn" @onclick="AddLab" disabled="@(_lab is not null)">+ Add result</button>
            </div>
            @if (_lab is not null)
            {
                <section class="card">
                    <div class="inline-fields">
                        <div class="field"><label>Date</label><input type="date" @bind="_lab.Date" /></div>
                        <div class="field"><label>Lab</label><input @bind="_lab.LabName" placeholder="Testosterone, A1C…" /></div>
                        <div class="field"><label>Value</label><input type="number" step="0.01" @bind="_lab.Value" /></div>
                        <div class="field"><label>Unit</label><input @bind="_lab.Unit" /></div>
                    </div>
                    <div class="field"><label>Notes</label><input @bind="_lab.Notes" /></div>
                    <div class="routine-actions">
                        <button class="save-btn" @onclick="SaveLab" disabled="@_busy">@(_busy ? "Saving…" : "Save")</button>
                        <button class="link-btn" @onclick="() => _lab = null" disabled="@_busy">Cancel</button>
                        @if (_lab.Id is Guid) { <button class="link-btn danger" style="margin-left:auto" @onclick="DeleteLab" disabled="@_busy">Delete</button> }
                    </div>
                </section>
            }
            <section class="card">
                @if (_labs.Count == 0) { <p class="empty">No lab results yet.</p> }
                else
                {
                    <table class="history">
                        <thead><tr><th>Date</th><th>Lab</th><th class="num">Value</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var l in _labs.OrderByDescending(x => x.Date))
                            {
                                <tr>
                                    <td>@l.Date.ToString("MMM d, yyyy")</td><td>@l.LabName</td>
                                    <td class="num">@(l.Value?.ToString("0.##") ?? "—") @l.Unit</td>
                                    <td class="num"><button class="icon-action" title="Edit" @onclick="() => EditLab(l)">✏️</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        }
    }
</div>

@code {
    private bool _loading = true, _busy;
    private string? _error, _msg;
    private string _tab = "meds";
    private List<MedicationSchedule> _schedules = new();
    private IReadOnlyList<MedicationDose> _meds = Array.Empty<MedicationDose>();
    private IReadOnlyList<LabResult> _labs = Array.Empty<LabResult>();
    private MedDraft? _med;
    private LabDraft? _lab;

    private sealed class MedDraft
    {
        public Guid? Id; public DateTime TakenAt = DateTime.Now; public string? Name, Dose, Frequency, InjectionSite, ReactionNotes;
        public static MedDraft From(MedicationDose m) => new() { Id = m.Id, TakenAt = m.TakenAt, Name = m.Name, Dose = m.Dose, Frequency = m.Frequency, InjectionSite = m.InjectionSite, ReactionNotes = m.ReactionNotes };
        public MedicationDoseData ToData() => new(TakenAt, Name ?? "", Dose, Frequency, InjectionSite, ReactionNotes);
    }

    private sealed class LabDraft
    {
        public Guid? Id; public DateOnly Date = DateOnly.FromDateTime(DateTime.Now); public string? LabName, Unit, Notes; public double? Value;
        public static LabDraft From(LabResult l) => new() { Id = l.Id, Date = l.Date, LabName = l.LabName, Value = l.Value, Unit = l.Unit, Notes = l.Notes };
        public LabData ToData() => new(Date, LabName ?? "", Value, Unit, Notes);
    }

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true; _error = null;
        try
        {
            _meds = await MedSvc.ListAsync();
            _labs = await LabSvc.ListAsync();
            _schedules = WebSyncClient.Rows<MedicationSchedule>(await State.DataAsync())
                .Where(s => s.Active).OrderBy(s => s.Name).ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void AddMed() { _med = new MedDraft(); _msg = null; }
    private void EditMed(MedicationDose m) { _med = MedDraft.From(m); _msg = null; }

    // Prefill a new dose from one of the user's medication schedules — mirrors completing a phone
    // reminder (copies name + dose). Time defaults to now; injection site is left for the user to set.
    private void PickMed(MedicationSchedule s)
    {
        _med = new MedDraft { TakenAt = DateTime.Now, Name = s.Name, Dose = s.Dose };
        _msg = null;
    }
    private async Task SaveMed()
    {
        if (_med is null) return;
        _busy = true; _msg = null;
        try
        {
            var ok = _med.Id is Guid id ? (await MedSvc.UpdateAsync(id, _med.ToData())).IsSuccess
                                        : (await MedSvc.CreateAsync(_med.ToData())).IsSuccess;
            if (!ok) { _msg = "Save failed (a name is required)."; return; }
            _med = null; await Load();
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }
    private async Task DeleteMed()
    {
        if (_med?.Id is not Guid id) return;
        _busy = true; try { await MedSvc.DeleteAsync(id); _med = null; await Load(); } catch (Exception ex) { _msg = ex.Message; } finally { _busy = false; }
    }

    private void AddLab() { _lab = new LabDraft(); _msg = null; }
    private void EditLab(LabResult l) { _lab = LabDraft.From(l); _msg = null; }
    private async Task SaveLab()
    {
        if (_lab is null) return;
        _busy = true; _msg = null;
        try
        {
            var ok = _lab.Id is Guid id ? (await LabSvc.UpdateAsync(id, _lab.ToData())).IsSuccess
                                        : (await LabSvc.CreateAsync(_lab.ToData())).IsSuccess;
            if (!ok) { _msg = "Save failed (a lab name is required)."; return; }
            _lab = null; await Load();
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }
    private async Task DeleteLab()
    {
        if (_lab?.Id is not Guid id) return;
        _busy = true; try { await LabSvc.DeleteAsync(id); _lab = null; await Load(); } catch (Exception ex) { _msg = ex.Message; } finally { _busy = false; }
    }
}
