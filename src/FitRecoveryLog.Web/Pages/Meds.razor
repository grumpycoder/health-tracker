@page "/meds"
@using Microsoft.AspNetCore.Authorization
@using FitRecoveryLog.Data
@attribute [Authorize]
@inject AppState State
@inject WebSyncClient Sync

<PageTitle>Medication & Labs — Fit Log</PageTitle>

<h1 class="mb-3">Medication &amp; Labs</h1>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
    <button class="btn btn-primary" @onclick="() => Load(true)">Retry</button>
}
else
{
    <!-- ===== Medication log ===== -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h4 class="mb-0">Medication log</h4>
        <button class="btn btn-sm btn-primary" @onclick="AddMed" disabled="@(_medEdit is not null)">+ Add dose</button>
    </div>
    <p class="text-muted small">Medication <em>schedules</em> (reminders) are managed on the phone — they carry on-device notification state.</p>
    @if (_medEdit is not null)
    {
        <div class="card p-3 mb-3">
            <div class="row g-2">
                <div class="col-sm-6"><label class="form-label">Name</label><input class="form-control" @bind="_medEdit.Name" /></div>
                <div class="col-sm-3"><label class="form-label">Dose</label><input class="form-control" @bind="_medEdit.Dose" /></div>
                <div class="col-sm-3"><label class="form-label">Frequency</label><input class="form-control" @bind="_medEdit.Frequency" /></div>
                <div class="col-sm-5"><label class="form-label">Taken at</label><input type="datetime-local" class="form-control" @bind="_medEdit.TakenAt" /></div>
                <div class="col-sm-3"><label class="form-label">Injection site</label><input class="form-control" @bind="_medEdit.InjectionSite" /></div>
                <div class="col-12"><label class="form-label">Reaction notes</label><input class="form-control" @bind="_medEdit.ReactionNotes" /></div>
            </div>
            <div class="mt-2 d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveMed" disabled="@_saving">@(_saving ? "Saving…" : "Save")</button>
                <button class="btn btn-secondary" @onclick="() => _medEdit = null" disabled="@_saving">Cancel</button>
                @if (!_medNew) { <button class="btn btn-outline-danger ms-auto" @onclick="DeleteMed" disabled="@_saving">Delete</button> }
            </div>
        </div>
    }
    <table class="table table-hover table-sm align-middle mb-4">
        <thead><tr><th>When</th><th>Name</th><th>Dose</th><th>Site</th><th></th></tr></thead>
        <tbody>
            @foreach (var m in _meds.OrderByDescending(x => x.TakenAt))
            {
                <tr>
                    <td><small>@m.TakenAt.ToLocalTime().ToString("g")</small></td>
                    <td>@m.Name</td>
                    <td>@(m.Dose ?? "—")</td>
                    <td>@(m.InjectionSite ?? "—")</td>
                    <td class="text-end"><button class="btn btn-sm btn-outline-primary" @onclick="() => EditMed(m)">Edit</button></td>
                </tr>
            }
            @if (_meds.Count == 0) { <tr><td colspan="5" class="text-muted">No doses logged.</td></tr> }
        </tbody>
    </table>

    <!-- ===== Labs ===== -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h4 class="mb-0">Lab results</h4>
        <button class="btn btn-sm btn-primary" @onclick="AddLab" disabled="@(_labEdit is not null)">+ Add</button>
    </div>
    @if (_labEdit is not null)
    {
        <div class="card p-3 mb-3">
            <div class="row g-2">
                <div class="col-sm-4"><label class="form-label">Date</label><input type="date" class="form-control" @bind="_labEdit.Date" /></div>
                <div class="col-sm-4"><label class="form-label">Lab</label><input class="form-control" @bind="_labEdit.LabName" placeholder="Testosterone, A1C…" /></div>
                <div class="col-6 col-sm-2"><label class="form-label">Value</label><input type="number" step="0.01" class="form-control" @bind="_labEdit.Value" /></div>
                <div class="col-6 col-sm-2"><label class="form-label">Unit</label><input class="form-control" @bind="_labEdit.Unit" /></div>
                <div class="col-12"><label class="form-label">Notes</label><input class="form-control" @bind="_labEdit.Notes" /></div>
            </div>
            <div class="mt-2 d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveLab" disabled="@_saving">@(_saving ? "Saving…" : "Save")</button>
                <button class="btn btn-secondary" @onclick="() => _labEdit = null" disabled="@_saving">Cancel</button>
                @if (!_labNew) { <button class="btn btn-outline-danger ms-auto" @onclick="DeleteLab" disabled="@_saving">Delete</button> }
            </div>
        </div>
    }
    <table class="table table-hover table-sm align-middle">
        <thead><tr><th>Date</th><th>Lab</th><th class="text-end">Value</th><th></th></tr></thead>
        <tbody>
            @foreach (var l in _labs.OrderByDescending(x => x.Date))
            {
                <tr>
                    <td>@l.Date.ToString("MMM d, yyyy")</td>
                    <td>@l.LabName</td>
                    <td class="text-end">@(l.Value?.ToString("0.##") ?? "—") @l.Unit</td>
                    <td class="text-end"><button class="btn btn-sm btn-outline-primary" @onclick="() => EditLab(l)">Edit</button></td>
                </tr>
            }
            @if (_labs.Count == 0) { <tr><td colspan="4" class="text-muted">No lab results.</td></tr> }
        </tbody>
    </table>
}

@code {
    private bool _loading = true, _saving, _medNew, _labNew;
    private string? _error;
    private List<MedicationEntry> _meds = new();
    private List<LabResult> _labs = new();
    private MedicationEntry? _medEdit;
    private LabResult? _labEdit;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load(bool refresh = false)
    {
        _loading = true; _error = null;
        try
        {
            var pull = await State.DataAsync(refresh);
            _meds = WebSyncClient.Rows<MedicationEntry>(pull);
            _labs = WebSyncClient.Rows<LabResult>(pull);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    // Medication log
    private void AddMed() { _medEdit = new MedicationEntry { TakenAt = DateTime.Now }; _medNew = true; }
    private void EditMed(MedicationEntry m) { _medEdit = WebSyncClient.Clone(m); _medNew = false; }
    private async Task SaveMed()
    {
        if (_medEdit is null) return;
        _saving = true;
        try { await Sync.PushAsync(_medEdit); State.Invalidate(); await Load(true); _medEdit = null; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }
    private async Task DeleteMed()
    {
        if (_medEdit is null) return;
        _saving = true;
        try { _medEdit.IsDeleted = true; _medEdit.DeletedAt = DateTime.UtcNow; await Sync.PushAsync(_medEdit); State.Invalidate(); await Load(true); _medEdit = null; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    // Labs
    private void AddLab() { _labEdit = new LabResult { Date = DateOnly.FromDateTime(DateTime.Now) }; _labNew = true; }
    private void EditLab(LabResult l) { _labEdit = WebSyncClient.Clone(l); _labNew = false; }
    private async Task SaveLab()
    {
        if (_labEdit is null) return;
        _saving = true;
        try { await Sync.PushAsync(_labEdit); State.Invalidate(); await Load(true); _labEdit = null; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }
    private async Task DeleteLab()
    {
        if (_labEdit is null) return;
        _saving = true;
        try { _labEdit.IsDeleted = true; _labEdit.DeletedAt = DateTime.UtcNow; await Sync.PushAsync(_labEdit); State.Invalidate(); await Load(true); _labEdit = null; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }
}
