@page "/drinks"
@using Microsoft.AspNetCore.Authorization
@using FitRecoveryLog.Application.Nutrition
@using FitRecoveryLog.Domain.Common
@using FitRecoveryLog.Domain.Nutrition
@attribute [Authorize]
@inject DrinkService DrinkSvc

<PageTitle>Drinks — Fit Log</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Drinks</h1>
    <button class="btn btn-primary" @onclick="AddNew" disabled="@(_edit is not null)">+ Add drink</button>
</div>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
    <button class="btn btn-primary" @onclick="Load">Retry</button>
}
else
{
    @if (_edit is not null)
    {
        <div class="card p-3 mb-4">
            <h5>@(_isNew ? "New drink" : "Edit drink")</h5>
            @if (_isNew && _drinkNames.Count > 0)
            {
                <div class="mb-3">
                    <label class="form-label">Repeat a recent drink</label>
                    <select class="form-select" @onchange="RepeatDrink">
                        <option value="">— pick to prefill oz, sugar &amp; macros —</option>
                        @foreach (var n in _drinkNames) { <option value="@n">@n</option> }
                    </select>
                </div>
            }
            <div class="row g-2">
                <div class="col-12"><label class="form-label">Description</label><input class="form-control" @bind="_edit.Description" /></div>
                <div class="col-sm-5"><label class="form-label">Time</label><input type="datetime-local" class="form-control" @bind="_edit.Time" /></div>
                <div class="col-6 col-sm-3"><label class="form-label">Ounces</label><input type="number" step="0.1" class="form-control" @bind="_edit.Ounces" /></div>
                <div class="col-6 col-sm-4"><label class="form-label">Sugar added (tsp)</label><input type="number" class="form-control" @bind="_edit.SugarCount" /></div>

                <div class="col-6 col-md-3"><label class="form-label">Calories</label><input type="number" class="form-control" @bind="_edit.Calories" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Protein (g)</label><input type="number" step="0.1" class="form-control" @bind="_edit.ProteinG" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Carbs (g)</label><input type="number" step="0.1" class="form-control" @bind="_edit.CarbsG" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Fat (g)</label><input type="number" step="0.1" class="form-control" @bind="_edit.FatG" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Fiber (g)</label><input type="number" step="0.1" class="form-control" @bind="_edit.FiberG" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Sugar (g)</label><input type="number" step="0.1" class="form-control" @bind="_edit.SugarG" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Added sugar (g)</label><input type="number" step="0.1" class="form-control" @bind="_edit.AddedSugarG" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Sodium (mg)</label><input type="number" class="form-control" @bind="_edit.SodiumMg" /></div>

                <div class="col-12"><label class="form-label">Tags (comma-separated)</label><input class="form-control" @bind="_edit.Tags" /></div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" @onclick="Save" disabled="@_busy">@(_busy ? "Saving…" : "Save")</button>
                <button class="btn btn-secondary" @onclick="Cancel" disabled="@_busy">Cancel</button>
                @if (!_isNew) { <button class="btn btn-outline-danger ms-auto" @onclick="Delete" disabled="@_busy">Delete</button> }
            </div>
            @if (_msg is not null) { <div class="form-text mt-2">@_msg</div> }
        </div>
    }

    <table class="table table-hover align-middle">
        <thead><tr><th>When</th><th>Description</th><th class="text-end">Oz</th><th class="text-end">Cal</th><th></th></tr></thead>
        <tbody>
            @foreach (var d in _drinks.OrderByDescending(x => x.Time))
            {
                <tr>
                    <td><small>@d.Time.ToLocalTime().ToString("g")</small></td>
                    <td>@d.Description</td>
                    <td class="text-end">@(d.Ounces?.ToString("0.#") ?? "—")</td>
                    <td class="text-end">@(d.Macros.Calories?.ToString() ?? "—")</td>
                    <td class="text-end"><button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(d)">Edit</button></td>
                </tr>
            }
            @if (_drinks.Count == 0) { <tr><td colspan="5" class="text-muted">No drinks.</td></tr> }
        </tbody>
    </table>
}

@code {
    private bool _loading = true, _busy, _isNew;
    private string? _error, _msg;
    private IReadOnlyList<Drink> _drinks = Array.Empty<Drink>();
    private Draft? _edit;
    private Dictionary<string, Drink> _drinkMemory = new(StringComparer.OrdinalIgnoreCase);
    private List<string> _drinkNames = new();

    private sealed class Draft
    {
        public Guid? Id;
        public DateTime Time = DateTime.Now;
        public string? Description, Tags;
        public double? Ounces;
        public int? SugarCount, Calories, SodiumMg;
        public double? ProteinG, CarbsG, SugarG, FatG, FiberG, AddedSugarG;

        public static Draft From(Drink d) => new()
        {
            Id = d.Id, Time = d.Time, Description = d.Description, Ounces = d.Ounces, SugarCount = d.SugarCount,
            Calories = d.Macros.Calories, SodiumMg = d.Macros.SodiumMg, ProteinG = d.Macros.ProteinG,
            CarbsG = d.Macros.CarbsG, SugarG = d.Macros.SugarG, FatG = d.Macros.FatG, FiberG = d.Macros.FiberG,
            AddedSugarG = d.Macros.AddedSugarG, Tags = d.Tags.ToCsv(),
        };

        public DrinkData ToData() => new(Time, Description, Ounces, SugarCount,
            new Macros(Calories, ProteinG, CarbsG, FatG, FiberG, SugarG, AddedSugarG, SodiumMg),
            FitRecoveryLog.Domain.Common.Tags.FromCsv(Tags));
    }

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true; _error = null;
        try
        {
            _drinks = await DrinkSvc.ListAsync();
            _drinkMemory = _drinks.Where(d => !string.IsNullOrWhiteSpace(d.Description))
                .GroupBy(d => d.Description.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.OrderByDescending(d => d.Time).First(), StringComparer.OrdinalIgnoreCase);
            _drinkNames = _drinkMemory.Values.OrderByDescending(d => d.Time).Select(d => d.Description.Trim()).ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void AddNew() { _edit = new Draft { Time = DateTime.Now }; _isNew = true; _msg = null; }
    private void Edit(Drink d) { _edit = Draft.From(d); _isNew = false; _msg = null; }
    private void Cancel() { _edit = null; _msg = null; }

    private void RepeatDrink(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        if (_edit is null || string.IsNullOrEmpty(name) || !_drinkMemory.TryGetValue(name, out var src)) return;
        var d = Draft.From(src);
        d.Id = null; d.Time = DateTime.Now;
        _edit = d;
    }

    private async Task Save()
    {
        if (_edit is null) return;
        _busy = true; _msg = null;
        try
        {
            var ok = _isNew
                ? (await DrinkSvc.CreateAsync(_edit.ToData())).IsSuccess
                : (await DrinkSvc.UpdateAsync(_edit.Id!.Value, _edit.ToData())).IsSuccess;
            if (!ok) { _msg = "Save failed (check amounts)."; return; }
            _edit = null;
            await Load();
        }
        catch (Exception ex) { _msg = "Failed: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task Delete()
    {
        if (_edit?.Id is not Guid id) return;
        _busy = true; _msg = null;
        try { await DrinkSvc.DeleteAsync(id); _edit = null; await Load(); }
        catch (Exception ex) { _msg = "Failed: " + ex.Message; }
        finally { _busy = false; }
    }
}
