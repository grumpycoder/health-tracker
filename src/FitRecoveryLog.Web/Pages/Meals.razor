@page "/meals"
@using Microsoft.AspNetCore.Authorization
@using FitRecoveryLog.Application.Nutrition
@using FitRecoveryLog.Domain.Common
@using FitRecoveryLog.Domain.Nutrition
@using FitRecoveryLog.Application.Ai
@attribute [Authorize]
@inject MealService MealSvc
@inject DrinkService DrinkSvc
@inject IAiCoach Coach

<PageTitle>Meals &amp; Drinks — Fit Log</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <div class="dash-date">Meals &amp; Drinks</div>
        <div class="dash-date-sub">@DateTime.Now.ToString("dddd, MMM d")</div>
    </header>

    <div class="segmented">
        <button class="seg @(_tab == "meal" ? "active" : "")" @onclick='() => Switch("meal")'>🍽️ Meals</button>
        <button class="seg @(_tab == "drink" ? "active" : "")" @onclick='() => Switch("drink")'>🥤 Drinks</button>
    </div>

    @if (_loading)
    {
        <section class="card"><p class="muted">Loading…</p></section>
    }
    else if (_error is not null)
    {
        <section class="card"><p class="warn-msg" style="margin:0">@_error</p><button class="save-btn" @onclick="Load">Retry</button></section>
    }
    else if (_tab == "meal")
    {
        <div class="routine-head">
            <h2 style="margin:0;color:var(--text)">Meal log</h2>
            <button class="link-btn" @onclick="AddMeal" disabled="@(_meal is not null)">+ Add meal</button>
        </div>

        @if (_meal is not null)
        {
            <section class="card">
                @if (_meal.Id is null && _foodNames.Count > 0)
                {
                    <div class="field">
                        <label>Repeat a recent meal</label>
                        <select @onchange="RepeatFood">
                            <option value="">— pick to prefill macros &amp; tags —</option>
                            @foreach (var n in _foodNames) { <option value="@n">@n</option> }
                        </select>
                    </div>
                }
                <div class="field"><label>Description</label><input @bind="_meal.Description" /></div>
                <div class="inline-fields">
                    <div class="field"><label>Type</label><select @bind="_meal.MealType">@foreach (var v in Enum.GetValues<MealType>()) { <option value="@v">@v</option> }</select></div>
                    <div class="field"><label>Time</label><input type="datetime-local" @bind="_meal.Time" /></div>
                    <div class="field"><label>Satiety</label><select @bind="_meal.Satiety">@foreach (var v in Enum.GetValues<Satiety>()) { <option value="@v">@v</option> }</select></div>
                </div>
                <div class="inline-fields">
                    <div class="field"><label>Calories</label><input type="number" @bind="_meal.Calories" /></div>
                    <div class="field"><label>Protein (g)</label><input type="number" step="0.1" @bind="_meal.ProteinG" /></div>
                    <div class="field"><label>Carbs (g)</label><input type="number" step="0.1" @bind="_meal.CarbsG" /></div>
                    <div class="field"><label>Fat (g)</label><input type="number" step="0.1" @bind="_meal.FatG" /></div>
                </div>
                <div class="inline-fields">
                    <div class="field"><label>Sugar (g)</label><input type="number" step="0.1" @bind="_meal.SugarG" /></div>
                    <div class="field"><label>Added sugar (g)</label><input type="number" step="0.1" @bind="_meal.AddedSugarG" /></div>
                    <div class="field"><label>Fiber (g)</label><input type="number" step="0.1" @bind="_meal.FiberG" /></div>
                    <div class="field"><label>Sodium (mg)</label><input type="number" @bind="_meal.SodiumMg" /></div>
                </div>
                <div class="field"><label>Portion note</label><input @bind="_meal.PortionNote" /></div>
                <div class="field">
                    <label>Tags (comma-separated)</label>
                    <input @bind="_meal.Tags" />
                    <div class="chip-row" style="gap:1rem;margin-top:0.35rem">
                        <button class="link-btn" style="padding:0" @onclick="EstimateMacros" disabled="@(_aiBusy || string.IsNullOrWhiteSpace(_meal.Description))">
                            @(_aiBusy ? "Thinking…" : "✨ Estimate macros")
                        </button>
                        <button class="link-btn" style="padding:0" @onclick="SuggestTags" disabled="@(_aiBusy || string.IsNullOrWhiteSpace(_meal.Description))">
                            ✨ Suggest tags only
                        </button>
                    </div>
                    @if (_meal.QualityStars is { } stars)
                    {
                        <span class="pill @(stars >= 4 ? "good" : stars >= 3 ? "caution" : "critical")" style="margin-left:0.5rem">
                            @(new string('★', stars))@(new string('☆', 5 - stars))@(string.IsNullOrWhiteSpace(_starReason) ? "" : $" · {_starReason}")
                        </span>
                    }
                </div>
                @if (_advice is not null)
                {
                    <div class="card" style="border-color:var(--caution);margin:0 0 0.8rem">
                        <div style="color:var(--caution);font-weight:700;font-size:.78rem;letter-spacing:.06em;margin-bottom:4px">⚠ OVER YOUR TARGETS</div>
                        @if (!string.IsNullOrEmpty(_advice.Message)) { <p style="margin:0 0 .4rem;line-height:1.45">@_advice.Message</p> }
                        <p style="margin:0 0 .6rem"><strong>Suggestion:</strong> @_advice.Suggestion</p>
                        <div class="chip-row" style="gap:12px">
                            <button class="save-btn" @onclick="ApplyAdvice">Apply suggestion</button>
                            <button class="link-btn" @onclick="() => _advice = null">Dismiss</button>
                        </div>
                    </div>
                }
                <div class="routine-actions">
                    <button class="save-btn" @onclick="SaveMeal" disabled="@_busy">@(_busy ? "Saving…" : "Save")</button>
                    <button class="link-btn" @onclick="() => _meal = null" disabled="@_busy">Cancel</button>
                    @if (_meal.Id is Guid) { <button class="link-btn danger" style="margin-left:auto" @onclick="DeleteMeal" disabled="@_busy">Delete</button> }
                </div>
                @if (_msg is not null) { <p class="muted" style="margin:0.4rem 0 0">@_msg</p> }
            </section>
        }

        <section class="card">
            @if (_meals.Count == 0) { <p class="muted">No meals logged.</p> }
            <ul class="timeline">
                @foreach (var m in _meals.OrderByDescending(x => x.Time))
                {
                    <li>
                        <div>
                            <span class="time">@m.Time.ToLocalTime().ToString("g")</span>
                            <span class="entry"><strong>@m.MealType</strong> — @m.Description
                                @if (m.Macros.Calories is { } c) { <span class="muted"> · @c cal</span> }
                            </span>
                        </div>
                        <div class="routine-actions"><button class="icon-action" title="Edit" @onclick="() => EditMeal(m)">✏️</button></div>
                    </li>
                }
            </ul>
        </section>
    }
    else
    {
        <div class="routine-head">
            <h2 style="margin:0;color:var(--text)">Drink log</h2>
            <button class="link-btn" @onclick="AddDrink" disabled="@(_drink is not null)">+ Add drink</button>
        </div>

        @if (_drink is not null)
        {
            <section class="card">
                @if (_drink.Id is null && _drinkNames.Count > 0)
                {
                    <div class="field">
                        <label>Repeat a recent drink</label>
                        <select @onchange="RepeatDrink">
                            <option value="">— pick to prefill oz, sugar &amp; macros —</option>
                            @foreach (var n in _drinkNames) { <option value="@n">@n</option> }
                        </select>
                    </div>
                }
                <div class="field"><label>Description</label><input @bind="_drink.Description" /></div>
                <div class="inline-fields">
                    <div class="field"><label>Time</label><input type="datetime-local" @bind="_drink.Time" /></div>
                    <div class="field"><label>Ounces</label><input type="number" step="0.1" @bind="_drink.Ounces" /></div>
                    <div class="field"><label>Sugar added (tsp)</label><input type="number" @bind="_drink.SugarCount" /></div>
                </div>
                <div class="inline-fields">
                    <div class="field"><label>Calories</label><input type="number" @bind="_drink.Calories" /></div>
                    <div class="field"><label>Protein (g)</label><input type="number" step="0.1" @bind="_drink.ProteinG" /></div>
                    <div class="field"><label>Carbs (g)</label><input type="number" step="0.1" @bind="_drink.CarbsG" /></div>
                    <div class="field"><label>Fat (g)</label><input type="number" step="0.1" @bind="_drink.FatG" /></div>
                </div>
                <div class="inline-fields">
                    <div class="field"><label>Sugar (g)</label><input type="number" step="0.1" @bind="_drink.SugarG" /></div>
                    <div class="field"><label>Added sugar (g)</label><input type="number" step="0.1" @bind="_drink.AddedSugarG" /></div>
                    <div class="field"><label>Fiber (g)</label><input type="number" step="0.1" @bind="_drink.FiberG" /></div>
                    <div class="field"><label>Sodium (mg)</label><input type="number" @bind="_drink.SodiumMg" /></div>
                </div>
                <div class="field">
                    <label>Tags (comma-separated)</label>
                    <input @bind="_drink.Tags" />
                    <div class="chip-row" style="gap:1rem;margin-top:0.35rem">
                        <button class="link-btn" style="padding:0" @onclick="EstimateDrinkMacros" disabled="@(_aiBusy || string.IsNullOrWhiteSpace(_drink.Description))">
                            @(_aiBusy ? "Thinking…" : "✨ Estimate macros")
                        </button>
                        <button class="link-btn" style="padding:0" @onclick="SuggestDrinkTags" disabled="@(_aiBusy || string.IsNullOrWhiteSpace(_drink.Description))">
                            ✨ Suggest tags only
                        </button>
                    </div>
                    @if (_drinkStars is { } stars)
                    {
                        <span class="pill @(stars >= 4 ? "good" : stars >= 3 ? "caution" : "critical")" style="margin-top:0.4rem;display:inline-block">
                            @(new string('★', stars))@(new string('☆', 5 - stars))@(string.IsNullOrWhiteSpace(_starReason) ? "" : $" · {_starReason}")
                        </span>
                    }
                </div>
                @if (_advice is not null)
                {
                    <div class="card" style="border-color:var(--caution);margin:0 0 0.8rem">
                        <div style="color:var(--caution);font-weight:700;font-size:.78rem;letter-spacing:.06em;margin-bottom:4px">⚠ OVER YOUR TARGETS</div>
                        @if (!string.IsNullOrEmpty(_advice.Message)) { <p style="margin:0 0 .4rem;line-height:1.45">@_advice.Message</p> }
                        <p style="margin:0 0 .6rem"><strong>Suggestion:</strong> @_advice.Suggestion</p>
                        <div class="chip-row" style="gap:12px">
                            <button class="save-btn" @onclick="ApplyAdvice">Apply suggestion</button>
                            <button class="link-btn" @onclick="() => _advice = null">Dismiss</button>
                        </div>
                    </div>
                }
                <div class="routine-actions">
                    <button class="save-btn" @onclick="SaveDrink" disabled="@_busy">@(_busy ? "Saving…" : "Save")</button>
                    <button class="link-btn" @onclick="() => _drink = null" disabled="@_busy">Cancel</button>
                    @if (_drink.Id is Guid) { <button class="link-btn danger" style="margin-left:auto" @onclick="DeleteDrink" disabled="@_busy">Delete</button> }
                </div>
                @if (_msg is not null) { <p class="muted" style="margin:0.4rem 0 0">@_msg</p> }
            </section>
        }

        <section class="card">
            @if (_drinks.Count == 0) { <p class="muted">No drinks logged.</p> }
            <ul class="timeline">
                @foreach (var d in _drinks.OrderByDescending(x => x.Time))
                {
                    <li>
                        <div>
                            <span class="time">@d.Time.ToLocalTime().ToString("g")</span>
                            <span class="entry">🥤 @d.Description
                                @if (d.Ounces is { } oz) { <span class="muted"> · @oz.ToString("0.#") oz</span> }
                                @if (d.Macros.Calories is { } c) { <span class="muted"> · @c cal</span> }
                            </span>
                        </div>
                        <div class="routine-actions"><button class="icon-action" title="Edit" @onclick="() => EditDrink(d)">✏️</button></div>
                    </li>
                }
            </ul>
        </section>
    }
</div>

@code {
    private string _tab = "meal";
    private bool _loading = true, _busy, _aiBusy;
    private string? _error, _msg, _starReason;
    private int? _drinkStars;
    private PortionAdvice? _advice;                       // day-fit trim advice from the estimator
    private readonly List<string> _mealAiTags = new();   // tags the last AI run added (for replace-on-rerun)
    private readonly List<string> _drinkAiTags = new();
    private List<string> _tagVocab = new();

    private IReadOnlyList<Meal> _meals = Array.Empty<Meal>();
    private IReadOnlyList<Drink> _drinks = Array.Empty<Drink>();
    private MealDraft? _meal;
    private DrinkDraft? _drink;
    private Dictionary<string, Meal> _foodMemory = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, Drink> _drinkMemory = new(StringComparer.OrdinalIgnoreCase);
    private List<string> _foodNames = new();
    private List<string> _drinkNames = new();

    private void Switch(string tab) { _tab = tab; _meal = null; _drink = null; _msg = null; _starReason = null; _drinkStars = null; _advice = null; _mealAiTags.Clear(); _drinkAiTags.Clear(); }

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true; _error = null;
        try
        {
            _meals = await MealSvc.ListAsync();
            _drinks = await DrinkSvc.ListAsync();
            _foodMemory = _meals.Where(m => !string.IsNullOrWhiteSpace(m.Description))
                .GroupBy(m => m.Description.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.OrderByDescending(m => m.Time).First(), StringComparer.OrdinalIgnoreCase);
            _foodNames = _foodMemory.Values.OrderByDescending(m => m.Time).Select(m => m.Description.Trim()).ToList();
            _drinkMemory = _drinks.Where(d => !string.IsNullOrWhiteSpace(d.Description))
                .GroupBy(d => d.Description.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.OrderByDescending(d => d.Time).First(), StringComparer.OrdinalIgnoreCase);
            _drinkNames = _drinkMemory.Values.OrderByDescending(d => d.Time).Select(d => d.Description.Trim()).ToList();

            // Existing tags become the suggester's vocabulary (it strongly prefers reusing them).
            _tagVocab = _meals.SelectMany(m => m.Tags.Values)
                .Concat(_drinks.SelectMany(d => d.Tags.Values))
                .Where(t => !string.IsNullOrWhiteSpace(t))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    // ✨ Estimate macros from the text description (no camera) + tag/rate it, then fill the form.
    // Values are estimates — left editable so the user can correct portions.
    private async Task EstimateMacros()
    {
        if (_meal is null || string.IsNullOrWhiteSpace(_meal.Description)) return;
        _aiBusy = true; _msg = null; _starReason = null;
        try
        {
            var scan = await Coach.EstimateMealFromTextAsync(
                _meal.MealType.ToString(), _meal.Description!, _meal.PortionNote, _tagVocab);
            if (scan is null) { _msg = "The AI couldn't estimate that — try a clearer description."; return; }

            var f = scan.Facts;
            _meal.Calories = f.Calories; _meal.ProteinG = f.ProteinG; _meal.CarbsG = f.CarbsG; _meal.FatG = f.FatG;
            _meal.SugarG = f.SugarG; _meal.AddedSugarG = f.AddedSugarG; _meal.FiberG = f.FiberG; _meal.SodiumMg = f.SodiumMg;
            ApplyTags(scan.Tags);
            _advice = scan.Advice;
            _msg = $"Estimated{(string.IsNullOrWhiteSpace(f.ServingSize) ? "" : $" for {f.ServingSize}")} — adjust if needed.";
        }
        catch (Exception ex) { _msg = "AI request failed: " + ex.Message; }
        finally { _aiBusy = false; }
    }

    // ✨ Tags + fit rating only (leaves macros as the user entered them).
    private async Task SuggestTags()
    {
        if (_meal is null || string.IsNullOrWhiteSpace(_meal.Description)) return;
        _aiBusy = true; _msg = null; _starReason = null;
        try
        {
            var macros = _meal.Calories is { } c ? $"{c} kcal, {_meal.ProteinG ?? 0:0}g protein, {_meal.CarbsG ?? 0:0}g carbs, {_meal.FatG ?? 0:0}g fat, {_meal.SugarG ?? 0:0}g sugar, {_meal.SodiumMg ?? 0}mg sodium" : null;
            var suggestion = await Coach.SuggestMealTagsAsync(
                _meal.MealType.ToString(), _meal.Description!, _meal.PortionNote, _tagVocab, macros);
            ApplyTags(suggestion);
            _advice = null;
            if (suggestion.Known.Count == 0 && string.IsNullOrWhiteSpace(suggestion.Proposed) && suggestion.Stars is null)
                _msg = "The AI didn't return any suggestions — try adding a description or macros.";
        }
        catch (Exception ex) { _msg = "AI request failed: " + ex.Message; }
        finally { _aiBusy = false; }
    }

    // Apply the estimator's trim suggestion: overwrite the open draft's macros with the adjusted
    // values, note the change on a meal's portion, and clear the advice.
    private void ApplyAdvice()
    {
        if (_advice is null) return;
        var a = _advice.Adjusted;
        if (_meal is not null)
        {
            _meal.Calories = a.Calories; _meal.ProteinG = a.ProteinG; _meal.CarbsG = a.CarbsG; _meal.FatG = a.FatG;
            _meal.SugarG = a.SugarG; _meal.AddedSugarG = a.AddedSugarG; _meal.FiberG = a.FiberG; _meal.SodiumMg = a.SodiumMg;
            _meal.PortionNote = string.IsNullOrWhiteSpace(_meal.PortionNote) ? "Trimmed per suggestion" : $"{_meal.PortionNote} · trimmed per suggestion";
        }
        else if (_drink is not null)
        {
            _drink.Calories = a.Calories; _drink.ProteinG = a.ProteinG; _drink.CarbsG = a.CarbsG; _drink.FatG = a.FatG;
            _drink.SugarG = a.SugarG; _drink.AddedSugarG = a.AddedSugarG; _drink.FiberG = a.FiberG; _drink.SodiumMg = a.SodiumMg;
        }
        _advice = null;
        _msg = "Macros updated from the suggestion.";
    }

    // Meal: refresh tags from a suggestion + record the persisted quality score.
    private void ApplyTags(TagSuggestion s)
    {
        if (_meal is null) return;
        _meal.Tags = ApplyAiTags(_meal.Tags, s, _mealAiTags);
        _meal.QualityStars = s.Stars;
        _starReason = s.StarReason;
    }

    // Merge an AI suggestion into a tag CSV: drop the tags a PRIOR AI run added (so re-running on a
    // changed item replaces, not accumulates), keep the user's own tags, add the new suggestion.
    // Records the tags this run attributes to the AI into <paramref name="priorAiTags"/>.
    private static readonly StringComparer Ci = StringComparer.OrdinalIgnoreCase;
    private static string ApplyAiTags(string? currentCsv, TagSuggestion s, List<string> priorAiTags)
    {
        var tags = Tags.FromCsv(currentCsv).Values.ToList();
        tags.RemoveAll(t => priorAiTags.Contains(t, Ci));   // strip last run's AI tags
        var userTags = new List<string>(tags);              // whatever's left is the user's
        var aiTags = new List<string>();

        void Add(string? tag)
        {
            if (string.IsNullOrWhiteSpace(tag)) return;
            if (!tags.Contains(tag, Ci)) tags.Add(tag);
            if (!userTags.Contains(tag, Ci) && !aiTags.Contains(tag, Ci)) aiTags.Add(tag);
        }
        foreach (var t in s.Known) Add(t);
        Add(s.Proposed);

        priorAiTags.Clear();
        priorAiTags.AddRange(aiTags);
        return string.Join(", ", tags);
    }

    // ✨ Drinks — same two AI actions. Drinks carry no persisted quality score, so the ★ rating
    // is shown transiently (_drinkStars) for feedback but not saved.
    private async Task EstimateDrinkMacros()
    {
        if (_drink is null || string.IsNullOrWhiteSpace(_drink.Description)) return;
        _aiBusy = true; _msg = null; _starReason = null; _drinkStars = null;
        try
        {
            var portion = _drink.Ounces is { } oz ? $"{oz:0.#} oz" : null;
            var scan = await Coach.EstimateMealFromTextAsync("Drink", _drink.Description!, portion, _tagVocab);
            if (scan is null) { _msg = "The AI couldn't estimate that — try a clearer description."; return; }

            var f = scan.Facts;
            _drink.Calories = f.Calories; _drink.ProteinG = f.ProteinG; _drink.CarbsG = f.CarbsG; _drink.FatG = f.FatG;
            _drink.SugarG = f.SugarG; _drink.AddedSugarG = f.AddedSugarG; _drink.FiberG = f.FiberG; _drink.SodiumMg = f.SodiumMg;
            _drink.Tags = ApplyAiTags(_drink.Tags, scan.Tags, _drinkAiTags);
            _drinkStars = scan.Tags.Stars; _starReason = scan.Tags.StarReason;
            _advice = scan.Advice;
            _msg = $"Estimated{(string.IsNullOrWhiteSpace(f.ServingSize) ? "" : $" for {f.ServingSize}")} — adjust if needed.";
        }
        catch (Exception ex) { _msg = "AI request failed: " + ex.Message; }
        finally { _aiBusy = false; }
    }

    private async Task SuggestDrinkTags()
    {
        if (_drink is null || string.IsNullOrWhiteSpace(_drink.Description)) return;
        _aiBusy = true; _msg = null; _starReason = null; _drinkStars = null;
        try
        {
            var portion = _drink.Ounces is { } oz ? $"{oz:0.#} oz" : null;
            var macros = _drink.Calories is { } c ? $"{c} kcal, {_drink.ProteinG ?? 0:0}g protein, {_drink.CarbsG ?? 0:0}g carbs, {_drink.SugarG ?? 0:0}g sugar, {_drink.SodiumMg ?? 0}mg sodium" : null;
            var s = await Coach.SuggestMealTagsAsync("Drink", _drink.Description!, portion, _tagVocab, macros);
            _drink.Tags = ApplyAiTags(_drink.Tags, s, _drinkAiTags);
            _drinkStars = s.Stars; _starReason = s.StarReason;
            _advice = null;
            if (s.Known.Count == 0 && string.IsNullOrWhiteSpace(s.Proposed) && s.Stars is null)
                _msg = "The AI didn't return any suggestions.";
        }
        catch (Exception ex) { _msg = "AI request failed: " + ex.Message; }
        finally { _aiBusy = false; }
    }

    // ---- meals ----
    private void AddMeal() { _meal = new MealDraft { Time = DateTime.Now }; _msg = null; _starReason = null; _mealAiTags.Clear(); }
    private void EditMeal(Meal m) { _meal = MealDraft.From(m); _msg = null; _starReason = null; _mealAiTags.Clear(); }
    private void RepeatFood(ChangeEventArgs e)
    {
        if (_meal is null || e.Value?.ToString() is not { Length: > 0 } name || !_foodMemory.TryGetValue(name, out var src)) return;
        var d = MealDraft.From(src); d.Id = null; d.Time = DateTime.Now; _meal = d;
    }
    private async Task SaveMeal()
    {
        if (_meal is null) return;
        _busy = true; _msg = null;
        try
        {
            var ok = _meal.Id is Guid id ? (await MealSvc.UpdateAsync(id, _meal.ToData())).IsSuccess
                                         : (await MealSvc.CreateAsync(_meal.ToData())).IsSuccess;
            if (!ok) { _msg = "Save failed."; return; }
            _meal = null; await Load();
        }
        catch (Exception ex) { _msg = "Failed: " + ex.Message; }
        finally { _busy = false; }
    }
    private async Task DeleteMeal()
    {
        if (_meal?.Id is not Guid id) return;
        _busy = true; try { await MealSvc.DeleteAsync(id); _meal = null; await Load(); } catch (Exception ex) { _msg = ex.Message; } finally { _busy = false; }
    }

    // ---- drinks ----
    private void AddDrink() { _drink = new DrinkDraft { Time = DateTime.Now }; _msg = null; _drinkStars = null; _starReason = null; _drinkAiTags.Clear(); }
    private void EditDrink(Drink d) { _drink = DrinkDraft.From(d); _msg = null; _drinkStars = null; _starReason = null; _drinkAiTags.Clear(); }
    private void RepeatDrink(ChangeEventArgs e)
    {
        if (_drink is null || e.Value?.ToString() is not { Length: > 0 } name || !_drinkMemory.TryGetValue(name, out var src)) return;
        var d = DrinkDraft.From(src); d.Id = null; d.Time = DateTime.Now; _drink = d;
    }
    private async Task SaveDrink()
    {
        if (_drink is null) return;
        _busy = true; _msg = null;
        try
        {
            var ok = _drink.Id is Guid id ? (await DrinkSvc.UpdateAsync(id, _drink.ToData())).IsSuccess
                                          : (await DrinkSvc.CreateAsync(_drink.ToData())).IsSuccess;
            if (!ok) { _msg = "Save failed (check amounts)."; return; }
            _drink = null; await Load();
        }
        catch (Exception ex) { _msg = "Failed: " + ex.Message; }
        finally { _busy = false; }
    }
    private async Task DeleteDrink()
    {
        if (_drink?.Id is not Guid id) return;
        _busy = true; try { await DrinkSvc.DeleteAsync(id); _drink = null; await Load(); } catch (Exception ex) { _msg = ex.Message; } finally { _busy = false; }
    }

    private sealed class MealDraft
    {
        public Guid? Id;
        public DateTime Time = DateTime.Now;
        public MealType MealType = MealType.Snack;
        public string? Description, PortionNote, Tags;
        public Satiety Satiety = Satiety.Unset;
        public int? QualityStars, Calories, SodiumMg;
        public double? ProteinG, CarbsG, SugarG, FatG, FiberG, AddedSugarG;

        public static MealDraft From(Meal m) => new()
        {
            Id = m.Id, Time = m.Time, MealType = m.MealType, Description = m.Description, PortionNote = m.PortionNote,
            Satiety = m.Satiety, QualityStars = m.QualityStars, Calories = m.Macros.Calories, SodiumMg = m.Macros.SodiumMg,
            ProteinG = m.Macros.ProteinG, CarbsG = m.Macros.CarbsG, SugarG = m.Macros.SugarG, FatG = m.Macros.FatG,
            FiberG = m.Macros.FiberG, AddedSugarG = m.Macros.AddedSugarG, Tags = m.Tags.ToCsv(),
        };

        public MealData ToData() => new(Time, MealType, Description, PortionNote, Satiety, QualityStars,
            new Macros(Calories, ProteinG, CarbsG, FatG, FiberG, SugarG, AddedSugarG, SodiumMg),
            FitRecoveryLog.Domain.Common.Tags.FromCsv(Tags));
    }

    private sealed class DrinkDraft
    {
        public Guid? Id;
        public DateTime Time = DateTime.Now;
        public string? Description, Tags;
        public double? Ounces;
        public int? SugarCount, Calories, SodiumMg;
        public double? ProteinG, CarbsG, SugarG, FatG, FiberG, AddedSugarG;

        public static DrinkDraft From(Drink d) => new()
        {
            Id = d.Id, Time = d.Time, Description = d.Description, Ounces = d.Ounces, SugarCount = d.SugarCount,
            Calories = d.Macros.Calories, SodiumMg = d.Macros.SodiumMg, ProteinG = d.Macros.ProteinG,
            CarbsG = d.Macros.CarbsG, SugarG = d.Macros.SugarG, FatG = d.Macros.FatG, FiberG = d.Macros.FiberG,
            AddedSugarG = d.Macros.AddedSugarG, Tags = d.Tags.ToCsv(),
        };

        public DrinkData ToData() => new(Time, Description, Ounces, SugarCount,
            new Macros(Calories, ProteinG, CarbsG, FatG, FiberG, SugarG, AddedSugarG, SodiumMg),
            FitRecoveryLog.Domain.Common.Tags.FromCsv(Tags));
    }
