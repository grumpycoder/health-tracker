    private void AddMeal() { _meal = new MealDraft { Time = DateTime.Now }; _msg = null; _starReason = null; _mealAiTags.Clear(); }
    private void EditMeal(Meal m) { _meal = MealDraft.From(m); _meal.Items = ItemsOf(m.Id); _msg = null; _starReason = null; _mealAiTags.Clear(); }
    private void RepeatFood(ChangeEventArgs e)
    {
        if (_meal is null || e.Value?.ToString() is not { Length: > 0 } name || !_foodMemory.TryGetValue(name, out var src)) return;
        var d = MealDraft.From(src); d.Id = null; d.Time = DateTime.Now;
        d.Items = _lib.Restore(ItemsOf(src.Id));
        if (d.Items.Count > 0) d.SetTotals();   // one serving of each; curated saved-food macros win
        _meal = d;
    }
    private async Task SaveMeal()
    {
        if (_meal is null) return;
        _busy = true; _msg = null;
        try
        {
            MealRepo.StageItems(_meal.Items);
            var remind = _meal.Id is null && _remindFullness;
            if (remind) _meal.Satiety = Satiety.Unset;
            var (foodName, isSnack) = (_meal.Description ?? "your meal", _meal.MealType == MealType.Snack);
            var ok = _meal.Id is Guid id ? (await MealSvc.UpdateAsync(id, _meal.ToData())).IsSuccess
                                         : (await MealSvc.CreateAsync(_meal.ToData())).IsSuccess;
            if (!ok) { _msg = "Save failed."; return; }
            if (remind)
                await JS.InvokeVoidAsync("fitlogReminders.schedule", "How did it sit? 🍽️",
                    $"Rate how \"{foodName}\" left you.", isSnack ? 5 : 30);
            else if (_meal.Satiety != Satiety.Unset)
                await JS.InvokeVoidAsync("fitlogReminders.cancel");   // rated now — drop any pending nudge
            _meal = null; _remindFullness = false; await Load();
        }
        catch (Exception ex) { _msg = "Failed: " + ex.Message; }
        finally { _busy = false; MealRepo.ClearStagedItems(); }
    }
    private async Task DeleteMeal()
    {
        if (_meal?.Id is not Guid id) return;
        _busy = true; try { await MealSvc.DeleteAsync(id); _meal = null; await Load(); } catch (Exception ex) { _msg = ex.Message; } finally { _busy = false; }
    }

