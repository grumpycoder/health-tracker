@page "/meals"
@using Microsoft.AspNetCore.Authorization
@using FitRecoveryLog.Application.Nutrition
@using FitRecoveryLog.Domain.Common
@using FitRecoveryLog.Domain.Nutrition
@using FitRecoveryLog.Application.Ai
@attribute [Authorize]
@inject MealService MealSvc
@inject DrinkService DrinkSvc
@inject IAiCoach Coach
@inject AppState State
@inject FitRecoveryLog.Web.Infrastructure.ApiMealRepository MealRepo
@inject FitRecoveryLog.Web.Infrastructure.ApiDrinkRepository DrinkRepo
@inject SavedFoodService SavedFoodSvc
@inject IJSRuntime JS

<PageTitle>Meals &amp; Drinks — Fit Log</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <div class="dash-date">Meals &amp; Drinks</div>
        <div class="dash-date-sub">@DateTime.Now.ToString("dddd, MMM d")</div>
    </header>

    <div class="segmented">
        <button class="seg @(_tab == "meal" ? "active" : "")" @onclick='() => Switch("meal")'>🍽️ Meals</button>
        <button class="seg @(_tab == "drink" ? "active" : "")" @onclick='() => Switch("drink")'>🥤 Drinks</button>
    </div>

    <section class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:0.6rem;flex-wrap:wrap">
            <h2 style="margin:0">@(_viewDate == DateTime.Today ? "Today" : _viewDate.ToString("ddd, MMM d"))</h2>
            <div class="chip-row">
                <button class="icon-action" title="Previous day" aria-label="Previous day" @onclick="() => ShiftDay(-1)">◀</button>
                <input type="date" style="width:auto" value="@_viewDate.ToString("yyyy-MM-dd")" @onchange="OnViewDateChanged" />
                <button class="icon-action" title="Next day" aria-label="Next day" @onclick="() => ShiftDay(1)" disabled="@(_viewDate >= DateTime.Today)">▶</button>
                @if (_viewDate != DateTime.Today) { <button class="link-btn" @onclick="() => ShiftDay(0)">Today</button> }
            </div>
        </div>
        @if (!_loading && _error is null)
        {
            <button class="link-btn" style="padding:0;margin-top:0.4rem" @onclick="() => _showDayMacros = !_showDayMacros">
                @(_showDayMacros ? "▾" : "▸") Macros for this day
            </button>
            @if (_showDayMacros)
            {
                <div style="margin-top:0.4rem;padding-top:0.4rem;border-top:1px solid var(--border)">
                    <DaySummary Meals="_dayMealRows" Drinks="_dayDrinkRows" Goals="_goals" ActiveDay="_viewDayActive" EnergyOut="EnergyOut" Avg7="_avg7" Avg14="_avg14" AvgEnd="_avgEnd" Bal7="_bal7" Bal14="_bal14" />
                </div>
            }
        }
    </section>

    @if (_loading)
    {
        <section class="card"><p class="muted">Loading…</p></section>
    }
    else if (_error is not null)
    {
        <section class="card"><p class="warn-msg" style="margin:0">@_error</p><button class="save-btn" @onclick="Load">Retry</button></section>
    }
    else if (_tab == "meal")
    {
        <div class="routine-head">
            <h2 style="margin:0;color:var(--text)">Meal log</h2>
            <button class="link-btn" @onclick="AddMeal" disabled="@(_meal is not null)">+ Add meal</button>
        </div>

        @if (_meal is not null)
        {
            <section class="card">
                @if (_meal.Id is null && _foodNames.Count > 0)
                {
                    <div class="field">
                        <label>Repeat a recent meal</label>
                        <select @onchange="RepeatFood">
                            <option value="">— pick to prefill macros &amp; tags —</option>
                            @foreach (var n in _foodNames) { <option value="@n">@n</option> }
                        </select>
                    </div>
                }
                <div class="field"><label>Description</label><input @bind="_meal.Description" /></div>
                <div class="inline-fields">
                    <div class="field"><label>Type</label><select @bind="_meal.MealType">@foreach (var v in Enum.GetValues<MealType>()) { <option value="@v">@v</option> }</select></div>
                    <div class="field"><label>Time</label><input type="datetime-local" @bind="_meal.Time" /></div>
                    <div class="field"><label>Satiety</label><select @bind="_meal.Satiety">@foreach (var v in Enum.GetValues<Satiety>()) { <option value="@v">@v</option> }</select></div>
                </div>
                <div class="chip-row" style="margin-bottom:0.4rem">
                    <label class="chip" style="cursor:pointer;opacity:@(_aiBusy ? "0.5" : "1")">
                        📷 Plate photo (AI estimate)
                        <InputFile accept="image/*" capture="environment" style="display:none" OnChange="EstimatePlate" disabled="@_aiBusy" />
                    </label>
                    <input @bind="_plateHint" placeholder="optional hint, e.g. it's turkey · ~4 oz" style="flex:1;min-width:10rem" />
                </div>
                <ItemBuilder Items="_meal.Items" Changed="@(() => _meal.SetTotals())" Library="_lib" LibraryChanged="ReloadLibrary"
                             SeedBase="@(() => _meal.BaseItem())" TagVocab="_tagVocab" AddHint="e.g. whole milk" />
                <div class="inline-fields">
                    <div class="field"><label>Calories</label><input type="number" @bind="_meal.Calories" /></div>
                    <div class="field"><label>Protein (g)</label><input type="number" step="0.1" @bind="_meal.ProteinG" /></div>
                    <div class="field"><label>Carbs (g)</label><input type="number" step="0.1" @bind="_meal.CarbsG" /></div>
                    <div class="field"><label>Fat (g)</label><input type="number" step="0.1" @bind="_meal.FatG" /></div>
                </div>
                <div class="inline-fields">
                    <div class="field"><label>Sugar (g)</label><input type="number" step="0.1" @bind="_meal.SugarG" /></div>
                    <div class="field"><label>Added sugar (g)</label><input type="number" step="0.1" @bind="_meal.AddedSugarG" /></div>
                    <div class="field"><label>Fiber (g)</label><input type="number" step="0.1" @bind="_meal.FiberG" /></div>
                    <div class="field"><label>Sodium (mg)</label><input type="number" @bind="_meal.SodiumMg" /></div>
                </div>
                <div class="field"><label>Portion note</label><input @bind="_meal.PortionNote" /></div>
                @if (_meal.Id is null)
                {
                    <div class="chip-row" style="margin-bottom:0.4rem">
                        <button type="button" class="chip @(_remindFullness ? "selected" : "")" @onclick="ToggleRemind">
                            ⏰ Logging before eating — remind me to rate fullness
                        </button>
                    </div>
                    @if (_remindFullness)
                    {
                        <p class="muted" style="margin:-0.2rem 0 0.4rem;font-size:0.78rem">
                            Fullness stays unrated; you'll get a reminder in @(_meal.MealType == MealType.Snack ? 5 : 30) min while a Fit Log tab is open@(_notifyPermission == "granted" ? "" : " (allow notifications for a pop-up)"), and a one-tap rating shows on the meal.
                        </p>
                    }
                }
                <div class="field">
                    <label>Tags (comma-separated)</label>
                    <input @bind="_meal.Tags" />
                    <div class="chip-row" style="gap:1rem;margin-top:0.35rem">
                        <button class="link-btn" style="padding:0" @onclick="EstimateMacros" disabled="@(_aiBusy || string.IsNullOrWhiteSpace(_meal.Description))">
                            @(_aiBusy ? "Thinking…" : "✨ Estimate macros")
                        </button>
                        <button class="link-btn" style="padding:0" @onclick="SuggestTags" disabled="@(_aiBusy || string.IsNullOrWhiteSpace(_meal.Description))">
                            ✨ Suggest tags only
                        </button>
                    </div>
                    @if (_meal.QualityStars is { } stars)
                    {
                        <span class="pill @(stars >= 4 ? "good" : stars >= 3 ? "caution" : "critical")" style="margin-left:0.5rem">
                            @(new string('★', stars))@(new string('☆', 5 - stars))@(string.IsNullOrWhiteSpace(_starReason) ? "" : $" · {_starReason}")
                        </span>
                    }
                </div>
                @if (_advice is not null)
                {
                    <div class="card" style="border-color:var(--caution);margin:0 0 0.8rem">
                        <div style="color:var(--caution);font-weight:700;font-size:.78rem;letter-spacing:.06em;margin-bottom:4px">⚠ OVER YOUR TARGETS</div>
                        @if (!string.IsNullOrEmpty(_advice.Message)) { <p style="margin:0 0 .4rem;line-height:1.45">@_advice.Message</p> }
                        <p style="margin:0 0 .6rem"><strong>Suggestion:</strong> @_advice.Suggestion</p>
                        <div class="chip-row" style="gap:12px">
                            <button class="save-btn" @onclick="ApplyAdvice">Apply suggestion</button>
                            <button class="link-btn" @onclick="() => _advice = null">Dismiss</button>
                        </div>
                    </div>
                }
                <div class="routine-actions">
                    <button class="save-btn" @onclick="SaveMeal" disabled="@_busy">@(_busy ? "Saving…" : "Save")</button>
                    <button class="link-btn" @onclick="() => _meal = null" disabled="@_busy">Cancel</button>
                    @if (_meal.Id is Guid) { <button class="link-btn danger" style="margin-left:auto" @onclick="DeleteMeal" disabled="@_busy">Delete</button> }
                </div>
                @if (_msg is not null) { <p class="muted" style="margin:0.4rem 0 0">@_msg</p> }
            </section>
        }

        <section class="card">
            @if (!DayMeals.Any()) { <p class="muted">No meals logged this day.</p> }
            <ul class="timeline">
                @foreach (var m in DayMeals)
                {
                    <li>
                        <div>
                            <span class="time">@m.Time.ToString("h:mm tt")</span>
                            <span class="entry"><strong>@m.MealType</strong> — @m.Description
                                @if (m.Macros.Calories is { } c) { <span class="muted"> · @c cal</span> }
                            </span>
                            @ItemBreakdown(m.Id)
                            @if (m.Satiety == Satiety.Unset)
                            {
                                <div class="chip-row" style="margin-top:0.4rem">
                                    <span class="muted" style="font-size:0.75rem">how did it sit?</span>
                                    @foreach (var sat in SatietyOptions)
                                    {
                                        <button type="button" class="chip" disabled="@_busy" @onclick="() => RateMeal(m, sat)">@Pretty(sat.ToString())</button>
                                    }
                                </div>
                            }
                        </div>
                        <div class="routine-actions"><button class="icon-action" title="Edit" @onclick="() => EditMeal(m)">✏️</button></div>
                    </li>
                }
            </ul>
        </section>
    }
    else
    {
        <div class="routine-head">
            <h2 style="margin:0;color:var(--text)">Drink log</h2>
            <button class="link-btn" @onclick="AddDrink" disabled="@(_drink is not null)">+ Add drink</button>
        </div>

        @if (_drink is not null)
        {
            <section class="card">
                @if (_drink.Id is null && _drinkNames.Count > 0)
                {
                    <div class="field">
                        <label>Repeat a recent drink</label>
                        <select @onchange="RepeatDrink">
                            <option value="">— pick to prefill oz, sugar &amp; macros —</option>
                            @foreach (var n in _drinkNames) { <option value="@n">@n</option> }
                        </select>
                    </div>
                }
                <div class="field"><label>Description</label><input @bind="_drink.Description" /></div>
                <div class="inline-fields">
                    <div class="field"><label>Time</label><input type="datetime-local" @bind="_drink.Time" /></div>
                    <div class="field"><label>Ounces</label><input type="number" step="0.1" @bind="_drink.Ounces" /></div>
                    <div class="field"><label>Sugar added (tsp)</label><input type="number" @bind="_drink.SugarCount" /></div>
                </div>
                <ItemBuilder Items="_drink.Items" Changed="@(() => _drink.SetTotals())" Library="_lib" LibraryChanged="ReloadLibrary"
                             SeedBase="@(() => _drink.BaseItem())" ScanServings="DrinkScanServings" TagVocab="_tagVocab"
                             AddHint="e.g. creamer, sugar cube" />
                <div class="inline-fields">
                    <div class="field"><label>Calories</label><input type="number" @bind="_drink.Calories" /></div>
                    <div class="field"><label>Protein (g)</label><input type="number" step="0.1" @bind="_drink.ProteinG" /></div>
                    <div class="field"><label>Carbs (g)</label><input type="number" step="0.1" @bind="_drink.CarbsG" /></div>
                    <div class="field"><label>Fat (g)</label><input type="number" step="0.1" @bind="_drink.FatG" /></div>
                </div>
                <div class="inline-fields">
                    <div class="field"><label>Sugar (g)</label><input type="number" step="0.1" @bind="_drink.SugarG" /></div>
                    <div class="field"><label>Added sugar (g)</label><input type="number" step="0.1" @bind="_drink.AddedSugarG" /></div>
                    <div class="field"><label>Fiber (g)</label><input type="number" step="0.1" @bind="_drink.FiberG" /></div>
                    <div class="field"><label>Sodium (mg)</label><input type="number" @bind="_drink.SodiumMg" /></div>
                </div>
                <div class="field">
                    <label>Tags (comma-separated)</label>
                    <input @bind="_drink.Tags" />
                    <div class="chip-row" style="gap:1rem;margin-top:0.35rem">
                        <button class="link-btn" style="padding:0" @onclick="EstimateDrinkMacros" disabled="@(_aiBusy || string.IsNullOrWhiteSpace(_drink.Description))">
                            @(_aiBusy ? "Thinking…" : "✨ Estimate macros")
                        </button>
                        <button class="link-btn" style="padding:0" @onclick="SuggestDrinkTags" disabled="@(_aiBusy || string.IsNullOrWhiteSpace(_drink.Description))">
                            ✨ Suggest tags only
                        </button>
                    </div>
                    @if (_drinkStars is { } stars)
                    {
                        <span class="pill @(stars >= 4 ? "good" : stars >= 3 ? "caution" : "critical")" style="margin-top:0.4rem;display:inline-block">
                            @(new string('★', stars))@(new string('☆', 5 - stars))@(string.IsNullOrWhiteSpace(_starReason) ? "" : $" · {_starReason}")
                        </span>
                    }
                </div>
                @if (_advice is not null)
                {
                    <div class="card" style="border-color:var(--caution);margin:0 0 0.8rem">
                        <div style="color:var(--caution);font-weight:700;font-size:.78rem;letter-spacing:.06em;margin-bottom:4px">⚠ OVER YOUR TARGETS</div>
                        @if (!string.IsNullOrEmpty(_advice.Message)) { <p style="margin:0 0 .4rem;line-height:1.45">@_advice.Message</p> }
                        <p style="margin:0 0 .6rem"><strong>Suggestion:</strong> @_advice.Suggestion</p>
                        <div class="chip-row" style="gap:12px">
                            <button class="save-btn" @onclick="ApplyAdvice">Apply suggestion</button>
                            <button class="link-btn" @onclick="() => _advice = null">Dismiss</button>
                        </div>
                    </div>
                }
                <div class="routine-actions">
                    <button class="save-btn" @onclick="SaveDrink" disabled="@_busy">@(_busy ? "Saving…" : "Save")</button>
                    <button class="link-btn" @onclick="() => _drink = null" disabled="@_busy">Cancel</button>
                    @if (_drink.Id is Guid) { <button class="link-btn danger" style="margin-left:auto" @onclick="DeleteDrink" disabled="@_busy">Delete</button> }
                </div>
                @if (_msg is not null) { <p class="muted" style="margin:0.4rem 0 0">@_msg</p> }
            </section>
        }

        <section class="card">
            @if (!DayDrinks.Any()) { <p class="muted">No drinks logged this day.</p> }
            <ul class="timeline">
                @foreach (var d in DayDrinks)
                {
                    <li>
                        <div>
                            <span class="time">@d.Time.ToString("h:mm tt")</span>
                            <span class="entry">🥤 @d.Description
                                @if (d.Ounces is { } oz) { <span class="muted"> · @oz.ToString("0.#") oz</span> }
                                @if (d.Macros.Calories is { } c) { <span class="muted"> · @c cal</span> }
                            </span>
                            @ItemBreakdown(d.Id)
                        </div>
                        <div class="routine-actions"><button class="icon-action" title="Edit" @onclick="() => EditDrink(d)">✏️</button></div>
                    </li>
                }
            </ul>
        </section>
    }
</div>

@code {
    private string _tab = "meal";
    private bool _loading = true, _busy, _aiBusy;
    private string? _error, _msg, _starReason;
    private int? _drinkStars;
    private PortionAdvice? _advice;                       // day-fit trim advice from the estimator
    private readonly List<string> _mealAiTags = new();   // tags the last AI run added (for replace-on-rerun)
    private readonly List<string> _drinkAiTags = new();
    private List<string> _tagVocab = new();

    private IReadOnlyList<Meal> _meals = Array.Empty<Meal>();
    private IReadOnlyList<Drink> _drinks = Array.Empty<Drink>();
    private MealDraft? _meal;
    private DrinkDraft? _drink;
    private Dictionary<string, Meal> _foodMemory = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, Drink> _drinkMemory = new(StringComparer.OrdinalIgnoreCase);
    private List<string> _foodNames = new();
    private List<string> _drinkNames = new();
    // Per-entry item breakdown (out-of-aggregate ItemsJson), keyed by meal/drink id; read-only here.
    private Dictionary<Guid, List<FitRecoveryLog.Data.MealItemPortion>> _items = new();
    private readonly HashSet<Guid> _expanded = new();

    private void ToggleItems(Guid id) { if (!_expanded.Remove(id)) _expanded.Add(id); }

    private RenderFragment ItemBreakdown(Guid id) => __builder =>
    {
        if (!_items.TryGetValue(id, out var items)) return;
        <button class="link-btn" style="padding:0;font-size:0.8rem;display:block" @onclick="() => ToggleItems(id)">
            @(_expanded.Contains(id) ? "▾" : "▸") @items.Count item@(items.Count == 1 ? "" : "s")
        </button>
        @if (_expanded.Contains(id))
        {
            <ul style="margin:0.2rem 0 0;padding-left:1.1rem;font-size:0.85rem">
                @foreach (var it in items)
                {
                    <li>
                        @it.Name
                        @if (Math.Abs(it.Portion - 1.0) > 0.01) { <span class="muted"> · @it.Portion.ToString("0.##")× serving</span> }
                        @if (ItemLine(it) is { Length: > 0 } line) { <span class="muted" style="display:block;font-size:0.75rem">@line</span> }
                    </li>
                }
            </ul>
        }
    };

    // ---- Day view (matches the phone's Log tab) ----
    private DateTime _viewDate = DateTime.Today;
    private bool _showDayMacros = true;
    private List<FitRecoveryLog.Data.MealEntry> _dayMealRows = new();
    private List<FitRecoveryLog.Data.DrinkEntry> _dayDrinkRows = new();
    private FitRecoveryLog.Data.GoalSettings? _goals;
    private bool _viewDayActive;
    private FitRecoveryLog.Data.EnergyHistory? _energy;
    private FitRecoveryLog.Data.EnergyHistory.RollingAverage? _avg7, _avg14;
    private FitRecoveryLog.Data.EnergyHistory.RollingBalance? _bal7, _bal14;
    private DateOnly _avgEnd;
    private FitRecoveryLog.Data.DailyLog? _viewDayLog;

    private IEnumerable<Meal> DayMeals => _meals.Where(m => m.Time.Date == _viewDate).OrderByDescending(m => m.Time);
    private IEnumerable<Drink> DayDrinks => _drinks.Where(d => d.Time.Date == _viewDate).OrderByDescending(d => d.Time);

    private void ShiftDay(int days)
    {
        var next = days == 0 ? DateTime.Today : _viewDate.AddDays(days);
        if (next > DateTime.Today) return;
        _viewDate = next;
        _meal = null; _drink = null;
        _ = RefreshDay();
    }

    private async Task OnViewDateChanged(ChangeEventArgs e)
    {
        if (!DateTime.TryParse(e.Value?.ToString(), out var d)) return;
        _viewDate = d.Date > DateTime.Today ? DateTime.Today : d.Date;
        _meal = null; _drink = null;
        await RefreshDay();
    }

    // Rows for the viewed day + the inputs the summary needs (goals, day type, energy balance).
    private async Task RefreshDay()
    {
        var pull = await State.DataAsync();
        var day = DateOnly.FromDateTime(_viewDate);
        _dayMealRows = WebSyncClient.Rows<FitRecoveryLog.Data.MealEntry>(pull).Where(m => m.Time.Date == _viewDate).ToList();
        _dayDrinkRows = WebSyncClient.Rows<FitRecoveryLog.Data.DrinkEntry>(pull).Where(d => d.Time.Date == _viewDate).ToList();
        _goals = WebSyncClient.Rows<FitRecoveryLog.Data.GoalSettings>(pull).OrderByDescending(g => g.UpdatedAt).FirstOrDefault();
        var today = DateOnly.FromDateTime(DateTime.Today);
        _energy = new FitRecoveryLog.Data.EnergyHistory(
            WebSyncClient.Rows<FitRecoveryLog.Data.DailyLog>(pull),
            WebSyncClient.Rows<FitRecoveryLog.Data.BodyMeasurement>(pull),
            WebSyncClient.Rows<FitRecoveryLog.Data.WorkoutSession>(pull),
            today);
        _avgEnd = day < today ? day : today.AddDays(-1);
        _avg7 = _energy.Average(day, 7);
        _avg14 = _energy.Average(day, 14);
        var kin = FitRecoveryLog.Data.NutritionMath.CaloriesByDay(
            WebSyncClient.Rows<FitRecoveryLog.Data.MealEntry>(pull), WebSyncClient.Rows<FitRecoveryLog.Data.DrinkEntry>(pull));
        _bal7 = _energy.Balance(day, 7, kin);
        _bal14 = _energy.Balance(day, 14, kin);
        _viewDayLog = _energy.Log(day);
        var dayType = _viewDayLog?.DayType;
        _viewDayActive = dayType is FitRecoveryLog.Data.DayType.Workout or FitRecoveryLog.Data.DayType.HighWorkload;
        StateHasChanged();
    }

    // Same as the phone: Apple Health resting + active for a completed day, else the BMR estimate.
    private FitRecoveryLog.Data.EnergyMath.EnergyOut? EnergyOut => _energy?.For(DateOnly.FromDateTime(_viewDate));

    // ---- Fullness: one-tap rating for unrated meals + the "remind me" toggle ----
    private static readonly Satiety[] SatietyOptions = Enum.GetValues<Satiety>().Where(x => x != Satiety.Unset).ToArray();
    private bool _remindFullness;
    private string? _notifyPermission;

    private static string Pretty(string camel) =>
        System.Text.RegularExpressions.Regex.Replace(camel, "(?<=.)([A-Z])", " $1");

    private async Task ToggleRemind()
    {
        _remindFullness = !_remindFullness;
        if (_remindFullness && _notifyPermission is null or "default")
        {
            try { _notifyPermission = await JS.InvokeAsync<string>("fitlogReminders.requestPermission"); }
            catch (JSException) { _notifyPermission = "unsupported"; }
        }
    }

    private async Task RateMeal(Meal m, Satiety satiety)
    {
        _busy = true; _msg = null;
        try
        {
            var d = MealDraft.From(m);
            d.Satiety = satiety;   // ToData keeps every other field; no staged items → breakdown kept
            var result = await MealSvc.UpdateAsync(m.Id, d.ToData());
            if (!result.IsSuccess) { _msg = result.Error; return; }
            await JS.InvokeVoidAsync("fitlogReminders.cancel");   // rated before the reminder fired
            await Load();
        }
        catch (Exception ex) { _msg = "Failed: " + ex.Message; }
        finally { _busy = false; }
    }

    private FitRecoveryLog.Web.Infrastructure.FoodLibrary _lib = FitRecoveryLog.Web.Infrastructure.FoodLibrary.Empty;
    private string _plateHint = "";

    private async Task ReloadLibrary() =>
        _lib = await FitRecoveryLog.Web.Infrastructure.FoodLibrary.LoadAsync(State, SavedFoodSvc, await FitRecoveryLog.Web.Infrastructure.WebHiddenFoods.LoadAsync(JS));

    // A label's macros are per serving; for a drink, scale by ounces drunk ÷ the label's serving.
    private double DrinkScanServings(NutritionFacts f) =>
        _drink?.Ounces is { } drank and > 0 && ParseServingOunces(f.ServingSize) is { } serv and > 0 ? drank / serv : 1;

    private static double? ParseServingOunces(string? serving)
    {
        if (string.IsNullOrWhiteSpace(serving)) return null;
        var rx = System.Text.RegularExpressions.RegexOptions.IgnoreCase;
        var oz = System.Text.RegularExpressions.Regex.Match(serving, @"(\d+(?:\.\d+)?)\s*fl\s*oz", rx);
        if (!oz.Success) oz = System.Text.RegularExpressions.Regex.Match(serving, @"(\d+(?:\.\d+)?)\s*oz", rx);
        if (oz.Success && double.TryParse(oz.Groups[1].Value, out var v)) return v;
        var ml = System.Text.RegularExpressions.Regex.Match(serving, @"(\d+(?:\.\d+)?)\s*ml", rx);
        if (ml.Success && double.TryParse(ml.Groups[1].Value, out var mlv) && mlv > 0) return Math.Round(mlv / 29.5735, 1);
        return null;
    }

    // 📷 Plate photo → the AI's per-item estimate, added to the meal as items (one serving each;
    // adjust servings per item afterwards). Adds onto anything already on the meal.
    private async Task EstimatePlate(InputFileChangeEventArgs e)
    {
        if (_meal is null) return;
        _aiBusy = true; _msg = null; _starReason = null;
        try
        {
            var jpegFile = await e.File.RequestImageFileAsync("image/jpeg", 1600, 1600);
            using var ms = new MemoryStream();
            await jpegFile.OpenReadStream(15 * 1024 * 1024).CopyToAsync(ms);
            var scan = await Coach.EstimateMealFromPhotoAsync(ms.ToArray(), _tagVocab,
                string.IsNullOrWhiteSpace(_plateHint) ? null : _plateHint, _meal.MealType.ToString());
            var f = scan?.Facts;
            if (f is null || (f.Calories is null && f.ProteinG is null && f.CarbsG is null))
            {
                _msg = "Couldn't estimate macros from that photo — try a clearer shot or enter by hand.";
                return;
            }
            var items = f.Items.Count > 0
                ? f.Items.Select(i => new FitRecoveryLog.Data.MealItemPortion
                {
                    Name = i.Name, Calories = i.Calories, ProteinG = i.ProteinG, CarbsG = i.CarbsG, SugarG = i.SugarG,
                    AddedSugarG = i.AddedSugarG, FatG = i.FatG, SodiumMg = i.SodiumMg, FiberG = i.FiberG, Portion = 1,
                }).ToList()
                : new() { new FitRecoveryLog.Data.MealItemPortion
                {
                    Name = string.IsNullOrWhiteSpace(f.FoodDescription) ? "Plate" : f.FoodDescription.Trim(),
                    Calories = f.Calories, ProteinG = f.ProteinG, CarbsG = f.CarbsG, SugarG = f.SugarG,
                    AddedSugarG = f.AddedSugarG, FatG = f.FatG, SodiumMg = f.SodiumMg, FiberG = f.FiberG, Portion = 1,
                } };
            if (_meal.Items.Count == 0 && _meal.BaseItem() is { } baseItem) _meal.Items.Add(baseItem);
            _meal.Items.AddRange(items);
            _meal.SetTotals();
            if (string.IsNullOrWhiteSpace(_meal.Description) && !string.IsNullOrWhiteSpace(f.FoodDescription))
                _meal.Description = f.FoodDescription.Trim();
            ApplyTags(scan!.Tags);
            _advice = scan.Advice;
            _msg = $"Estimated {items.Count} item{(items.Count == 1 ? "" : "s")} — set servings for each if needed.";
        }
        catch (Exception ex) { _msg = "Estimate failed: " + ex.Message; }
        finally { _aiBusy = false; }
    }

    // Deep copy of an entry's stored breakdown, so editing (or cancelling) doesn't touch the cache.
    private List<FitRecoveryLog.Data.MealItemPortion> ItemsOf(Guid id) =>
        _items.TryGetValue(id, out var items)
            ? FitRecoveryLog.Data.MealItemPortion.Parse(FitRecoveryLog.Data.MealItemPortion.Serialize(items))
            : new();

    // Sum of each item's per-serving macros × servings; null when nothing is left.
    private sealed record ItemTotals(int? Calories, double? ProteinG, double? CarbsG, double? SugarG,
        double? AddedSugarG, double? FatG, int? SodiumMg, double? FiberG)
    {
        public static ItemTotals Of(List<FitRecoveryLog.Data.MealItemPortion> items)
        {
            if (items.Count == 0) return new(null, null, null, null, null, null, null, null);
            double Sum(Func<FitRecoveryLog.Data.MealItemPortion, double?> sel) => items.Sum(it => (sel(it) ?? 0) * it.Portion);
            return new((int)Math.Round(Sum(x => x.Calories)), Math.Round(Sum(x => x.ProteinG), 1),
                Math.Round(Sum(x => x.CarbsG), 1), Math.Round(Sum(x => x.SugarG), 1),
                Math.Round(Sum(x => x.AddedSugarG), 1), Math.Round(Sum(x => x.FatG), 1),
                (int)Math.Round(Sum(x => x.SodiumMg)), Math.Round(Sum(x => x.FiberG), 1));
        }
    }

    // An item's contribution (per-serving macros × servings).
    private static string ItemLine(FitRecoveryLog.Data.MealItemPortion it)
    {
        var p = it.Portion;
        var parts = new List<string>();
        if (it.Calories is { } c) parts.Add($"{Math.Round(c * p)} cal");
        if (it.ProteinG is { } pr) parts.Add($"{pr * p:0.#}g protein");
        if (it.CarbsG is { } cb) parts.Add($"{cb * p:0.#}g carbs");
        if (it.SugarG is { } su) parts.Add($"{su * p:0.#}g sugar");
        if (it.FatG is { } f) parts.Add($"{f * p:0.#}g fat");
        if (it.SodiumMg is { } so) parts.Add($"{Math.Round(so * p)}mg sodium");
        return string.Join(" · ", parts);
    }

    private void Switch(string tab) { _tab = tab; _meal = null; _drink = null; _msg = null; _starReason = null; _drinkStars = null; _advice = null; _mealAiTags.Clear(); _drinkAiTags.Clear(); }

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true; _error = null;
        try
        {
            _meals = await MealSvc.ListAsync();
            _drinks = await DrinkSvc.ListAsync();
            var pull = await State.DataAsync();
            _items = WebSyncClient.Rows<FitRecoveryLog.Data.MealEntry>(pull).Select(m => (m.Id, Items: m.Items))
                .Concat(WebSyncClient.Rows<FitRecoveryLog.Data.DrinkEntry>(pull).Select(d => (d.Id, Items: d.Items)))
                .Where(x => x.Items.Count > 0)
                .ToDictionary(x => x.Id, x => x.Items);
            _foodMemory = _meals.Where(m => !string.IsNullOrWhiteSpace(m.Description))
                .GroupBy(m => m.Description.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.OrderByDescending(m => m.Time).First(), StringComparer.OrdinalIgnoreCase);
            _foodNames = _foodMemory.Values.OrderByDescending(m => m.Time).Select(m => m.Description.Trim()).ToList();
            _drinkMemory = _drinks.Where(d => !string.IsNullOrWhiteSpace(d.Description))
                .GroupBy(d => d.Description.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.OrderByDescending(d => d.Time).First(), StringComparer.OrdinalIgnoreCase);
            _drinkNames = _drinkMemory.Values.OrderByDescending(d => d.Time).Select(d => d.Description.Trim()).ToList();

            await RefreshDay();
            _lib = await FitRecoveryLog.Web.Infrastructure.FoodLibrary.LoadAsync(State, SavedFoodSvc, await FitRecoveryLog.Web.Infrastructure.WebHiddenFoods.LoadAsync(JS));

            // Existing tags become the suggester's vocabulary (it strongly prefers reusing them).
            _tagVocab = _meals.SelectMany(m => m.Tags.Values)
                .Concat(_drinks.SelectMany(d => d.Tags.Values))
                .Where(t => !string.IsNullOrWhiteSpace(t))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    // ✨ Estimate macros from the text description (no camera) + tag/rate it, then fill the form.
    // Values are estimates — left editable so the user can correct portions.
    private async Task EstimateMacros()
    {
        if (_meal is null || string.IsNullOrWhiteSpace(_meal.Description)) return;
        _aiBusy = true; _msg = null; _starReason = null;
        try
        {
            var scan = await Coach.EstimateMealFromTextAsync(
                _meal.MealType.ToString(), _meal.Description!, _meal.PortionNote, _tagVocab);
            if (scan is null) { _msg = "The AI couldn't estimate that — try a clearer description."; return; }

            var f = scan.Facts;
            _meal.Calories = f.Calories; _meal.ProteinG = f.ProteinG; _meal.CarbsG = f.CarbsG; _meal.FatG = f.FatG;
            _meal.SugarG = f.SugarG; _meal.AddedSugarG = f.AddedSugarG; _meal.FiberG = f.FiberG; _meal.SodiumMg = f.SodiumMg;
            ApplyTags(scan.Tags);
            _advice = scan.Advice;
            _msg = $"Estimated{(string.IsNullOrWhiteSpace(f.ServingSize) ? "" : $" for {f.ServingSize}")} — adjust if needed.";
        }
        catch (Exception ex) { _msg = "AI request failed: " + ex.Message; }
