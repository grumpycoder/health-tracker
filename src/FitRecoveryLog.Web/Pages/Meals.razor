@page "/meals"
@using Microsoft.AspNetCore.Authorization
@using FitRecoveryLog.Application.Common
@using FitRecoveryLog.Application.Nutrition
@using FitRecoveryLog.Domain.Common
@using FitRecoveryLog.Domain.Nutrition
@attribute [Authorize]
@inject MealService MealSvc

<PageTitle>Meals — Fit Log</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Meals</h1>
    <button class="btn btn-primary" @onclick="AddNew" disabled="@(_edit is not null)">+ Add meal</button>
</div>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
    <button class="btn btn-primary" @onclick="Load">Retry</button>
}
else
{
    @if (_edit is not null)
    {
        <div class="card p-3 mb-4">
            <h5>@(_isNew ? "New meal" : "Edit meal")</h5>
            @if (_isNew && _foodNames.Count > 0)
            {
                <div class="mb-3">
                    <label class="form-label">Repeat a recent meal</label>
                    <select class="form-select" @onchange="RepeatFood">
                        <option value="">— pick to prefill macros &amp; tags —</option>
                        @foreach (var n in _foodNames) { <option value="@n">@n</option> }
                    </select>
                </div>
            }
            <div class="row g-2">
                <div class="col-12"><label class="form-label">Description</label><input class="form-control" @bind="_edit.Description" /></div>
                <div class="col-sm-4"><label class="form-label">Type</label>
                    <select class="form-select" @bind="_edit.MealType">@foreach (var v in Enum.GetValues<MealType>()) { <option value="@v">@v</option> }</select></div>
                <div class="col-sm-5"><label class="form-label">Time</label><input type="datetime-local" class="form-control" @bind="_edit.Time" /></div>
                <div class="col-sm-3"><label class="form-label">Satiety</label>
                    <select class="form-select" @bind="_edit.Satiety">@foreach (var v in Enum.GetValues<Satiety>()) { <option value="@v">@v</option> }</select></div>

                <div class="col-6 col-md-3"><label class="form-label">Calories</label><input type="number" class="form-control" @bind="_edit.Calories" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Protein (g)</label><input type="number" step="0.1" class="form-control" @bind="_edit.ProteinG" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Carbs (g)</label><input type="number" step="0.1" class="form-control" @bind="_edit.CarbsG" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Fat (g)</label><input type="number" step="0.1" class="form-control" @bind="_edit.FatG" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Fiber (g)</label><input type="number" step="0.1" class="form-control" @bind="_edit.FiberG" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Sugar (g)</label><input type="number" step="0.1" class="form-control" @bind="_edit.SugarG" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Added sugar (g)</label><input type="number" step="0.1" class="form-control" @bind="_edit.AddedSugarG" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Sodium (mg)</label><input type="number" class="form-control" @bind="_edit.SodiumMg" /></div>

                <div class="col-md-6"><label class="form-label">Portion note</label><input class="form-control" @bind="_edit.PortionNote" /></div>
                <div class="col-md-6"><label class="form-label">Tags (comma-separated)</label><input class="form-control" @bind="_edit.Tags" /></div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" @onclick="Save" disabled="@_busy">@(_busy ? "Saving…" : "Save")</button>
                <button class="btn btn-secondary" @onclick="Cancel" disabled="@_busy">Cancel</button>
                @if (!_isNew) { <button class="btn btn-outline-danger ms-auto" @onclick="Delete" disabled="@_busy">Delete</button> }
            </div>
            @if (_msg is not null) { <div class="form-text mt-2">@_msg</div> }
        </div>
    }

    <table class="table table-hover align-middle">
        <thead><tr><th>When</th><th>Type</th><th>Description</th><th class="text-end">Cal</th><th></th></tr></thead>
        <tbody>
            @foreach (var m in _meals.OrderByDescending(x => x.Time))
            {
                <tr>
                    <td><small>@m.Time.ToLocalTime().ToString("g")</small></td>
                    <td>@m.MealType</td>
                    <td>@m.Description</td>
                    <td class="text-end">@(m.Macros.Calories?.ToString() ?? "—")</td>
                    <td class="text-end"><button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(m)">Edit</button></td>
                </tr>
            }
            @if (_meals.Count == 0) { <tr><td colspan="5" class="text-muted">No meals.</td></tr> }
        </tbody>
    </table>
}

@code {
    private bool _loading = true, _busy, _isNew;
    private string? _error, _msg;
    private IReadOnlyList<Meal> _meals = Array.Empty<Meal>();
    private Draft? _edit;
    private Dictionary<string, Meal> _foodMemory = new(StringComparer.OrdinalIgnoreCase);
    private List<string> _foodNames = new();

    private sealed class Draft
    {
        public Guid? Id;
        public DateTime Time = DateTime.Now;
        public MealType MealType = MealType.Snack;
        public string? Description, PortionNote, Tags;
        public Satiety Satiety = Satiety.Unset;
        public int? QualityStars, Calories, SodiumMg;
        public double? ProteinG, CarbsG, SugarG, FatG, FiberG, AddedSugarG;

        public static Draft From(Meal m) => new()
        {
            Id = m.Id, Time = m.Time, MealType = m.MealType, Description = m.Description, PortionNote = m.PortionNote,
            Satiety = m.Satiety, QualityStars = m.QualityStars, Calories = m.Macros.Calories, SodiumMg = m.Macros.SodiumMg,
            ProteinG = m.Macros.ProteinG, CarbsG = m.Macros.CarbsG, SugarG = m.Macros.SugarG, FatG = m.Macros.FatG,
            FiberG = m.Macros.FiberG, AddedSugarG = m.Macros.AddedSugarG, Tags = m.Tags.ToCsv(),
        };

        public MealData ToData() => new(Time, MealType, Description, PortionNote, Satiety, QualityStars,
            new Macros(Calories, ProteinG, CarbsG, FatG, FiberG, SugarG, AddedSugarG, SodiumMg),
            FitRecoveryLog.Domain.Common.Tags.FromCsv(Tags));
    }

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true; _error = null;
        try
        {
            _meals = await MealSvc.ListAsync();
            _foodMemory = _meals.Where(m => !string.IsNullOrWhiteSpace(m.Description))
                .GroupBy(m => m.Description.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.OrderByDescending(m => m.Time).First(), StringComparer.OrdinalIgnoreCase);
            _foodNames = _foodMemory.Values.OrderByDescending(m => m.Time).Select(m => m.Description.Trim()).ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void AddNew() { _edit = new Draft { Time = DateTime.Now }; _isNew = true; _msg = null; }
    private void Edit(Meal m) { _edit = Draft.From(m); _isNew = false; _msg = null; }
    private void Cancel() { _edit = null; _msg = null; }

    private void RepeatFood(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        if (_edit is null || string.IsNullOrEmpty(name) || !_foodMemory.TryGetValue(name, out var src)) return;
        var d = Draft.From(src);
        d.Id = null; d.Time = DateTime.Now;   // a repeat is a new entry
        _edit = d;
    }

    private async Task Save()
    {
        if (_edit is null) return;
        _busy = true; _msg = null;
        try
        {
            var result = _isNew
                ? (await MealSvc.CreateAsync(_edit.ToData())) is { IsSuccess: true }
                : (await MealSvc.UpdateAsync(_edit.Id!.Value, _edit.ToData())).IsSuccess;
            if (!result) { _msg = "Save failed."; return; }
            _edit = null;
            await Load();
        }
        catch (Exception ex) { _msg = "Failed: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task Delete()
    {
        if (_edit?.Id is not Guid id) return;
        _busy = true; _msg = null;
        try { await MealSvc.DeleteAsync(id); _edit = null; await Load(); }
        catch (Exception ex) { _msg = "Failed: " + ex.Message; }
        finally { _busy = false; }
    }
}
