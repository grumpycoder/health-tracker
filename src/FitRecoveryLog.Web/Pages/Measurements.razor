@page "/measurements"
@using Microsoft.AspNetCore.Authorization
@using FitRecoveryLog.Application.Body
@using FitRecoveryLog.Domain.Body
@using ProgressPhoto = FitRecoveryLog.Data.ProgressPhoto
@using GoalSettings = FitRecoveryLog.Data.GoalSettings
@using GoalProgress = FitRecoveryLog.Data.GoalProgress
@attribute [Authorize]
@inject MeasurementService MeasurementSvc
@inject AppState State
@inject WebSyncClient Sync

<PageTitle>Measurements — Fit Log</PageTitle>

<div class="content">
    <div class="page-head">
        <div>
            <div class="eyebrow">Body</div>
            <h1 class="dash-date">Measurements</h1>
        </div>
        <button class="btn primary" @onclick="AddNew" disabled="@(_edit is not null)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>Add measurement
        </button>
    </div>

    @if (_loading)
    {
        <section class="card"><p class="muted">Loading…</p></section>
    }
    else if (_error is not null)
    {
        <section class="card"><p class="warn-msg" style="margin:0">@_error</p><button class="save-btn" @onclick="Load">Retry</button></section>
    }
    else
    {
        @if (_rows.Count > 0)
        {
            <div class="stats">
                <div class="stat">
                    <div class="s-top"><span class="ic teal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10M18 20V4M6 20v-4" /></svg></span>Weight</div>
                    <div class="s-num num">@_weightText <small>lb</small></div>
                    <div class="s-sub">@if (_weightDeltaText is not null) { <span class="pill @_weightPill">@_weightDeltaText</span> } else { <text>latest weigh-in</text> }</div>
                    @if (_weightGoalText is not null) { <div class="s-sub muted">@_weightGoalText</div> }
                </div>
                <div class="stat">
                    <div class="s-top"><span class="ic amber"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 3 0 0 0 18 0M3 12a9 3 0 0 1 18 0M3 12v0" /></svg></span>Waist</div>
                    <div class="s-num num">@_waistText <small>in</small></div>
                    <div class="s-sub">@(_waistGoalText ?? "latest")</div>
                </div>
                <div class="stat">
                    <div class="s-top"><span class="ic rose"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span>Body fat</div>
                    <div class="s-num num">@_bodyFatText <small>%</small></div>
                    <div class="s-sub">@(_bodyFatGoalText ?? "latest")</div>
                </div>
            </div>
        }

        @if (_overview.Count > 0)
        {
            <section class="card">
                <div class="card-head"><h2>Body metrics &amp; goals</h2></div>
                <div class="goal-list">
                    @foreach (var r in _overview)
                    {
                        var showBase = r.Baseline is double bl && r.Current is double cu && r.Goal is not null && Math.Abs(bl - cu) > 0.05;
                        <div class="goal-item">
                            <div class="goal-top">
                                <span class="goal-dot @DotClass(r.Trend)"></span>
                                <span class="goal-name">@r.Label</span>
                                @if (!string.IsNullOrEmpty(r.Arrow)) { <span class="goal-arrow">@r.Arrow</span> }
                                <span class="goal-vals">
                                    @if (showBase) { <span class="muted">@r.Baseline!.Value.ToString("0.#") → </span> }@(r.Current is null ? "—" : r.Current.Value.ToString("0.#"))@if (r.Goal is not null) { <span class="muted"> → @r.Goal.Value.ToString("0.#")</span> } <span class="muted">@r.Unit</span>
                                </span>
                            </div>
                            @if (r.Goal is not null)
                            {
                                <div class="goal-bar"><i style="width:@(r.Percent ?? 0)%"></i></div>
                                <div class="goal-sub">
                                    @if (r.Met) { <span class="pill good">Goal met ✓</span> }
                                    else if (!string.IsNullOrEmpty(r.Achieved)) { <strong>@(r.Percent ?? 0)% complete</strong><span class="muted"> · @r.Achieved</span> }
                                    else { <strong>@(r.Percent ?? 0)% complete</strong> }
                                    @if (!string.IsNullOrEmpty(r.Recent)) { <span class="goal-recent @DotClass(r.RecentTrend)">@r.Recent</span> }
                                </div>
                            }
                            else
                            {
                                <div class="goal-sub muted">@r.Status @if (!string.IsNullOrEmpty(r.Recent)) { <span class="goal-recent @DotClass(r.RecentTrend)">@r.Recent</span> }</div>
                            }
                        </div>
                    }
                </div>
                <p class="muted" style="margin:.6rem 0 0;font-size:.8rem">Shown as start → now → <a href="goals">goal</a>. Bar = progress from your first recorded value; dot = overall trend; chip = vs last entry.</p>
            </section>
        }

        @if (_edit is not null)
        {
            <section class="card">
                <h2>@(_isNew ? "New measurement" : "Edit measurement")</h2>
                <div class="inline-fields">
                    <div class="field"><label>Date</label><input type="date" @bind="_edit.Date" /></div>
                    <div class="field"><label>Weight (lbs)</label><input type="number" step="0.1" @bind="_edit.WeightLbs" /></div>
                    <div class="field"><label>Waist (in)</label><input type="number" step="0.1" @bind="_edit.WaistInches" /></div>
                    <div class="field"><label>Chest (in)</label><input type="number" step="0.1" @bind="_edit.ChestInches" /></div>
                </div>
                <div class="inline-fields">
                    <div class="field"><label>Hips (in)</label><input type="number" step="0.1" @bind="_edit.HipsInches" /></div>
                    <div class="field"><label>Arms (in)</label><input type="number" step="0.1" @bind="_edit.ArmsInches" /></div>
                    <div class="field"><label>Thighs (in)</label><input type="number" step="0.1" @bind="_edit.ThighsInches" /></div>
                </div>
                <div class="inline-fields">
                    <div class="field"><label>Shoulders (in)</label><input type="number" step="0.1" @bind="_edit.ShouldersInches" /></div>
                    <div class="field"><label>Calves (in)</label><input type="number" step="0.1" @bind="_edit.CalvesInches" /></div>
                </div>
                <div class="inline-fields">
                    <div class="field"><label>Body fat (%)</label><input type="number" step="0.1" @bind="_edit.BodyFatPercent" /></div>
                    <div class="field"><label>Muscle mass (lbs)</label><input type="number" step="0.1" @bind="_edit.MuscleMassLbs" /></div>
                    <div class="field"><label>Visceral fat</label><input type="number" step="0.1" @bind="_edit.VisceralFat" /></div>
                    <div class="field"><label>Body water (%)</label><input type="number" step="0.1" @bind="_edit.BodyWaterPercent" /></div>
                </div>
                <div class="inline-fields">
                    <div class="field"><label>BMR</label><input type="number" @bind="_edit.BasalMetabolicRate" /></div>
                    <div class="field"><label>Metabolic age</label><input type="number" @bind="_edit.MetabolicAge" /></div>
                </div>
                <div class="field"><label>Clothing-fit notes</label><input @bind="_edit.ClothingFitNotes" /></div>
                <div class="routine-actions">
                    <button class="save-btn" @onclick="Save" disabled="@_busy">@(_busy ? "Saving…" : "Save")</button>
                    <button class="link-btn" @onclick="Cancel" disabled="@_busy">Cancel</button>
                    @if (!_isNew) { <button class="link-btn danger" style="margin-left:auto" @onclick="Delete" disabled="@_busy">Delete</button> }
                </div>
                @if (_msg is not null) { <p class="warn-msg" style="margin:0.5rem 0 0">@_msg</p> }
            </section>
        }

        <section class="card">
            @if (_rows.Count == 0) { <p class="empty">No measurements yet.</p> }
            else
            {
                <table class="history">
                    <thead><tr><th>Date</th><th class="num">Weight</th><th class="num">Waist</th><th class="num">Body fat</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var m in _rows.OrderByDescending(x => x.Date))
                        {
                            <tr>
                                <td>@m.Date.ToString("ddd, MMM d, yyyy")</td>
                                <td class="num">@(m.WeightLbs?.ToString("0.#") ?? "—")</td>
                                <td class="num">@(m.WaistInches?.ToString("0.#") ?? "—")</td>
                                <td class="num">@(m.BodyFatPercent?.ToString("0.#") ?? "—")</td>
                                <td class="num"><button class="icon-action" title="Edit" @onclick="() => Edit(m)">✏️</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
</div>

@code {
    private bool _loading = true, _busy, _isNew;
    private string? _error, _msg;
    private IReadOnlyList<Measurement> _rows = Array.Empty<Measurement>();
    private Draft? _edit;

    private string _weightText = "—", _waistText = "—", _bodyFatText = "—";
    private string? _weightDeltaText;
    private string _weightPill = "good";

    private double? _goalWeight, _goalWaist, _goalBodyFat;   // from GoalSettings (null = unset)
    private string? _weightGoalText, _waistGoalText, _bodyFatGoalText;
    private List<GoalProgress.Row> _overview = new();  // all 8 body metrics vs goals (latest measurement)

    private void BuildSummary()
    {
        var ordered = _rows.OrderByDescending(m => m.Date).ToList();
        // Each card shows the most recent entry that actually HAS that value — a blank/photo-only
        // day (all nulls) at the top must not blank out the summary.
        var weights = ordered.Where(m => m.WeightLbs is not null).ToList();
        var latestWeight = weights.FirstOrDefault();
        var curWeight = latestWeight?.WeightLbs;
        var curWaist = ordered.FirstOrDefault(m => m.WaistInches is not null)?.WaistInches;
        var curBodyFat = ordered.FirstOrDefault(m => m.BodyFatPercent is not null)?.BodyFatPercent;
        _weightText = curWeight?.ToString("0.#") ?? "—";
        _waistText = curWaist?.ToString("0.#") ?? "—";
        _bodyFatText = curBodyFat?.ToString("0.#") ?? "—";

        _weightGoalText = GoalSub(curWeight, _goalWeight, "lb");
        _waistGoalText = GoalSub(curWaist, _goalWaist, "in");
        _bodyFatGoalText = GoalSub(curBodyFat, _goalBodyFat, "%");

        _weightDeltaText = null;
        if (latestWeight?.WeightLbs is double now && weights.Skip(1).FirstOrDefault()?.WeightLbs is double prev)
        {
            var delta = now - prev;
            _weightPill = delta <= 0 ? "good" : "caution";
            _weightDeltaText = $"{(delta <= 0 ? "▼" : "▲")} {Math.Abs(delta):0.#} lb vs last";
        }
    }

    private static string DotClass(GoalProgress.Trend t) => t switch
    {
        GoalProgress.Trend.Met => "met",
        GoalProgress.Trend.Toward => "toward",
        GoalProgress.Trend.Away => "away",
        GoalProgress.Trend.Flat => "flat",
        _ => "nodata",
    };

    // "goal X · Y to go" / "goal X · reached ✓" — direction-agnostic distance to the target.
    private static string? GoalSub(double? current, double? goal, string unit)
    {
        if (goal is not double g) return null;
        if (current is not double c) return $"goal {g:0.#} {unit}";
        var toGo = Math.Abs(c - g);
        return toGo < 0.05 ? $"goal {g:0.#} {unit} · reached ✓" : $"goal {g:0.#} {unit} · {toGo:0.#} to go";
    }

    private sealed class Draft
    {
        public Guid? Id;
        public DateOnly Date = DateOnly.FromDateTime(DateTime.Now);
        public double? WeightLbs, WaistInches, ChestInches, HipsInches, ArmsInches, ThighsInches,
            ShouldersInches, CalvesInches, BodyFatPercent, MuscleMassLbs, VisceralFat, BodyWaterPercent;
        public int? BasalMetabolicRate, MetabolicAge;
        public string? ClothingFitNotes;

        public static Draft From(Measurement m) => new()
        {
            Id = m.Id, Date = m.Date, WeightLbs = m.WeightLbs, WaistInches = m.WaistInches, ChestInches = m.ChestInches,
            HipsInches = m.HipsInches, ArmsInches = m.ArmsInches, ThighsInches = m.ThighsInches,
            ShouldersInches = m.ShouldersInches, CalvesInches = m.CalvesInches,
            BodyFatPercent = m.BodyFatPercent, MuscleMassLbs = m.MuscleMassLbs, VisceralFat = m.VisceralFat,
            BodyWaterPercent = m.BodyWaterPercent, BasalMetabolicRate = m.BasalMetabolicRate,
            MetabolicAge = m.MetabolicAge, ClothingFitNotes = m.ClothingFitNotes,
        };

        public MeasurementData ToData() => new(Date, WeightLbs, WaistInches, ChestInches, HipsInches, ArmsInches,
            ThighsInches, ShouldersInches, CalvesInches, BodyFatPercent, MuscleMassLbs, VisceralFat, BodyWaterPercent,
            BasalMetabolicRate, MetabolicAge, ClothingFitNotes);
    }

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true; _error = null;
        try
        {
            _rows = await MeasurementSvc.ListAsync();
            var g = WebSyncClient.Rows<GoalSettings>(await State.DataAsync()).OrderByDescending(x => x.UpdatedAt).FirstOrDefault();
            _goalWeight = g?.GoalWeightLbs; _goalWaist = g?.GoalWaistInches; _goalBodyFat = g?.GoalBodyFatPercent;
            BuildSummary();

            // Goal progress across all eight metrics — full history (oldest→newest) so we can show
            // progress from the baseline and a trend vs the previous entry.
            var history = _rows.OrderBy(m => m.Date)
                .Select(m => new GoalProgress.Snapshot(m.WeightLbs, m.WaistInches, m.BodyFatPercent, m.ChestInches,
                    m.ShouldersInches, m.ArmsInches, m.ThighsInches, m.CalvesInches))
                .ToList();
            _overview = GoalProgress.Overview(g, history);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void AddNew() { _edit = new Draft(); _isNew = true; _msg = null; }
    private void Edit(Measurement m) { _edit = Draft.From(m); _isNew = false; _msg = null; }
    private void Cancel() { _edit = null; _msg = null; }

    private async Task Save()
    {
        if (_edit is null) return;
        _busy = true; _msg = null;
        try
        {
            var ok = _isNew
                ? (await MeasurementSvc.CreateAsync(_edit.ToData())).IsSuccess
                : (await MeasurementSvc.UpdateAsync(_edit.Id!.Value, _edit.ToData())).IsSuccess;
            if (!ok) { _msg = "Save failed (values must be non-negative)."; return; }
            _edit = null;
            await Load();
        }
        catch (Exception ex) { _msg = "Failed: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task Delete()
    {
        if (_edit?.Id is not Guid id) return;
        _busy = true; _msg = null;
        try
        {
            var date = _edit.Date;
            await MeasurementSvc.DeleteAsync(id);
            // Photos belong to the measurement — tombstone that date's progress photos too (their
            // image files live on the phone; the phone sweeps them once it syncs these tombstones).
            var photos = WebSyncClient.Rows<ProgressPhoto>(await State.DataAsync()).Where(p => p.Date == date).ToList();
            foreach (var p in photos)
            {
                var row = WebSyncClient.Clone(p);
                row.IsDeleted = true; row.DeletedAt = DateTime.UtcNow;
                await Sync.PushAsync(row);
            }
            State.Invalidate();
            _edit = null;
            await Load();
        }
        catch (Exception ex) { _msg = "Failed: " + ex.Message; }
        finally { _busy = false; }
    }
}
