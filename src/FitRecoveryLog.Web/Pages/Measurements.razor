@page "/measurements"
@using Microsoft.AspNetCore.Authorization
@using FitRecoveryLog.Application.Body
@using FitRecoveryLog.Domain.Body
@attribute [Authorize]
@inject MeasurementService MeasurementSvc

<PageTitle>Measurements — Fit Log</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Body Measurements</h1>
    <button class="btn btn-primary" @onclick="AddNew" disabled="@(_edit is not null)">+ Add</button>
</div>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
    <button class="btn btn-primary" @onclick="Load">Retry</button>
}
else
{
    @if (_edit is not null)
    {
        <div class="card p-3 mb-4">
            <h5>@(_isNew ? "New measurement" : "Edit measurement")</h5>
            <div class="row g-2">
                <div class="col-sm-4"><label class="form-label">Date</label><input type="date" class="form-control" @bind="_edit.Date" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Weight (lbs)</label><input type="number" step="0.1" class="form-control" @bind="_edit.WeightLbs" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Waist (in)</label><input type="number" step="0.1" class="form-control" @bind="_edit.WaistInches" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Chest (in)</label><input type="number" step="0.1" class="form-control" @bind="_edit.ChestInches" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Hips (in)</label><input type="number" step="0.1" class="form-control" @bind="_edit.HipsInches" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Arms (in)</label><input type="number" step="0.1" class="form-control" @bind="_edit.ArmsInches" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Thighs (in)</label><input type="number" step="0.1" class="form-control" @bind="_edit.ThighsInches" /></div>

                <div class="col-6 col-md-3"><label class="form-label">Body fat (%)</label><input type="number" step="0.1" class="form-control" @bind="_edit.BodyFatPercent" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Muscle mass (lbs)</label><input type="number" step="0.1" class="form-control" @bind="_edit.MuscleMassLbs" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Visceral fat</label><input type="number" step="0.1" class="form-control" @bind="_edit.VisceralFat" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Body water (%)</label><input type="number" step="0.1" class="form-control" @bind="_edit.BodyWaterPercent" /></div>
                <div class="col-6 col-md-3"><label class="form-label">BMR</label><input type="number" class="form-control" @bind="_edit.BasalMetabolicRate" /></div>
                <div class="col-6 col-md-3"><label class="form-label">Metabolic age</label><input type="number" class="form-control" @bind="_edit.MetabolicAge" /></div>

                <div class="col-12"><label class="form-label">Clothing-fit notes</label><input class="form-control" @bind="_edit.ClothingFitNotes" /></div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" @onclick="Save" disabled="@_busy">@(_busy ? "Saving…" : "Save")</button>
                <button class="btn btn-secondary" @onclick="Cancel" disabled="@_busy">Cancel</button>
                @if (!_isNew) { <button class="btn btn-outline-danger ms-auto" @onclick="Delete" disabled="@_busy">Delete</button> }
            </div>
            @if (_msg is not null) { <div class="form-text mt-2">@_msg</div> }
        </div>
    }

    <table class="table table-hover align-middle">
        <thead><tr><th>Date</th><th class="text-end">Weight</th><th class="text-end">Waist</th><th class="text-end">Body fat</th><th></th></tr></thead>
        <tbody>
            @foreach (var m in _rows.OrderByDescending(x => x.Date))
            {
                <tr>
                    <td>@m.Date.ToString("ddd, MMM d, yyyy")</td>
                    <td class="text-end">@(m.WeightLbs?.ToString("0.#") ?? "—")</td>
                    <td class="text-end">@(m.WaistInches?.ToString("0.#") ?? "—")</td>
                    <td class="text-end">@(m.BodyFatPercent?.ToString("0.#") ?? "—")</td>
                    <td class="text-end"><button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(m)">Edit</button></td>
                </tr>
            }
            @if (_rows.Count == 0) { <tr><td colspan="5" class="text-muted">No measurements.</td></tr> }
        </tbody>
    </table>
}

@code {
    private bool _loading = true, _busy, _isNew;
    private string? _error, _msg;
    private IReadOnlyList<Measurement> _rows = Array.Empty<Measurement>();
    private Draft? _edit;

    private sealed class Draft
    {
        public Guid? Id;
        public DateOnly Date = DateOnly.FromDateTime(DateTime.Now);
        public double? WeightLbs, WaistInches, ChestInches, HipsInches, ArmsInches, ThighsInches,
            BodyFatPercent, MuscleMassLbs, VisceralFat, BodyWaterPercent;
        public int? BasalMetabolicRate, MetabolicAge;
        public string? ClothingFitNotes;

        public static Draft From(Measurement m) => new()
        {
            Id = m.Id, Date = m.Date, WeightLbs = m.WeightLbs, WaistInches = m.WaistInches, ChestInches = m.ChestInches,
            HipsInches = m.HipsInches, ArmsInches = m.ArmsInches, ThighsInches = m.ThighsInches,
            BodyFatPercent = m.BodyFatPercent, MuscleMassLbs = m.MuscleMassLbs, VisceralFat = m.VisceralFat,
            BodyWaterPercent = m.BodyWaterPercent, BasalMetabolicRate = m.BasalMetabolicRate,
            MetabolicAge = m.MetabolicAge, ClothingFitNotes = m.ClothingFitNotes,
        };

        public MeasurementData ToData() => new(Date, WeightLbs, WaistInches, ChestInches, HipsInches, ArmsInches,
            ThighsInches, BodyFatPercent, MuscleMassLbs, VisceralFat, BodyWaterPercent, BasalMetabolicRate, MetabolicAge, ClothingFitNotes);
    }

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true; _error = null;
        try { _rows = await MeasurementSvc.ListAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void AddNew() { _edit = new Draft(); _isNew = true; _msg = null; }
    private void Edit(Measurement m) { _edit = Draft.From(m); _isNew = false; _msg = null; }
    private void Cancel() { _edit = null; _msg = null; }

    private async Task Save()
    {
        if (_edit is null) return;
        _busy = true; _msg = null;
        try
        {
            var ok = _isNew
                ? (await MeasurementSvc.CreateAsync(_edit.ToData())).IsSuccess
                : (await MeasurementSvc.UpdateAsync(_edit.Id!.Value, _edit.ToData())).IsSuccess;
            if (!ok) { _msg = "Save failed (values must be non-negative)."; return; }
            _edit = null;
            await Load();
        }
        catch (Exception ex) { _msg = "Failed: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task Delete()
    {
        if (_edit?.Id is not Guid id) return;
        _busy = true; _msg = null;
        try { await MeasurementSvc.DeleteAsync(id); _edit = null; await Load(); }
        catch (Exception ex) { _msg = "Failed: " + ex.Message; }
        finally { _busy = false; }
    }
}
