        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="workouts">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Workouts
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="routines">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Routines
            </NavLink>
