@* One day's nutrition, matching the phone's Log tab: totals, goal-fit stars, goal bars (rest vs
   active-day ranges from the synced goals) and a rough energy balance. Tap a bar for numbers. *@
@using FitRecoveryLog.Data

@if (!NutritionMath.HasData(Meals, Drinks) && NutritionMath.FluidOz(Drinks) <= 0)
{
    <p class="muted" style="margin:0">Nothing with macros logged this day.</p>
}
else
{
    <div style="display:flex;flex-wrap:wrap;gap:0.4rem 1.1rem;font-size:0.95rem;margin-bottom:0.4rem">
        <span><strong>@Calories</strong> <span class="muted">cal</span></span>
        <span><strong>@NutritionMath.Protein(Meals, Drinks).ToString("0")</strong> <span class="muted">g protein</span></span>
        <span><strong>@NutritionMath.Sugar(Meals, Drinks).ToString("0")</strong> <span class="muted">g total sugar</span></span>
        <span><strong>@NutritionMath.Sodium(Meals, Drinks).ToString("0")</strong> <span class="muted">mg sodium</span></span>
    </div>
    @if (Rated.Count > 0)
    {
        <p class="muted" style="margin:0 0 0.4rem" title="Average 'fit with your goals' across rated meals">
            Goal fit: <span style="color:#f5b301">@Rated.Average(m => m.QualityStars!.Value).ToString("0.0")★</span>
            <span style="font-size:0.8rem"> · @Rated.Count rated meal(s)</span>
        </p>
    }
    @if (Goals is { } g)
    {
        <p class="muted" style="margin:0 0 0.3rem;font-size:0.72rem">
            @(ActiveDay ? "🏋️ Active-day targets" : "🛌 Rest-day targets") <span style="opacity:0.7">(calories/carbs/water)</span> · tap a bar for exact numbers
        </p>
        @Bar("Calories", Calories, "", ActiveDay ? g.CaloriesActiveMin : g.CaloriesRestMin, ActiveDay ? g.CaloriesActiveMax : g.CaloriesRestMax, false)
        @Bar("Protein", NutritionMath.Protein(Meals, Drinks), " g", g.ProteinMin, g.ProteinMax, false)
        @Bar("Carbs", NutritionMath.Carbs(Meals, Drinks), " g", ActiveDay ? g.CarbsActiveMin : g.CarbsRestMin, ActiveDay ? g.CarbsActiveMax : g.CarbsRestMax, false)
        @Bar("Fat", NutritionMath.Fat(Meals, Drinks), " g", g.FatMin, g.FatMax, false)
        @Bar("Fiber", NutritionMath.Fiber(Meals, Drinks), " g", g.FiberMin, g.FiberMax, false)
        @Bar("Added sugar", NutritionMath.AddedSugar(Meals, Drinks), " g", 0, g.AddedSugarMax, true)
        @Bar("Sodium", NutritionMath.Sodium(Meals, Drinks), " mg", 0, SodiumMaxMg, true)
        @Bar("💧 Fluids (all drinks)", NutritionMath.FluidOz(Drinks), " oz", ActiveDay ? g.WaterActiveMin : g.WaterRestMin, ActiveDay ? g.WaterActiveMax : g.WaterRestMax, false)
    }
    else
    {
        <p class="muted" style="margin:0;font-size:0.8rem">Set nutrition targets on the Goals page to see progress bars.</p>
    }
    @EnergyPanel(Date, Calories, EnergyOut, Avg7, Bal7, Avg14, Bal14, AvgEnd)
}

@code {
    [Parameter] public List<MealEntry> Meals { get; set; } = new();
    [Parameter] public List<DrinkEntry> Drinks { get; set; } = new();
    [Parameter] public GoalSettings? Goals { get; set; }
    /// <summary>Workout / High Workload day → active-day calorie, carb and water ranges.</summary>
    [Parameter] public bool ActiveDay { get; set; }
    /// <summary>Calories out (Apple Health for a completed day, else the BMR estimate); null if unknown.</summary>
    [Parameter] public EnergyMath.EnergyOut? EnergyOut { get; set; }
    /// <summary>The day shown; today's out/balance are labeled projected (the day isn't over).</summary>
    [Parameter] public DateOnly Date { get; set; }
    /// <summary>Rolling average calories out over completed days ending <see cref="AvgEnd"/>.</summary>
    [Parameter] public EnergyHistory.RollingAverage? Avg7 { get; set; }
    [Parameter] public EnergyHistory.RollingAverage? Avg14 { get; set; }
    [Parameter] public DateOnly AvgEnd { get; set; }
    /// <summary>Average daily deficit/surplus over the same windows (days with food logged only).</summary>
    [Parameter] public EnergyHistory.RollingBalance? Bal7 { get; set; }
    [Parameter] public EnergyHistory.RollingBalance? Bal14 { get; set; }

    // FDA daily value — the phone uses the same fixed ceiling.
    private const int SodiumMaxMg = 2300;
    private readonly HashSet<string> _show = new();

    private int Calories => NutritionMath.Calories(Meals, Drinks);
    private List<MealEntry> Rated => Meals.Where(m => m.QualityStars is not null).ToList();

    // Energy panel: the viewed day's in/out/balance as three labeled stats, then one card per
    // rolling window (completed days only) so each number sits under its own label.
    private static RenderFragment EnergyPanel(DateOnly date, int caloriesIn, EnergyMath.EnergyOut? day,
        EnergyHistory.RollingAverage? avg7, EnergyHistory.RollingBalance? bal7,
        EnergyHistory.RollingAverage? avg14, EnergyHistory.RollingBalance? bal14, DateOnly end) => __builder =>
    {
        if (day is null && avg7 is null && bal7 is null) return;
        <div style="margin-top:0.6rem;padding-top:0.5rem;border-top:1px solid var(--border)">
            @if (day is { } d && caloriesIn > 0)
            {
                var net = caloriesIn - d.Kcal;
                var projected = date >= DateOnly.FromDateTime(DateTime.Now);   // day not over: out is a full-day estimate
                <div class="muted" style="font-size:0.72rem;text-transform:uppercase;letter-spacing:0.04em">This day · @(projected ? (d.Live ? "projected · Health activity so far" : "projected full day") : d.FromHealth ? "Apple Health" : "estimated burn")</div>
                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.4rem;margin:0.2rem 0 0.6rem">
                    @Stat(caloriesIn.ToString("N0"), "in", null)
                    @Stat(d.Kcal.ToString("N0"), projected ? "projected out" : "out", null)
                    @if (projected)
                    {
                        // Today: what's left before eating reaches the projected burn (maintenance).
                        @Stat(Math.Abs(net).ToString("N0"), net > 0 ? "over calorie budget" : "remaining calorie budget", NetColor(net))
                    }
                    else
                    {
                        @Stat(Signed(net), net > 0 ? "surplus" : "deficit", NetColor(net))
                    }
                </div>
            }
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem">
                @WindowCard(7, avg7, bal7, end)
                @WindowCard(14, avg14, bal14, end)
            </div>
            @if ((avg14 ?? avg7) is { } src)
            {
                <div class="muted" style="font-size:0.72rem;margin-top:0.35rem">
                    Averages use completed days only (today is left out). Out is from Apple Health on @src.HealthDays of @src.Days days@(src.HealthDays < src.Days ? ", estimated from BMR on the rest" : "").
                </div>
            }
        </div>
    };

    private static RenderFragment Stat(string value, string label, string? color) => __builder =>
    {
        <div>
            <div style="font-size:1.05rem;font-weight:600;color:@(color ?? "inherit")">@value</div>
            <div class="muted" style="font-size:0.72rem">@label</div>
        </div>
    };

    private static RenderFragment WindowCard(int days, EnergyHistory.RollingAverage? avg, EnergyHistory.RollingBalance? bal, DateOnly end) => __builder =>
    {
        <div style="border:1px solid var(--border);border-radius:8px;padding:0.45rem 0.55rem">
            <div class="muted" style="font-size:0.72rem">@days days · @DayRange(end.AddDays(1 - days), end)</div>
            @if (bal is { } b)
            {
                <div style="font-size:1.05rem;font-weight:600;color:@NetColor(b.AvgNet)">@Signed(b.AvgNet)<span style="font-size:0.75rem;font-weight:400">/day</span></div>
                <div class="muted" style="font-size:0.72rem;margin-bottom:0.3rem">avg @(b.AvgNet > 0 ? "surplus" : "deficit")</div>
                @Row("Total", $"{Signed(b.TotalNet)} (≈{(b.Pounds > 0 ? "+" : "")}{b.Pounds:0.0} lb)")
            }
            else
            {
                <div class="muted" style="font-size:0.8rem;margin:0.2rem 0 0.3rem">No food logged</div>
            }
            @if (avg is { } a) { @Row("Avg out", $"{a.Kcal:N0}/day") }
            @Row("Logged", $"{bal?.Days ?? 0} of {days} days")
        </div>
    };

    private static RenderFragment Row(string label, string value) => __builder =>
    {
        <div style="display:flex;justify-content:space-between;gap:0.4rem;font-size:0.75rem;line-height:1.5">
            <span class="muted">@label</span><span style="text-align:right">@value</span>
        </div>
    };

    private static string DayRange(DateOnly from, DateOnly to) =>
        from.Month == to.Month ? $"{from:MMM d}–{to.Day}" : $"{from:MMM d}–{to:MMM d}";
    private static string Signed(int v) => (v > 0 ? "+" : "") + v.ToString("N0");
    private static string NetColor(int net) => net > 0 ? "#c47f00" : "#3fa34d";

    private void Toggle(string label) { if (!_show.Remove(label)) _show.Add(label); }

    private RenderFragment Bar(string label, double value, string unit, int low, int high, bool ceiling)
    {
        if (high <= 0) return @<text></text>;
        var fillPct = (int)Math.Clamp(value / high * 100, 0, 100);
        var lowPct = ceiling ? -1 : (int)Math.Clamp((double)low / high * 100, 0, 100);
        var text = ceiling ? $"{value:0} / ≤{high}{unit}" : $"{value:0} / {low}–{high}{unit}";
        var expanded = _show.Contains(label);
        return @<div style="padding:0.25rem 0;cursor:pointer" @onclick="() => Toggle(label)">
            <div style="display:flex;justify-content:space-between;font-size:0.85rem">
                <span>@label</span>
                <span class="muted" style="font-size:0.78rem">@(expanded ? text : "")</span>
            </div>
            <div style="position:relative;height:9px;border-radius:5px;overflow:hidden;margin-top:0.2rem;background:linear-gradient(to right,#4a72d0,#c47f00)">
                <div style="position:absolute;top:0;bottom:0;left:@(fillPct)%;right:0;background:var(--border)"></div>
                @if (lowPct >= 0)
                {
                    <div style="position:absolute;top:0;bottom:0;left:@(lowPct)%;width:2px;background:rgba(120,120,120,0.85)" title="range start"></div>
                }
            </div>
        </div>;
    }
}
