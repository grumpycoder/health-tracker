@page "/sleep"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IHealthService Health

<PageTitle>Sleep & recovery</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <div class="dash-date">Sleep & recovery</div>
        <div class="dash-date-sub">@DateTime.Now.ToString("dddd, MMM d")</div>
    </header>

    <section class="card">
        <h2>Sleep</h2>
        <div class="field">
            <label>Date</label>
            <input type="date" @bind="_date" />
        </div>
        <div class="field">
            <label>Duration (hours)</label>
            <input type="number" inputmode="decimal" step="0.25" @bind="_sleep.DurationHours" placeholder="e.g. 7.5" />
        </div>
        <div class="field">
            <label>Sleep score</label>
            <input type="number" inputmode="decimal" step="1" @bind="_sleep.SleepScore" placeholder="0-100" />
        </div>
        <div class="field">
            <label>Interruptions</label>
            <input type="number" inputmode="decimal" step="1" @bind="_sleep.Interruptions" placeholder="e.g. 2" />
        </div>
        <div class="field">
            <label>Notes</label>
            <textarea rows="2" @bind="_sleep.Notes" placeholder="e.g. woke at 3am, dog"></textarea>
        </div>
        <button class="save-btn" @onclick="SaveSleep">Save sleep</button>
        @if (_sleepSaved)
        {
            <span class="saved-msg">Saved ✓</span>
        }
        @if (_sleepWarn is not null)
        {
            <span class="warn-msg">@_sleepWarn</span>
        }
    </section>

    <section class="card">
        <h2>Recovery & soreness</h2>
        <div class="field">
            <label>Recovery rating (1-10)</label>
            <input type="number" inputmode="decimal" min="1" max="10" @bind="_recovery.RecoveryRating" />
        </div>
        <div class="field">
            <label>Fatigue rating (1-10)</label>
            <input type="number" inputmode="decimal" min="1" max="10" @bind="_recovery.FatigueRating" />
        </div>
        <div class="field">
            <label>Soreness locations</label>
            <div class="chip-row">
                @foreach (var loc in SorenessLocations)
                {
                    <button type="button"
                            class="chip @(_soreLocs.Contains(loc) ? "selected" : "")"
                            @onclick="() => ToggleLoc(loc)">@loc</button>
                }
            </div>
        </div>
        <div class="field">
            <label>Soreness severity</label>
            <select @bind="_recovery.SorenessSeverity">
                @foreach (var s in Enum.GetValues<SorenessSeverity>())
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Notes</label>
            <textarea rows="2" @bind="_recovery.Notes"
                      placeholder="e.g. yard work yesterday, lower back tight"></textarea>
        </div>
        <button class="save-btn" @onclick="SaveRecovery">Save recovery</button>
        @if (_recoverySaved)
        {
            <span class="saved-msg">Saved ✓</span>
        }
        @if (_recoveryWarn is not null)
        {
            <span class="warn-msg">@_recoveryWarn</span>
        }
    </section>

    @if (Health.IsAvailable)
    {
        <section class="card">
            <button class="quick-btn wide" @onclick="PullFromHealth">
                <span class="quick-emoji">❤️</span> Pull sleep from Apple Health
            </button>
            @if (_pullMsg is not null)
            {
                <p class="muted" style="margin:0.5rem 0 0">@_pullMsg</p>
            }
        </section>
    }

    <section class="card">
        <h2>Recent sleep</h2>
        @if (_recentSleep.Count == 0)
        {
            <p class="muted">No sleep entries yet.</p>
        }
        else
        {
            <ul class="timeline">
                @foreach (var s in _recentSleep)
                {
                    <li>
                        @if (_editId == s.Id)
                        {
                            <div class="edit-exercise" style="width:100%">
                                <div class="field"><label>Date</label><input type="date" @bind="_editDate" /></div>
                                <div class="inline-fields">
                                    <div class="field"><label>Hours</label><input type="number" inputmode="decimal" step="0.25" @bind="_edit.DurationHours" /></div>
                                    <div class="field"><label>Score</label><input type="number" inputmode="decimal" @bind="_edit.SleepScore" /></div>
                                    <div class="field"><label>Interruptions</label><input type="number" inputmode="decimal" @bind="_edit.Interruptions" /></div>
                                </div>
                                <div class="field"><label>Notes</label><textarea rows="2" @bind="_edit.Notes"></textarea></div>
                                <div class="routine-actions">
                                    <button class="save-btn" @onclick="SaveEdit">Save</button>
                                    <button class="link-btn" @onclick="() => _editId = null">Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ex-row" style="width:100%">
                                <div>
                                    <span class="time">@s.Date.ToString("MMM d")</span>
                                    <span class="entry">
                                        @(s.DurationHours?.ToString("0.0") ?? "—") h
                                        @if (s.SleepScore is not null)
                                        {
                                            <span class="muted"> · score @s.SleepScore</span>
                                        }
                                    </span>
                                </div>
                                <div class="routine-actions">
                                    <button class="icon-action" title="Edit" aria-label="Edit" @onclick="() => StartEdit(s)">✏️</button>
                                    <button class="icon-action danger" title="Delete" aria-label="Delete" @onclick="() => Delete(s)">🗑</button>
                                </div>
                            </div>
                        }
                    </li>
                }
            </ul>
        }
    </section>
</div>

@code {
    private static readonly string[] SorenessLocations =
        { "Lower back", "Mid-back", "Thighs", "Shoulders", "Core", "Other" };

    private DateTime _date = DateTime.Now.Date;
    private SleepEntry _sleep = new();
    private RecoveryEntry _recovery = new();
    private readonly HashSet<string> _soreLocs = new();
    private bool _sleepSaved, _recoverySaved;
    private string? _sleepWarn, _recoveryWarn;
    private List<SleepEntry> _recentSleep = new();

    private Guid? _editId;
    private SleepEntry _edit = new();
    private DateTime _editDate = DateTime.Now.Date;
    private string? _pullMsg;

    protected override async Task OnInitializedAsync()
    {
        if (Health.IsAvailable) { try { await Health.RequestAuthorizationAsync(); } catch { } }
        await LoadRecent();
    }

    private async Task PullFromHealth()
    {
        _pullMsg = null;
        var nights = await Health.ReadSleepAsync(DateTime.Now.AddDays(-30));
        if (nights.Count == 0) { _pullMsg = "No sleep found in Health (or access denied)."; return; }

        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = (await db.SleepEntries.Select(s => s.Date).ToListAsync()).ToHashSet();
        var added = 0;
        foreach (var (date, hours) in nights)
        {
            if (existing.Contains(date)) continue; // don't overwrite manual entries
            db.SleepEntries.Add(new SleepEntry { Date = date, DurationHours = Math.Round(hours, 1) });
            existing.Add(date);
            added++;
        }
        if (added > 0) await db.SaveChangesAsync();
        _pullMsg = added > 0 ? $"Imported {added} night(s) from Health." : "Already up to date with Health.";
        await LoadRecent();
    }

    private void StartEdit(SleepEntry s)
    {
        _editId = s.Id;
        _edit = new SleepEntry { DurationHours = s.DurationHours, SleepScore = s.SleepScore, Interruptions = s.Interruptions, Notes = s.Notes };
        _editDate = s.Date.ToDateTime(TimeOnly.MinValue);
    }

    private async Task SaveEdit()
    {
        if (_editId is not { } id) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.SleepEntries.FindAsync(id);
        if (e is not null)
        {
            e.Date = DateOnly.FromDateTime(_editDate);
            e.DurationHours = _edit.DurationHours; e.SleepScore = _edit.SleepScore;
            e.Interruptions = _edit.Interruptions; e.Notes = _edit.Notes;
            await db.SaveChangesAsync();
        }
        _editId = null;
        await LoadRecent();
    }

    private async Task Delete(SleepEntry s)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.SleepEntries.FindAsync(s.Id);
        if (e is not null) { db.SleepEntries.Remove(e); await db.SaveChangesAsync(); }
        if (_editId == s.Id) _editId = null;
        await LoadRecent();
    }

    private void ToggleLoc(string loc)
    {
        if (!_soreLocs.Add(loc)) _soreLocs.Remove(loc);
    }

    private async Task SaveSleep()
    {
        if (_sleep.DurationHours is null && _sleep.SleepScore is null
            && _sleep.Interruptions is null && string.IsNullOrWhiteSpace(_sleep.Notes))
        {
            _sleepWarn = "Enter sleep duration, score, or a note."; _sleepSaved = false; return;
        }
        _sleepWarn = null;
        _sleep.Date = DateOnly.FromDateTime(_date);
        await using var db = await DbFactory.CreateDbContextAsync();
        db.SleepEntries.Add(_sleep);
        await db.SaveChangesAsync();

        _sleepSaved = true;
        _sleep = new SleepEntry();
        await LoadRecent();
    }

    private async Task SaveRecovery()
    {
        if (_recovery.RecoveryRating is null && _recovery.FatigueRating is null
            && _soreLocs.Count == 0 && string.IsNullOrWhiteSpace(_recovery.Notes))
        {
            _recoveryWarn = "Enter a rating, soreness, or a note."; _recoverySaved = false; return;
        }
        _recoveryWarn = null;
        _recovery.Date = DateOnly.FromDateTime(_date);
        _recovery.SorenessLocations = CsvField.Join(_soreLocs);
        await using var db = await DbFactory.CreateDbContextAsync();
        db.RecoveryEntries.Add(_recovery);
        await db.SaveChangesAsync();

        _recoverySaved = true;
        _recovery = new RecoveryEntry();
        _soreLocs.Clear();
    }

    private async Task LoadRecent()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _recentSleep = await db.SleepEntries
            .OrderByDescending(s => s.Date).Take(10).ToListAsync();
    }
}
