@page "/workload"
@using FitRecoveryLog.Services
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Physical Workload</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <div class="dash-date">Physical Workload</div>
        <div class="dash-date-sub">Non-workout activity that taxes the body</div>
    </header>

    <section class="card">
        <h2>Log activity</h2>
        <div class="field">
            <label>Date</label>
            <input type="date" @bind="_date" />
        </div>
        <div class="field">
            <label>Activity</label>
            <input @bind="_entry.Activity" placeholder="e.g. Grass cutting" />
            <div class="chip-row" style="margin-top:0.4rem">
                @foreach (var a in CommonActivities)
                {
                    <button type="button" class="chip @(_entry.Activity == a ? "selected" : "")"
                            @onclick="() => _entry.Activity = a">@a</button>
                }
            </div>
        </div>
        <div class="inline-fields">
            <div class="field">
                <label>Duration (min)</label>
                <input type="number" inputmode="decimal" min="0" @bind="_entry.DurationMinutes" />
            </div>
            <div class="field">
                <label>Intensity</label>
                <select @bind="_entry.Intensity">
                    @foreach (var i in Enum.GetValues<Intensity>())
                    {
                        <option value="@i">@i</option>
                    }
                </select>
            </div>
        </div>
        <div class="field">
            <label>Body areas affected</label>
            <div class="chip-row">
                @foreach (var area in BodyAreas)
                {
                    <button type="button" class="chip @(_areas.Contains(area) ? "selected" : "")"
                            @onclick="() => ToggleArea(area)">@area</button>
                }
            </div>
        </div>
        <div class="field">
            <label>Notes</label>
            <textarea rows="2" @bind="_entry.Notes" placeholder="e.g. lifting bags of mulch"></textarea>
        </div>
        @if (_hasAiKey)
        {
            <button class="link-btn" style="display:block;padding:0;margin:0 0 0.6rem" disabled="@_aiBusy" @onclick="SuggestWorkload">
                @(_aiBusy ? "Suggesting…" : "✨ Suggest intensity & areas")
            </button>
            @if (_aiNote is not null)
            {
                <p class="muted" style="margin:0 0 0.6rem">🤖 @_aiNote</p>
            }
        }
        <button class="save-btn" @onclick="Save">Save Activity</button>
        @if (_saved)
        {
            <span class="saved-msg">Saved ✓</span>
        }
        @if (_warn is not null)
        {
            <span class="warn-msg">@_warn</span>
        }
    </section>

    <section class="card">
        <h2>Recent</h2>
        @if (_recent.Count == 0)
        {
            <p class="muted">No activity logged yet.</p>
        }
        else
        {
            <ul class="timeline">
                @foreach (var w in _recent)
                {
                    <li>
                        @if (_editId == w.Id)
                        {
                            <div class="edit-exercise" style="width:100%">
                                <div class="field"><label>Date</label><input type="date" @bind="_editDate" /></div>
                                <div class="field"><label>Activity</label><input @bind="_edit.Activity" /></div>
                                <div class="inline-fields">
                                    <div class="field"><label>Duration (min)</label><input type="number" inputmode="decimal" min="0" @bind="_edit.DurationMinutes" /></div>
                                    <div class="field">
                                        <label>Intensity</label>
                                        <select @bind="_edit.Intensity">
                                            @foreach (var i in Enum.GetValues<Intensity>()) { <option value="@i">@i</option> }
                                        </select>
                                    </div>
                                </div>
                                <div class="field"><label>Notes</label><textarea rows="2" @bind="_edit.Notes"></textarea></div>
                                <div class="routine-actions">
                                    <button class="save-btn" @onclick="SaveEdit">Save</button>
                                    <button class="link-btn" @onclick="() => _editId = null">Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ex-row" style="width:100%">
                                <div>
                                    <span class="time">@w.Date.ToString("MMM d")</span>
                                    <span class="entry"><strong>@w.Activity</strong>
                                        <span class="muted"> @(w.DurationMinutes?.ToString() ?? "—") min · @w.Intensity</span>
                                    </span>
                                </div>
                                <div class="routine-actions">
                                    <button class="icon-action" title="Edit" aria-label="Edit" @onclick="() => StartEdit(w)">✏️</button>
                                    <button class="icon-action danger" title="Delete" aria-label="Delete" @onclick="() => Delete(w)">🗑</button>
                                </div>
                            </div>
                        }
                    </li>
                }
            </ul>
        }
    </section>
</div>

@code {
    private static readonly string[] CommonActivities =
    {
        "Yard work", "Weed pulling", "Grass cutting", "House maintenance",
        "Car detailing", "Dog care / lifting", "Walking", "Travel / long driving", "Other"
    };
    private static readonly string[] BodyAreas =
    {
        "Lower back", "Mid-back", "Shoulders", "Arms", "Core", "Legs", "Knees", "Other"
    };

    private PhysicalWorkloadEntry _entry = new() { Intensity = Intensity.Moderate };
    private DateTime _date = DateTime.Now.Date;
    private readonly HashSet<string> _areas = new();
    private bool _saved;
    private string? _warn;
    private List<PhysicalWorkloadEntry> _recent = new();

    private Guid? _editId;
    private PhysicalWorkloadEntry _edit = new();
    private DateTime _editDate = DateTime.Now.Date;

    // AI assist: suggests intensity + body areas, and flags entries not worth logging.
    private bool _hasAiKey, _aiBusy;
    private string? _aiNote;

    protected override async Task OnInitializedAsync()
    {
        _hasAiKey = !string.IsNullOrEmpty(await GeminiAnalyzer.KeyStore.GetAsync());
        await LoadRecent();
    }

    private async Task SuggestWorkload()
    {
        var activity = _entry.Activity?.Trim();
        if (string.IsNullOrWhiteSpace(activity)) { _aiNote = "Enter an activity first."; return; }
        _aiBusy = true;
        _aiNote = null;
        StateHasChanged();
        try
        {
            var key = await GeminiAnalyzer.KeyStore.GetAsync()
                ?? throw new InvalidOperationException("No API key set.");
            var s = await GeminiAnalyzer.SuggestWorkloadAsync(key, activity, _entry.DurationMinutes, _entry.Notes, BodyAreas);
            if (Enum.TryParse<Intensity>(s.Intensity, true, out var intensity))
                _entry.Intensity = intensity;
            if (s.Areas.Count > 0)
            {
                _areas.Clear();
                foreach (var a in s.Areas) _areas.Add(a);
            }
            _aiNote = (s.WorthLogging ? "" : "Probably not worth logging — this barely taxes recovery. ")
                      + (s.Note ?? "");
            if (string.IsNullOrWhiteSpace(_aiNote)) _aiNote = "Applied.";
        }
        catch (Exception ex)
        {
            _aiNote = $"AI unavailable ({ex.Message}) — set intensity and areas manually.";
        }
        finally
        {
            _aiBusy = false;
        }
    }

    private void StartEdit(PhysicalWorkloadEntry w)
    {
        _editId = w.Id;
        _edit = new PhysicalWorkloadEntry { Activity = w.Activity, DurationMinutes = w.DurationMinutes, Intensity = w.Intensity, Notes = w.Notes, BodyAreasAffected = w.BodyAreasAffected };
        _editDate = w.Date.ToDateTime(TimeOnly.MinValue);
    }

    private async Task SaveEdit()
    {
        if (_editId is not { } id) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.PhysicalWorkloadEntries.FindAsync(id);
        if (e is not null)
        {
            e.Date = DateOnly.FromDateTime(_editDate);
            e.Activity = _edit.Activity; e.DurationMinutes = _edit.DurationMinutes;
            e.Intensity = _edit.Intensity; e.Notes = _edit.Notes;
            await db.SaveChangesAsync();
        }
        _editId = null;
        await LoadRecent();
    }

    private async Task Delete(PhysicalWorkloadEntry w)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.PhysicalWorkloadEntries.FindAsync(w.Id);
        if (e is not null) { db.PhysicalWorkloadEntries.Remove(e); await db.SaveChangesAsync(); }
        if (_editId == w.Id) _editId = null;
        await LoadRecent();
    }

    private void ToggleArea(string area)
    {
        if (!_areas.Add(area)) _areas.Remove(area);
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_entry.Activity)) { _warn = "Enter an activity first."; _saved = false; return; }
        _warn = null;
        _entry.Date = DateOnly.FromDateTime(_date);
        _entry.BodyAreasAffected = CsvField.Join(_areas);

        await using var db = await DbFactory.CreateDbContextAsync();
        db.PhysicalWorkloadEntries.Add(_entry);
        await db.SaveChangesAsync();

        _saved = true;
        _entry = new PhysicalWorkloadEntry { Intensity = Intensity.Moderate };
        _areas.Clear();
        await LoadRecent();
    }

    private async Task LoadRecent()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _recent = await db.PhysicalWorkloadEntries
            .OrderByDescending(w => w.Date).Take(15).ToListAsync();
    }
}
