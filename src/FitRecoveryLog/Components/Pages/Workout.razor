@page "/workout"
@using FitRecoveryLog.Services
@implements IDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IHealthService Health
@inject ActiveWorkoutState Active

<PageTitle>Workout</PageTitle>

<div class="dashboard">

@if (_state == WorkoutState.Choosing)
{
    <header class="dash-header">
        <div class="dash-date">Start a Workout</div>
        <div class="dash-date-sub">Pick a routine to begin</div>
    </header>

    <section class="card">
        <button class="quick-btn wide" @onclick="@(() => Nav.NavigateTo("workout-history"))">
            <span class="quick-emoji">📋</span> Workout History
        </button>
        <button class="quick-btn wide" style="margin-top:0.6rem" @onclick="@(() => Nav.NavigateTo("progression"))">
            <span class="quick-emoji">💡</span> Progression Suggestions
        </button>
        <button class="quick-btn wide" style="margin-top:0.6rem" @onclick="@(() => Nav.NavigateTo("exercises"))">
            <span class="quick-emoji">📚</span> Exercise Library
        </button>
    </section>

    @if (_routines.Count == 0)
    {
        <section class="card">
            <p class="muted">No routines yet.</p>
            <button class="save-btn" @onclick="@(() => Nav.NavigateTo("routines"))">Create a Routine</button>
        </section>
    }
    else
    {
        @foreach (var r in _routines)
        {
            var age = RoutineAge(r.Id);
            <section class="card">
                <div class="routine-head">
                    <h2>@r.Name</h2>
                    <button class="save-btn" @onclick="@(() => StartWorkout(r))">Start ▶</button>
                </div>
                <button class="link-btn" style="padding:0;margin:0.2rem 0 0" @onclick="@(() => ToggleExpanded(r.Id))">
                    @(_expandedRoutines.Contains(r.Id) ? "▾" : "▸")
                    @r.Exercises.Count exercise(s)@(age is { } a ? $" · running {a.Text} · {a.Count} workout(s)" : "")
                </button>
                @if (age is { Stale: true })
                {
                    <span class="badge warn" style="margin-left:0.4rem">time to progress</span>
                }
                @if (_expandedRoutines.Contains(r.Id))
                {
                    <ul class="timeline" style="margin-top:0.5rem">
                        @foreach (var re in r.Exercises.OrderBy(e => e.Order))
                        {
                            var def = re.ExerciseDefinition;
                            <li>
                                <div class="ex-row" style="width:100%">
                                    <div>
                                        <span class="ex-name">@(def?.Name ?? "?")</span>
                                        <span class="ex-target">@RoutinePrescription(re, def)</span>
                                    </div>
                                    @if (def is not null)
                                    {
                                        <div class="routine-actions">
                                            <button class="icon-action" title="How-to video" aria-label="How-to video" @onclick="@(() => Exercises.OpenDemo(def))">🎬</button>
                                        </div>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
                @if (age is { Stale: true })
                {
                    <button class="link-btn" style="padding:0;margin-top:0.4rem"
                            @onclick="@(() => Nav.NavigateTo("routines"))">Design a fresh routine ✨</button>
                }
            </section>
        }
        <section class="card">
            <button class="link-btn" @onclick="@(() => Nav.NavigateTo("routines"))">Manage Routines</button>
        </section>
    }
}
else if (_state == WorkoutState.Active)
{
    <header class="dash-header timer-head">
        <div class="dash-date">@Elapsed</div>
        <div class="dash-date-sub">@_routineName</div>
    </header>

    @if (_rest > 0)
    {
        <section class="card rest-banner">
            <span>Rest: <strong>@_rest s</strong></span>
            <button class="link-btn" @onclick="StopRest">Skip</button>
        </section>
    }

    @if (Current is { } cur)
    {
        var isTime = cur.Ex.Def.Measure == ExerciseMeasure.Duration;
        <section class="card">
            <p class="muted" style="margin:0 0 0.25rem">
                Set @cur.Set.SetNumber of @cur.Ex.Sets.Count · @DoneSets/@TotalSets sets done
            </p>
            <h2 style="text-transform:none;letter-spacing:0;color:var(--text);font-size:1.5rem;margin:0 0 0.7rem">
                @cur.Ex.Def.Name
                <button class="link-btn" style="padding:0 0.3rem;font-size:1rem" title="How-to video"
                        aria-label="How-to video" @onclick="() => Exercises.OpenDemo(cur.Ex.Def)">🎬</button>
            </h2>
            @if (_advice.TryGetValue(cur.Ex.Def.Name, out var adv))
            {
                <p class="muted" style="margin:-0.4rem 0 0.7rem">
                    🤖 AI suggests: <span class="badge @AiAdviceStore.BadgeClass(adv.Action)">@AiAdviceStore.Glyph(adv.Action) @(adv.Target ?? adv.Action)</span>
                </p>
            }
            @if (!string.IsNullOrWhiteSpace(cur.Ex.TargetNote))
            {
                <p class="muted" style="margin:-0.4rem 0 0.7rem">🎯 @cur.Ex.TargetNote</p>
            }

            @if (isTime)
            {
                @if (_timingSet == cur.Set)
                {
                    <div style="text-align:center;margin:0.5rem 0 0.8rem">
                        <span class="timing" style="font-size:2.2rem">@Math.Max(0, SetRemaining) s</span>
                        <button class="icon-btn stop" title="Stop" aria-label="Stop hold"
                                @onclick="() => StopSetTimer(cur.Set)">⏹</button>
                    </div>
                }
                else
                {
                    @if (_holdDoneSet == cur.Set)
                    {
                        <p class="muted" style="text-align:center;margin:0 0 0.5rem">
                            ✅ Full @(cur.Set.DurationSeconds)s hold — tap Complete Set
                        </p>
                    }
                    <div class="inline-fields">
                        <div class="field"><label>Hold (s)</label>
                            <input type="number" inputmode="decimal" min="0" @bind="cur.Set.DurationSeconds" />
                        </div>
                        <div class="field"><label>Weight (lb)</label>
                            <input type="number" inputmode="decimal" min="0" step="0.5" @bind="cur.Set.Weight" placeholder="—" />
                        </div>
                    </div>
                    <button class="save-btn" @onclick="() => StartSetTimer(cur.Set)">▶ Start Hold</button>
                    <button class="save-btn" style="margin-top:0.6rem" @onclick="CompleteCurrentSet">Complete Set ✓</button>
                }
            }
            else
            {
                <div class="inline-fields">
                    <div class="field"><label>Reps</label>
                        <input type="number" inputmode="decimal" min="0" @bind="cur.Set.Reps" />
                    </div>
                    <div class="field"><label>Weight (lb)</label>
                        <input type="number" inputmode="decimal" min="0" step="0.5" @bind="cur.Set.Weight" placeholder="—" />
                    </div>
                </div>
                <button class="save-btn" @onclick="CompleteCurrentSet">Complete Set ✓</button>
            }

            @if (_timingSet != cur.Set)
            {
                <div class="routine-actions" style="margin-top:0.7rem">
                    @if (_stepIndex > 0)
                    {
                        <button class="link-btn" @onclick="PreviousStep">◀ Back</button>
                    }
                    <button class="link-btn danger" @onclick="SkipCurrentExercise">Skip @cur.Ex.Def.Name</button>
                </div>
            }
            @if (NextUpName is { } next)
            {
                <p class="muted" style="margin:0.7rem 0 0">Up next: @next</p>
            }
        </section>

        <section class="card">
            <h2>Progress <span class="muted" style="font-weight:400;font-size:0.8rem">· tap to jump/correct</span></h2>
            <ul class="timeline">
                @foreach (var ex in _exercises)
                {
                    <li>
                        <button class="link-btn" style="padding:0;text-align:left;width:100%" @onclick="() => JumpTo(ex)">
                            <span class="entry @(ex == cur.Ex ? "" : "muted")">
                                @(ex.Skipped ? "⏭" : ex.Sets.All(s => s.Completed) ? "✅" : ex == cur.Ex ? "▶" : "·")
                                @ex.Def.Name
                                <span class="muted"> @(ex.Skipped ? "skipped — tap to restore" : $"{ex.Sets.Count(s => s.Completed)}/{ex.Sets.Count}")</span>
                            </span>
                        </button>
                    </li>
                }
            </ul>
        </section>
    }

    <section class="card">
        <button class="save-btn finish" @onclick="GoToFeedback">Finish Workout</button>
        <button class="link-btn danger" style="width:100%;margin-top:0.7rem" @onclick="DiscardWorkout">Discard Workout</button>
    </section>
}
else // Feedback
{
    <header class="dash-header">
        <div class="dash-date">How did it go?</div>
        <div class="dash-date-sub">@Elapsed total · optional feedback</div>
    </header>

    @foreach (var ex in _exercises.Where(e => !e.Skipped))
    {
        <section class="card">
            <h2>@ex.Def.Name</h2>
            <div class="field">
                <label>Difficulty</label>
                <select @bind="ex.Feedback.Difficulty">
                    @foreach (var d in Enum.GetValues<Difficulty>())
                    {
                        <option value="@d">@Pretty(d.ToString())</option>
                    }
                </select>
            </div>
            <div class="chip-row">
                <button type="button" class="chip @(ex.Feedback.PainOrDiscomfort ? "selected" : "")"
                        @onclick="@(() => ex.Feedback.PainOrDiscomfort = !ex.Feedback.PainOrDiscomfort)">Pain / discomfort</button>
                <button type="button" class="chip @(ex.Feedback.BreathingDifficulty ? "selected" : "")"
                        @onclick="@(() => ex.Feedback.BreathingDifficulty = !ex.Feedback.BreathingDifficulty)">Breathing</button>
                <button type="button" class="chip @(ex.Feedback.FormIssues ? "selected" : "")"
                        @onclick="@(() => ex.Feedback.FormIssues = !ex.Feedback.FormIssues)">Form issues</button>
            </div>
            <div class="field">
                <textarea rows="2" @bind="ex.Feedback.Comment" placeholder="Notes (e.g. last set very hard)"></textarea>
            </div>
        </section>
    }

    <section class="card">
        <div class="field">
            <label>Total time (minutes)</label>
            <input type="number" inputmode="decimal" min="0" step="1" @bind="_totalMinutes" />
        </div>
        <div class="field">
            <label>Workout notes</label>
            <textarea rows="2" @bind="_sessionNotes"></textarea>
        </div>
        <button class="save-btn" disabled="@_saving" @onclick="SaveWorkout">@(_saving ? "Saving…" : "Save Workout")</button>
        @if (_saveError is not null)
        {
            <span class="warn-msg">@_saveError</span>
        }
        <button class="link-btn danger" style="width:100%;margin-top:0.7rem" @onclick="DiscardWorkout">Discard Without Saving</button>
    </section>
}

</div>

@code {
    [Parameter, SupplyParameterFromQuery] public Guid? RoutineId { get; set; }

    // Resumable run state lives in the singleton so it survives navigating away
    // (Blazor disposes this component on navigation). These properties delegate to it.
    private WorkoutRun _run = new();
    private WorkoutState _state { get => _run.State; set => _run.State = value; }
    private List<ExVM> _exercises => _run.Exercises;
    private List<StepVM> _steps => _run.Steps;
    private int _stepIndex { get => _run.StepIndex; set => _run.StepIndex = value; }
    private Guid? _routineId { get => _run.RoutineId; set => _run.RoutineId = value; }
    private string _routineName { get => _run.RoutineName; set => _run.RoutineName = value; }
    private DateTime _startedAt { get => _run.StartedAt; set => _run.StartedAt = value; }
    private int _rest { get => _run.Rest; set => _run.Rest = value; }
    private int _totalMinutes { get => _run.TotalMinutes; set => _run.TotalMinutes = value; }
    private string? _sessionNotes { get => _run.SessionNotes; set => _run.SessionNotes = value; }
    private SetVM? _timingSet { get => _run.TimingSet; set => _run.TimingSet = value; }
    private SetVM? _holdDoneSet { get => _run.HoldDoneSet; set => _run.HoldDoneSet = value; }
    private DateTime _setStart { get => _run.SetStart; set => _run.SetStart = value; }
    private int _holdTarget { get => _run.HoldTarget; set => _run.HoldTarget = value; }

    private List<WorkoutRoutine> _routines = new();
    private readonly HashSet<Guid> _expandedRoutines = new();

    private void ToggleExpanded(Guid id)
    {
        if (!_expandedRoutines.Add(id)) _expandedRoutines.Remove(id);
    }

    /// <summary>Compact one-line prescription for the expanded routine preview.</summary>
    private static string RoutinePrescription(RoutineExercise re, ExerciseDefinition? def)
    {
        var parts = new List<string>();
        if (def?.Measure == ExerciseMeasure.Duration && re.TargetDurationSeconds is not null)
            parts.Add($"{re.TargetDurationSeconds}s × {re.TargetSets}");
        else if (re.TargetReps is not null)
            parts.Add($"{re.TargetReps} reps × {re.TargetSets}");
        else if (re.TargetSets is not null)
            parts.Add($"{re.TargetSets} sets");
        if (re.TargetWeight is { } w and > 0)
            parts.Add($"{w:0.#} lb");
        if (!string.IsNullOrWhiteSpace(re.TargetNote))
            parts.Add(re.TargetNote);
        return string.Join(" · ", parts);
    }
    private System.Threading.Timer? _timer;
    private string? _saveError;
    private bool _saving;   // in-flight guard against double-tap
    private bool _savedOk;  // commit succeeded; a re-tap just navigates home

    private int SetElapsed => (int)(DateTime.Now - _setStart).TotalSeconds;
    private int SetRemaining => _holdTarget - SetElapsed;

    private string Elapsed
    {
        get
        {
            var t = _state == WorkoutState.Active ? DateTime.Now - _startedAt : TimeSpan.FromMinutes(_totalMinutes);
            return t.TotalHours >= 1 ? t.ToString(@"h\:mm\:ss") : t.ToString(@"mm\:ss");
        }
    }

    private StepVM? Current => _stepIndex < _steps.Count ? _steps[_stepIndex] : null;
    private int TotalSets => _exercises.Where(e => !e.Skipped).Sum(e => e.Sets.Count);
    private int DoneSets => _exercises.Where(e => !e.Skipped).Sum(e => e.Sets.Count(s => s.Completed));

    private string? NextUpName
    {
        get
        {
            for (var i = _stepIndex + 1; i < _steps.Count; i++)
                if (!_steps[i].Ex.Skipped && !_steps[i].Set.Completed)
                    return _steps[i].Ex.Def.Name + (_steps[i].Ex == Current?.Ex ? $" (set {_steps[i].Set.SetNumber})" : "");
            return null;
        }
    }

    /// <summary>Move past completed/skipped steps to the next actionable one.</summary>
    private void Advance()
    {
        while (_stepIndex < _steps.Count && (_steps[_stepIndex].Ex.Skipped || _steps[_stepIndex].Set.Completed))
            _stepIndex++;
    }

    /// <summary>Step back one to review/correct a prior set (bypasses the auto-skip
    /// of completed steps that Advance does).</summary>
    private void PreviousStep()
    {
        if (_stepIndex <= 0) return;
        _stepIndex--;
        _timingSet = null;
        _holdDoneSet = null;
        _rest = 0;
    }

    /// <summary>Jump to any exercise from the Progress list — to correct it, or to
    /// restore one that was skipped by mistake.</summary>
    private void JumpTo(ExVM ex)
    {
        if (ex.Skipped) ex.Skipped = false; // tapping a skipped exercise restores it
        // Prefer its first not-yet-completed set; otherwise its first set (to edit).
        var idx = _steps.FindIndex(st => st.Ex == ex && !st.Set.Completed);
        if (idx < 0) idx = _steps.FindIndex(st => st.Ex == ex);
        if (idx < 0) return;
        _stepIndex = idx;
        _timingSet = null;
        _holdDoneSet = null;
        _rest = 0;
    }

    /// <summary>Rest (if prescribed), advance, and finish automatically after the last set.</summary>
    private void AfterSetCompleted(ExVM ex)
    {
        Advance();
        if (Current is null) { GoToFeedback(); return; }
        if (ex.Rest is > 0) _rest = ex.Rest.Value;
    }

    private void CompleteCurrentSet()
    {
        if (Current is not { } cur) return;
        cur.Set.Completed = true;
        _holdDoneSet = null;
        AfterSetCompleted(cur.Ex);
    }

    private void SkipCurrentExercise()
    {
        if (Current is not { } cur) return;
        cur.Ex.Skipped = true;
        if (_timingSet is not null && cur.Ex.Sets.Contains(_timingSet)) _timingSet = null;
        if (_holdDoneSet is not null && cur.Ex.Sets.Contains(_holdDoneSet)) _holdDoneSet = null;
        Advance();
        if (Current is null) GoToFeedback();
    }

    // Latest AI per-exercise suggestions (empty until an analysis is run).
    private Dictionary<string, GeminiAnalyzer.ExerciseAdvice> _advice = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _advice = AiAdviceStore.LoadExercises();

        // Resume an in-progress workout if one survived navigation.
        if (Active.HasResumable)
        {
            _run = Active.Current!;
            StartTimer();
            SetKeepScreenOn(true);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        _routines = await db.WorkoutRoutines
            .Include(r => r.Exercises).ThenInclude(e => e.ExerciseDefinition)
            .OrderBy(r => r.Name).ToListAsync();

        // Per-routine usage, to show running time + a "time to progress" nudge here
        // (the workout chooser) where it's actually seen day to day.
        var stats = await db.WorkoutSessions.Where(w => w.RoutineId != null)
            .GroupBy(w => w.RoutineId!.Value)
            .Select(g => new { Id = g.Key, Count = g.Count(), First = g.Min(x => x.Date), Last = g.Max(x => x.Date) })
            .ToListAsync();
        _routineStats = stats.ToDictionary(x => x.Id, x => (x.Count, x.First, x.Last));

        if (RoutineId is { } id && _routines.FirstOrDefault(r => r.Id == id) is { } match)
            StartWorkout(match);
    }

    // RoutineId -> (session count, first used, last used).
    private Dictionary<Guid, (int Count, DateOnly First, DateOnly Last)> _routineStats = new();

    /// <summary>Running time + staleness (5+ weeks OR 25+ sessions of recent use).</summary>
    private (string Text, int Count, bool Stale)? RoutineAge(Guid id)
    {
        if (!_routineStats.TryGetValue(id, out var s) || s.Count == 0) return null;
        var today = DateOnly.FromDateTime(DateTime.Now);
        var weeks = (today.DayNumber - s.First.DayNumber) / 7;
        var text = weeks < 1 ? "under a week" : $"{weeks} wk{(weeks == 1 ? "" : "s")}";
        var activeRecently = today.DayNumber - s.Last.DayNumber <= 14;
        var stale = activeRecently && (weeks >= 5 || s.Count >= 25);
        return (text, s.Count, stale);
    }

    private void StartWorkout(WorkoutRoutine routine)
    {
        _run = new WorkoutRun();      // fresh session
        Active.Current = _run;        // persist it across navigation
        _exercises.Clear();
        foreach (var re in routine.Exercises.OrderBy(e => e.Order))
        {
            if (re.ExerciseDefinition is null) continue;
            var def = re.ExerciseDefinition;
            var vm = new ExVM { Def = def, Rest = re.RestSeconds, TargetNote = re.TargetNote };
            var sets = re.TargetSets ?? 1;
            for (var i = 1; i <= sets; i++)
                vm.Sets.Add(new SetVM
                {
                    SetNumber = i,
                    Reps = def.Measure == ExerciseMeasure.Reps ? re.TargetReps : null,
                    Weight = re.TargetWeight,
                    DurationSeconds = def.Measure == ExerciseMeasure.Duration ? re.TargetDurationSeconds : null
                });
            vm.Feedback.ExerciseDefinitionId = re.ExerciseDefinition.Id;
            _exercises.Add(vm);
        }

        // Circuit queue: one set of each exercise per round, in routine order.
        _steps.Clear();
        _stepIndex = 0;
        var rounds = _exercises.Count == 0 ? 0 : _exercises.Max(e => e.Sets.Count);
        for (var round = 0; round < rounds; round++)
            foreach (var ex in _exercises)
                if (round < ex.Sets.Count)
                    _steps.Add(new StepVM { Ex = ex, Set = ex.Sets[round] });

        _routineId = routine.Id;
        _routineName = routine.Name;
        _startedAt = DateTime.Now;
        _saving = false;
        _savedOk = false;
        _saveError = null;
        _state = WorkoutState.Active;
        StartTimer();
        SetKeepScreenOn(true);
        _ = ReminderNotifier.RequestPermissionAsync(); // so hold-end alerts can fire
    }

    private void StartTimer()
    {
        _timer?.Dispose();
        _timer = new System.Threading.Timer(_ => Tick(), null, 1000, 1000);
    }

    /// <summary>Prevent the device from auto-locking mid-workout (timed holds especially).</summary>
    private static void SetKeepScreenOn(bool on)
    {
        try { Microsoft.Maui.Devices.DeviceDisplay.Current.KeepScreenOn = on; } catch { }
    }

    private void Tick() => InvokeAsync(async () =>
    {
        if (_rest > 0) _rest--;
        if (_timingSet is not null && SetRemaining <= 0)
            await CompleteHold();
        StateHasChanged();
    });

    private void StartRest(int seconds) => _rest = seconds;
    private void StopRest() => _rest = 0;

    private async Task StartSetTimer(SetVM s)
    {
        // Only one set timed at a time; record the previous if still running.
        if (_timingSet is not null) StopSetTimer(_timingSet);
        _holdDoneSet = null;
        _holdTarget = s.DurationSeconds is > 0 ? s.DurationSeconds.Value : 30;
        _setStart = DateTime.Now;
        _timingSet = s;
        // Unlock audio within this user gesture so the end-of-hold beep can play.
        try { await JS.InvokeVoidAsync("holdTimer.arm"); } catch { }
        // Backup OS notification in case the device locks or the app is backgrounded
        // (the in-app beep/haptic only fire while in the foreground).
        if (Current?.Set == s)
            try { await ReminderNotifier.ScheduleHoldEndAsync(Current.Ex.Def.Name, _holdTarget); } catch { }
    }

    // Stopped early — record the actual time held; completing the set stays manual.
    private void StopSetTimer(SetVM s)
    {
        ReminderNotifier.CancelHoldEnd();
        s.DurationSeconds = Math.Min(SetElapsed, _holdTarget);
        _timingSet = null;
    }

    // Countdown reached zero — record the full target and alert, but wait for an
    // explicit "Complete Set" tap before advancing.
    private async Task CompleteHold()
    {
        ReminderNotifier.CancelHoldEnd(); // foreground path: in-app beep/haptic suffice
        var s = _timingSet!;
        s.DurationSeconds = _holdTarget;
        _timingSet = null;
        _holdDoneSet = s;
        try { await JS.InvokeVoidAsync("holdTimer.beep"); } catch { }
        try { Microsoft.Maui.Devices.HapticFeedback.Default.Perform(Microsoft.Maui.Devices.HapticFeedbackType.LongPress); } catch { }
    }

    private async Task DiscardWorkout()
    {
        // Nothing is persisted until Save, so just tear down and return to the chooser.
        SetKeepScreenOn(false);
        ReminderNotifier.CancelHoldEnd();
        _timer?.Dispose();
        _timer = null;
        Active.Current = null;        // drop the persisted session
        _run = new WorkoutRun();      // back to a clean chooser
        await ReloadRoutines();
        _state = WorkoutState.Choosing;
    }

    private async Task ReloadRoutines()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _routines = await db.WorkoutRoutines
            .Include(r => r.Exercises).ThenInclude(e => e.ExerciseDefinition)
            .OrderBy(r => r.Name).ToListAsync();
    }

    private void GoToFeedback()
    {
        if (_timingSet is not null) StopSetTimer(_timingSet); // capture an in-progress hold
        SetKeepScreenOn(false);
        _timer?.Dispose();
        _timer = null;
        _totalMinutes = (int)Math.Round((DateTime.Now - _startedAt).TotalMinutes);
        _saveError = null;
        _state = WorkoutState.Feedback;
    }

    private async Task SaveWorkout()
    {
        if (_saving) return;          // ignore double-taps
        if (_savedOk) { Nav.NavigateTo(""); return; } // already saved; just leave
        _saving = true;
        _saveError = null;

        var session = new WorkoutSession
        {
            Date = DateOnly.FromDateTime(_startedAt),
            RoutineId = _routineId,
            StartedAt = _startedAt,
            EndedAt = DateTime.Now,
            TotalSeconds = _totalMinutes * 60,
            Notes = _sessionNotes
        };

        foreach (var ex in _exercises)
        {
            foreach (var s in ex.Sets)
            {
                session.Sets.Add(new ExerciseSet
                {
                    ExerciseDefinitionId = ex.Def.Id,
                    SetNumber = s.SetNumber,
                    Reps = s.Reps,
                    Weight = s.Weight,
                    DurationSeconds = s.DurationSeconds,
                    Completed = s.Completed
                });
            }
            ex.Feedback.ExerciseDefinitionId = ex.Def.Id;
            if (ex.Skipped && string.IsNullOrWhiteSpace(ex.Feedback.Comment))
                ex.Feedback.Comment = "Skipped";
            session.Feedback.Add(ex.Feedback);
        }

        double? weightLbs = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // Read first — anything that could throw happens BEFORE the commit, so a
            // successful save is always followed by navigation (never strands a
            // committed workout on this screen).
            weightLbs = await db.BodyMeasurements
                .Where(m => m.WeightLbs != null)
                .OrderByDescending(m => m.Date)
                .Select(m => m.WeightLbs)
                .FirstOrDefaultAsync();

            db.WorkoutSessions.Add(session);

            // Forgot to plan the day? A completed workout makes it a workout day.
            // (Deliberately chosen day types are left alone.)
            var day = await db.DailyLogs.FirstOrDefaultAsync(x => x.Date == session.Date);
            if (day is null)
                db.DailyLogs.Add(new DailyLog { Date = session.Date, DayType = DayType.Workout });
            else if (day.DayType == DayType.Unset)
                day.DayType = DayType.Workout;

            await db.SaveChangesAsync();
            _savedOk = true; // commit succeeded — safe to leave even if Health write hiccups
            Active.Current = null; // session is persisted; drop the in-progress copy
        }
        catch (Exception ex)
        {
            // Keep the user on the feedback screen with their data intact to retry.
            _saveError = $"Couldn't save: {ex.Message}";
            _saving = false;
            return;
        }

        // Mirror to Apple Health/Fitness — fire-and-forget so a hung or slow
        // HealthKit query can never block leaving this screen (the DB save is done).
        if (Health.IsAvailable && session.EndedAt is { } ended && ended > session.StartedAt)
        {
            var startedAt = session.StartedAt!.Value;
            var name = _routineName;
            _ = Task.Run(async () =>
            {
                try { await Health.WriteWorkoutAsync(startedAt, ended, name, weightLbs); } catch { }
            });
        }

        Nav.NavigateTo("");
    }

    private static string Pretty(string camel) =>
        System.Text.RegularExpressions.Regex.Replace(camel, "(?<=.)([A-Z])", " $1");

    public void Dispose()
    {
        // Covers navigating away mid-workout (back button, deep link, etc.).
        SetKeepScreenOn(false);
        ReminderNotifier.CancelHoldEnd();
        _timer?.Dispose();
    }
}
