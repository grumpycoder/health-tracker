@page "/workout"
@using FitRecoveryLog.Services
@implements IDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Workout</PageTitle>

<div class="dashboard">

@if (_state == State.Choosing)
{
    <header class="dash-header">
        <div class="dash-date">Start a Workout</div>
        <div class="dash-date-sub">Pick a routine to begin</div>
    </header>

    <section class="card">
        <button class="quick-btn wide" @onclick="@(() => Nav.NavigateTo("workout-history"))">
            <span class="quick-emoji">📋</span> Workout History
        </button>
        <button class="quick-btn wide" style="margin-top:0.6rem" @onclick="@(() => Nav.NavigateTo("progression"))">
            <span class="quick-emoji">💡</span> Progression Suggestions
        </button>
        <button class="quick-btn wide" style="margin-top:0.6rem" @onclick="@(() => Nav.NavigateTo("exercises"))">
            <span class="quick-emoji">📚</span> Exercise Library
        </button>
    </section>

    @if (_routines.Count == 0)
    {
        <section class="card">
            <p class="muted">No routines yet.</p>
            <button class="save-btn" @onclick="@(() => Nav.NavigateTo("routines"))">Create a Routine</button>
        </section>
    }
    else
    {
        @foreach (var r in _routines)
        {
            <section class="card">
                <div class="routine-head">
                    <h2>@r.Name</h2>
                    <button class="save-btn" @onclick="@(() => StartWorkout(r))">Start ▶</button>
                </div>
                <p class="muted">@r.Exercises.Count exercise(s)</p>
            </section>
        }
        <section class="card">
            <button class="link-btn" @onclick="@(() => Nav.NavigateTo("routines"))">Manage Routines</button>
        </section>
    }
}
else if (_state == State.Active)
{
    <header class="dash-header timer-head">
        <div class="dash-date">@Elapsed</div>
        <div class="dash-date-sub">@_routineName</div>
    </header>

    @if (_rest > 0)
    {
        <section class="card rest-banner">
            <span>Rest: <strong>@_rest s</strong></span>
            <button class="link-btn" @onclick="StopRest">Skip</button>
        </section>
    }

    @if (Current is { } cur)
    {
        var isTime = cur.Ex.Def.Measure == ExerciseMeasure.Duration;
        <section class="card">
            <p class="muted" style="margin:0 0 0.25rem">
                Set @cur.Set.SetNumber of @cur.Ex.Sets.Count · @DoneSets/@TotalSets sets done
            </p>
            <h2 style="text-transform:none;letter-spacing:0;color:var(--text);font-size:1.5rem;margin:0 0 0.7rem">
                @cur.Ex.Def.Name
            </h2>
            @if (_advice.TryGetValue(cur.Ex.Def.Name, out var adv))
            {
                <p class="muted" style="margin:-0.4rem 0 0.7rem">
                    🤖 AI suggests: <span class="badge @AiAdviceStore.BadgeClass(adv.Action)">@AiAdviceStore.Glyph(adv.Action) @(adv.Target ?? adv.Action)</span>
                </p>
            }

            @if (isTime)
            {
                @if (_timingSet == cur.Set)
                {
                    <div style="text-align:center;margin:0.5rem 0 0.8rem">
                        <span class="timing" style="font-size:2.2rem">@Math.Max(0, SetRemaining) s</span>
                        <button class="icon-btn stop" title="Stop" aria-label="Stop hold"
                                @onclick="() => StopSetTimer(cur.Set)">⏹</button>
                    </div>
                }
                else
                {
                    <div class="inline-fields">
                        <div class="field"><label>Hold (s)</label>
                            <input type="number" inputmode="decimal" min="0" @bind="cur.Set.DurationSeconds" />
                        </div>
                    </div>
                    <button class="save-btn" @onclick="() => StartSetTimer(cur.Set)">▶ Start Hold</button>
                }
            }
            else
            {
                <div class="inline-fields">
                    <div class="field"><label>Reps</label>
                        <input type="number" inputmode="decimal" min="0" @bind="cur.Set.Reps" />
                    </div>
                </div>
                <button class="save-btn" @onclick="CompleteCurrentSet">Complete Set ✓</button>
            }

            @if (_timingSet != cur.Set)
            {
                <button class="link-btn" style="width:100%;margin-top:0.7rem"
                        @onclick="SkipCurrentExercise">Skip @cur.Ex.Def.Name today</button>
            }
            @if (NextUpName is { } next)
            {
                <p class="muted" style="margin:0.7rem 0 0">Up next: @next</p>
            }
        </section>

        <section class="card">
            <h2>Progress</h2>
            <ul class="timeline">
                @foreach (var ex in _exercises)
                {
                    <li>
                        <span class="entry @(ex == cur.Ex ? "" : "muted")">
                            @(ex.Skipped ? "⏭" : ex.Sets.All(s => s.Completed) ? "✅" : ex == cur.Ex ? "▶" : "·")
                            @ex.Def.Name
                            <span class="muted"> @(ex.Skipped ? "skipped" : $"{ex.Sets.Count(s => s.Completed)}/{ex.Sets.Count}")</span>
                        </span>
                    </li>
                }
            </ul>
        </section>
    }

    <section class="card">
        <button class="save-btn finish" @onclick="GoToFeedback">Finish Workout</button>
        <button class="link-btn danger" style="width:100%;margin-top:0.7rem" @onclick="DiscardWorkout">Discard Workout</button>
    </section>
}
else // Feedback
{
    <header class="dash-header">
        <div class="dash-date">How did it go?</div>
        <div class="dash-date-sub">@Elapsed total · optional feedback</div>
    </header>

    @foreach (var ex in _exercises.Where(e => !e.Skipped))
    {
        <section class="card">
            <h2>@ex.Def.Name</h2>
            <div class="field">
                <label>Difficulty</label>
                <select @bind="ex.Feedback.Difficulty">
                    @foreach (var d in Enum.GetValues<Difficulty>())
                    {
                        <option value="@d">@Pretty(d.ToString())</option>
                    }
                </select>
            </div>
            <div class="chip-row">
                <button type="button" class="chip @(ex.Feedback.PainOrDiscomfort ? "selected" : "")"
                        @onclick="@(() => ex.Feedback.PainOrDiscomfort = !ex.Feedback.PainOrDiscomfort)">Pain / discomfort</button>
                <button type="button" class="chip @(ex.Feedback.BreathingDifficulty ? "selected" : "")"
                        @onclick="@(() => ex.Feedback.BreathingDifficulty = !ex.Feedback.BreathingDifficulty)">Breathing</button>
                <button type="button" class="chip @(ex.Feedback.FormIssues ? "selected" : "")"
                        @onclick="@(() => ex.Feedback.FormIssues = !ex.Feedback.FormIssues)">Form issues</button>
            </div>
            <div class="field">
                <textarea rows="2" @bind="ex.Feedback.Comment" placeholder="Notes (e.g. last set very hard)"></textarea>
            </div>
        </section>
    }

    <section class="card">
        <div class="field">
            <label>Total time (minutes)</label>
            <input type="number" inputmode="decimal" min="0" step="1" @bind="_totalMinutes" />
        </div>
        <div class="field">
            <label>Workout notes</label>
            <textarea rows="2" @bind="_sessionNotes"></textarea>
        </div>
        <button class="save-btn" @onclick="SaveWorkout">Save Workout</button>
        <button class="link-btn danger" style="width:100%;margin-top:0.7rem" @onclick="DiscardWorkout">Discard Without Saving</button>
    </section>
}

</div>

@code {
    [Parameter, SupplyParameterFromQuery] public Guid? RoutineId { get; set; }

    private enum State { Choosing, Active, Feedback }
    private State _state = State.Choosing;

    private List<WorkoutRoutine> _routines = new();
    private readonly List<ExVM> _exercises = new();
    private Guid? _routineId;
    private string _routineName = "Workout";

    private DateTime _startedAt;
    private System.Threading.Timer? _timer;
    private int _rest;
    private int _totalMinutes;
    private string? _sessionNotes;

    // Live hold countdown for a timed set (e.g. planks).
    private SetVM? _timingSet;
    private DateTime _setStart;
    private int _holdTarget;
    private int SetElapsed => (int)(DateTime.Now - _setStart).TotalSeconds;
    private int SetRemaining => _holdTarget - SetElapsed;

    private string Elapsed
    {
        get
        {
            var t = _state == State.Active ? DateTime.Now - _startedAt : TimeSpan.FromMinutes(_totalMinutes);
            return t.TotalHours >= 1 ? t.ToString(@"h\:mm\:ss") : t.ToString(@"mm\:ss");
        }
    }

    private class SetVM { public int SetNumber; public int? Reps; public int? DurationSeconds; public bool Completed; }
    private class ExVM
    {
        public ExerciseDefinition Def = null!;
        public int? Rest;   // this routine's rest prescription
        public bool Skipped; // skipped for this session (injury etc.)
        public List<SetVM> Sets = new();
        public ExerciseFeedback Feedback = new();
    }

    // Circuit order: set 1 of every exercise, then set 2, and so on.
    private class StepVM { public ExVM Ex = null!; public SetVM Set = null!; }
    private readonly List<StepVM> _steps = new();
    private int _stepIndex;

    private StepVM? Current => _stepIndex < _steps.Count ? _steps[_stepIndex] : null;
    private int TotalSets => _exercises.Where(e => !e.Skipped).Sum(e => e.Sets.Count);
    private int DoneSets => _exercises.Where(e => !e.Skipped).Sum(e => e.Sets.Count(s => s.Completed));

    private string? NextUpName
    {
        get
        {
            for (var i = _stepIndex + 1; i < _steps.Count; i++)
                if (!_steps[i].Ex.Skipped && !_steps[i].Set.Completed)
                    return _steps[i].Ex.Def.Name + (_steps[i].Ex == Current?.Ex ? $" (set {_steps[i].Set.SetNumber})" : "");
            return null;
        }
    }

    /// <summary>Move past completed/skipped steps to the next actionable one.</summary>
    private void Advance()
    {
        while (_stepIndex < _steps.Count && (_steps[_stepIndex].Ex.Skipped || _steps[_stepIndex].Set.Completed))
            _stepIndex++;
    }

    /// <summary>Rest (if prescribed), advance, and finish automatically after the last set.</summary>
    private void AfterSetCompleted(ExVM ex)
    {
        Advance();
        if (Current is null) { GoToFeedback(); return; }
        if (ex.Rest is > 0) _rest = ex.Rest.Value;
    }

    private void CompleteCurrentSet()
    {
        if (Current is not { } cur) return;
        cur.Set.Completed = true;
        AfterSetCompleted(cur.Ex);
    }

    private void SkipCurrentExercise()
    {
        if (Current is not { } cur) return;
        cur.Ex.Skipped = true;
        if (_timingSet is not null && cur.Ex.Sets.Contains(_timingSet)) _timingSet = null;
        Advance();
        if (Current is null) GoToFeedback();
    }

    // Latest AI per-exercise suggestions (empty until an analysis is run).
    private Dictionary<string, GeminiAnalyzer.ExerciseAdvice> _advice = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _advice = AiAdviceStore.LoadExercises();
        await using var db = await DbFactory.CreateDbContextAsync();
        _routines = await db.WorkoutRoutines
            .Include(r => r.Exercises).ThenInclude(e => e.ExerciseDefinition)
            .OrderBy(r => r.Name).ToListAsync();

        if (RoutineId is { } id && _routines.FirstOrDefault(r => r.Id == id) is { } match)
            StartWorkout(match);
    }

    private void StartWorkout(WorkoutRoutine routine)
    {
        _exercises.Clear();
        foreach (var re in routine.Exercises.OrderBy(e => e.Order))
        {
            if (re.ExerciseDefinition is null) continue;
            var def = re.ExerciseDefinition;
            var vm = new ExVM { Def = def, Rest = re.RestSeconds };
            var sets = re.TargetSets ?? 1;
            for (var i = 1; i <= sets; i++)
                vm.Sets.Add(new SetVM
                {
                    SetNumber = i,
                    Reps = def.Measure == ExerciseMeasure.Reps ? re.TargetReps : null,
                    DurationSeconds = def.Measure == ExerciseMeasure.Duration ? re.TargetDurationSeconds : null
                });
            vm.Feedback.ExerciseDefinitionId = re.ExerciseDefinition.Id;
            _exercises.Add(vm);
        }

        // Circuit queue: one set of each exercise per round, in routine order.
        _steps.Clear();
        _stepIndex = 0;
        var rounds = _exercises.Count == 0 ? 0 : _exercises.Max(e => e.Sets.Count);
        for (var round = 0; round < rounds; round++)
            foreach (var ex in _exercises)
                if (round < ex.Sets.Count)
                    _steps.Add(new StepVM { Ex = ex, Set = ex.Sets[round] });

        _routineId = routine.Id;
        _routineName = routine.Name;
        _startedAt = DateTime.Now;
        _state = State.Active;
        _timer = new System.Threading.Timer(_ => Tick(), null, 1000, 1000);
    }

    private void Tick() => InvokeAsync(async () =>
    {
        if (_rest > 0) _rest--;
        if (_timingSet is not null && SetRemaining <= 0)
            await CompleteHold();
        StateHasChanged();
    });

    private void StartRest(int seconds) => _rest = seconds;
    private void StopRest() => _rest = 0;

    private async Task StartSetTimer(SetVM s)
    {
        // Only one set timed at a time; record the previous if still running.
        if (_timingSet is not null) StopSetTimer(_timingSet);
        _holdTarget = s.DurationSeconds is > 0 ? s.DurationSeconds.Value : 30;
        _setStart = DateTime.Now;
        _timingSet = s;
        // Unlock audio within this user gesture so the end-of-hold beep can play.
        try { await JS.InvokeVoidAsync("holdTimer.arm"); } catch { }
    }

    // Stopped early — record the actual time held.
    private void StopSetTimer(SetVM s)
    {
        s.DurationSeconds = Math.Min(SetElapsed, _holdTarget);
        s.Completed = true;
        _timingSet = null;
        if (Current?.Set == s) AfterSetCompleted(Current.Ex);
    }

    // Countdown reached zero — held the full target; alert and record it.
    private async Task CompleteHold()
    {
        var s = _timingSet!;
        s.DurationSeconds = _holdTarget;
        s.Completed = true;
        _timingSet = null;
        try { await JS.InvokeVoidAsync("holdTimer.beep"); } catch { }
        try { Microsoft.Maui.Devices.HapticFeedback.Default.Perform(Microsoft.Maui.Devices.HapticFeedbackType.LongPress); } catch { }
        if (Current?.Set == s) AfterSetCompleted(Current.Ex);
    }

    private void DiscardWorkout()
    {
        // Nothing is persisted until Save, so just tear down and return to the chooser.
        _timer?.Dispose();
        _timer = null;
        _timingSet = null;
        _rest = 0;
        _exercises.Clear();
        _steps.Clear();
        _stepIndex = 0;
        _state = State.Choosing;
    }

    private void GoToFeedback()
    {
        if (_timingSet is not null) StopSetTimer(_timingSet); // capture an in-progress hold
        _timer?.Dispose();
        _timer = null;
        _totalMinutes = (int)Math.Round((DateTime.Now - _startedAt).TotalMinutes);
        _state = State.Feedback;
    }

    private async Task SaveWorkout()
    {
        var session = new WorkoutSession
        {
            Date = DateOnly.FromDateTime(_startedAt),
            RoutineId = _routineId,
            StartedAt = _startedAt,
            EndedAt = DateTime.Now,
            TotalSeconds = _totalMinutes * 60,
            Notes = _sessionNotes
        };

        foreach (var ex in _exercises)
        {
            foreach (var s in ex.Sets)
            {
                session.Sets.Add(new ExerciseSet
                {
                    ExerciseDefinitionId = ex.Def.Id,
                    SetNumber = s.SetNumber,
                    Reps = s.Reps,
                    DurationSeconds = s.DurationSeconds,
                    Completed = s.Completed
                });
            }
            ex.Feedback.ExerciseDefinitionId = ex.Def.Id;
            if (ex.Skipped && string.IsNullOrWhiteSpace(ex.Feedback.Comment))
                ex.Feedback.Comment = "Skipped";
            session.Feedback.Add(ex.Feedback);
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        db.WorkoutSessions.Add(session);
        await db.SaveChangesAsync();

        Nav.NavigateTo("");
    }

    private static string Pretty(string camel) =>
        System.Text.RegularExpressions.Regex.Replace(camel, "(?<=.)([A-Z])", " $1");

    public void Dispose() => _timer?.Dispose();
}
