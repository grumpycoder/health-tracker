@page "/export"
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.Maui.Storage
@using Microsoft.Maui.ApplicationModel.DataTransfer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject FitRecoveryLog.Services.AutoBackup AutoBackup

<PageTitle>Export Data</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <div class="dash-date">Export Data</div>
        <div class="dash-date-sub">Back up or share your log</div>
    </header>

    <section class="card">
        <h2>Full backup (JSON)</h2>
        <p class="muted" style="margin:0 0 0.6rem">Every record, machine-readable — good for backups.</p>
        <button class="save-btn" disabled="@_busy" @onclick="ExportJson">Export JSON</button>
        <p class="muted" style="margin:0.6rem 0 0;font-size:0.8rem">
            @(AutoBackup.Latest() is { } la
                ? $"Auto-backup runs daily. Latest: {la.When:MMM d, h:mm tt}. Export & share regularly — auto-backups don't survive deleting the app."
                : "Auto-backup runs daily on open. Export & share regularly for off-device safety.")
        </p>
    </section>

    <section class="card">
        <h2>Date range</h2>
        <p class="muted" style="margin:0 0 0.6rem">Applies to the report and CSV exports. The JSON backup is always complete.</p>
        <label style="display:flex;gap:0.4rem;align-items:center">
            <input type="checkbox" @bind="_allDates" /> All dates
        </label>
        @if (!_allDates)
        {
            <div class="inline-fields" style="margin-top:0.4rem">
                <div class="field"><label>From</label><input type="date" @bind="_from" max="@_to.ToString("yyyy-MM-dd")" /></div>
                <div class="field"><label>To</label><input type="date" @bind="_to" min="@_from.ToString("yyyy-MM-dd")" /></div>
            </div>
        }
    </section>

    <section class="card">
        <h2>Report (Markdown)</h2>
        <p class="muted" style="margin:0 0 0.6rem">Readable summary you can keep or convert to PDF.</p>
        <button class="save-btn" disabled="@_busy" @onclick="ExportMarkdown">Export Markdown</button>
    </section>

    <section class="card">
        <h2>Spreadsheet (CSV)</h2>
        <div class="field">
            <label>Category</label>
            <select @bind="_csvCategory">
                @foreach (var c in Categories)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>
        <button class="save-btn" disabled="@_busy" @onclick="ExportCsv">Export @_csvCategory CSV</button>
    </section>

    <section class="card">
        <h2>Restore from Backup</h2>
        <p class="muted" style="margin:0 0 0.6rem">Replaces ALL current data with a previously exported JSON backup.</p>
        @if (_pendingRestore is null)
        {
            <button class="save-btn" disabled="@_busy" @onclick="PickRestoreFile">Choose Backup File</button>
            @if (AutoBackup.Latest() is { } ra)
            {
                <button class="link-btn" style="margin-left:0.6rem" disabled="@_busy"
                        @onclick="LoadLatestAutoBackup">Use latest auto-backup (@ra.When.ToString("MMM d, h:mm tt"))</button>
            }
        }
        else
        {
            <p style="margin:0 0 0.4rem"><strong>@_restoreFileName</strong> contains: @_restoreSummary.</p>
            <p class="warn-msg" style="display:block;margin:0 0 0.6rem">Everything currently in the app will be erased.</p>
            <button class="save-btn" disabled="@_busy" @onclick="ConfirmRestore">Restore Now</button>
            <button class="link-btn" style="margin-left:0.6rem" @onclick="CancelRestore">Cancel</button>
        }
    </section>

    @if (_status is not null)
    {
        <section class="card"><p class="muted">@_status</p></section>
    }
</div>

@code {
    private static readonly string[] Categories =
        { "Body measurements", "Daily nutrition", "Meals", "Drinks", "Workouts", "Sleep", "Recovery", "Medications", "Labs", "Workload" };

    private string _csvCategory = "Body measurements";
    private bool _allDates = true;
    private DateOnly _from = DateOnly.FromDateTime(DateTime.Today).AddDays(-30);
    private DateOnly _to = DateOnly.FromDateTime(DateTime.Today);
    private bool _busy;
    private string? _status;

    // Restore flow: pick + parse first, apply only after explicit confirmation.
    private BackupRestore.Backup? _pendingRestore;
    private string? _restoreFileName;
    private string? _restoreSummary;

    protected override async Task OnInitializedAsync()
    {
        // Guarantee a same-day snapshot exists so "restore latest auto-backup" is available.
        await AutoBackup.SnapshotIfDueAsync();
    }

    private async Task PickRestoreFile()
    {
        _status = null;
        try
        {
            var picked = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Pick a Fit Log backup (.json)",
                FileTypes = new FilePickerFileType(new Dictionary<Microsoft.Maui.Devices.DevicePlatform, IEnumerable<string>>
                {
                    { Microsoft.Maui.Devices.DevicePlatform.iOS, new[] { "public.json", "public.plain-text" } },
                    { Microsoft.Maui.Devices.DevicePlatform.MacCatalyst, new[] { "json", "txt" } },
                })
            });
            if (picked is null) return; // user cancelled

            using var stream = await picked.OpenReadAsync();
            using var reader = new System.IO.StreamReader(stream);
            var backup = BackupRestore.Parse(await reader.ReadToEndAsync());

            _pendingRestore = backup;
            _restoreFileName = picked.FileName;
            _restoreSummary = BackupRestore.Summarize(backup);
        }
        catch (Exception ex)
        {
            _status = $"Could not read backup: {ex.Message}";
        }
    }

    private async Task LoadLatestAutoBackup()
    {
        _status = null;
        try
        {
            if (AutoBackup.Latest() is not { } a) { _status = "No auto-backup found yet."; return; }
            var backup = BackupRestore.Parse(await File.ReadAllTextAsync(a.Path));
            _pendingRestore = backup;
            _restoreFileName = $"auto-backup ({a.When:MMM d, h:mm tt})";
            _restoreSummary = BackupRestore.Summarize(backup);
        }
        catch (Exception ex)
        {
            _status = $"Could not read auto-backup: {ex.Message}";
        }
    }

    private void CancelRestore()
    {
        _pendingRestore = null;
        _restoreFileName = null;
        _restoreSummary = null;
    }

    private async Task ConfirmRestore()
    {
        if (_pendingRestore is null) return;
        _busy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            BackupRestore.Apply(db, _pendingRestore);
            _status = $"Restored {_restoreFileName}: {_restoreSummary}.";
            CancelRestore();
        }
        catch (Exception ex)
        {
            _status = $"Restore failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Inclusive date range for the report/CSV; null bounds = all dates.</summary>
    private sealed record Range(DateOnly? From, DateOnly? To)
    {
        public static readonly Range All = new(null, null);
        public DateOnly Min => From ?? DateOnly.MinValue;
        public DateOnly Max => To ?? DateOnly.MaxValue;
        // Timestamped rows: [From 00:00, day after To 00:00).
        public DateTime Start => From?.ToDateTime(TimeOnly.MinValue) ?? DateTime.MinValue;
        public DateTime End => To?.AddDays(1).ToDateTime(TimeOnly.MinValue) ?? DateTime.MaxValue;
        public string Label => From is null ? "all dates" : $"{From:yyyy-MM-dd} to {To:yyyy-MM-dd}";
        public string FileSuffix => From is null ? "" : $"-{From:yyyyMMdd}-{To:yyyyMMdd}";
    }

    private Range SelectedRange()
    {
        if (_allDates) return Range.All;
        var (from, to) = _from <= _to ? (_from, _to) : (_to, _from);
        return new Range(from, to);
    }

    private static readonly JsonSerializerOptions JsonOpts = new()
    {
        WriteIndented = true,
        ReferenceHandler = ReferenceHandler.IgnoreCycles,
        Converters = { new JsonStringEnumConverter() }
    };

    private async Task ExportJson()
    {
        await Run("fitrecoverylog-backup.json", db => BackupRestore.BuildJsonAsync(db));
        // Count this as an off-device backup and push the weekly reminder out a week.
        AutoBackup.MarkExported();
        await AutoBackup.EnsureBackupReminderAsync();
    }

    private async Task ExportMarkdown()
    {
        var r = SelectedRange();
        await Run($"fitrecoverylog-report{r.FileSuffix}.md", async db =>
        {
            var sb = new StringBuilder();
            sb.AppendLine($"# Fit Recovery Log — export");
            sb.AppendLine($"_Generated {DateTime.Now:yyyy-MM-dd HH:mm} · {r.Label}_\n");

            var weight = await db.BodyMeasurements.Where(m => m.Date >= r.Min && m.Date <= r.Max).OrderByDescending(m => m.Date).ToListAsync();
            sb.AppendLine("## Body measurements");
            sb.AppendLine("| Date | Weight | Waist |");
            sb.AppendLine("|---|---|---|");
            foreach (var m in weight)
                sb.AppendLine($"| {m.Date:yyyy-MM-dd} | {m.WeightLbs?.ToString("0.0") ?? "—"} | {m.WaistInches?.ToString("0.0") ?? "—"} |");

            var sessions = await db.WorkoutSessions.Where(s => s.Date >= r.Min && s.Date <= r.Max).OrderByDescending(s => s.Date).ToListAsync();
            sb.AppendLine("\n## Workouts");
            sb.AppendLine("| Date | Minutes |");
            sb.AppendLine("|---|---|");
            foreach (var s in sessions)
                sb.AppendLine($"| {s.Date:yyyy-MM-dd} | {(s.TotalSeconds is { } t ? (t / 60).ToString() : "—")} |");

            var sleep = await db.SleepEntries.Where(s => s.Date >= r.Min && s.Date <= r.Max).OrderByDescending(s => s.Date).ToListAsync();
            sb.AppendLine("\n## Sleep");
            sb.AppendLine("| Date | Hours | Score |");
            sb.AppendLine("|---|---|---|");
            foreach (var s in sleep)
                sb.AppendLine($"| {s.Date:yyyy-MM-dd} | {s.DurationHours?.ToString("0.0") ?? "—"} | {s.SleepScore?.ToString() ?? "—"} |");

            var meds = await db.MedicationEntries.Where(m => m.TakenAt >= r.Start && m.TakenAt < r.End).OrderByDescending(m => m.TakenAt).ToListAsync();
            sb.AppendLine("\n## Medications");
            sb.AppendLine("| When | Name | Dose | Site |");
            sb.AppendLine("|---|---|---|---|");
            foreach (var m in meds)
                sb.AppendLine($"| {m.TakenAt:yyyy-MM-dd HH:mm} | {m.Name} | {m.Dose} | {m.InjectionSite} |");

            var labs = await db.LabResults.Where(l => l.Date >= r.Min && l.Date <= r.Max).OrderByDescending(l => l.Date).ToListAsync();
            sb.AppendLine("\n## Labs");
            sb.AppendLine("| Date | Lab | Value | Unit |");
            sb.AppendLine("|---|---|---|---|");
            foreach (var l in labs)
                sb.AppendLine($"| {l.Date:yyyy-MM-dd} | {l.LabName} | {l.Value?.ToString("0.##")} | {l.Unit} |");

            return sb.ToString();
        });
    }

    private async Task ExportCsv()
    {
        var cat = _csvCategory;
        var r = SelectedRange();
        var file = $"fitrecoverylog-{cat.ToLower().Replace(' ', '-')}{r.FileSuffix}.csv";
        await Run(file, db => BuildCsv(db, cat, r));
    }

    private static async Task<string> BuildCsv(AppDbContext db, string category, Range r)
    {
        var sb = new StringBuilder();
        switch (category)
        {
            case "Body measurements":
                sb.AppendLine("Date,Weight (lbs),Waist,Chest,Hips,Arms,Forearms,Thighs,Shoulders,Calves," +
                              "Body fat %,Muscle mass (lbs),Visceral fat,Body water %,BMR,Metabolic age,Notes");
                foreach (var m in await db.BodyMeasurements.Where(x => x.Date >= r.Min && x.Date <= r.Max).OrderBy(x => x.Date).ToListAsync())
                    sb.AppendLine(Row(m.Date.ToString("yyyy-MM-dd"), m.WeightLbs, m.WaistInches, m.ChestInches, m.HipsInches,
                        m.ArmsInches, m.ForearmsInches, m.ThighsInches, m.ShouldersInches, m.CalvesInches,
                        m.BodyFatPercent, m.MuscleMassLbs, m.VisceralFat, m.BodyWaterPercent, m.BasalMetabolicRate,
                        m.MetabolicAge, m.ClothingFitNotes));
                break;
            case "Daily nutrition":
                await DailyNutritionCsv(db, r, sb);
                break;
            case "Meals":
                sb.AppendLine("Time,Type,Description,Portion,Tags,Satiety," + MacroHeader);
                foreach (var m in await db.MealEntries.Where(x => x.Time >= r.Start && x.Time < r.End).OrderBy(x => x.Time).ToListAsync())
                    sb.AppendLine(Row(m.Time.ToString("yyyy-MM-dd HH:mm"), m.MealType, m.Description, m.PortionNote, m.Tags, m.Satiety,
                        m.Calories, m.ProteinG, m.CarbsG, m.FatG, m.FiberG, m.SugarG, m.AddedSugarG, m.SodiumMg));
                break;
            case "Drinks":
                sb.AppendLine("Time,Description,Ounces,Sugar," + MacroHeader);
                foreach (var d in await db.DrinkEntries.Where(x => x.Time >= r.Start && x.Time < r.End).OrderBy(x => x.Time).ToListAsync())
                    sb.AppendLine(Row(d.Time.ToString("yyyy-MM-dd HH:mm"), d.Description, d.Ounces, d.SugarCount,
                        d.Calories, d.ProteinG, d.CarbsG, d.FatG, d.FiberG, d.SugarG, d.AddedSugarG, d.SodiumMg));
                break;
            case "Workouts":
                sb.AppendLine("Date,Minutes,Notes");
                foreach (var s in await db.WorkoutSessions.Where(x => x.Date >= r.Min && x.Date <= r.Max).OrderBy(x => x.Date).ToListAsync())
                    sb.AppendLine(Row(s.Date.ToString("yyyy-MM-dd"), s.TotalSeconds is { } t ? t / 60 : (int?)null, s.Notes));
                break;
            case "Sleep":
                sb.AppendLine("Date,Hours,Score,Interruptions,Notes");
                foreach (var s in await db.SleepEntries.Where(x => x.Date >= r.Min && x.Date <= r.Max).OrderBy(x => x.Date).ToListAsync())
                    sb.AppendLine(Row(s.Date.ToString("yyyy-MM-dd"), s.DurationHours, s.SleepScore, s.Interruptions, s.Notes));
                break;
            case "Recovery":
                sb.AppendLine("Date,Recovery,Fatigue,Soreness,Severity,Notes");
                foreach (var rec in await db.RecoveryEntries.Where(x => x.Date >= r.Min && x.Date <= r.Max).OrderBy(x => x.Date).ToListAsync())
                    sb.AppendLine(Row(rec.Date.ToString("yyyy-MM-dd"), rec.RecoveryRating, rec.FatigueRating, rec.SorenessLocations, rec.SorenessSeverity, rec.Notes));
                break;
            case "Medications":
                sb.AppendLine("When,Name,Dose,Frequency,Site,Notes");
                foreach (var m in await db.MedicationEntries.Where(x => x.TakenAt >= r.Start && x.TakenAt < r.End).OrderBy(x => x.TakenAt).ToListAsync())
                    sb.AppendLine(Row(m.TakenAt.ToString("yyyy-MM-dd HH:mm"), m.Name, m.Dose, m.Frequency, m.InjectionSite, m.ReactionNotes));
                break;
            case "Labs":
                sb.AppendLine("Date,Lab,Value,Unit,Notes");
                foreach (var l in await db.LabResults.Where(x => x.Date >= r.Min && x.Date <= r.Max).OrderBy(x => x.Date).ToListAsync())
                    sb.AppendLine(Row(l.Date.ToString("yyyy-MM-dd"), l.LabName, l.Value, l.Unit, l.Notes));
                break;
            case "Workload":
                sb.AppendLine("Date,Activity,Minutes,Intensity,BodyAreas,Notes");
                foreach (var w in await db.PhysicalWorkloadEntries.Where(x => x.Date >= r.Min && x.Date <= r.Max).OrderBy(x => x.Date).ToListAsync())
                    sb.AppendLine(Row(w.Date.ToString("yyyy-MM-dd"), w.Activity, w.DurationMinutes, w.Intensity, w.BodyAreasAffected, w.Notes));
                break;
        }
        return sb.ToString();
    }

    /// <summary>One row per day with any meal or drink: macro totals (same math as the Log tab),
    /// macro coverage, fluids, and calories out (Apple Health for completed days, else the BMR
    /// estimate using the body measurements known as of that day) with 7/14-day rolling averages.</summary>
    private static async Task DailyNutritionCsv(AppDbContext db, Range r, StringBuilder sb)
    {
        var meals = await db.MealEntries.Where(x => x.Time >= r.Start && x.Time < r.End).ToListAsync();
        var drinks = await db.DrinkEntries.Where(x => x.Time >= r.Start && x.Time < r.End).ToListAsync();
        // 14 extra days before the range so the first rows' rolling averages are full.
        var histMin = r.From?.AddDays(-14) ?? DateOnly.MinValue;
        var energy = new EnergyHistory(
            await db.DailyLogs.Where(x => x.Date >= histMin && x.Date <= r.Max).ToListAsync(),
            await db.BodyMeasurements.Where(m => m.WeightLbs != null || m.BasalMetabolicRate != null).ToListAsync(),
            await db.WorkoutSessions.Where(x => x.Date >= histMin && x.Date <= r.Max).ToListAsync(),
            DateOnly.FromDateTime(DateTime.Now));

        sb.AppendLine("Date,Day type,Meals,Meals with macros,Drinks," + MacroHeader +
                      ",Fluids (oz),Calories out,Calories out source,Net calories,Calories out 7d avg,Calories out 14d avg");
        var days = meals.Select(m => DateOnly.FromDateTime(m.Time))
            .Concat(drinks.Select(d => DateOnly.FromDateTime(d.Time))).Distinct().Order();
        foreach (var day in days)
        {
            var dm = meals.Where(m => DateOnly.FromDateTime(m.Time) == day).ToList();
            var dd = drinks.Where(d => DateOnly.FromDateTime(d.Time) == day).ToList();
            var log = energy.Log(day);
            var dayOut = energy.For(day);
            var calories = NutritionMath.Calories(dm, dd);
            sb.AppendLine(Row(day.ToString("yyyy-MM-dd"),
                log?.DayType is { } dt and not DayType.Unset ? dt : null,
                dm.Count, dm.Count(m => m.Calories is not null || m.ProteinG is not null), dd.Count,
                calories, R1(NutritionMath.Protein(dm, dd)), R1(NutritionMath.Carbs(dm, dd)), R1(NutritionMath.Fat(dm, dd)),
                R1(NutritionMath.Fiber(dm, dd)), R1(NutritionMath.Sugar(dm, dd)), R1(NutritionMath.AddedSugar(dm, dd)),
                (int)Math.Round(NutritionMath.Sodium(dm, dd)), NutritionMath.FluidOz(dd),
                dayOut?.Kcal, dayOut is null ? null : dayOut.Value.FromHealth ? "Apple Health" : "Estimate",
                dayOut is null ? null : calories - dayOut.Value.Kcal,
                energy.Average(day, 7)?.Kcal, energy.Average(day, 14)?.Kcal));
        }

        static double R1(double v) => Math.Round(v, 1);
    }

    // Shared macro columns for meals and drinks, in the same order as the row values.
    private const string MacroHeader = "Calories,Protein (g),Carbs (g),Fat (g),Fiber (g),Sugar (g),Added sugar (g),Sodium (mg)";

    private static string Row(params object?[] cells) =>
        string.Join(",", cells.Select(Csv));

    private static string Csv(object? v)
    {
        var s = v?.ToString() ?? "";
        if (s.Contains(',') || s.Contains('"') || s.Contains('\n'))
            s = "\"" + s.Replace("\"", "\"\"") + "\"";
        return s;
    }

    private async Task Run(string fileName, Func<AppDbContext, Task<string>> build)
    {
        _busy = true;
        _status = null;
        try
        {
            string content;
            await using (var db = await DbFactory.CreateDbContextAsync())
                content = await build(db);

            var path = Path.Combine(FileSystem.CacheDirectory, fileName);
            await File.WriteAllTextAsync(path, content);

            await Share.Default.RequestAsync(new ShareFileRequest
            {
                Title = "Fit Recovery Log export",
                File = new ShareFile(path)
            });
            _status = $"Exported {fileName} ({content.Length:N0} chars).";
        }
        catch (Exception ex)
        {
            _status = $"Export failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}
