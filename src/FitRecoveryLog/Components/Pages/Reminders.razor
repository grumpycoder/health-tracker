@page "/reminders"
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Reminders</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <div class="dash-date">Reminders</div>
        <div class="dash-date-sub">Injection, labs, measurements, weekly review</div>
    </header>

    @if (_permission == false)
    {
        <section class="card">
            <p class="muted">Notifications aren't allowed. Enable them for Fit Recovery Log in
            system Settings, then reopen this page.</p>
        </section>
    }

    <section class="card">
        <h2>Medication reminders</h2>
        @if (_medSchedules.Count == 0)
        {
            <p class="muted">No active medication schedules. Add them under Medication → My medications.</p>
        }
        else
        {
            <ul class="timeline">
                @foreach (var sc in _medSchedules)
                {
                    <li>
                        <div class="ex-row" style="width:100%">
                            <div>
                                <span class="entry"><strong>@sc.Name</strong>
                                    <span class="muted"> @sc.Repeat · next @ReminderNotifier.NextDue(sc).ToString("MMM d, h:mm tt")</span>
                                </span>
                            </div>
                            <button class="save-btn" style="padding:0.4rem 0.9rem" @onclick="() => LogMedClicked(sc)">Log dose</button>
                        </div>
                        @if (_logSiteFor == sc.Id)
                        {
                            <div class="chip-row" style="margin-top:0.5rem">
                                <span class="muted" style="align-self:center;font-size:0.75rem">site:</span>
                                @foreach (var site in InjectionSites)
                                {
                                    <button type="button" class="chip @(site == _suggestedSite ? "selected" : "")"
                                            @onclick="() => LogMedDose(sc, site)">@site</button>
                                }
                            </div>
                        }
                        @if (_loggedSchedId == sc.Id)
                        {
                            <p class="saved-msg" style="margin:0.4rem 0 0">Logged ✓</p>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <section class="card">
        <h2>New reminder</h2>
        <div class="field"><label>Title</label><input @bind="_new.Title" placeholder="e.g. TRT injection" /></div>
        <div class="field"><label>Notes</label><input @bind="_new.Notes" placeholder="optional" /></div>
        <div class="field"><label>When</label><input type="datetime-local" @bind="_due" /></div>
        <div class="field">
            <label>Repeat</label>
            <select @bind="_new.Repeat">
                @foreach (var r in Enum.GetValues<ReminderRepeat>())
                {
                    <option value="@r">@r</option>
                }
            </select>
        </div>
        <button class="save-btn" @onclick="Add">Add reminder</button>
    </section>

    <section class="card">
        <h2>Scheduled</h2>
        @if (_reminders.Count == 0)
        {
            <p class="muted">No reminders yet.</p>
        }
        else
        {
            <ul class="timeline">
                @foreach (var rem in _reminders)
                {
                    <li>
                        @if (_editId == rem.Id)
                        {
                            <div class="edit-exercise" style="width:100%">
                                <div class="field"><label>Title</label><input @bind="_edit.Title" /></div>
                                <div class="field"><label>Notes</label><input @bind="_edit.Notes" /></div>
                                <div class="field"><label>When</label><input type="datetime-local" @bind="_editDue" /></div>
                                <div class="field">
                                    <label>Repeat</label>
                                    <select @bind="_edit.Repeat">
                                        @foreach (var r in Enum.GetValues<ReminderRepeat>()) { <option value="@r">@r</option> }
                                    </select>
                                </div>
                                <div class="routine-actions">
                                    <button class="save-btn" @onclick="SaveEdit">Save</button>
                                    <button class="link-btn" @onclick="() => _editId = null">Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ex-row" style="width:100%">
                                <div>
                                    <span class="entry @(rem.Active ? "" : "muted")"><strong>@rem.Title</strong>
                                        <span class="muted"> · @rem.NextDue.ToString("MMM d, h:mm tt")@(rem.Repeat == ReminderRepeat.Once ? "" : $" · {rem.Repeat}")@(rem.Active ? "" : " · off")</span>
                                    </span>
                                </div>
                                <div class="routine-actions">
                                    <button class="link-btn" @onclick="() => Toggle(rem)">@(rem.Active ? "Pause" : "Resume")</button>
                                    <button class="icon-action" title="Edit" aria-label="Edit" @onclick="() => StartEdit(rem)">✏️</button>
                                    <button class="icon-action danger" title="Delete" aria-label="Delete" @onclick="() => Delete(rem)">🗑</button>
                                </div>
                            </div>
                        }
                    </li>
                }
            </ul>
        }
    </section>
</div>

@code {
    private List<Reminder> _reminders = new();
    private Reminder _new = new() { Repeat = ReminderRepeat.Weekly };
    private DateTime _due = DateTime.Now.AddHours(1);
    private bool? _permission;

    private Guid? _editId;
    private Reminder _edit = new();
    private DateTime _editDue = DateTime.Now;

    // Medication reminders (from active schedules)
    private static readonly string[] InjectionSites =
        { "Left delt", "Right delt", "Left glute", "Right glute", "Left quad", "Right quad", "Left ventroglute", "Right ventroglute" };
    private List<MedicationSchedule> _medSchedules = new();
    private List<MedicationEntry> _recentMeds = new();
    private Guid? _logSiteFor;
    private string? _suggestedSite;
    private Guid? _loggedSchedId;

    protected override async Task OnInitializedAsync()
    {
        try { _permission = await ReminderNotifier.RequestPermissionAsync(); } catch { _permission = null; }
        await Load();
        // Re-assert OS schedules for active reminders and med schedules (idempotent).
        foreach (var r in _reminders.Where(r => r.Active))
            try { await ReminderNotifier.ScheduleAsync(r); } catch { }
        foreach (var s in _medSchedules)
            try { await ReminderNotifier.ScheduleAsync(s); } catch { }
    }

    private async Task Load()
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        await using var db = await DbFactory.CreateDbContextAsync();
        _reminders = await db.Reminders.OrderBy(r => r.NextDue).ToListAsync();
        _medSchedules = await db.MedicationSchedules
            .Where(s => s.Active && (s.EndDate == null || s.EndDate >= today))
            .OrderBy(s => s.Name).ToListAsync();
        _recentMeds = await db.MedicationEntries
            .OrderByDescending(m => m.TakenAt).Take(20).ToListAsync();
    }

    private void LogMedClicked(MedicationSchedule sc)
    {
        _loggedSchedId = null;
        if (sc.IsInjection)
        {
            var last = _recentMeds.FirstOrDefault(m =>
                string.Equals(m.Name, sc.Name, StringComparison.OrdinalIgnoreCase)
                && !string.IsNullOrWhiteSpace(m.InjectionSite))?.InjectionSite;
            _suggestedSite = last switch
            {
                not null when last.Contains("Left") => last.Replace("Left", "Right"),
                not null when last.Contains("Right") => last.Replace("Right", "Left"),
                _ => InjectionSites.FirstOrDefault()
            };
            _logSiteFor = sc.Id;
        }
        else
        {
            _ = LogMedDose(sc, null);
        }
    }

    private async Task LogMedDose(MedicationSchedule sc, string? site)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.MedicationEntries.Add(new MedicationEntry
            {
                Name = sc.Name, Dose = sc.Dose, Frequency = sc.Repeat.ToString(),
                TakenAt = DateTime.Now, InjectionSite = site
            });
            await db.SaveChangesAsync();
        }
        _logSiteFor = null;
        _loggedSchedId = sc.Id;
        await Load();
    }

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(_new.Title)) return;
        _new.Title = _new.Title.Trim();
        _new.NextDue = _due;
        _new.NotificationId = Random.Shared.Next(1, int.MaxValue);
        _new.Active = true;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.Reminders.Add(_new);
            await db.SaveChangesAsync();
        }
        try { await ReminderNotifier.ScheduleAsync(_new); } catch { }

        _new = new Reminder { Repeat = ReminderRepeat.Weekly };
        _due = DateTime.Now.AddHours(1);
        await Load();
    }

    private void StartEdit(Reminder r)
    {
        _editId = r.Id;
        _edit = new Reminder { Title = r.Title, Notes = r.Notes, Repeat = r.Repeat, NotificationId = r.NotificationId, Active = r.Active };
        _editDue = r.NextDue;
    }

    private async Task SaveEdit()
    {
        if (_editId is not { } id) return;
        Reminder? saved = null;
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var e = await db.Reminders.FindAsync(id);
            if (e is not null)
            {
                e.Title = _edit.Title; e.Notes = _edit.Notes; e.Repeat = _edit.Repeat; e.NextDue = _editDue;
                await db.SaveChangesAsync();
                saved = e;
            }
        }
        if (saved is not null) try { await ReminderNotifier.ScheduleAsync(saved); } catch { }
        _editId = null;
        await Load();
    }

    private async Task Toggle(Reminder r)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var e = await db.Reminders.FindAsync(r.Id);
            if (e is not null) { e.Active = !e.Active; await db.SaveChangesAsync(); r = e; }
        }
        try { await ReminderNotifier.ScheduleAsync(r); } catch { } // cancels if now inactive
        await Load();
    }

    private async Task Delete(Reminder r)
    {
        ReminderNotifier.Cancel(r.NotificationId);
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var e = await db.Reminders.FindAsync(r.Id);
            if (e is not null) { db.Reminders.Remove(e); await db.SaveChangesAsync(); }
        }
        if (_editId == r.Id) _editId = null;
        await Load();
    }
}
