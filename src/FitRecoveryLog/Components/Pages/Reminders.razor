@page "/reminders"
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Reminders</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <div class="dash-date">Reminders</div>
        <div class="dash-date-sub">Derived from your schedules</div>
    </header>

    @if (_permission == false)
    {
        <section class="card">
            <p class="muted">Notifications aren't allowed. Enable them for Fit Recovery Log in
            system Settings, then reopen this page.</p>
        </section>
    }

    <section class="card">
        <h2>Medication doses</h2>
        @if (_medSchedules.Count == 0)
        {
            <p class="muted">@(_loggedTodayCount > 0
                ? "All doses logged for today ✓"
                : _activeSchedules.Count == 0
                    ? "No active medication schedules. Add them under Medication → My medications."
                    : "No doses due today.")</p>
        }
        else
        {
            <ul class="timeline">
                @foreach (var sc in _medSchedules)
                {
                    <li>
                        <div class="ex-row" style="width:100%">
                            <div>
                                <span class="entry"><strong>@sc.Name</strong>
                                    <span class="muted"> @sc.Repeat · @DueLabel(sc)</span>
                                </span>
                            </div>
                            <button class="save-btn" style="padding:0.4rem 0.9rem" @onclick="() => LogMedClicked(sc)">Log Dose</button>
                        </div>
                        @if (_logSiteFor == sc.Id)
                        {
                            <div class="chip-row" style="margin-top:0.5rem">
                                <span class="muted" style="align-self:center;font-size:0.75rem">site (tap to change):</span>
                                @foreach (var site in InjectionSites)
                                {
                                    <button type="button" class="chip @(site == _suggestedSite ? "selected" : "")"
                                            @onclick="() => LogMedDose(sc, site)">@site</button>
                                }
                            </div>
                        }
                    </li>
                }
            </ul>
            @if (_loggedTodayCount > 0)
            {
                <p class="muted" style="margin:0.5rem 0 0">@_loggedTodayCount logged today ✓</p>
            }
        }
    </section>

    <section class="card">
        <h2>Routine reminders</h2>
        <ul class="timeline">
            @foreach (var s in _settings)
            {
                <li>
                    <div class="ex-row" style="width:100%">
                        <div>
                            <span class="entry @(s.Active ? "" : "muted")"><strong>@Label(s.Key)</strong>
                                <span class="muted"> @s.Repeat · @s.Time.ToString("h:mm tt")@(s.Active ? $" · next {ReminderNotifier.NextDue(s):MMM d}" : " · off")</span>
                            </span>
                        </div>
                        <button class="link-btn" @onclick="() => ToggleSetting(s)">@(s.Active ? "On" : "Off")</button>
                    </div>
                    @if (s.Active)
                    {
                        <div class="inline-fields" style="margin-top:0.4rem">
                            <div class="field">
                                <label>Repeat</label>
                                <select value="@s.Repeat" @onchange="e => ChangeRepeat(s, e)">
                                    @foreach (var r in Repeats) { <option value="@r" selected="@(r == s.Repeat)">@r</option> }
                                </select>
                            </div>
                            <div class="field">
                                <label>Time</label>
                                <input type="time" value="@s.Time.ToString("HH:mm")" @onchange="e => ChangeTime(s, e)" />
                            </div>
                        </div>
                    }
                </li>
            }
        </ul>
    </section>
</div>

@code {
    private static readonly string[] InjectionSites =
        { "Left delt", "Right delt", "Left glute", "Right glute", "Left quad", "Right quad", "Left ventroglute", "Right ventroglute" };
    private static readonly ReminderRepeat[] Repeats =
        { ReminderRepeat.Daily, ReminderRepeat.Weekly, ReminderRepeat.Monthly };

    private bool? _permission;
    private List<MedicationSchedule> _activeSchedules = new(); // all active (drives OS scheduling)
    private List<MedicationSchedule> _medSchedules = new();    // due today and not yet logged
    private List<MedicationEntry> _recentMeds = new();
    private List<ReminderSetting> _settings = new();
    private Guid? _logSiteFor;
    private string? _suggestedSite;
    private int _loggedTodayCount;

    protected override async Task OnInitializedAsync()
    {
        try { _permission = await ReminderNotifier.RequestPermissionAsync(); } catch { _permission = null; }
        await Load();
        foreach (var s in _activeSchedules) try { await ReminderNotifier.ScheduleAsync(s); } catch { }
        foreach (var s in _settings) try { await ReminderNotifier.ScheduleAsync(s, Label(s.Key)); } catch { }
    }

    private async Task Load()
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        await using var db = await DbFactory.CreateDbContextAsync();
        _activeSchedules = await db.MedicationSchedules
            .Where(s => s.Active && (s.EndDate == null || s.EndDate >= today))
            .OrderBy(s => s.Name).ToListAsync();

        // Outstanding = due date reached (today or overdue) and nothing logged since.
        var lastTaken = (await db.MedicationEntries
                .GroupBy(m => m.Name)
                .Select(g => new { Name = g.Key, Last = g.Max(m => m.TakenAt) })
                .ToListAsync())
            .ToDictionary(x => x.Name, x => DateOnly.FromDateTime(x.Last), StringComparer.OrdinalIgnoreCase);
        _medSchedules = _activeSchedules
            .Where(s => ReminderNotifier.LastDue(s) is { } due
                        && (!lastTaken.TryGetValue(s.Name, out var taken) || taken < due))
            .ToList();
        _loggedTodayCount = _activeSchedules.Count(s =>
            lastTaken.TryGetValue(s.Name, out var t) && t == today);
        _recentMeds = await db.MedicationEntries.OrderByDescending(m => m.TakenAt).Take(20).ToListAsync();
        _settings = await db.ReminderSettings.ToListAsync();

        // Settings added after the original seed get created on demand.
        if (_settings.All(s => s.Key != "progressPhoto"))
        {
            var photo = new ReminderSetting { Key = "progressPhoto", Repeat = ReminderRepeat.Monthly, Time = new(9, 0), Active = false, NotificationId = 2004 };
            db.ReminderSettings.Add(photo);
            await db.SaveChangesAsync();
            _settings.Add(photo);
        }

        _settings.Sort((a, b) => Order(a.Key).CompareTo(Order(b.Key)));
    }

    /// <summary>"due today 9:00 AM", or "overdue — was due Jun 2" once the date slips.</summary>
    private static string DueLabel(MedicationSchedule sc)
    {
        var due = ReminderNotifier.LastDue(sc);
        var today = DateOnly.FromDateTime(DateTime.Now);
        return due is { } d && d < today
            ? $"overdue — was due {d:MMM d}"
            : $"due today {sc.ReminderTime.ToString("h:mm tt")}";
    }

    private static string Label(string key) => key switch
    {
        "measurement" => "Body Measurement",
        "labCheck" => "Lab Check",
        "weeklyReview" => "Weekly Review",
        "progressPhoto" => "Progress Photo",
        _ => key
    };
    private static int Order(string key) => key switch { "measurement" => 0, "progressPhoto" => 1, "labCheck" => 2, "weeklyReview" => 3, _ => 9 };

    private Task ToggleSetting(ReminderSetting s) => Update(s, x => x.Active = !x.Active);
    private Task ChangeRepeat(ReminderSetting s, ChangeEventArgs e) =>
        Enum.TryParse<ReminderRepeat>(e.Value?.ToString(), out var r) ? Update(s, x => x.Repeat = r) : Task.CompletedTask;
    private Task ChangeTime(ReminderSetting s, ChangeEventArgs e) =>
        TimeOnly.TryParse(e.Value?.ToString(), out var t) ? Update(s, x => x.Time = t) : Task.CompletedTask;

    private async Task Update(ReminderSetting s, Action<ReminderSetting> apply)
    {
        ReminderSetting? saved = null;
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var e = await db.ReminderSettings.FindAsync(s.Id);
            if (e is not null) { apply(e); await db.SaveChangesAsync(); saved = e; }
        }
        if (saved is not null) try { await ReminderNotifier.ScheduleAsync(saved, Label(saved.Key)); } catch { }
        await Load();
    }

    private Guid? _lastLoggedMedId; // the dose just logged, so a site change updates it

    private async Task LogMedClicked(MedicationSchedule sc)
    {
        _lastLoggedMedId = null;
        if (sc.Form == MedicationForm.Injection)
        {
            var last = _recentMeds.FirstOrDefault(m =>
                string.Equals(m.Name, sc.Name, StringComparison.OrdinalIgnoreCase)
                && !string.IsNullOrWhiteSpace(m.InjectionSite))?.InjectionSite;
            _suggestedSite = last switch
            {
                not null when last.Contains("Left") => last.Replace("Left", "Right"),
                not null when last.Contains("Right") => last.Replace("Right", "Left"),
                _ => InjectionSites.FirstOrDefault()
            };
            // Log it now with the suggested site; the chips stay open to change it.
            await LogMedDose(sc, _suggestedSite);
            _logSiteFor = sc.Id;
        }
        else
        {
            await LogMedDose(sc, null);
        }
    }

    private async Task LogMedDose(MedicationSchedule sc, string? site)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            // Site change on the dose we just logged updates it in place.
            if (_lastLoggedMedId is { } id && await db.MedicationEntries.FindAsync(id) is { } existing)
            {
                existing.InjectionSite = site;
                await db.SaveChangesAsync();
                _suggestedSite = site;
            }
            else
            {
                var entry = new MedicationEntry
                {
                    Name = sc.Name, Dose = sc.Dose, Frequency = sc.Repeat.ToString(),
                    TakenAt = DateTime.Now, InjectionSite = site
                };
                db.MedicationEntries.Add(entry);
                await db.SaveChangesAsync();
                _lastLoggedMedId = entry.Id;
            }
        }
        await Load();
    }
}
