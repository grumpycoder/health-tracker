@page "/measurements"
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Body Measurements</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <div class="dash-date">Body measurements</div>
        <div class="dash-date-sub">Weight, waist & more</div>
    </header>

    <section class="card">
        <h2>New entry</h2>
        <EditForm Model="_entry" OnValidSubmit="Save">
            <div class="field">
                <label>Date</label>
                <input type="date" @bind="_dateInput" />
            </div>
            <div class="field">
                <label>Weight (lbs)</label>
                <input type="number" step="0.1" @bind="_entry.WeightLbs" placeholder="e.g. 185.4" />
            </div>
            <div class="field">
                <label>Waist (in)</label>
                <input type="number" step="0.1" @bind="_entry.WaistInches" placeholder="e.g. 34.0" />
            </div>
            <div class="field">
                <label>Chest (in)</label>
                <input type="number" step="0.1" @bind="_entry.ChestInches" />
            </div>
            <div class="field">
                <label>Arms (in)</label>
                <input type="number" step="0.1" @bind="_entry.ArmsInches" />
            </div>
            <div class="field">
                <label>Thighs (in)</label>
                <input type="number" step="0.1" @bind="_entry.ThighsInches" />
            </div>
            <div class="field">
                <label>Clothing fit notes</label>
                <textarea rows="2" @bind="_entry.ClothingFitNotes"
                          placeholder="e.g. belt one notch tighter"></textarea>
            </div>
            <button class="save-btn" type="submit">Save measurement</button>
            @if (_saved)
            {
                <span class="saved-msg">Saved ✓</span>
            }
        </EditForm>
    </section>

    <section class="card">
        <h2>History</h2>
        @if (_history.Count == 0)
        {
            <p class="muted">No measurements yet.</p>
        }
        else
        {
            <ul class="timeline">
                @foreach (var m in _history)
                {
                    <li>
                        @if (_editId == m.Id)
                        {
                            <div class="edit-exercise" style="width:100%">
                                <div class="field"><label>Date</label><input type="date" @bind="_editDate" /></div>
                                <div class="inline-fields">
                                    <div class="field"><label>Weight (lbs)</label><input type="number" step="0.1" @bind="_edit.WeightLbs" /></div>
                                    <div class="field"><label>Waist (in)</label><input type="number" step="0.1" @bind="_edit.WaistInches" /></div>
                                </div>
                                <div class="inline-fields">
                                    <div class="field"><label>Chest</label><input type="number" step="0.1" @bind="_edit.ChestInches" /></div>
                                    <div class="field"><label>Arms</label><input type="number" step="0.1" @bind="_edit.ArmsInches" /></div>
                                    <div class="field"><label>Thighs</label><input type="number" step="0.1" @bind="_edit.ThighsInches" /></div>
                                </div>
                                <div class="field"><label>Clothing fit notes</label><textarea rows="2" @bind="_edit.ClothingFitNotes"></textarea></div>
                                <div class="routine-actions">
                                    <button class="save-btn" @onclick="SaveEdit">Save</button>
                                    <button class="link-btn" @onclick="() => _editId = null">Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ex-row" style="width:100%">
                                <div>
                                    <span class="time">@m.Date.ToString("MMM d")</span>
                                    <span class="entry">
                                        @(m.WeightLbs?.ToString("0.0") ?? "—") lbs
                                        @if (m.WaistInches is not null)
                                        {
                                            <span class="muted"> · waist @m.WaistInches.Value.ToString("0.0")</span>
                                        }
                                    </span>
                                </div>
                                <div class="routine-actions">
                                    <button class="link-btn" @onclick="() => StartEdit(m)">Edit</button>
                                    <button class="link-btn danger" @onclick="() => Delete(m)">Delete</button>
                                </div>
                            </div>
                        }
                    </li>
                }
            </ul>
        }
    </section>
</div>

@code {
    private BodyMeasurement _entry = new() { Date = DateOnly.FromDateTime(DateTime.Now) };
    private List<BodyMeasurement> _history = new();
    private bool _saved;

    // <input type="date"> binds to DateTime; bridge it to the entity's DateOnly.
    private DateTime _dateInput = DateTime.Now.Date;

    private Guid? _editId;
    private BodyMeasurement _edit = new();
    private DateTime _editDate = DateTime.Now.Date;

    protected override async Task OnInitializedAsync() => await LoadHistory();

    private void StartEdit(BodyMeasurement m)
    {
        _editId = m.Id;
        _edit = new BodyMeasurement
        {
            WeightLbs = m.WeightLbs, WaistInches = m.WaistInches, ChestInches = m.ChestInches,
            ArmsInches = m.ArmsInches, ThighsInches = m.ThighsInches, ClothingFitNotes = m.ClothingFitNotes
        };
        _editDate = m.Date.ToDateTime(TimeOnly.MinValue);
    }

    private async Task SaveEdit()
    {
        if (_editId is not { } id) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.BodyMeasurements.FindAsync(id);
        if (e is not null)
        {
            e.Date = DateOnly.FromDateTime(_editDate);
            e.WeightLbs = _edit.WeightLbs; e.WaistInches = _edit.WaistInches; e.ChestInches = _edit.ChestInches;
            e.ArmsInches = _edit.ArmsInches; e.ThighsInches = _edit.ThighsInches; e.ClothingFitNotes = _edit.ClothingFitNotes;
            await db.SaveChangesAsync();
        }
        _editId = null;
        await LoadHistory();
    }

    private async Task Delete(BodyMeasurement m)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.BodyMeasurements.FindAsync(m.Id);
        if (e is not null) { db.BodyMeasurements.Remove(e); await db.SaveChangesAsync(); }
        if (_editId == m.Id) _editId = null;
        await LoadHistory();
    }

    private async Task LoadHistory()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _history = await db.BodyMeasurements
            .OrderByDescending(x => x.Date)
            .Take(20)
            .ToListAsync();
    }

    private async Task Save()
    {
        _entry.Date = DateOnly.FromDateTime(_dateInput);
        await using var db = await DbFactory.CreateDbContextAsync();
        db.BodyMeasurements.Add(_entry);
        await db.SaveChangesAsync();

        _saved = true;
        _entry = new BodyMeasurement { Date = DateOnly.FromDateTime(_dateInput) };
        await LoadHistory();
    }
}
