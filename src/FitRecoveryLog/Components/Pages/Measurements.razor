@page "/measurements"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IHealthService Health

<PageTitle>Body Measurements</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <div class="dash-date">Body Measurements</div>
        <div class="dash-date-sub">Weight, waist & more</div>
    </header>

    <section class="card">
        <h2>New entry</h2>
        <EditForm Model="_entry" OnValidSubmit="Save">
            <div class="field">
                <label>Date</label>
                <input type="date" @bind="_dateInput" />
            </div>
            <div class="field">
                <label>Weight (lbs)</label>
                <input type="number" inputmode="decimal" step="0.1" @bind="_entry.WeightLbs" placeholder="e.g. 185.4" />
            </div>
            <div class="field">
                <label>Waist (in)</label>
                <input type="number" inputmode="decimal" step="0.1" @bind="_entry.WaistInches" placeholder="e.g. 34.0" />
            </div>
            <div class="field">
                <label>Chest (in)</label>
                <input type="number" inputmode="decimal" step="0.1" @bind="_entry.ChestInches" />
            </div>
            <div class="field">
                <label>Arms (in)</label>
                <input type="number" inputmode="decimal" step="0.1" @bind="_entry.ArmsInches" />
            </div>
            <div class="field">
                <label>Thighs (in)</label>
                <input type="number" inputmode="decimal" step="0.1" @bind="_entry.ThighsInches" />
            </div>
            <div class="field">
                <label>Clothing fit notes</label>
                <textarea rows="2" @bind="_entry.ClothingFitNotes"
                          placeholder="e.g. belt one notch tighter"></textarea>
            </div>
            <button class="save-btn" type="submit">Save Measurement</button>
            @if (_saved)
            {
                <span class="saved-msg">Saved ✓</span>
            }
            @if (_warn is not null)
            {
                <span class="warn-msg">@_warn</span>
            }
        </EditForm>
    </section>

    @if (Health.IsAvailable)
    {
        <section class="card">
            <button class="quick-btn wide" @onclick="PullFromHealth">
                <span class="quick-emoji">❤️</span> Pull Weight from Apple Health
            </button>
            @if (_pullMsg is not null)
            {
                <p class="muted" style="margin:0.5rem 0 0">@_pullMsg</p>
            }
        </section>
    }

    <section class="card">
        <h2>Progress Photos</h2>
        <div class="routine-actions" style="margin-bottom:0.6rem">
            @if (_captureSupported)
            {
                <button class="save-btn" @onclick="() => AddPhoto(true)">📷 Take Photo</button>
            }
            <button class="save-btn" @onclick="() => AddPhoto(false)">🖼 Choose Photo</button>
        </div>
        @if (_photoMsg is not null)
        {
            <p class="muted" style="margin:0 0 0.5rem">@_photoMsg</p>
        }
        @if (_viewPhoto is not null)
        {
            <img src="@PhotoDataUrl(_viewPhoto.PhotoPath)" style="width:100%;border-radius:12px;margin-bottom:0.4rem" />
            <div class="routine-actions" style="margin-bottom:0.6rem">
                <span class="muted" style="align-self:center">@_viewPhoto.Date.ToString("MMM d, yyyy")</span>
                <button class="link-btn danger" @onclick="() => DeletePhoto(_viewPhoto)">Delete Photo</button>
                <button class="link-btn" @onclick="() => _viewPhoto = null">Close</button>
            </div>
        }
        @if (_photos.Count == 0)
        {
            <p class="muted">No photos yet. One photo is kept per day.</p>
        }
        else
        {
            <div class="photo-grid">
                @foreach (var p in _photos)
                {
                    <div class="photo-cell" @onclick="() => _viewPhoto = p">
                        <img src="@PhotoDataUrl(p.PhotoPath)" />
                        <span class="photo-date">@p.Date.ToString("MMM d")</span>
                    </div>
                }
            </div>
        }
    </section>

    <section class="card">
        <h2>History</h2>
        @if (_history.Count == 0)
        {
            <p class="muted">No measurements yet.</p>
        }
        else
        {
            <ul class="timeline">
                @foreach (var m in _history)
                {
                    <li>
                        @if (_editId == m.Id)
                        {
                            <div class="edit-exercise" style="width:100%">
                                <div class="field"><label>Date</label><input type="date" @bind="_editDate" /></div>
                                <div class="inline-fields">
                                    <div class="field"><label>Weight (lbs)</label><input type="number" inputmode="decimal" step="0.1" @bind="_edit.WeightLbs" /></div>
                                    <div class="field"><label>Waist (in)</label><input type="number" inputmode="decimal" step="0.1" @bind="_edit.WaistInches" /></div>
                                </div>
                                <div class="inline-fields">
                                    <div class="field"><label>Chest</label><input type="number" inputmode="decimal" step="0.1" @bind="_edit.ChestInches" /></div>
                                    <div class="field"><label>Arms</label><input type="number" inputmode="decimal" step="0.1" @bind="_edit.ArmsInches" /></div>
                                    <div class="field"><label>Thighs</label><input type="number" inputmode="decimal" step="0.1" @bind="_edit.ThighsInches" /></div>
                                </div>
                                <div class="field"><label>Clothing fit notes</label><textarea rows="2" @bind="_edit.ClothingFitNotes"></textarea></div>
                                <div class="routine-actions">
                                    <button class="save-btn" @onclick="SaveEdit">Save</button>
                                    <button class="link-btn" @onclick="() => _editId = null">Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ex-row" style="width:100%">
                                <div>
                                    <span class="time">@m.Date.ToString("MMM d")</span>
                                    <span class="entry">
                                        @(m.WeightLbs?.ToString("0.0") ?? "—") lbs
                                        @if (m.WaistInches is not null)
                                        {
                                            <span class="muted"> · waist @m.WaistInches.Value.ToString("0.0")</span>
                                        }
                                    </span>
                                </div>
                                <div class="routine-actions">
                                    <button class="icon-action" title="Edit" aria-label="Edit" @onclick="() => StartEdit(m)">✏️</button>
                                    <button class="icon-action danger" title="Delete" aria-label="Delete" @onclick="() => Delete(m)">🗑</button>
                                </div>
                            </div>
                        }
                    </li>
                }
            </ul>
        }
    </section>
</div>

@code {
    private BodyMeasurement _entry = new() { Date = DateOnly.FromDateTime(DateTime.Now) };
    private List<BodyMeasurement> _history = new();
    private bool _saved;
    private string? _warn;

    // <input type="date"> binds to DateTime; bridge it to the entity's DateOnly.
    private DateTime _dateInput = DateTime.Now.Date;

    private Guid? _editId;
    private BodyMeasurement _edit = new();
    private DateTime _editDate = DateTime.Now.Date;
    private string? _pullMsg;

    // Progress photos: one per day, stored downscaled under AppData/photos.
    // PhotoPath holds the FILE NAME only — the iOS container path changes
    // between reinstalls, so absolute paths would break.
    private List<BodyMeasurement> _photos = new();
    private BodyMeasurement? _viewPhoto;
    private string? _photoMsg;
    private bool _captureSupported;

    private static string PhotosDir => Path.Combine(Microsoft.Maui.Storage.FileSystem.AppDataDirectory, "photos");

    private static string? PhotoDataUrl(string? name)
    {
        if (string.IsNullOrEmpty(name)) return null;
        var path = Path.Combine(PhotosDir, name);
        if (!File.Exists(path)) return null;
        return $"data:image/jpeg;base64,{Convert.ToBase64String(File.ReadAllBytes(path))}";
    }

    private async Task AddPhoto(bool camera)
    {
        _photoMsg = null;
        try
        {
            var picked = camera
                ? await Microsoft.Maui.Media.MediaPicker.Default.CapturePhotoAsync()
                : await Microsoft.Maui.Media.MediaPicker.Default.PickPhotoAsync();
            if (picked is null) return; // cancelled

            Directory.CreateDirectory(PhotosDir);
            var name = $"{Guid.NewGuid():N}.jpg";
            using (var src = await picked.OpenReadAsync())
            {
                var img = Microsoft.Maui.Graphics.Platform.PlatformImage.FromStream(src);
                using var resized = img.Downsize(1280, disposeOriginal: true);
                var bytes = resized.AsBytes(Microsoft.Maui.Graphics.ImageFormat.Jpeg, quality: 0.8f);
                await File.WriteAllBytesAsync(Path.Combine(PhotosDir, name), bytes);
            }

            var today = DateOnly.FromDateTime(DateTime.Now);
            await using var db = await DbFactory.CreateDbContextAsync();
            var m = await db.BodyMeasurements.FirstOrDefaultAsync(x => x.Date == today);
            if (m is null)
            {
                db.BodyMeasurements.Add(new BodyMeasurement { Date = today, PhotoPath = name });
            }
            else
            {
                // One photo per day — replace and remove the old file.
                if (m.PhotoPath is { } old)
                {
                    var oldPath = Path.Combine(PhotosDir, old);
                    if (File.Exists(oldPath)) File.Delete(oldPath);
                }
                m.PhotoPath = name;
            }
            await db.SaveChangesAsync();
            _photoMsg = "Photo saved ✓";
            await LoadHistory();
        }
        catch (Exception ex)
        {
            _photoMsg = $"Photo failed: {ex.Message}";
        }
    }

    private async Task DeletePhoto(BodyMeasurement p)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.BodyMeasurements.FindAsync(p.Id);
        if (e?.PhotoPath is { } name)
        {
            var path = Path.Combine(PhotosDir, name);
            if (File.Exists(path)) File.Delete(path);
            e.PhotoPath = null;
            await db.SaveChangesAsync();
        }
        _viewPhoto = null;
        await LoadHistory();
    }

    protected override async Task OnInitializedAsync()
    {
        try { _captureSupported = Microsoft.Maui.Media.MediaPicker.Default.IsCaptureSupported; } catch { }
        if (Health.IsAvailable) { try { await Health.RequestAuthorizationAsync(); } catch { } }
        await LoadHistory();
    }

    private async Task PullFromHealth()
    {
        _pullMsg = null;
        var weights = await Health.ReadWeightsAsync(DateTime.Now.AddDays(-365));
        if (weights.Count == 0) { _pullMsg = "No weights found in Health (or access denied)."; return; }

        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = (await db.BodyMeasurements.Select(m => m.Date).ToListAsync()).ToHashSet();
        // One import per date, only for dates we don't already have.
        var added = 0;
        foreach (var (date, lbs) in weights.GroupBy(w => w.Date).Select(g => g.First()))
        {
            if (existing.Contains(date)) continue;
            db.BodyMeasurements.Add(new BodyMeasurement { Date = date, WeightLbs = Math.Round(lbs, 1) });
            existing.Add(date);
            added++;
        }
        if (added > 0) await db.SaveChangesAsync();
        _pullMsg = added > 0 ? $"Imported {added} weight(s) from Health." : "Already up to date with Health.";
        await LoadHistory();
    }

    private void StartEdit(BodyMeasurement m)
    {
        _editId = m.Id;
        _edit = new BodyMeasurement
        {
            WeightLbs = m.WeightLbs, WaistInches = m.WaistInches, ChestInches = m.ChestInches,
            ArmsInches = m.ArmsInches, ThighsInches = m.ThighsInches, ClothingFitNotes = m.ClothingFitNotes
        };
        _editDate = m.Date.ToDateTime(TimeOnly.MinValue);
    }

    private async Task SaveEdit()
    {
        if (_editId is not { } id) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.BodyMeasurements.FindAsync(id);
        if (e is not null)
        {
            e.Date = DateOnly.FromDateTime(_editDate);
            e.WeightLbs = _edit.WeightLbs; e.WaistInches = _edit.WaistInches; e.ChestInches = _edit.ChestInches;
            e.ArmsInches = _edit.ArmsInches; e.ThighsInches = _edit.ThighsInches; e.ClothingFitNotes = _edit.ClothingFitNotes;
            await db.SaveChangesAsync();
        }
        _editId = null;
        await LoadHistory();
    }

    private async Task Delete(BodyMeasurement m)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.BodyMeasurements.FindAsync(m.Id);
        if (e is not null) { db.BodyMeasurements.Remove(e); await db.SaveChangesAsync(); }
        if (_editId == m.Id) _editId = null;
        await LoadHistory();
    }

    private async Task LoadHistory()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _history = await db.BodyMeasurements
            .OrderByDescending(x => x.Date)
            .Take(20)
            .ToListAsync();
        _photos = await db.BodyMeasurements
            .Where(x => x.PhotoPath != null)
            .OrderByDescending(x => x.Date)
            .Take(12)
            .ToListAsync();
    }

    private async Task Save()
    {
        if (_entry.WeightLbs is null && _entry.WaistInches is null && _entry.ChestInches is null
            && _entry.ArmsInches is null && _entry.ThighsInches is null
            && string.IsNullOrWhiteSpace(_entry.ClothingFitNotes))
        {
            _warn = "Enter at least one measurement.";
            _saved = false;
            return;
        }
        _warn = null;
        _entry.Date = DateOnly.FromDateTime(_dateInput);
        var entry = _entry;
        await using var db = await DbFactory.CreateDbContextAsync();
        db.BodyMeasurements.Add(entry);
        await db.SaveChangesAsync();

        // Mirror weight to Apple Health (iOS only; no-op otherwise).
        if (Health.IsAvailable && entry.WeightLbs is { } lbs)
        {
            try { await Health.WriteWeightAsync(entry.Date, lbs, entry.Id); } catch { }
        }

        _saved = true;
        _entry = new BodyMeasurement { Date = DateOnly.FromDateTime(_dateInput) };
        await LoadHistory();
    }
}
