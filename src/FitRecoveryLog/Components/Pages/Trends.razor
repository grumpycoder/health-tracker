@page "/trends"
@using FitRecoveryLog.Services
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IHealthService Health

<PageTitle>Trends</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <div class="dash-date">Trends</div>
        <div class="dash-date-sub">How things are changing over time</div>
    </header>

    @if (_bodyStatus is not null)
    {
        <section class="card">
            <span class="badge @(_bodyStatus == "on-track" ? "good" : _bodyStatus == "off-track" ? "warn" : "")">
                @(_bodyStatus == "on-track" ? "✓ On Track" : _bodyStatus == "off-track" ? "✗ Off Track" : "? Unclear")
            </span>
            @if (_bodyNote is not null)
            {
                <span style="margin-left:0.5rem">@_bodyNote</span>
            }
            <p class="muted" style="margin:0.3rem 0 0;font-size:0.75rem">From your AI analysis</p>
        </section>
    }

    @if (!_loaded)
    {
        <section class="card"><p class="muted">Loading…</p></section>
    }
    else if (_empty)
    {
        <section class="card">
            <p class="muted">No data yet. Log some measurements, sleep, workouts, or drinks
            and your trends will show up here.</p>
        </section>
    }
    else
    {
        <section class="card"><LineChart Title="Weight" Unit=" lbs" Points="_weight" /></section>
        <section class="card"><LineChart Title="Waist" Unit=" in" Points="_waist" /></section>
        <section class="card"><LineChart Title="Sleep score" Points="_sleep" ValueFormat="0" /></section>
        <section class="card"><LineChart Title="Workout duration" Unit=" min" Points="_workoutMin" ValueFormat="0" /></section>
        @if (_steps.Count >= 2)
        {
            <section class="card"><LineChart Title="Steps (Apple Health)" Points="_steps" ValueFormat="0" /></section>
        }

        @if (_drinks.Count > 0)
        {
            <div class="section-label">Drinks per day (oz)</div>
            @foreach (var series in _drinks)
            {
                <section class="card"><LineChart Title="@series.Name" Unit=" oz" Points="series.Points" ValueFormat="0" /></section>
            }
        }
    }
</div>

@code {
    private bool _loaded;
    private bool _empty;

    private List<(DateOnly Date, double Value)> _weight = new();
    private List<(DateOnly Date, double Value)> _waist = new();
    private List<(DateOnly Date, double Value)> _sleep = new();
    private List<(DateOnly Date, double Value)> _workoutMin = new();
    private List<(DateOnly Date, double Value)> _steps = new();
    private List<(string Name, List<(DateOnly Date, double Value)> Points)> _drinks = new();

    // Body-trend verdict from the latest AI analysis (null until one is run).
    private string? _bodyStatus, _bodyNote;

    protected override async Task OnInitializedAsync()
    {
        (_bodyStatus, _bodyNote) = AiAdviceStore.LoadBodyTrend();
        await using var db = await DbFactory.CreateDbContextAsync();

        // Project to anonymous types server-side (translation-safe), map to tuples in memory.
        _weight = (await db.BodyMeasurements
            .Where(m => m.WeightLbs != null).OrderBy(m => m.Date)
            .Select(m => new { m.Date, V = m.WeightLbs!.Value }).ToListAsync())
            .Select(x => (x.Date, x.V)).ToList();

        _waist = (await db.BodyMeasurements
            .Where(m => m.WaistInches != null).OrderBy(m => m.Date)
            .Select(m => new { m.Date, V = m.WaistInches!.Value }).ToListAsync())
            .Select(x => (x.Date, x.V)).ToList();

        _sleep = (await db.SleepEntries
            .Where(s => s.SleepScore != null).OrderBy(s => s.Date)
            .Select(s => new { s.Date, V = (double)s.SleepScore!.Value }).ToListAsync())
            .Select(x => (x.Date, x.V)).ToList();

        _workoutMin = (await db.WorkoutSessions
            .Where(w => w.TotalSeconds != null).OrderBy(w => w.Date)
            .Select(w => new { w.Date, V = w.TotalSeconds!.Value / 60.0 }).ToListAsync())
            .Select(x => (x.Date, x.V)).ToList();

        // Drinks by type: one series per drink name, summed ounces per day.
        var drinks = await db.DrinkEntries
            .Where(d => d.Ounces != null)
            .Select(d => new { d.Time, d.Description, Oz = d.Ounces!.Value })
            .ToListAsync();
        _drinks = drinks
            .GroupBy(d => d.Description.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => (
                Name: g.First().Description.Trim(),
                Points: g.GroupBy(x => DateOnly.FromDateTime(x.Time.Date))
                         .Select(day => (day.Key, day.Sum(x => x.Oz)))
                         .OrderBy(p => p.Item1)
                         .ToList()))
            .Where(s => s.Points.Count >= 2)              // need 2+ days to chart
            .OrderByDescending(s => s.Points.Sum(p => p.Item2))
            .ToList();

        // Steps from Apple Health (iOS only) — last 14 days, read per day.
        if (Health.IsAvailable)
        {
            try
            {
                await Health.RequestAuthorizationAsync();
                var today = DateOnly.FromDateTime(DateTime.Now);
                var pts = new List<(DateOnly Date, double Value)>();
                for (var i = 13; i >= 0; i--)
                {
                    var d = today.AddDays(-i);
                    var s = await Health.ReadStepsAsync(d);
                    if (s is > 0) pts.Add((d, s.Value));
                }
                _steps = pts;
            }
            catch { }
        }

        _empty = _weight.Count == 0 && _waist.Count == 0 && _sleep.Count == 0
                 && _workoutMin.Count == 0 && _drinks.Count == 0 && _steps.Count == 0;
        _loaded = true;
    }
}
