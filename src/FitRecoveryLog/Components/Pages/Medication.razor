@page "/medication"
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Medication & Labs</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <div class="dash-date">Medication & labs</div>
        <div class="dash-date-sub">@DateTime.Now.ToString("dddd, MMM d")</div>
    </header>

    <section class="card">
        <h2>My medications</h2>
        @if (_schedules.Count == 0)
        {
            <p class="muted">No saved medications yet. Add one below to log it with one tap.</p>
        }
        else
        {
            <ul class="timeline">
                @foreach (var sc in _schedules)
                {
                    <li>
                        @if (_editSchedId == sc.Id)
                        {
                            <div class="edit-exercise" style="width:100%">
                                <div class="field"><label>Name</label><input @bind="_schedEdit.Name" /></div>
                                <div class="inline-fields">
                                    <div class="field"><label>Dose</label><input @bind="_schedEdit.Dose" /></div>
                                    <div class="field"><label>Frequency</label><input @bind="_schedEdit.Frequency" /></div>
                                </div>
                                <div class="chip-row">
                                    <button type="button" class="chip @(_schedEdit.IsInjection ? "selected" : "")"
                                            @onclick="() => _schedEdit.IsInjection = !_schedEdit.IsInjection">Injection</button>
                                </div>
                                <div class="routine-actions">
                                    <button class="save-btn" @onclick="SaveSchedEdit">Save</button>
                                    <button class="link-btn" @onclick="() => _editSchedId = null">Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ex-row" style="width:100%">
                                <div>
                                    <span class="entry"><strong>@sc.Name</strong>
                                        <span class="muted"> @sc.Dose@(string.IsNullOrWhiteSpace(sc.Frequency) ? "" : $" · {sc.Frequency}")</span>
                                    </span>
                                </div>
                                <div class="routine-actions">
                                    <button class="save-btn" style="padding:0.4rem 0.9rem" @onclick="() => LogClicked(sc)">Log now</button>
                                    <button class="icon-action" title="Edit" aria-label="Edit" @onclick="() => StartEditSched(sc)">✏️</button>
                                    <button class="icon-action danger" title="Remove" aria-label="Remove" @onclick="() => DeleteSched(sc)">🗑</button>
                                </div>
                            </div>
                            @if (_logSiteFor == sc.Id)
                            {
                                <div class="chip-row" style="margin-top:0.5rem">
                                    <span class="muted" style="align-self:center;font-size:0.75rem">site:</span>
                                    @foreach (var site in InjectionSites)
                                    {
                                        <button type="button" class="chip @(site == _suggestedSite ? "selected" : "")"
                                                @onclick="() => LogSchedule(sc, site)">@site</button>
                                    }
                                </div>
                            }
                            @if (_loggedSchedId == sc.Id)
                            {
                                <p class="saved-msg" style="margin:0.4rem 0 0">Logged ✓</p>
                            }
                        }
                    </li>
                }
            </ul>
        }

        <div class="add-exercise">
            <div class="field"><label>Add a saved medication</label><input @bind="_newSched.Name" placeholder="e.g. Testosterone Cypionate" /></div>
            <div class="inline-fields">
                <div class="field"><label>Dose</label><input @bind="_newSched.Dose" placeholder="100mg / 0.5mL" /></div>
                <div class="field"><label>Frequency</label><input @bind="_newSched.Frequency" placeholder="weekly" /></div>
            </div>
            <div class="chip-row">
                <button type="button" class="chip @(_newSched.IsInjection ? "selected" : "")"
                        @onclick="() => _newSched.IsInjection = !_newSched.IsInjection">Injection</button>
            </div>
            <button class="save-btn" @onclick="AddSched">Add medication</button>
        </div>
    </section>

    <section class="card">
        <h2>Log a one-off / new med</h2>
        <div class="field">
            <label>Medication</label>
            <input @bind="_med.Name" placeholder="e.g. Testosterone Cypionate" list="commonMeds" />
            <datalist id="commonMeds">
                @foreach (var m in CommonMeds)
                {
                    <option value="@m" />
                }
            </datalist>
        </div>
        <div class="field">
            <label>Dose</label>
            <input @bind="_med.Dose" placeholder="e.g. 100mg / 0.5mL" />
        </div>
        <div class="field">
            <label>Frequency</label>
            <input @bind="_med.Frequency" placeholder="e.g. weekly" />
        </div>
        <div class="field">
            <label>Date / time taken</label>
            <input type="datetime-local" @bind="_takenAt" />
        </div>
        <div class="field">
            <label>Injection site (if applicable)</label>
            <select @bind="_med.InjectionSite">
                <option value="">— none —</option>
                @foreach (var s in InjectionSites)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Reaction / soreness notes</label>
            <textarea rows="2" @bind="_med.ReactionNotes"></textarea>
        </div>
        <button class="save-btn" @onclick="SaveMed">Save medication</button>
        @if (_medSaved)
        {
            <span class="saved-msg">Saved ✓</span>
        }
    </section>

    <section class="card">
        <h2>Log lab result</h2>
        <div class="field">
            <label>Date</label>
            <input type="date" @bind="_labDate" />
        </div>
        <div class="field">
            <label>Lab</label>
            <input @bind="_lab.LabName" placeholder="e.g. Total Testosterone" list="commonLabs" />
            <datalist id="commonLabs">
                @foreach (var l in CommonLabs)
                {
                    <option value="@l" />
                }
            </datalist>
        </div>
        <div class="field">
            <label>Value</label>
            <input type="number" step="0.01" @bind="_lab.Value" />
        </div>
        <div class="field">
            <label>Unit</label>
            <input @bind="_lab.Unit" placeholder="e.g. ng/dL, %" list="commonUnits" />
            <datalist id="commonUnits">
                <option value="ng/dL" /><option value="pg/mL" /><option value="%" />
                <option value="g/dL" /><option value="mg/dL" />
            </datalist>
        </div>
        <button class="save-btn" @onclick="SaveLab">Save lab</button>
        @if (_labSaved)
        {
            <span class="saved-msg">Saved ✓</span>
        }
    </section>

    <section class="card">
        <h2>Recent medications</h2>
        @if (_recentMeds.Count == 0)
        {
            <p class="muted">No medications logged yet.</p>
        }
        else
        {
            <ul class="timeline">
                @foreach (var m in _recentMeds)
                {
                    <li>
                        @if (_editMedId == m.Id)
                        {
                            <div class="edit-exercise" style="width:100%">
                                <div class="field"><label>Medication</label><input @bind="_medEdit.Name" /></div>
                                <div class="field"><label>Dose</label><input @bind="_medEdit.Dose" /></div>
                                <div class="field"><label>Frequency</label><input @bind="_medEdit.Frequency" /></div>
                                <div class="field"><label>Date / time taken</label><input type="datetime-local" @bind="_medEditTakenAt" /></div>
                                <div class="field">
                                    <label>Injection site</label>
                                    <select @bind="_medEdit.InjectionSite">
                                        <option value="">— none —</option>
                                        @foreach (var s in InjectionSites) { <option value="@s">@s</option> }
                                    </select>
                                </div>
                                <div class="field"><label>Reaction / notes</label><textarea rows="2" @bind="_medEdit.ReactionNotes"></textarea></div>
                                <div class="routine-actions">
                                    <button class="save-btn" @onclick="SaveMedEdit">Save</button>
                                    <button class="link-btn" @onclick="() => _editMedId = null">Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ex-row" style="width:100%">
                                <div>
                                    <span class="time">@m.TakenAt.ToString("MMM d, h:mm tt")</span>
                                    <span class="entry"><strong>@m.Name</strong> @m.Dose
                                        @if (!string.IsNullOrWhiteSpace(m.InjectionSite))
                                        {
                                            <span class="muted"> @@ @m.InjectionSite</span>
                                        }
                                    </span>
                                </div>
                                <div class="routine-actions">
                                    <button class="icon-action" title="Edit" aria-label="Edit" @onclick="() => StartEditMed(m)">✏️</button>
                                    <button class="icon-action danger" title="Delete" aria-label="Delete" @onclick="() => DeleteMed(m)">🗑</button>
                                </div>
                            </div>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <section class="card">
        <h2>Recent labs</h2>
        @if (_recentLabs.Count == 0)
        {
            <p class="muted">No labs logged yet.</p>
        }
        else
        {
            <ul class="timeline">
                @foreach (var l in _recentLabs)
                {
                    <li>
                        @if (_editLabId == l.Id)
                        {
                            <div class="edit-exercise" style="width:100%">
                                <div class="field"><label>Date</label><input type="date" @bind="_labEditDate" /></div>
                                <div class="field"><label>Lab</label><input @bind="_labEdit.LabName" /></div>
                                <div class="inline-fields">
                                    <div class="field"><label>Value</label><input type="number" step="0.01" @bind="_labEdit.Value" /></div>
                                    <div class="field"><label>Unit</label><input @bind="_labEdit.Unit" /></div>
                                </div>
                                <div class="routine-actions">
                                    <button class="save-btn" @onclick="SaveLabEdit">Save</button>
                                    <button class="link-btn" @onclick="() => _editLabId = null">Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ex-row" style="width:100%">
                                <div>
                                    <span class="time">@l.Date.ToString("MMM d")</span>
                                    <span class="entry"><strong>@l.LabName</strong> @(l.Value?.ToString("0.##")) @l.Unit</span>
                                </div>
                                <div class="routine-actions">
                                    <button class="icon-action" title="Edit" aria-label="Edit" @onclick="() => StartEditLab(l)">✏️</button>
                                    <button class="icon-action danger" title="Delete" aria-label="Delete" @onclick="() => DeleteLab(l)">🗑</button>
                                </div>
                            </div>
                        }
                    </li>
                }
            </ul>
        }
    </section>
</div>

@code {
    private static readonly string[] CommonMeds =
        { "Testosterone Cypionate", "Vitamin D", "Fish oil" };
    private static readonly string[] InjectionSites =
        { "Left delt", "Right delt", "Left glute", "Right glute", "Left quad", "Right quad", "Left ventroglute", "Right ventroglute" };
    private static readonly string[] CommonLabs =
        { "Total Testosterone", "Free Testosterone", "Hematocrit", "Hemoglobin", "PSA", "A1C", "Lipids - Total", "Lipids - LDL", "Lipids - HDL" };

    private MedicationEntry _med = new();
    private LabResult _lab = new();
    private DateTime _takenAt = DateTime.Now;
    private DateTime _labDate = DateTime.Now.Date;
    private bool _medSaved, _labSaved;

    private List<MedicationEntry> _recentMeds = new();
    private List<LabResult> _recentLabs = new();

    // Saved medications (schedules) for one-tap logging
    private List<MedicationSchedule> _schedules = new();
    private MedicationSchedule _newSched = new();
    private Guid? _editSchedId;
    private MedicationSchedule _schedEdit = new();
    private Guid? _logSiteFor;     // schedule awaiting a site pick (injections)
    private string? _suggestedSite;
    private Guid? _loggedSchedId;  // shows a transient "Logged ✓"

    // Inline edit state
    private Guid? _editMedId;
    private MedicationEntry _medEdit = new();
    private DateTime _medEditTakenAt = DateTime.Now;
    private Guid? _editLabId;
    private LabResult _labEdit = new();
    private DateTime _labEditDate = DateTime.Now.Date;

    protected override async Task OnInitializedAsync() => await LoadRecent();

    private void StartEditMed(MedicationEntry m)
    {
        _editLabId = null;
        _editMedId = m.Id;
        _medEdit = new MedicationEntry { Name = m.Name, Dose = m.Dose, Frequency = m.Frequency, InjectionSite = m.InjectionSite, ReactionNotes = m.ReactionNotes };
        _medEditTakenAt = m.TakenAt;
    }

    private async Task SaveMedEdit()
    {
        if (_editMedId is not { } id) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.MedicationEntries.FindAsync(id);
        if (e is not null)
        {
            e.Name = _medEdit.Name; e.Dose = _medEdit.Dose; e.Frequency = _medEdit.Frequency;
            e.TakenAt = _medEditTakenAt; e.InjectionSite = _medEdit.InjectionSite; e.ReactionNotes = _medEdit.ReactionNotes;
            await db.SaveChangesAsync();
        }
        _editMedId = null;
        await LoadRecent();
    }

    private async Task DeleteMed(MedicationEntry m)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.MedicationEntries.FindAsync(m.Id);
        if (e is not null) { db.MedicationEntries.Remove(e); await db.SaveChangesAsync(); }
        if (_editMedId == m.Id) _editMedId = null;
        await LoadRecent();
    }

    private void StartEditLab(LabResult l)
    {
        _editMedId = null;
        _editLabId = l.Id;
        _labEdit = new LabResult { LabName = l.LabName, Value = l.Value, Unit = l.Unit };
        _labEditDate = l.Date.ToDateTime(TimeOnly.MinValue);
    }

    private async Task SaveLabEdit()
    {
        if (_editLabId is not { } id) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.LabResults.FindAsync(id);
        if (e is not null)
        {
            e.LabName = _labEdit.LabName; e.Value = _labEdit.Value; e.Unit = _labEdit.Unit;
            e.Date = DateOnly.FromDateTime(_labEditDate);
            await db.SaveChangesAsync();
        }
        _editLabId = null;
        await LoadRecent();
    }

    private async Task DeleteLab(LabResult l)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.LabResults.FindAsync(l.Id);
        if (e is not null) { db.LabResults.Remove(e); await db.SaveChangesAsync(); }
        if (_editLabId == l.Id) _editLabId = null;
        await LoadRecent();
    }

    private async Task SaveMed()
    {
        _med.TakenAt = _takenAt;
        await using var db = await DbFactory.CreateDbContextAsync();
        db.MedicationEntries.Add(_med);
        await db.SaveChangesAsync();

        _medSaved = true;
        _med = new MedicationEntry();
        _takenAt = DateTime.Now;
        await LoadRecent();
    }

    private async Task SaveLab()
    {
        _lab.Date = DateOnly.FromDateTime(_labDate);
        await using var db = await DbFactory.CreateDbContextAsync();
        db.LabResults.Add(_lab);
        await db.SaveChangesAsync();

        _labSaved = true;
        _lab = new LabResult();
        await LoadRecent();
    }

    private async Task LoadRecent()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _schedules = await db.MedicationSchedules.Where(s => s.Active)
            .OrderBy(s => s.Name).ToListAsync();
        _recentMeds = await db.MedicationEntries
            .OrderByDescending(m => m.TakenAt).Take(10).ToListAsync();
        _recentLabs = await db.LabResults
            .OrderByDescending(l => l.Date).Take(10).ToListAsync();
    }

    private async Task AddSched()
    {
        if (string.IsNullOrWhiteSpace(_newSched.Name)) return;
        _newSched.Name = _newSched.Name.Trim();
        await using var db = await DbFactory.CreateDbContextAsync();
        db.MedicationSchedules.Add(_newSched);
        await db.SaveChangesAsync();
        _newSched = new MedicationSchedule();
        await LoadRecent();
    }

    private void StartEditSched(MedicationSchedule sc)
    {
        _editSchedId = sc.Id;
        _schedEdit = new MedicationSchedule { Name = sc.Name, Dose = sc.Dose, Frequency = sc.Frequency, IsInjection = sc.IsInjection };
    }

    private async Task SaveSchedEdit()
    {
        if (_editSchedId is not { } id) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.MedicationSchedules.FindAsync(id);
        if (e is not null)
        {
            e.Name = _schedEdit.Name; e.Dose = _schedEdit.Dose;
            e.Frequency = _schedEdit.Frequency; e.IsInjection = _schedEdit.IsInjection;
            await db.SaveChangesAsync();
        }
        _editSchedId = null;
        await LoadRecent();
    }

    private async Task DeleteSched(MedicationSchedule sc)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.MedicationSchedules.FindAsync(sc.Id);
        if (e is not null) { db.MedicationSchedules.Remove(e); await db.SaveChangesAsync(); }
        if (_editSchedId == sc.Id) _editSchedId = null;
        await LoadRecent();
    }

    private void LogClicked(MedicationSchedule sc)
    {
        _loggedSchedId = null;
        if (sc.IsInjection)
        {
            // Suggest the mirror of the last site used for this medication.
            var last = _recentMeds.FirstOrDefault(m =>
                string.Equals(m.Name, sc.Name, StringComparison.OrdinalIgnoreCase)
                && !string.IsNullOrWhiteSpace(m.InjectionSite))?.InjectionSite;
            _suggestedSite = last switch
            {
                not null when last.Contains("Left") => last.Replace("Left", "Right"),
                not null when last.Contains("Right") => last.Replace("Right", "Left"),
                _ => InjectionSites.FirstOrDefault()
            };
            _logSiteFor = sc.Id;
        }
        else
        {
            _ = LogSchedule(sc, null);
        }
    }

    private async Task LogSchedule(MedicationSchedule sc, string? site)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.MedicationEntries.Add(new MedicationEntry
        {
            Name = sc.Name, Dose = sc.Dose, Frequency = sc.Frequency,
            TakenAt = DateTime.Now, InjectionSite = site
        });
        await db.SaveChangesAsync();
        _logSiteFor = null;
        _loggedSchedId = sc.Id;
        await LoadRecent();
    }
}
