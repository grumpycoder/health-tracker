            e.SugarCount = _drinkEdit.SugarCount;
            e.Tags = CsvField.Join(_drinkEditTagBox.Selected);
            await db.SaveChangesAsync();
        }
        _editDrinkId = null;
        await LoadToday();
    }

    private async Task DeleteDrink(DrinkEntry d)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.DrinkEntries.FindAsync(d.Id);
