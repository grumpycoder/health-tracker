        if (toEdit) { AppendItem(_mealEditItems, _mealEdit, ItemFromFood(name)); _addFoodEdit = ""; }
        else { AppendItem(_pendingMealItems, _meal, ItemFromFood(name)); _mealComponents.Add(name); AutoNameFromComponents(); _addFoodEntry = ""; _scanMsg = $"Added {name} ✓"; }
    }

    // Auto-fill the meal name from its components (until the user types their own).
    private void AutoNameFromComponents()
    {
        if (_mealComponents.Count == 0) return;
        if (string.IsNullOrWhiteSpace(_meal.Description)
            || string.Equals(_meal.Description.Trim(), _mealAutoDesc?.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            _meal.Description = string.Join(" + ", _mealComponents);
            _mealAutoDesc = _meal.Description;
        }
    }

    // Scan a single item's label and append it to the meal being built/edited.
    private async Task AddScannedItem(bool toEdit, bool camera)
    {
        void Msg(string? m) { if (toEdit) _mealEditScanMsg = m; else _scanMsg = m; }
        if (!_hasAiKey) { Msg("Set a Gemini API key in Settings to scan."); return; }
        _addScanBusy = true;
        try
        {
            var jpeg = await CapturePhotoAsync(camera);
            if (jpeg is null) { _addScanBusy = false; return; }
            var facts = (await AiCoach.ReadNutritionLabelAsync(jpeg, _mealTagOptions))?.Facts;
            if (facts is null || (facts.Calories is null && facts.ProteinG is null && facts.CarbsG is null))
            {
                Msg("Couldn't read a label from that photo.");
            }
            else
            {
                var item = ItemFromFacts(facts);
                if (toEdit)
                {
                    AppendItem(_mealEditItems, _mealEdit, item);
                }
                else
                {
                    AppendItem(_pendingMealItems, _meal, item);
                    _mealComponents.Add(item.Name);
                    AutoNameFromComponents();
                }
                Msg($"Added {item.Name} ✓");
            }
        }
        catch (Exception ex) { Msg($"Scan failed: {ex.Message}"); }
        _addScanBusy = false;
    }

    private void RescaleMealEdit(double factor)
    {
        _mealEditFactor = factor <= 0 ? 1 : factor;
        var f = _mealEditFactor;
        _mealEdit.Calories = _mealEditBase.Calories is int c ? (int)Math.Round(c * f) : null;
        _mealEdit.SodiumMg = _mealEditBase.SodiumMg is int s ? (int)Math.Round(s * f) : null;
        _mealEdit.ProteinG = ScaleMacro(_mealEditBase.ProteinG, f);
        _mealEdit.CarbsG = ScaleMacro(_mealEditBase.CarbsG, f);
        _mealEdit.SugarG = ScaleMacro(_mealEditBase.SugarG, f);
        _mealEdit.AddedSugarG = ScaleMacro(_mealEditBase.AddedSugarG, f);
        _mealEdit.FatG = ScaleMacro(_mealEditBase.FatG, f);
        _mealEdit.FiberG = ScaleMacro(_mealEditBase.FiberG, f);

        static double? ScaleMacro(double? v, double f) => v is double d ? Math.Round(d * f, 1) : null;
    }

