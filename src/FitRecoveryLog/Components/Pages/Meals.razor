    private async Task ScanDrinkLabel(bool camera)
    {
        _drinkScanMsg = null;
        if (!_hasAiKey) { _drinkScanMsg = "Set a Gemini API key in Settings to scan labels."; return; }
        _scanBusy = true;
        try
        {
            var jpeg = await CapturePhotoAsync(camera);
            if (jpeg is null) { _scanBusy = false; return; } // cancelled
            var result = await AiCoach.ReadNutritionLabelAsync(jpeg, _drinkTagOptions);
            var facts = result?.Facts;
            if (facts is null || (facts.Calories is null && facts.SugarG is null && facts.ProteinG is null))
                _drinkScanMsg = "Couldn't read a nutrition label from that photo — try again or enter by hand.";
            else
            {
                _drinkScan = facts;
                _drinkScanServingOz = ParseServingOunces(facts.ServingSize);
                // Fill the drink name from the label's product name (e.g. "Coke Zero") when blank.
                if (string.IsNullOrWhiteSpace(_drink.Description) && !string.IsNullOrWhiteSpace(facts.FoodDescription))
                    _drink.Description = facts.FoodDescription.Trim();
                ApplySuggestionToBox(_drinkTagBox, _drinkTagOptions, result!.Tags); // tags in the same call
            }
        }
        catch (Exception ex) { _drinkScanMsg = $"Scan failed: {ex.Message}"; }
        _scanBusy = false;
    }

    /// <summary>Pull the serving size in fluid ounces out of a label's serving string
    /// (e.g. "12 fl oz (355 mL)" → 12); converts from mL if that's all that's given.</summary>
    private static double? ParseServingOunces(string? serving)
    {
        if (string.IsNullOrWhiteSpace(serving)) return null;
        var oz = System.Text.RegularExpressions.Regex.Match(serving, @"(\d+(?:\.\d+)?)\s*fl\s*oz", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (!oz.Success) oz = System.Text.RegularExpressions.Regex.Match(serving, @"(\d+(?:\.\d+)?)\s*oz", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (oz.Success && double.TryParse(oz.Groups[1].Value, out var v)) return v;
        var ml = System.Text.RegularExpressions.Regex.Match(serving, @"(\d+(?:\.\d+)?)\s*ml", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (ml.Success && double.TryParse(ml.Groups[1].Value, out var mlv) && mlv > 0) return Math.Round(mlv / 29.5735, 1);
        return null;
    }

    /// <summary>Apply the reviewed macros to the drink, scaled by ounces drunk ÷ label
    /// serving oz (falls back to one full serving when the ounces aren't both known).</summary>
    private void ApplyDrinkScan(bool add)
    {
        if (_drinkScan is not { } f) return;
        var n = _drink.Ounces is { } drank and > 0 && _drinkScanServingOz is { } serv and > 0
            ? drank / serv
            : 1.0;
        _drink.Calories = CombineInt(_drink.Calories, f.Calories, n, add);
        _drink.ProteinG = CombineDbl(_drink.ProteinG, f.ProteinG, n, add);
        _drink.CarbsG = CombineDbl(_drink.CarbsG, f.CarbsG, n, add);
        _drink.SugarG = CombineDbl(_drink.SugarG, f.SugarG, n, add);
        _drink.FatG = CombineDbl(_drink.FatG, f.FatG, n, add);
        _drink.SodiumMg = CombineInt(_drink.SodiumMg, f.SodiumMg, n, add);
        _drink.FiberG = CombineDbl(_drink.FiberG, f.FiberG, n, add);
        _drink.AddedSugarG = CombineDbl(_drink.AddedSugarG, f.AddedSugarG, n, add);
        _drinkScan = null;
        _drinkScanMsg = add ? "Added to drink ✓" : "Macros applied ✓";
    }

