    /// <summary>Shared plate-estimate call (initial capture and hint re-runs). Keeps the
    /// photo in memory so a correction can re-estimate; the bytes are cleared on apply/
    /// discard/save (never written to disk).</summary>
    // Per-item portion slider → recompute the whole-plate totals live from each item's macros.
    private void SetItemPct(int i, object? value)
    {
        if (i < 0 || i >= _itemPct.Count) return;
        if (double.TryParse(value?.ToString(), out var p))
        {
            _itemPct[i] = Math.Clamp(p / 100.0, 0, 1);
            RecomputeFromItems();
        }
    }

    private void RecomputeFromItems()
    {
        if (_scan is not { } f || f.Items.Count == 0) return;
        double Sum(Func<NutritionItem, double?> sel)
        {
            double t = 0;
            for (var i = 0; i < f.Items.Count; i++)
                t += (sel(f.Items[i]) ?? 0) * (i < _itemPct.Count ? _itemPct[i] : 1);
            return t;
        }
        f.Calories = (int)Math.Round(Sum(x => (double?)x.Calories));
        f.ProteinG = Math.Round(Sum(x => x.ProteinG), 1);
        f.CarbsG = Math.Round(Sum(x => x.CarbsG), 1);
        f.SugarG = Math.Round(Sum(x => x.SugarG), 1);
        f.AddedSugarG = Math.Round(Sum(x => x.AddedSugarG), 1);
        f.FatG = Math.Round(Sum(x => x.FatG), 1);
        f.SodiumMg = (int)Math.Round(Sum(x => (double?)x.SodiumMg));
        f.FiberG = Math.Round(Sum(x => x.FiberG), 1);
    }

    private async Task RunPlateEstimate(byte[] jpeg)
    {
        var result = await AiCoach.EstimateMealFromPhotoAsync(jpeg, _mealTagOptions,
            string.IsNullOrWhiteSpace(_plateHint) ? null : _plateHint, _meal.MealType.ToString());
        var facts = result?.Facts;
        if (facts is null || (facts.Calories is null && facts.ProteinG is null && facts.CarbsG is null))
        {
            _scanMsg = "Couldn't estimate macros from that photo — try a clearer shot or enter by hand.";
            return;
        }
        _scan = facts; _scanServings = 1; _scanIsEstimate = true; _plateJpeg = jpeg;
        _itemPct = Enumerable.Repeat(1.0, facts.Items.Count).ToList();   // start every item at 100% eaten
        _plateAdvice = result!.Advice;   // set when the plate would push a macro over today's targets
        // Fill the food name from what the AI saw. Overwrite it on a re-estimate when the field still
        // holds the estimator's own previous guess (so a hint correction updates it), but never clobber
        // a name the user typed themselves.
        var seen = facts.FoodDescription;
        if (!string.IsNullOrWhiteSpace(seen)
            && (string.IsNullOrWhiteSpace(_meal.Description)
                || string.Equals(_meal.Description.Trim(), _plateAutoDesc?.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            _meal.Description = seen;
            _plateAutoDesc = seen;
        }
        ApplySuggestionToBox(_mealTagBox, _mealTagOptions, result.Tags);
    }

    /// <summary>Apply the estimator's trim suggestion: replace the reviewed macros with the adjusted
    /// values, then let the user set servings and add/replace onto the meal as usual.</summary>
    private void ApplyPlateAdvice()
    {
        if (_plateAdvice is null || _scan is null) return;
        var a = _plateAdvice.Adjusted;
        _scan.Calories = a.Calories; _scan.ProteinG = a.ProteinG; _scan.CarbsG = a.CarbsG; _scan.FatG = a.FatG;
        _scan.SugarG = a.SugarG; _scan.AddedSugarG = a.AddedSugarG; _scan.FiberG = a.FiberG; _scan.SodiumMg = a.SodiumMg;
        _plateAdvice = null;
        _scanMsg = "Adjusted per the suggestion — review and apply.";
    }

    /// <summary>Multiply the reviewed per-serving values by servings eaten onto the meal.</summary>
    // True once an entry carries any macro — drives the Add-vs-Replace choice so a
    // second scan (e.g. whey added to yogurt) can sum onto the first instead of overwriting.
    private bool MealHasMacros => _meal.Calories is not null || _meal.ProteinG is not null
        || _meal.CarbsG is not null || _meal.SugarG is not null || _meal.FatG is not null
        || _meal.SodiumMg is not null || _meal.FiberG is not null || _meal.AddedSugarG is not null;
    private bool DrinkHasMacros => _drink.Calories is not null || _drink.ProteinG is not null
        || _drink.CarbsG is not null || _drink.SugarG is not null || _drink.FatG is not null
        || _drink.SodiumMg is not null || _drink.FiberG is not null || _drink.AddedSugarG is not null;

    // Combine a scanned value (× servings) with the current: replace it, or add onto it.
    private static int? CombineInt(int? current, int? scanned, double servings, bool add)
    {
        if (scanned is null) return add ? current : null;
        var v = (int)Math.Round(scanned.Value * servings);
        return add ? (current ?? 0) + v : v;
    }
    private static double? CombineDbl(double? current, double? scanned, double servings, bool add)
    {
        if (scanned is null) return add ? current : null;
        var v = scanned.Value * servings;
        return Math.Round(add ? (current ?? 0) + v : v, 1);
    }

    private void ApplyScan(bool add)
    {
        if (_scan is not { } f) return;
        var n = _scanServings <= 0 ? 1 : _scanServings;
        _meal.Calories = CombineInt(_meal.Calories, f.Calories, n, add);
        _meal.ProteinG = CombineDbl(_meal.ProteinG, f.ProteinG, n, add);
        _meal.CarbsG = CombineDbl(_meal.CarbsG, f.CarbsG, n, add);
        _meal.SugarG = CombineDbl(_meal.SugarG, f.SugarG, n, add);
        _meal.FatG = CombineDbl(_meal.FatG, f.FatG, n, add);
        _meal.SodiumMg = CombineInt(_meal.SodiumMg, f.SodiumMg, n, add);
        _meal.FiberG = CombineDbl(_meal.FiberG, f.FiberG, n, add);
        _meal.AddedSugarG = CombineDbl(_meal.AddedSugarG, f.AddedSugarG, n, add);

        // Remember the per-item breakdown (macros baked with servings, portion = how much eaten) so the
        // edit screen can show the same sliders. Only plate estimates carry items; labels don't.
        if (f.Items.Count > 0)
        {
            var items = new List<MealItemPortion>();
            for (var i = 0; i < f.Items.Count; i++)
            {
                var it = f.Items[i];
                items.Add(new MealItemPortion
                {
                    Name = it.Name,
                    Calories = it.Calories is int ic ? (int)Math.Round(ic * n) : null,
                    ProteinG = MulN(it.ProteinG, n), CarbsG = MulN(it.CarbsG, n), SugarG = MulN(it.SugarG, n),
                    AddedSugarG = MulN(it.AddedSugarG, n), FatG = MulN(it.FatG, n),
                    SodiumMg = it.SodiumMg is int isod ? (int)Math.Round(isod * n) : null, FiberG = MulN(it.FiberG, n),
                    Portion = i < _itemPct.Count ? _itemPct[i] : 1.0,
                });
            }
            if (add) _pendingMealItems.AddRange(items); else _pendingMealItems = items;
        }
        else if (!add) _pendingMealItems = new();

        // Track the components building this meal so the multi-scan flow is visible. "Add" appends;
        // "Replace"/first apply starts the list fresh.
        var comp = ComponentName();
        if (add) _mealComponents.Add(comp); else _mealComponents = new() { comp };
        // Auto-name the meal from its components until the user types their own name.
        if (string.IsNullOrWhiteSpace(_meal.Description)
            || string.Equals(_meal.Description.Trim(), _mealAutoDesc?.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            _meal.Description = string.Join(" + ", _mealComponents);
            _mealAutoDesc = _meal.Description;
        }

        _scan = null; _plateJpeg = null; _plateHint = ""; _plateAutoDesc = null;
        _scanMsg = add ? "Added to meal ✓" : "Macros applied ✓";

        static double? MulN(double? v, double n) => v is double d ? Math.Round(d * n, 1) : null;
    }

    /// <summary>A short label for the just-scanned component, for the "building this meal" list.</summary>
    private string ComponentName()
    {
        if (_scan is not { } f) return "Item";
        if (!string.IsNullOrWhiteSpace(f.FoodDescription)) return f.FoodDescription!.Trim();
        if (f.Items.Count > 0) return string.Join(", ", f.Items.Select(i => i.Name));
        return $"Item {_mealComponents.Count + 1}";
    }

    // Leftover-dinner → lunch suggestions for today (deterministic; recomputed on each load).
    private List<MealEntry> _lunchIdeas = new();

    /// <summary>Rank recent dinners that fit today's lunch: within the day-type calorie/carb
    /// ceiling AFTER what's already logged AND after reserving a typical dinner, so lunch doesn't
    /// front-load the day. Ranks by how well each closes the protein gap. Today-only.</summary>
    private void ComputeLunchIdeas(List<MealEntry> recentDinners)
    {
        _lunchIdeas = new();
        if (_viewDate != DateTime.Now.Date) return;                          // leftovers are for *today*
        if (_todayMeals.Any(m => m.MealType == MealType.Lunch)) return;      // lunch already logged

        var calCeil = NutritionGoals.GetDay(NutritionGoals.Calories, _viewDayActive).Max;
        var carbCeil = NutritionGoals.GetDay(NutritionGoals.Carbs, _viewDayActive).Max;
        if (calCeil <= 0 && carbCeil <= 0) return;                           // no ceiling to reason about
        var protein = NutritionGoals.Get(NutritionGoals.Protein);
        var fatMax = NutritionGoals.Get(NutritionGoals.Fat).Max;

        double loggedCal = NutritionMath.Calories(_todayMeals, _todayDrinks);
        double loggedCarb = NutritionMath.Carbs(_todayMeals, _todayDrinks);
        double loggedProtein = NutritionMath.Protein(_todayMeals, _todayDrinks);
        double loggedFat = NutritionMath.Fat(_todayMeals, _todayDrinks);

        var dinners = recentDinners
            .Where(m => !string.IsNullOrWhiteSpace(m.Description))
            .GroupBy(m => m.Description.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => g.OrderByDescending(x => x.Time).First())
            .ToList();
        if (dinners.Count == 0) return;

        // Reserve a typical dinner for tonight = average of recent dinners (fallback ~35% of ceiling).
        double reserveCal = Avg(dinners, d => d.Calories) ?? (calCeil > 0 ? calCeil * 0.35 : 0);
        double reserveCarb = Avg(dinners, d => d.CarbsG) ?? (carbCeil > 0 ? carbCeil * 0.35 : 0);
        double lunchCalBudget = calCeil > 0 ? calCeil - loggedCal - reserveCal : double.MaxValue;
        double lunchCarbBudget = carbCeil > 0 ? carbCeil - loggedCarb - reserveCarb : double.MaxValue;
        double proteinGap = protein.Max > 0 ? Math.Max(0, protein.Min - loggedProtein) : 0;

        var fits = new List<(MealEntry Meal, double Score)>();
        foreach (var d in dinners)
        {
            if (d.Calories is null && d.CarbsG is null) continue;            // nothing to judge
            double cal = d.Calories ?? 0, carb = d.CarbsG ?? 0, pro = d.ProteinG ?? 0, fat = d.FatG ?? 0;
            if (calCeil > 0 && cal > lunchCalBudget) continue;              // leaves room for dinner
            if (carbCeil > 0 && carb > lunchCarbBudget) continue;
            if (protein.Max > 0 && loggedProtein + pro > protein.Max) continue;
            if (fatMax > 0 && loggedFat + fat > fatMax) continue;
            fits.Add((d, proteinGap > 0 ? Math.Min(pro, proteinGap) : pro));
        }
        // Recency-first: last night's leftover is the most relevant; protein-fit breaks ties.
        _lunchIdeas = fits
            .OrderByDescending(x => x.Meal.Time).ThenByDescending(x => x.Score)
            .Take(3).Select(x => x.Meal).ToList();

        static double? Avg(List<MealEntry> ds, Func<MealEntry, double?> sel)
        {
            var vals = ds.Select(sel).Where(v => v is not null).Select(v => v!.Value).ToList();
            return vals.Count == 0 ? null : vals.Average();
        }
    }

    /// <summary>One-tap: clone a recent dinner into a Lunch entry for today (macros + breakdown).</summary>
    private async Task LogLeftoverAsLunch(MealEntry source)
    {
        var lunch = new MealEntry
        {
            Time = DateTime.Now,
            MealType = MealType.Lunch,
            Description = source.Description,
            PortionNote = source.PortionNote,
            Tags = source.Tags,
            QualityStars = source.QualityStars,
            Calories = source.Calories, ProteinG = source.ProteinG, CarbsG = source.CarbsG,
            SugarG = source.SugarG, FatG = source.FatG, SodiumMg = source.SodiumMg,
            FiberG = source.FiberG, AddedSugarG = source.AddedSugarG,
            Satiety = Satiety.Satisfied,
        };
        var result = await MealSvc.CreateAsync(MealToData(lunch));
        if (!result.IsSuccess) { _ = Toast.Show(result.Error!); return; }
        if (!string.IsNullOrWhiteSpace(source.ItemsJson))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.MealEntries.FindAsync(result.Value);
            if (row is not null) { row.ItemsJson = source.ItemsJson; await db.SaveChangesAsync(); }
        }
        await LoadToday();
        _ = Toast.Show("Logged as lunch ✓");
    }

    /// <summary>Reset the multi-scan build (macros + component list). Keeps the meal type and a
    /// name the user typed themselves; clears an auto-generated name.</summary>
    private void ClearMealBuild()
    {
        _meal.Calories = null; _meal.ProteinG = null; _meal.CarbsG = null; _meal.SugarG = null;
        _meal.FatG = null; _meal.SodiumMg = null; _meal.FiberG = null; _meal.AddedSugarG = null;
        _mealComponents = new();
        _pendingMealItems = new();
        if (string.Equals(_meal.Description?.Trim(), _mealAutoDesc?.Trim(), StringComparison.OrdinalIgnoreCase))
            _meal.Description = "";
        _mealAutoDesc = null;
        _scanMsg = null;
    }

    private static string MacroLine(MealEntry m)
    {
        var parts = new List<string>();
        if (m.Calories is { } c) parts.Add($"{c} cal");
        if (m.ProteinG is { } p) parts.Add($"{p:0.#}g protein");
        if (m.CarbsG is { } cb) parts.Add($"{cb:0.#}g carbs");
        if (m.SugarG is { } su) parts.Add($"{su:0.#}g sugar");
