    private DateTime _viewDate = DateTime.Now.Date;
    // Day-macro section on the Log tab: collapsed for today (macros live on the
    // dashboard), auto-expanded when reviewing a different day.
    private bool _showDayMacros;

    private async Task OnViewDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            _viewDate = d.Date;
            _showDayMacros = _viewDate != DateTime.Now.Date;
            _editMealId = null;
            _editDrinkId = null;
            await LoadToday();
        }
    }

    private async Task LoadToday()
    {
        var start = _viewDate;
        var end = start.AddDays(1);
        await using var db = await DbFactory.CreateDbContextAsync();
        _todayMeals = await db.MealEntries
            .Where(m => m.Time >= start && m.Time < end)
            .OrderBy(m => m.Time).ToListAsync();
        _todayDrinks = await db.DrinkEntries
            .Where(d => d.Time >= start && d.Time < end)
            .OrderBy(d => d.Time).ToListAsync();

        // Energy-balance inputs: latest weight + BMR (from Hume) and this day's
        // workout time. All best-effort — energy balance is a rough estimate.
        _latestWeightLbs = (await db.BodyMeasurements.Where(m => m.WeightLbs != null)
            .OrderByDescending(m => m.Date).Select(m => m.WeightLbs).FirstOrDefaultAsync());
        _latestBmr = (await db.BodyMeasurements.Where(m => m.BasalMetabolicRate != null)
            .OrderByDescending(m => m.Date).Select(m => m.BasalMetabolicRate).FirstOrDefaultAsync());
        var viewDate = DateOnly.FromDateTime(_viewDate);
        _dayWorkoutSeconds = await db.WorkoutSessions
            .Where(w => w.Date == viewDate && w.TotalSeconds != null)
            .SumAsync(w => w.TotalSeconds!.Value);
        var dayType = (await db.DailyLogs.FirstOrDefaultAsync(x => x.Date == viewDate))?.DayType ?? DayType.Unset;
        _viewDayActive = dayType is DayType.Workout or DayType.HighWorkload;

        // Leftover-lunch ideas: recent dinners that fit today's remaining budget with room for dinner.
        var since = start.AddDays(-5);
        var recentDinners = await db.MealEntries
            .Where(m => m.MealType == MealType.Dinner && m.Time >= since && m.Time < start)
            .ToListAsync();
        ComputeLunchIdeas(recentDinners);

        // Build typeahead libraries: seed list + every distinct food/drink logged.
        var mealRows = await db.MealEntries.OrderByDescending(m => m.Time)
            .Select(m => new { m.Description, m.PortionNote, m.Tags, m.Calories, m.ProteinG,
                m.CarbsG, m.SugarG, m.FatG, m.SodiumMg, m.FiberG, m.QualityStars }).ToListAsync();
        var loggedFoods = mealRows.Select(m => m.Description).Distinct().ToList();
        // Most recent details per food name (rows are newest-first) — portion, tags,
        // macros, and star rating, so a repeat reuses them without a fresh AI call.
        _foodDefaults = mealRows
            .Where(m => !string.IsNullOrWhiteSpace(m.Description))
            .GroupBy(m => m.Description.Trim(), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g =>
            {
                var f = g.First();
                return new FoodMemory(f.PortionNote, f.Tags, f.Calories, f.ProteinG,
                    f.CarbsG, f.SugarG, f.FatG, f.SodiumMg, f.FiberG, f.QualityStars);
            }, StringComparer.OrdinalIgnoreCase);
        // Remember each meal's most-recent item breakdown so reusing a saved meal restores its
        // components (adjustable per serving), and harvest individual item names so a component
        // added before (e.g. a scanned peanut butter) is reusable as its own saved food.
        var itemNames = new List<string>();
        _foodItems = new(StringComparer.OrdinalIgnoreCase);
        var breakdownRows = await db.MealEntries.Where(m => m.ItemsJson != null && m.Description != "")
            .OrderByDescending(m => m.Time).Select(m => new { m.Description, m.ItemsJson }).ToListAsync();
        foreach (var row in breakdownRows)
        {
            var items = ParseItems(row.ItemsJson);
            if (items.Count == 0) continue;
            var meal = row.Description.Trim();
            if (meal.Length > 0 && !_foodItems.ContainsKey(meal)) _foodItems[meal] = items;   // newest per meal
            foreach (var it in items)
            {
                var n = it.Name?.Trim();
                if (string.IsNullOrWhiteSpace(n)) continue;
                itemNames.Add(n);
                if (!_foodDefaults.ContainsKey(n))
                    _foodDefaults[n] = new FoodMemory(null, null, it.Calories, it.ProteinG,
                        it.CarbsG, it.SugarG, it.FatG, it.SodiumMg, it.FiberG, null);
            }
        }

        var hiddenFoods = HiddenFoods.Load();
        _foodLib = CommonFoods.Concat(loggedFoods).Concat(itemNames)
            .Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s.Trim())
            .Where(s => !hiddenFoods.Contains(s))
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s).ToList();
        var drinkRows = await db.DrinkEntries
            .OrderByDescending(d => d.Time)
            .Select(d => new { d.Description, d.Ounces, d.SugarCount, d.Tags, d.Calories, d.ProteinG,
                d.CarbsG, d.SugarG, d.FatG, d.SodiumMg, d.FiberG, d.AddedSugarG }).ToListAsync();
        _drinkLib = CommonDrinks.Concat(drinkRows.Select(d => d.Description))
            .Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s).ToList();
        // Per drink name: the MOST COMMON ounces/sugar among the RECENT window (not
        // all-time, not last). Mode over a window resists a one-off outlier while
        // still adapting when the usual amount changes (e.g. 8oz → 12oz coffee). Ties
        // break toward the most recent value. drinkRows is newest-first, so Take(N)
        // is the last N entries for that drink.
        const int RecentWindow = 10;
        static T? RecentMode<T>(IEnumerable<T?> newestFirst) where T : struct
        {
            var list = newestFirst.Where(x => x is not null).Take(RecentWindow).ToList();
            return list
                .GroupBy(x => x)
                .OrderByDescending(g => g.Count())
                .ThenBy(g => list.IndexOf(g.First())) // tie → most recent (lowest index)
                .Select(g => g.Key).FirstOrDefault();
        }
        _drinkDefaults = drinkRows
            .Where(d => !string.IsNullOrWhiteSpace(d.Description))
            .GroupBy(d => d.Description.Trim(), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g =>
            {
                var last = g.First(); // most recent entry (rows are newest-first) → macros
                return new DrinkMemory(
                    RecentMode(g.Select(x => x.Ounces)), RecentMode(g.Select(x => x.SugarCount)), last.Tags,
                    last.Calories, last.ProteinG, last.CarbsG, last.SugarG, last.FatG, last.SodiumMg,
                    last.FiberG, last.AddedSugarG);
            }, StringComparer.OrdinalIgnoreCase);

        // Separate vocabularies: each = its starter tags + custom tags already used
        // on that entry type, so meal and drink chips don't bleed into each other.
        // Exclude the OTHER type's starter tags from used tags, so cross-tagged
        // historical entries (back when the vocabulary was shared) don't bleed in.
        var usedMealTags = (await db.MealEntries.Select(m => m.Tags).ToListAsync()).SelectMany(CsvField.Split)
            .Where(t => !DrinkStarterTags.Contains(t, StringComparer.OrdinalIgnoreCase));
        var usedDrinkTags = (await db.DrinkEntries.Select(d => d.Tags).ToListAsync()).SelectMany(CsvField.Split)
            .Where(t => !MealStarterTags.Contains(t, StringComparer.OrdinalIgnoreCase));
        _mealTagOptions = MealStarterTags.Concat(usedMealTags)
            .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        _drinkTagOptions = DrinkStarterTags.Concat(usedDrinkTags)
            .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    }

    private static string Pretty(string camel) =>
        System.Text.RegularExpressions.Regex.Replace(camel, "(?<=.)([A-Z])", " $1");
}
