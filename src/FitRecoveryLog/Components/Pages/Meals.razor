    // Per-item serving slider (entry + edit) → set the item's servings multiplier and recompute
    // the meal's macro totals. Servings can exceed 1 (e.g. 2 slices of bread = 2×).
    private void SetItemServings(List<MealItemPortion> items, MealEntry meal, int i, object? value)
    {
        if (i < 0 || i >= items.Count) return;
        if (double.TryParse(value?.ToString(), out var v))
        {
            items[i].Portion = Math.Clamp(v, 0.25, 5);
            RecomputeTotals(items, meal);
        }
    }

    private void RemovePendingItem(int i) => RemoveItemAt(_pendingMealItems, _meal, i, entry: true);
    private void RemoveEditItem(int i) => RemoveItemAt(_mealEditItems, _mealEdit, i, entry: false);

    private void RemoveItemAt(List<MealItemPortion> items, MealEntry meal, int i, bool entry)
    {
        if (i < 0 || i >= items.Count) return;
        items.RemoveAt(i);
        if (items.Count == 0)
        {
            meal.Calories = null; meal.ProteinG = null; meal.CarbsG = null; meal.SugarG = null;
            meal.AddedSugarG = null; meal.FatG = null; meal.SodiumMg = null; meal.FiberG = null;
        }
        else RecomputeTotals(items, meal);
        // Keep the entry's auto-name components in step with the remaining items.
        if (entry) _mealComponents = items.Select(x => x.Name).ToList();
    }

    private void RecomputeMealEditFromItems() => RecomputeTotals(_mealEditItems, _mealEdit);

