    private async Task RateMeal(MealEntry m, Satiety satiety)
    {
        m.Satiety = satiety; // m carries all the meal's fields; ToData preserves the rest
        var result = await MealSvc.UpdateAsync(m.Id, MealToData(m));
        if (!result.IsSuccess) { _ = Toast.Show(result.Error!); return; }
        // Rated before the reminder fired — cancel the pending nudge.
        ReminderNotifier.Cancel(ReminderNotifier.MealRatingNotificationId);
        await LoadToday();
    }

    private async Task SaveMeal()
    {
        if (string.IsNullOrWhiteSpace(_meal.Description)) { _mealWarn = "Enter a food first."; return; }
        _mealWarn = null;
        _meal.Time = DateTime.Now;
        _meal.Tags = CsvField.Join(_mealTagBox.Selected);
        _meal.QualityStars = _mealTagBox.Stars;
        // Logging before eating: leave fullness unrated and schedule a reminder.
        if (_remindFullness) _meal.Satiety = Satiety.Unset;
        var remind = _remindFullness;
        var isSnack = _meal.MealType == MealType.Snack;
        var foodName = _meal.Description;

        var result = await MealSvc.CreateAsync(MealToData(_meal));
        if (!result.IsSuccess) { _mealWarn = result.Error; return; }

        // Persist the plate's per-item breakdown (out-of-aggregate) so it can be re-adjusted on edit.
        if (_pendingMealItems.Count > 0)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.MealEntries.FindAsync(result.Value);
            if (row is not null) { row.Items = _pendingMealItems; await db.SaveChangesAsync(); }
        }
        _pendingMealItems = new();

        if (remind)
            try { await ReminderNotifier.ScheduleMealRatingAsync(foodName, isSnack); } catch { }

        _meal = NewMeal();
        _mealTagBox.Reset();
        _remindFullness = false;
        _mealComponents = new(); _mealAutoDesc = null;
        _showMealExtras = false;
        _scan = null; _scanMsg = null; _scanServings = 1; _scanIsEstimate = false;
        _plateJpeg = null; _plateHint = "";
        await LoadToday();
        _tab = "today"; _scrollLogTop = true;   // land on the log (scrolled to top) so the saved meal is visible + editable
        _ = Toast.Show(remind ? "Meal logged ✓ — I'll remind you to rate it" : "Meal logged ✓");
    }

