    private async Task AskMealAdvice()
    {
        var considering = _considering.Trim();
        if (considering.Length == 0) { _adviceError = "Type what you're considering first."; return; }
        _adviceBusy = true;
        _adviceError = null;
        _mealAdvice = null;
        StateHasChanged();
        try
        {
            var key = await GeminiAnalyzer.KeyStore.GetAsync()
                ?? throw new InvalidOperationException("No API key set.");
            string prompt;
            await using (var db = await DbFactory.CreateDbContextAsync())
                prompt = await GeminiAnalyzer.BuildMealAdvicePromptAsync(db, considering);
            _mealAdvice = await GeminiAnalyzer.AdviseMealAsync(key, prompt)
                ?? throw new InvalidOperationException("Gemini returned nothing usable — try again.");
        }
        catch (Exception ex)
        {
            _adviceError = ex.Message;
        }
        finally
        {
            _adviceBusy = false;
        }
    }

