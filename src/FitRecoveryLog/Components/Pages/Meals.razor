@page "/meals"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Meals & Drinks</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <div class="dash-date">Meals & drinks</div>
        <div class="dash-date-sub">@DateTime.Now.ToString("dddd, MMM d")</div>
    </header>

    <section class="card">
        <button class="quick-btn wide" @onclick="@(() => Nav.NavigateTo("nutrition"))">
            <span class="quick-emoji">📊</span> Nutrition patterns
        </button>
    </section>

    <div class="segmented">
        <button class="seg @(_tab == "meal" ? "active" : "")" @onclick='() => _tab = "meal"'>🍽️ Meal</button>
        <button class="seg @(_tab == "drink" ? "active" : "")" @onclick='() => _tab = "drink"'>🥤 Drink</button>
        <button class="seg @(_tab == "today" ? "active" : "")" @onclick='() => _tab = "today"'>📋 Today</button>
    </div>

@if (_tab == "meal")
{
    <section class="card">
        <h2>Log meal / snack</h2>
        <div class="field">
            <label>Type</label>
            <select @bind="_meal.MealType">
                @foreach (var t in Enum.GetValues<MealType>())
                {
                    @if (t != MealType.Drink)
                    {
                        <option value="@t">@t</option>
                    }
                }
            </select>
        </div>
        <div class="field">
            <label>Food</label>
            <input value="@_meal.Description"
                   @oninput="e => _meal.Description = e.Value?.ToString() ?? string.Empty"
                   placeholder="Type a food, or tap a saved one below" />
            @{
                var foodMatches = Suggest(_foodLib, _meal.Description);
            }
            @if (foodMatches.Count > 0)
            {
                <div class="chip-row" style="margin-top:0.4rem">
                    @foreach (var f in foodMatches)
                    {
                        <button type="button" class="chip @(string.Equals(f, _meal.Description?.Trim(), StringComparison.OrdinalIgnoreCase) ? "selected" : "")"
                                @onclick="() => _meal.Description = f">@f</button>
                    }
                </div>
            }
        </div>
        <div class="field">
            <label>Portion note</label>
            <input @bind="_meal.PortionNote" placeholder="e.g. 2 eggs, 1 cup rice" />
        </div>
        <div class="field">
            <label>Tags</label>
            <div class="chip-row">
                @foreach (var tag in MealTags)
                {
                    <button type="button"
                            class="chip @(_mealTags.Contains(tag) ? "selected" : "")"
                            @onclick="() => ToggleMealTag(tag)">@tag</button>
                }
            </div>
        </div>
        <div class="field">
            <label>Satiety</label>
            <select @bind="_meal.Satiety">
                @foreach (var s in Enum.GetValues<Satiety>())
                {
                    <option value="@s">@Pretty(s.ToString())</option>
                }
            </select>
        </div>
        <button class="save-btn" @onclick="SaveMeal">Save meal</button>
        @if (_mealSaved)
        {
            <span class="saved-msg">Saved ✓</span>
        }
        @if (_mealWarn is not null)
        {
            <span class="warn-msg">@_mealWarn</span>
        }
    </section>
}

@if (_tab == "drink")
{
    <section class="card">
        <h2>Log drink</h2>
        <div class="field">
            <label>Drink</label>
            <input value="@_drink.Description"
                   @oninput="e => _drink.Description = e.Value?.ToString() ?? string.Empty"
                   placeholder="Type a drink, or tap a saved one below" />
            @{
                var drinkMatches = Suggest(_drinkLib, _drink.Description);
            }
            @if (drinkMatches.Count > 0)
            {
                <div class="chip-row" style="margin-top:0.4rem">
                    @foreach (var d in drinkMatches)
                    {
                        <button type="button" class="chip @(string.Equals(d, _drink.Description?.Trim(), StringComparison.OrdinalIgnoreCase) ? "selected" : "")"
                                @onclick="() => SelectDrink(d)">@d</button>
                    }
                </div>
            }
        </div>
        <div class="field">
            <label>Ounces</label>
            <input type="number" step="1" @bind="_drink.Ounces" placeholder="e.g. 16" />
        </div>
        <div class="field">
            <label>Sugar (cubes / tsp)</label>
            <input type="number" step="1" @bind="_drink.SugarCount" placeholder="e.g. 2" />
        </div>
        <button class="save-btn" @onclick="SaveDrink">Save drink</button>
        @if (_drinkSaved)
        {
            <span class="saved-msg">Saved ✓</span>
        }
        @if (_drinkWarn is not null)
        {
            <span class="warn-msg">@_drinkWarn</span>
        }
    </section>
}

@if (_tab == "today")
{
    <section class="card">
        <h2>Today</h2>
        @if (_todayMeals.Count == 0 && _todayDrinks.Count == 0)
        {
            <p class="muted">Nothing logged yet today.</p>
        }
        else
        {
            <ul class="timeline">
                @foreach (var m in _todayMeals)
                {
                    <li>
                        @if (_editMealId == m.Id)
                        {
                            <div class="edit-exercise" style="width:100%">
                                <div class="field">
                                    <label>Type</label>
                                    <select @bind="_mealEdit.MealType">
                                        @foreach (var t in Enum.GetValues<MealType>())
                                        {
                                            @if (t != MealType.Drink) { <option value="@t">@t</option> }
                                        }
                                    </select>
                                </div>
                                <div class="field"><label>Food</label><input @bind="_mealEdit.Description" /></div>
                                <div class="field"><label>Portion note</label><input @bind="_mealEdit.PortionNote" /></div>
                                <div class="field">
                                    <label>Tags</label>
                                    <div class="chip-row">
                                        @foreach (var tag in MealTags)
                                        {
                                            <button type="button" class="chip @(_mealEditTags.Contains(tag) ? "selected" : "")"
                                                    @onclick="() => ToggleEditTag(tag)">@tag</button>
                                        }
                                    </div>
                                </div>
                                <div class="field">
                                    <label>Satiety</label>
                                    <select @bind="_mealEdit.Satiety">
                                        @foreach (var s in Enum.GetValues<Satiety>()) { <option value="@s">@Pretty(s.ToString())</option> }
                                    </select>
                                </div>
                                <div class="routine-actions">
                                    <button class="save-btn" @onclick="SaveMealEdit">Save</button>
                                    <button class="link-btn" @onclick="() => _editMealId = null">Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ex-row" style="width:100%">
                                <div>
                                    <span class="time">@m.Time.ToString("h:mm tt")</span>
                                    <span class="entry"><strong>@m.MealType</strong> — @m.Description
                                        @if (m.TagList.Count > 0)
                                        {
                                            <span class="muted"> (@string.Join(", ", m.TagList))</span>
                                        }
                                    </span>
                                </div>
                                <div class="routine-actions">
                                    <button class="icon-action" title="Edit" aria-label="Edit" @onclick="() => StartEditMeal(m)">✏️</button>
                                    <button class="icon-action danger" title="Delete" aria-label="Delete" @onclick="() => DeleteMeal(m)">🗑</button>
                                </div>
                            </div>
                        }
                    </li>
                }
                @foreach (var d in _todayDrinks)
                {
                    <li>
                        @if (_editDrinkId == d.Id)
                        {
                            <div class="edit-exercise" style="width:100%">
                                <div class="field"><label>Drink</label><input @bind="_drinkEdit.Description" /></div>
                                <div class="inline-fields">
                                    <div class="field"><label>Ounces</label><input type="number" @bind="_drinkEdit.Ounces" /></div>
                                    <div class="field"><label>Sugar</label><input type="number" @bind="_drinkEdit.SugarCount" /></div>
                                </div>
                                <div class="routine-actions">
                                    <button class="save-btn" @onclick="SaveDrinkEdit">Save</button>
                                    <button class="link-btn" @onclick="() => _editDrinkId = null">Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ex-row" style="width:100%">
                                <div>
                                    <span class="time">@d.Time.ToString("h:mm tt")</span>
                                    <span class="entry">🥤 @d.Description
                                        @if (d.Ounces is not null)
                                        {
                                            <span class="muted"> @d.Ounces oz</span>
                                        }
                                    </span>
                                </div>
                                <div class="routine-actions">
                                    <button class="icon-action" title="Edit" aria-label="Edit" @onclick="() => StartEditDrink(d)">✏️</button>
                                    <button class="icon-action danger" title="Delete" aria-label="Delete" @onclick="() => DeleteDrink(d)">🗑</button>
                                </div>
                            </div>
                        }
                    </li>
                }
            </ul>
        }
    </section>
}
</div>

@code {
    private static readonly string[] CommonFoods =
        { "Eggs", "Turkey", "Chicken", "Rice", "Mini-Wheats", "Protein bar", "Banana" };
    private static readonly string[] CommonDrinks =
        { "Sweet tea", "Coke Zero", "Coffee", "Water" };
    private static readonly string[] MealTags =
        { "High protein", "High carb", "High sodium", "Sweet drink", "Restaurant meal", "Home-cooked", "Recovery meal" };

    private string _tab = "meal";
    private MealEntry _meal = new();
    private DrinkEntry _drink = new();
    private readonly HashSet<string> _mealTags = new();
    private bool _mealSaved, _drinkSaved;
    private string? _mealWarn, _drinkWarn;

    private List<MealEntry> _todayMeals = new();
    private List<DrinkEntry> _todayDrinks = new();

    // Saved food/drink names (typeahead libraries) — seed list + everything logged.
    private List<string> _foodLib = new();
    private List<string> _drinkLib = new();
    // Drink name -> most recent (ounces, sugar), to prefill on selection.
    private Dictionary<string, (double? Oz, int? Sugar)> _drinkDefaults = new(StringComparer.OrdinalIgnoreCase);

    private void SelectDrink(string name)
    {
        _drink.Description = name;
        if (_drinkDefaults.TryGetValue(name, out var d))
        {
            _drink.Ounces = d.Oz;
            _drink.SugarCount = d.Sugar;
        }
    }

    private static List<string> Suggest(List<string> lib, string? query)
    {
        var q = (query ?? "").Trim();
        return (q.Length == 0
                ? lib
                : lib.Where(x => x.Contains(q, StringComparison.OrdinalIgnoreCase)))
            .Take(10).ToList();
    }

    // Inline edit state for today's entries.
    private Guid? _editMealId;
    private MealEntry _mealEdit = new();
    private readonly HashSet<string> _mealEditTags = new();
    private Guid? _editDrinkId;
    private DrinkEntry _drinkEdit = new();

    protected override async Task OnInitializedAsync() => await LoadToday();

    private void StartEditMeal(MealEntry m)
    {
        _editDrinkId = null;
        _editMealId = m.Id;
        _mealEdit = new MealEntry
        {
            Description = m.Description, MealType = m.MealType,
            PortionNote = m.PortionNote, Satiety = m.Satiety
        };
        _mealEditTags.Clear();
        foreach (var t in m.TagList) _mealEditTags.Add(t);
    }

    private void ToggleEditTag(string tag)
    {
        if (!_mealEditTags.Add(tag)) _mealEditTags.Remove(tag);
    }

    private async Task SaveMealEdit()
    {
        if (_editMealId is not { } id) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.MealEntries.FindAsync(id);
        if (e is not null)
        {
            e.Description = _mealEdit.Description;
            e.MealType = _mealEdit.MealType;
            e.PortionNote = _mealEdit.PortionNote;
            e.Satiety = _mealEdit.Satiety;
            e.Tags = CsvField.Join(_mealEditTags);
            await db.SaveChangesAsync();
        }
        _editMealId = null;
        await LoadToday();
    }

    private async Task DeleteMeal(MealEntry m)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.MealEntries.FindAsync(m.Id);
        if (e is not null) { db.MealEntries.Remove(e); await db.SaveChangesAsync(); }
        if (_editMealId == m.Id) _editMealId = null;
        await LoadToday();
    }

    private void StartEditDrink(DrinkEntry d)
    {
        _editMealId = null;
        _editDrinkId = d.Id;
        _drinkEdit = new DrinkEntry { Description = d.Description, Ounces = d.Ounces, SugarCount = d.SugarCount };
    }

    private async Task SaveDrinkEdit()
    {
        if (_editDrinkId is not { } id) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.DrinkEntries.FindAsync(id);
        if (e is not null)
        {
            e.Description = _drinkEdit.Description;
            e.Ounces = _drinkEdit.Ounces;
            e.SugarCount = _drinkEdit.SugarCount;
            await db.SaveChangesAsync();
        }
        _editDrinkId = null;
        await LoadToday();
    }

    private async Task DeleteDrink(DrinkEntry d)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.DrinkEntries.FindAsync(d.Id);
        if (e is not null) { db.DrinkEntries.Remove(e); await db.SaveChangesAsync(); }
        if (_editDrinkId == d.Id) _editDrinkId = null;
        await LoadToday();
    }

    private void ToggleMealTag(string tag)
    {
        if (!_mealTags.Add(tag)) _mealTags.Remove(tag);
    }

    private async Task SaveMeal()
    {
        if (string.IsNullOrWhiteSpace(_meal.Description)) { _mealWarn = "Enter a food first."; _mealSaved = false; return; }
        _mealWarn = null;
        _meal.Time = DateTime.Now;
        _meal.Tags = CsvField.Join(_mealTags);
        await using var db = await DbFactory.CreateDbContextAsync();
        db.MealEntries.Add(_meal);
        await db.SaveChangesAsync();

        _mealSaved = true;
        _meal = new MealEntry();
        _mealTags.Clear();
        await LoadToday();
    }

    private async Task SaveDrink()
    {
        if (string.IsNullOrWhiteSpace(_drink.Description)) { _drinkWarn = "Enter a drink first."; _drinkSaved = false; return; }
        _drinkWarn = null;
        _drink.Time = DateTime.Now;
        await using var db = await DbFactory.CreateDbContextAsync();
        db.DrinkEntries.Add(_drink);
        await db.SaveChangesAsync();

        _drinkSaved = true;
        _drink = new DrinkEntry();
        await LoadToday();
    }

    private async Task LoadToday()
    {
        var start = DateTime.Now.Date;
        var end = start.AddDays(1);
        await using var db = await DbFactory.CreateDbContextAsync();
        _todayMeals = await db.MealEntries
            .Where(m => m.Time >= start && m.Time < end)
            .OrderBy(m => m.Time).ToListAsync();
        _todayDrinks = await db.DrinkEntries
            .Where(d => d.Time >= start && d.Time < end)
            .OrderBy(d => d.Time).ToListAsync();

        // Build typeahead libraries: seed list + every distinct food/drink logged.
        var loggedFoods = await db.MealEntries.Select(m => m.Description).Distinct().ToListAsync();
        _foodLib = CommonFoods.Concat(loggedFoods)
            .Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s).ToList();
        var drinkRows = await db.DrinkEntries
            .OrderByDescending(d => d.Time)
            .Select(d => new { d.Description, d.Ounces, d.SugarCount }).ToListAsync();
        _drinkLib = CommonDrinks.Concat(drinkRows.Select(d => d.Description))
            .Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s).ToList();
        // Most recent ounces/sugar per drink name (rows are newest-first).
        _drinkDefaults = drinkRows
            .Where(d => !string.IsNullOrWhiteSpace(d.Description))
            .GroupBy(d => d.Description.Trim(), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => (g.First().Ounces, g.First().SugarCount), StringComparer.OrdinalIgnoreCase);
    }

    private static string Pretty(string camel) =>
        System.Text.RegularExpressions.Regex.Replace(camel, "(?<=.)([A-Z])", " $1");
}
