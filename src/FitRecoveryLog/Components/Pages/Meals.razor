    // Sum every item's macros × portion into the meal's totals (the tracked source of truth).
    private static void RecomputeTotals(List<MealItemPortion> items, MealEntry meal)
    {
        if (items.Count == 0) return;
        double Sum(Func<MealItemPortion, double?> sel) => items.Sum(it => (sel(it) ?? 0) * it.Portion);
        meal.Calories = (int)Math.Round(Sum(x => (double?)x.Calories));
        meal.ProteinG = Math.Round(Sum(x => x.ProteinG), 1);
        meal.CarbsG = Math.Round(Sum(x => x.CarbsG), 1);
        meal.SugarG = Math.Round(Sum(x => x.SugarG), 1);
        meal.AddedSugarG = Math.Round(Sum(x => x.AddedSugarG), 1);
        meal.FatG = Math.Round(Sum(x => x.FatG), 1);
        meal.SodiumMg = (int)Math.Round(Sum(x => (double?)x.SodiumMg));
        meal.FiberG = Math.Round(Sum(x => x.FiberG), 1);
    }

    // A meal with no item breakdown yet: fold its current totals into one base item so adding a
    // new item on top preserves the original macros instead of replacing them.
    private static void SeedBaseItem(List<MealItemPortion> items, MealEntry meal)
    {
        if (items.Count > 0) return;
        var has = meal.Calories is not null || meal.ProteinG is not null || meal.CarbsG is not null
            || meal.SugarG is not null || meal.FatG is not null || meal.SodiumMg is not null
            || meal.FiberG is not null || meal.AddedSugarG is not null;
        if (!has) return;
        items.Add(new MealItemPortion
        {
            Name = string.IsNullOrWhiteSpace(meal.Description) ? "Meal" : meal.Description.Trim(),
            Calories = meal.Calories, ProteinG = meal.ProteinG, CarbsG = meal.CarbsG, SugarG = meal.SugarG,
            AddedSugarG = meal.AddedSugarG, FatG = meal.FatG, SodiumMg = meal.SodiumMg, FiberG = meal.FiberG,
            Portion = 1,
        });
    }

    private static void AppendItem(List<MealItemPortion> items, MealEntry meal, MealItemPortion it)
    {
        SeedBaseItem(items, meal);
        items.Add(it);
        RecomputeTotals(items, meal);
    }

