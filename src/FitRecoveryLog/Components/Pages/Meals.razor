@page "/meals"
@using FitRecoveryLog.Services
@using FitRecoveryLog.Application.Nutrition
@using FitRecoveryLog.Application.Ai
@inject IDbContextFactory<AppDbContext> DbFactory
@inject MealService MealSvc
@inject DrinkService DrinkSvc
@inject IAiCoach AiCoach
@inject NavigationManager Nav
@inject ToastService Toast
@inject IJSRuntime JS

<PageTitle>Meals & Drinks</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <div class="dash-date">Meals & Drinks</div>
        <div class="dash-date-sub">@DateTime.Now.ToString("dddd, MMM d")</div>
    </header>

    <div class="segmented">
        <button class="seg @(_tab == "meal" ? "active" : "")" @onclick='() => _tab = "meal"'>🍽️ Meal</button>
        <button class="seg @(_tab == "drink" ? "active" : "")" @onclick='() => _tab = "drink"'>🥤 Drink</button>
        <button class="seg @(_tab == "today" ? "active" : "")" @onclick="ShowLog">📋 Log</button>
    </div>

@if (_tab == "meal")
{
    @if (_hasAiKey)
    {
        <Collapsible Title="🤔 Thinking about…" Subtitle="get a quick verdict" PersistKey="meals-advisor">
            <div class="field">
                <input @bind="_considering" placeholder="e.g. Chipotle bowl, frozen pizza" />
            </div>
            <button class="save-btn" disabled="@_adviceBusy" @onclick="AskMealAdvice">
                @(_adviceBusy ? "Thinking…" : "Good idea?")
            </button>
            @if (_adviceError is not null)
            {
                <span class="warn-msg">@_adviceError</span>
            }
            @if (_mealAdvice is { } adv)
            {
                <p style="margin:0.6rem 0 0.3rem">
                    <span class="badge @(adv.Verdict == "good" ? "good" : adv.Verdict == "reconsider" ? "warn" : "")">
                        @(adv.Verdict == "good" ? "👍 Good choice" : adv.Verdict == "reconsider" ? "🤔 Maybe reconsider" : "🤷 It's fine")
                    </span>
                </p>
                <p style="margin:0 0 0.4rem">@adv.Reason</p>
                @if (!string.IsNullOrWhiteSpace(adv.RestaurantAlt))
                {
                    <p class="muted" style="margin:0">🍔 Out: @adv.RestaurantAlt</p>
                }
                @if (!string.IsNullOrWhiteSpace(adv.HomemadeAlt))
                {
                    <p class="muted" style="margin:0">🏠 Home: @adv.HomemadeAlt</p>
                }
                <button class="link-btn" style="padding:0;margin-top:0.5rem" @onclick="UseConsidered">
                    Going with it → prefill the log below
                </button>
            }
        </Collapsible>
    }

    @if (_lunchIdeas.Count > 0 && _meal.MealType == MealType.Lunch)
    {
        <section class="card">
            <h2>🍱 Leftover lunch ideas</h2>
            <p class="muted" style="margin:0 0 0.5rem;font-size:0.8rem">
                From the last 5 days' dinners — these fit today's @(_viewDayActive ? "active" : "rest")-day budget and still leave room for dinner.
            </p>
            <ul class="timeline">
                @foreach (var idea in _lunchIdeas)
                {
                    var d = idea;
                    <li>
                        <div class="meas-item">
                            <div class="ex-row">
                                <div>
                                    <span class="entry"><strong>@d.Description</strong></span>
                                    @if (MacroLine(d) is { Length: > 0 } ml)
                                    {
                                        <span class="muted" style="display:block;font-size:0.75rem">@ml</span>
                                    }
                                </div>
                                <div class="routine-actions">
                                    <button class="save-btn" @onclick="() => LogLeftoverAsLunch(d)">Log as lunch</button>
                                </div>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </section>
    }

    <section class="card">
        <h2>Log meal / snack</h2>
        <div class="field">
            <label>Type</label>
            <select @bind="_meal.MealType">
                @foreach (var t in Enum.GetValues<MealType>())
                {
                    @if (t != MealType.Drink)
                    {
                        <option value="@t">@t</option>
                    }
                }
            </select>
        </div>
        <div class="field">
            <label>Food</label>
            <input value="@_meal.Description"
                   @oninput="e => _meal.Description = e.Value?.ToString() ?? string.Empty"
                   placeholder="Type a food — saved matches appear as you type" />
            @if (!string.IsNullOrWhiteSpace(_meal.Description))
            {
                var foodMatches = Suggest(_foodLib, _meal.Description);
                @if (foodMatches.Count > 0)
                {
                    <div class="chip-row" style="margin-top:0.4rem">
                        @foreach (var f in foodMatches)
                        {
                            <button type="button" class="chip @(string.Equals(f, _meal.Description?.Trim(), StringComparison.OrdinalIgnoreCase) ? "selected" : "")"
                                    @onclick="() => SelectFood(f)">@f</button>
                        }
                    </div>
                }
            }
        </div>
        <div class="field">
            <label>Portion note</label>
            <input @bind="_meal.PortionNote" placeholder="e.g. 2 eggs, 1 cup rice" />
        </div>

        <div class="chip-row" style="margin-bottom:0.4rem">
            @if (_captureSupported)
            {
                <button type="button" class="chip" disabled="@_scanBusy" @onclick="() => ScanLabel(true)">📷 Scan label</button>
                <button type="button" class="chip" disabled="@_scanBusy" @onclick="() => EstimatePlate(true)">🍽 Estimate plate</button>
            }
            <button type="button" class="chip" disabled="@_scanBusy" @onclick="() => ScanLabel(false)">🖼 Label photo</button>
            <button type="button" class="chip" disabled="@_scanBusy" @onclick="() => EstimatePlate(false)">🖼 Plate photo</button>
            @if (_scanBusy) { <span class="muted" style="align-self:center;font-size:0.8rem">Reading…</span> }
        </div>
        @if (_scanMsg is not null)
        {
            <span class="muted" style="font-size:0.75rem">@_scanMsg</span>
        }
        @if (_scan is not null)
        {
            <div class="edit-exercise" style="margin-bottom:0.6rem">
                @if (_scanIsEstimate)
                {
                    <p class="muted" style="margin:0 0 0.4rem;font-size:0.8rem">
                        📷 Rough estimate from the photo@(string.IsNullOrWhiteSpace(_scan.FoodDescription) ? "" : $": {_scan.FoodDescription}") — <strong>double-check the numbers</strong> before applying. "Servings" = how many plates this size you ate.
                    </p>
                    @if (_plateJpeg is not null)
                    {
                        <div class="field">
                            <label>Got something wrong? Add a hint and re-estimate</label>
                            <input @bind="_plateHint" placeholder="e.g. it's turkey not beef · ~4 oz meat · no added oil" />
                        </div>
                        <button type="button" class="chip" disabled="@_scanBusy" style="margin-bottom:0.4rem"
                                @onclick="ReEstimatePlate">@(_scanBusy ? "Re-estimating…" : "🔄 Re-estimate with hint")</button>
                    }
                }
                else
                {
                    <p class="muted" style="margin:0 0 0.4rem;font-size:0.8rem">
                        Per serving@(string.IsNullOrWhiteSpace(_scan.ServingSize) ? "" : $" ({_scan.ServingSize})") — review, set servings eaten, then apply.
                    </p>
                }
                @if (_scan.Items.Count > 0)
                {
                    <p class="muted" style="margin:0.2rem 0 0.3rem;font-size:0.78rem">On the plate — drag to adjust how much of each you ate; the total below updates live.</p>
                    <div class="item-list">
                        @for (var i = 0; i < _scan.Items.Count; i++)
                        {
                            var idx = i;
                            var it = _scan.Items[idx];
                            var pct = idx < _itemPct.Count ? _itemPct[idx] : 1.0;
                            <div class="item-adj">
                                <div class="item-adj-top">
                                    <span class="entry">@it.Name</span>
                                    <span class="muted" style="font-size:0.8rem">@((int)Math.Round((it.Calories ?? 0) * pct)) cal · @((int)Math.Round(pct * 100))%</span>
                                </div>
                                <input type="range" min="0" max="100" step="5" value="@((int)Math.Round(pct * 100))"
                                       @oninput="e => SetItemPct(idx, e.Value)" style="width:100%" />
                            </div>
                        }
                    </div>
                }
                @if (_plateAdvice is not null)
                {
                    <div style="border:1px solid #d9a441;border-radius:10px;padding:0.5rem 0.6rem;margin:0 0 0.5rem;background:rgba(217,164,65,0.10)">
                        <div style="font-weight:700;font-size:0.72rem;letter-spacing:0.05em;color:#c47f00;margin-bottom:2px">⚠ OVER YOUR TARGETS</div>
                        @if (!string.IsNullOrEmpty(_plateAdvice.Message)) { <p style="margin:0 0 0.3rem;font-size:0.85rem">@_plateAdvice.Message</p> }
                        <p style="margin:0 0 0.4rem;font-size:0.85rem"><strong>Suggestion:</strong> @_plateAdvice.Suggestion</p>
                        <div class="routine-actions">
                            <button class="save-btn" @onclick="ApplyPlateAdvice">Apply suggestion</button>
                            <button class="link-btn" @onclick="() => _plateAdvice = null">Keep full plate</button>
                        </div>
                    </div>
                }
                <div class="inline-fields">
                    <div class="field"><label>Servings eaten</label><input type="number" inputmode="decimal" step="0.25" min="0" @bind="_scanServings" /></div>
                    <div class="field"><label>Calories</label><input type="number" inputmode="numeric" @bind="_scan.Calories" /></div>
                </div>
                <div class="inline-fields">
                    <div class="field"><label>Protein (g)</label><input type="number" inputmode="decimal" @bind="_scan.ProteinG" /></div>
                    <div class="field"><label>Carbs (g)</label><input type="number" inputmode="decimal" @bind="_scan.CarbsG" /></div>
                    <div class="field"><label>Sugar (g)</label><input type="number" inputmode="decimal" @bind="_scan.SugarG" /></div>
                </div>
                <div class="inline-fields">
                    <div class="field"><label>Added sugar (g)</label><input type="number" inputmode="decimal" @bind="_scan.AddedSugarG" /></div>
                    <div class="field"><label>Fat (g)</label><input type="number" inputmode="decimal" @bind="_scan.FatG" /></div>
                    <div class="field"><label>Sodium (mg)</label><input type="number" inputmode="numeric" @bind="_scan.SodiumMg" /></div>
                </div>
                <div class="inline-fields">
                    <div class="field"><label>Fiber (g)</label><input type="number" inputmode="decimal" @bind="_scan.FiberG" /></div>
                </div>
                <div class="routine-actions">
                    @if (MealHasMacros)
                    {
                        <button class="save-btn" @onclick="() => ApplyScan(true)">➕ Add to meal</button>
                        <button class="link-btn" @onclick="() => ApplyScan(false)">Replace</button>
                    }
                    else
                    {
                        <button class="save-btn" @onclick="() => ApplyScan(false)">Apply to meal</button>
                    }
                    <button class="link-btn" @onclick="() => { _scan = null; _scanMsg = null; _plateJpeg = null; _plateHint = string.Empty; _plateAutoDesc = null; _plateAdvice = null; }">Discard</button>
                </div>
            </div>
        }
        else if (MealHasMacros)
        {
            <div class="meal-build">
                @if (_pendingMealItems.Count > 0)
                {
                    <div class="build-head">
                        <span class="muted" style="font-size:0.75rem">Building this meal — drag to set servings of each item</span>
                    </div>
                    <div class="item-list">
                        @for (var i = 0; i < _pendingMealItems.Count; i++)
                        {
                            var idx = i;
                            var it = _pendingMealItems[idx];
                            <div class="item-adj">
                                <div class="item-adj-top">
                                    <span class="entry">@it.Name</span>
                                    <span class="muted" style="font-size:0.8rem">
                                        @it.Portion.ToString("0.##")× · @((int)Math.Round((it.Calories ?? 0) * it.Portion)) cal
                                        <button type="button" class="icon-action danger" title="Remove" aria-label="Remove" @onclick="() => RemovePendingItem(idx)">✕</button>
                                    </span>
                                </div>
                                <input type="range" min="0.25" max="5" step="0.25" value="@it.Portion"
                                       @oninput="e => SetItemServings(_pendingMealItems, _meal, idx, e.Value)" style="width:100%" />
                            </div>
                        }
                    </div>
                }
                else if (_mealComponents.Count > 0)
                {
                    <div class="build-head">
                        <span class="muted" style="font-size:0.75rem">Building this meal — @_mealComponents.Count item@(_mealComponents.Count == 1 ? "" : "s")</span>
                    </div>
                    <ul class="build-items">
                        @foreach (var name in _mealComponents)
                        {
                            <li><span class="entry">@name</span></li>
                        }
                    </ul>
                }
                <p class="muted" style="font-size:0.8rem;margin:0.2rem 0">@MacroLine(_meal)</p>
                <div class="add-item">
                    <div class="chip-row">
                        <input value="@_addFoodEntry" @oninput="e => _addFoodEntry = e.Value?.ToString() ?? string.Empty"
                               placeholder="add a saved food…" style="flex:1;min-width:0" />
                        <button type="button" class="chip" disabled="@string.IsNullOrWhiteSpace(_addFoodEntry)" @onclick="() => AddFoodItem(false)">Add item</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_addFoodEntry) && Suggest(_foodLib, _addFoodEntry) is { Count: > 0 } esug)
                    {
                        <div class="chip-row">
                            @foreach (var f in esug)
                            {
                                <button type="button" class="chip" @onclick="() => { _addFoodEntry = f; AddFoodItem(false); }">@f</button>
                            }
                        </div>
                    }
                    <div class="chip-row">
                        @if (_captureSupported) { <button type="button" class="chip" disabled="@_addScanBusy" @onclick="() => AddScannedItem(false, true)">📷 Scan label to add</button> }
                        <button type="button" class="chip" disabled="@_addScanBusy" @onclick="() => AddScannedItem(false, false)">🖼 Label photo</button>
                        @if (_addScanBusy) { <span class="muted" style="align-self:center;font-size:0.8rem">Reading…</span> }
                    </div>
                </div>
                <div class="chip-row">
                    <button type="button" class="chip" disabled="@_scanBusy" @onclick="() => ScanLabel(_captureSupported)">➕ Scan another label</button>
                    <button type="button" class="link-btn" @onclick="ClearMealBuild">Clear</button>
                </div>
            </div>
        }

        <button type="button" class="link-btn" style="padding:0;margin:0.2rem 0 0.5rem"
                @onclick="() => _showMealExtras = !_showMealExtras">
            @(_showMealExtras ? "▾" : "▸") Tags &amp; rating (optional)@(_mealTagBox.Selected.Count > 0 || _mealTagBox.Stars is not null ? " · set" : "")
        </button>
        @if (_showMealExtras)
        {
            @TagField(_mealTagBox, _mealTagOptions, () => SuggestTagsAsync(_mealTagBox, _mealTagOptions, _meal.MealType.ToString(), _meal.Description, _meal.PortionNote, _meal), showStars: true)
            @if (!_remindFullness)
            {
                <div class="field">
                    <label>How did this meal leave you? <span class="muted">(log after eating)</span></label>
                    <select @bind="_meal.Satiety">
                        @foreach (var s in SatietyOptions)
                        {
                            <option value="@s">@Pretty(s.ToString())</option>
                        }
                    </select>
                </div>
            }
            @if (ReminderNotifier.IsSupported)
            {
                <div class="chip-row" style="margin-bottom:0.4rem">
                    <button type="button" class="chip @(_remindFullness ? "selected" : "")"
                            @onclick="() => _remindFullness = !_remindFullness">
                        ⏰ Logging before eating — remind me to rate fullness
                    </button>
                </div>
            }
        }
        <button class="save-btn" disabled="@string.IsNullOrWhiteSpace(_meal.Description)" @onclick="SaveMeal">Save Meal</button>
        @if (_mealWarn is not null)
        {
            <span class="warn-msg">@_mealWarn</span>
        }
    </section>
}

@if (_tab == "drink")
{
    <section class="card">
        <h2>Log drink</h2>
        <div class="field">
            <label>Drink</label>
            <input value="@_drink.Description"
                   @oninput="e => _drink.Description = e.Value?.ToString() ?? string.Empty"
                   placeholder="Type a drink — saved matches appear as you type" />
            @if (!string.IsNullOrWhiteSpace(_drink.Description))
            {
                var drinkMatches = Suggest(_drinkLib, _drink.Description);
                @if (drinkMatches.Count > 0)
                {
                    <div class="chip-row" style="margin-top:0.4rem">
                        @foreach (var d in drinkMatches)
                        {
                            <button type="button" class="chip @(string.Equals(d, _drink.Description?.Trim(), StringComparison.OrdinalIgnoreCase) ? "selected" : "")"
                                    @onclick="() => SelectDrink(d)">@d</button>
                        }
                    </div>
                }
            }
        </div>
        <div class="field">
            <label>Ounces</label>
            <input type="number" inputmode="decimal" step="1" @bind="_drink.Ounces" placeholder="e.g. 16" />
        </div>
        <div class="field">
            <label>Sugar (cubes / tsp)</label>
            <input type="number" inputmode="decimal" step="1" @bind="_drink.SugarCount" placeholder="e.g. 2" />
        </div>

        <div class="chip-row" style="margin-bottom:0.4rem">
            @if (_captureSupported)
            {
                <button type="button" class="chip" disabled="@_scanBusy" @onclick="() => ScanDrinkLabel(true)">📷 Scan label</button>
            }
            <button type="button" class="chip" disabled="@_scanBusy" @onclick="() => ScanDrinkLabel(false)">🖼 Label photo</button>
            <button type="button" class="chip" disabled="@(_scanBusy || string.IsNullOrWhiteSpace(_drink.Description))" @onclick="EstimateDrinkFromName">🔎 Estimate by name</button>
            @if (_scanBusy) { <span class="muted" style="align-self:center;font-size:0.8rem">Reading…</span> }
        </div>
        @if (_drinkScanMsg is not null)
        {
            <span class="muted" style="font-size:0.75rem">@_drinkScanMsg</span>
        }
        @if (_drinkScan is not null)
        {
            <div class="edit-exercise" style="margin-bottom:0.6rem">
                <p class="muted" style="margin:0 0 0.4rem;font-size:0.8rem">
                    Per serving@(string.IsNullOrWhiteSpace(_drinkScan.ServingSize) ? "" : $" ({_drinkScan.ServingSize})") — the macros scale to the ounces you drank.
                </p>
                <div class="inline-fields">
                    <div class="field"><label>Label serving (oz)</label><input type="number" inputmode="decimal" step="0.5" min="0" @bind="_drinkScanServingOz" placeholder="e.g. 12" /></div>
                    <div class="field"><label>You drank (oz)</label><input type="number" inputmode="decimal" step="0.5" min="0" @bind="_drink.Ounces" placeholder="e.g. 8" /></div>
                </div>
                <p class="muted" style="margin:0 0 0.4rem;font-size:0.75rem">
                    @if (_drink.Ounces is { } oz and > 0 && _drinkScanServingOz is { } so and > 0)
                    {
                        <text>Scaling ×@((oz / so).ToString("0.##")) → applies @((int)Math.Round((_drinkScan.Calories ?? 0) * oz / so)) cal.</text>
                    }
                    else
                    {
                        <text>Set both ounce values to scale; otherwise 1 full serving is used.</text>
                    }
                </p>
                <div class="inline-fields">
                    <div class="field"><label>Calories</label><input type="number" inputmode="numeric" @bind="_drinkScan.Calories" /></div>
                    <div class="field"><label>Protein (g)</label><input type="number" inputmode="decimal" @bind="_drinkScan.ProteinG" /></div>
                </div>
                <div class="inline-fields">
                    <div class="field"><label>Carbs (g)</label><input type="number" inputmode="decimal" @bind="_drinkScan.CarbsG" /></div>
                    <div class="field"><label>Sugar (g)</label><input type="number" inputmode="decimal" @bind="_drinkScan.SugarG" /></div>
                    <div class="field"><label>Fat (g)</label><input type="number" inputmode="decimal" @bind="_drinkScan.FatG" /></div>
                </div>
                <div class="inline-fields">
                    <div class="field"><label>Added sugar (g)</label><input type="number" inputmode="decimal" @bind="_drinkScan.AddedSugarG" /></div>
                    <div class="field"><label>Sodium (mg)</label><input type="number" inputmode="numeric" @bind="_drinkScan.SodiumMg" /></div>
                    <div class="field"><label>Fiber (g)</label><input type="number" inputmode="decimal" @bind="_drinkScan.FiberG" /></div>
                </div>
                <div class="routine-actions">
                    @if (DrinkHasMacros)
                    {
                        <button class="save-btn" @onclick="() => ApplyDrinkScan(true)">➕ Add to drink</button>
                        <button class="link-btn" @onclick="() => ApplyDrinkScan(false)">Replace</button>
                    }
                    else
                    {
                        <button class="save-btn" @onclick="() => ApplyDrinkScan(false)">Apply to drink</button>
                    }
                    <button class="link-btn" @onclick="() => { _drinkScan = null; _drinkScanMsg = null; }">Discard</button>
                </div>
            </div>
        }
        else if (_drink.Calories is not null || _drink.ProteinG is not null)
        {
            <p class="muted" style="font-size:0.8rem">@DrinkMacroLine(_drink)</p>
        }

        @TagField(_drinkTagBox, _drinkTagOptions, () => SuggestTagsAsync(_drinkTagBox, _drinkTagOptions, "Drink", _drink.Description, DrinkPortion(_drink)))
        <button class="save-btn" disabled="@string.IsNullOrWhiteSpace(_drink.Description)" @onclick="SaveDrink">Save Drink</button>
        @if (_drinkWarn is not null)
        {
            <span class="warn-msg">@_drinkWarn</span>
        }
    </section>
}

@if (_tab == "today")
{
    <section class="card">
        <div style="display:flex;justify-content:space-between;align-items:baseline;gap:0.6rem">
            <h2>@(_viewDate == DateTime.Now.Date ? "Today" : _viewDate.ToString("ddd, MMM d"))</h2>
            <input type="date" style="width:auto" value="@_viewDate.ToString("yyyy-MM-dd")"
                   @onchange="OnViewDateChanged" />
        </div>
        @if (AvgStars is { } avg)
        {
            <p class="muted" style="margin:0.2rem 0 0" title="Average 'fit with your goals' across rated meals">
                Goal fit: <span style="color:#f5b301">@avg.ToString("0.0")★</span>
                <span style="font-size:0.8rem"> · @_ratedMealCount rated meal(s)</span>
            </p>
        }
        @if (HasNutritionData)
        {
            <button class="link-btn" style="padding:0;margin-top:0.4rem" @onclick="() => _showDayMacros = !_showDayMacros">
                @(_showDayMacros ? "▾" : "▸") Macros for this day
            </button>
        }
        @if (HasNutritionData && _showDayMacros)
        {
            <div style="margin-top:0.4rem;padding-top:0.4rem;border-top:1px solid var(--border)">
                <div style="display:flex;flex-wrap:wrap;gap:0.4rem 1.1rem;font-size:0.95rem;margin-bottom:0.4rem">
                    <span><strong>@DayCalories</strong> <span class="muted">cal</span></span>
                    <span><strong>@DaySugar.ToString("0")</strong> <span class="muted">g total sugar</span></span>
                    <span><strong>@DaySodium.ToString("0")</strong> <span class="muted">mg sodium</span></span>
                </div>
                <NutritionGoalsCard Meals="_todayMeals" Drinks="_todayDrinks" ActiveDay="_viewDayActive" />
                @if (EnergyOut is { } outKcal && DayCalories > 0)
                {
                    var net = DayCalories - outKcal;
                    <p class="muted" style="margin:0.4rem 0 0;font-size:0.8rem" title="Rough: assumes every item is logged with calories; resting burn is estimated">
                        Energy balance ≈ <strong>@DayCalories</strong> in − <strong>@outKcal</strong> out =
                        <span style="color:@(net > 0 ? "#c47f00" : "#3fa34d")">@(net > 0 ? "+" : "")@net cal</span>
                        (@(net > 0 ? "surplus" : "deficit")) · rough estimate
                    </p>
                }
                <p class="muted" style="margin:0.3rem 0 0;font-size:0.72rem">
                    Totals from @MacroMealCount of @_todayMeals.Count meal(s) with macros@(MacroMealCount < _todayMeals.Count ? " — scan/enter the rest for a full picture" : "")
                </p>
            </div>
        }
        @if (_todayMeals.Count == 0 && _todayDrinks.Count == 0)
        {
            <p class="muted">Nothing logged on this day.</p>
        }
        else
        {
            <ul class="timeline">
                @foreach (var item in MergedToday())
                {
                    <li>
                    @if (item.Meal is { } m)
                    {
                        @if (_editMealId == m.Id)
                        {
                            <div class="edit-exercise" style="width:100%">
                                <div class="field">
                                    <label>Type</label>
                                    <select @bind="_mealEdit.MealType">
                                        @foreach (var t in Enum.GetValues<MealType>())
                                        {
                                            @if (t != MealType.Drink) { <option value="@t">@t</option> }
                                        }
                                    </select>
                                </div>
                                <div class="field"><label>Food</label><input @bind="_mealEdit.Description" /></div>
                                <div class="field"><label>Time</label><input type="datetime-local" @bind="_mealEditTime" /></div>
                                <div class="field"><label>Portion note</label><input @bind="_mealEdit.PortionNote" /></div>
                                @TagField(_mealEditTagBox, _mealTagOptions, () => SuggestTagsAsync(_mealEditTagBox, _mealTagOptions, _mealEdit.MealType.ToString(), _mealEdit.Description, _mealEdit.PortionNote, _mealEdit), showStars: true)
                                <div class="field">
                                    <label>How did this meal leave you?</label>
                                    <select @bind="_mealEdit.Satiety">
                                        @foreach (var s in SatietyOptions) { <option value="@s">@Pretty(s.ToString())</option> }
                                    </select>
                                </div>
                                <p class="muted" style="margin:0.4rem 0 0.2rem;font-size:0.8rem">Macros</p>
                                @if (_mealEditItems.Count > 0)
                                {
                                    <p class="muted" style="margin:0 0 0.3rem;font-size:0.78rem">Drag to set servings of each item — the totals below update live.</p>
                                    <div class="item-list">
                                        @for (var i = 0; i < _mealEditItems.Count; i++)
                                        {
                                            var idx = i;
                                            var it = _mealEditItems[idx];
                                            <div class="item-adj">
                                                <div class="item-adj-top">
                                                    <span class="entry">@it.Name</span>
                                                    <span class="muted" style="font-size:0.8rem">
                                                        @it.Portion.ToString("0.##")× · @((int)Math.Round((it.Calories ?? 0) * it.Portion)) cal
                                                        <button type="button" class="icon-action danger" title="Remove" aria-label="Remove" @onclick="() => RemoveEditItem(idx)">✕</button>
                                                    </span>
                                                </div>
                                                <input type="range" min="0.25" max="5" step="0.25" value="@it.Portion"
                                                       @oninput="e => SetItemServings(_mealEditItems, _mealEdit, idx, e.Value)" style="width:100%" />
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="field">
                                        <label>Adjust portion eaten <span class="muted" style="font-weight:400">— scales all macros below</span></label>
                                        <div class="chip-row">
                                            @foreach (var f in PortionFactors)
                                            {
                                                <button type="button" class="chip @(Math.Abs(_mealEditFactor - f) < 0.001 ? "selected" : "")" @onclick="() => RescaleMealEdit(f)">@f.ToString("0.##")×</button>
                                            }
                                        </div>
                                    </div>
                                }
                                <div class="add-item">
                                    <label class="muted" style="font-size:0.78rem">➕ Add an item to this meal</label>
                                    <div class="chip-row">
                                        <input value="@_addFoodEdit" @oninput="e => _addFoodEdit = e.Value?.ToString() ?? string.Empty"
                                               placeholder="type a saved food" style="flex:1;min-width:0" />
                                        <button type="button" class="chip" disabled="@string.IsNullOrWhiteSpace(_addFoodEdit)" @onclick="() => AddFoodItem(true)">Add</button>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(_addFoodEdit) && Suggest(_foodLib, _addFoodEdit) is { Count: > 0 } sug)
                                    {
                                        <div class="chip-row">
                                            @foreach (var f in sug)
                                            {
                                                <button type="button" class="chip" @onclick="() => { _addFoodEdit = f; AddFoodItem(true); }">@f</button>
                                            }
                                        </div>
                                    }
                                    <div class="chip-row">
                                        @if (_captureSupported) { <button type="button" class="chip" disabled="@_addScanBusy" @onclick="() => AddScannedItem(true, true)">📷 Scan label to add</button> }
                                        <button type="button" class="chip" disabled="@_addScanBusy" @onclick="() => AddScannedItem(true, false)">🖼 Label photo</button>
                                        @if (_addScanBusy) { <span class="muted" style="align-self:center;font-size:0.8rem">Reading…</span> }
                                    </div>
                                    @if (_mealEditScanMsg is not null) { <span class="muted" style="font-size:0.75rem">@_mealEditScanMsg</span> }
                                </div>
                                <div class="inline-fields">
                                    <div class="field"><label>Calories</label><input type="number" inputmode="numeric" @bind="_mealEdit.Calories" /></div>
                                    <div class="field"><label>Protein (g)</label><input type="number" inputmode="decimal" @bind="_mealEdit.ProteinG" /></div>
                                    <div class="field"><label>Carbs (g)</label><input type="number" inputmode="decimal" @bind="_mealEdit.CarbsG" /></div>
                                </div>
                                <div class="inline-fields">
                                    <div class="field"><label>Sugar (g)</label><input type="number" inputmode="decimal" @bind="_mealEdit.SugarG" /></div>
                                    <div class="field"><label>Added sugar (g)</label><input type="number" inputmode="decimal" @bind="_mealEdit.AddedSugarG" /></div>
                                    <div class="field"><label>Fat (g)</label><input type="number" inputmode="decimal" @bind="_mealEdit.FatG" /></div>
                                </div>
                                <div class="inline-fields">
                                    <div class="field"><label>Sodium (mg)</label><input type="number" inputmode="numeric" @bind="_mealEdit.SodiumMg" /></div>
                                    <div class="field"><label>Fiber (g)</label><input type="number" inputmode="decimal" @bind="_mealEdit.FiberG" /></div>
                                </div>
                                <div class="routine-actions">
                                    <button class="save-btn" @onclick="SaveMealEdit">Save</button>
                                    <button class="link-btn" @onclick="() => _editMealId = null">Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div style="width:100%">
                                <div class="ex-row">
                                    <div>
                                        <span class="time">@m.Time.ToString("h:mm tt")</span>
                                        <span class="entry"><strong>@m.MealType</strong> — @m.Description
                                            @if (m.TagList.Count > 0)
                                            {
                                                <span class="muted"> (@string.Join(", ", m.TagList))</span>
                                            }
                                            @if (m.QualityStars is { } q)
                                            {
                                                <span title="Fit with your goals" style="color:#f5b301;margin-left:0.3rem">@(new string('★', q))<span class="muted">@(new string('☆', 5 - q))</span></span>
                                            }
                                        </span>
                                        @if (MacroLine(m) is { Length: > 0 } macros)
                                        {
                                            <span class="muted" style="display:block;font-size:0.75rem">@macros</span>
                                        }
                                    </div>
                                    <div class="routine-actions">
                                        <button class="icon-action" title="Edit" aria-label="Edit" @onclick="() => StartEditMeal(m)">✏️</button>
                                        <button class="icon-action danger" title="Delete" aria-label="Delete" @onclick="() => DeleteMeal(m)">🗑</button>
                                    </div>
                                </div>
                                @if (m.Items is { Count: > 0 } items)
                                {
                                    <button class="link-btn" style="padding:0;margin-top:0.3rem;font-size:0.8rem"
                                            @onclick="() => ToggleMealDetails(m.Id)">
                                        @(_detailMeals.Contains(m.Id) ? "▾" : "▸") @items.Count item@(items.Count == 1 ? "" : "s")
                                    </button>
                                    @if (_detailMeals.Contains(m.Id))
                                    {
                                        <ul class="meal-items">
                                            @foreach (var it in items)
                                            {
                                                <li>
                                                    <span class="entry">@it.Name</span>
                                                    @if (Math.Abs(it.Portion - 1.0) > 0.01)
                                                    {
                                                        <span class="muted" style="font-size:0.75rem"> · @it.Portion.ToString("0.##")× serving</span>
                                                    }
                                                    @if (ItemLine(it) is { Length: > 0 } il)
                                                    {
                                                        <span class="muted" style="display:block;font-size:0.72rem">@il</span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                }
                                @if (m.Satiety == Satiety.Unset)
                                {
                                    <div class="chip-row" style="margin-top:0.4rem">
                                        <span class="muted" style="align-self:center;font-size:0.75rem">how did it sit?</span>
                                        @foreach (var s in SatietyOptions)
                                        {
                                            <button type="button" class="chip" @onclick="() => RateMeal(m, s)">@Pretty(s.ToString())</button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (item.Drink is { } d)
                    {
                        @if (_editDrinkId == d.Id)
                        {
                            <div class="edit-exercise" style="width:100%">
                                <div class="field"><label>Drink</label><input @bind="_drinkEdit.Description" /></div>
                                <div class="field"><label>Time</label><input type="datetime-local" @bind="_drinkEditTime" /></div>
                                <div class="inline-fields">
                                    <div class="field"><label>Ounces</label><input type="number" inputmode="decimal" @bind="_drinkEdit.Ounces" /></div>
                                    <div class="field"><label>Sugar</label><input type="number" inputmode="decimal" @bind="_drinkEdit.SugarCount" /></div>
                                </div>
                                @TagField(_drinkEditTagBox, _drinkTagOptions, () => SuggestTagsAsync(_drinkEditTagBox, _drinkTagOptions, "Drink", _drinkEdit.Description, DrinkPortion(_drinkEdit)))
                                <p class="muted" style="margin:0.4rem 0 0.2rem;font-size:0.8rem">Macros</p>
                                <div class="inline-fields">
                                    <div class="field"><label>Calories</label><input type="number" inputmode="numeric" @bind="_drinkEdit.Calories" /></div>
                                    <div class="field"><label>Protein (g)</label><input type="number" inputmode="decimal" @bind="_drinkEdit.ProteinG" /></div>
                                    <div class="field"><label>Carbs (g)</label><input type="number" inputmode="decimal" @bind="_drinkEdit.CarbsG" /></div>
                                </div>
                                <div class="inline-fields">
                                    <div class="field"><label>Sugar (g)</label><input type="number" inputmode="decimal" @bind="_drinkEdit.SugarG" /></div>
                                    <div class="field"><label>Added sugar (g)</label><input type="number" inputmode="decimal" @bind="_drinkEdit.AddedSugarG" /></div>
                                    <div class="field"><label>Fat (g)</label><input type="number" inputmode="decimal" @bind="_drinkEdit.FatG" /></div>
                                </div>
                                <div class="inline-fields">
                                    <div class="field"><label>Sodium (mg)</label><input type="number" inputmode="numeric" @bind="_drinkEdit.SodiumMg" /></div>
                                    <div class="field"><label>Fiber (g)</label><input type="number" inputmode="decimal" @bind="_drinkEdit.FiberG" /></div>
                                </div>
                                <div class="routine-actions">
                                    <button class="save-btn" @onclick="SaveDrinkEdit">Save</button>
                                    <button class="link-btn" @onclick="() => _editDrinkId = null">Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ex-row" style="width:100%">
                                <div>
                                    <span class="time">@d.Time.ToString("h:mm tt")</span>
                                    <span class="entry">🥤 @d.Description
                                        @if (d.Ounces is not null)
                                        {
                                            <span class="muted">&nbsp;· @d.Ounces oz</span>
                                        }
                                    </span>
                                    @if (DrinkMacroLine(d) is { Length: > 0 } dmac)
                                    {
                                        <span class="muted" style="display:block;font-size:0.75rem">@dmac</span>
                                    }
                                </div>
                                <div class="routine-actions">
                                    <button class="icon-action" title="Edit" aria-label="Edit" @onclick="() => StartEditDrink(d)">✏️</button>
                                    <button class="icon-action danger" title="Delete" aria-label="Delete" @onclick="() => DeleteDrink(d)">🗑</button>
                                </div>
                            </div>
                        }
                    }
                    </li>
                }
            </ul>
        }
    </section>
}

    @if (_mealFlags.Count > 0)
    {
        <Collapsible Title="🤖 AI meal flags" Subtitle="@($"{_mealFlags.Count} note(s)")" PersistKey="meals-flags">
            @foreach (var f in _mealFlags)
            {
                <p style="margin:0 0 0.25rem">@f</p>
            }
            <p class="muted" style="margin:0.2rem 0 0;font-size:0.75rem">From your AI analysis</p>
        </Collapsible>
    }

    <section class="card">
        <button class="quick-btn wide" @onclick="@(() => Nav.NavigateTo("nutrition"))">
            <span class="quick-emoji">📊</span> Nutrition Patterns
        </button>
    </section>
</div>

@code {
    private static readonly string[] CommonFoods =
        { "Eggs", "Turkey", "Chicken", "Rice", "Mini-Wheats", "Protein bar", "Banana" };
    private static readonly string[] CommonDrinks =
        { "Sweet tea", "Coke Zero", "Coffee", "Water" };
    private static readonly string[] MealStarterTags =
        { "High protein", "High carb", "High sodium", "Restaurant meal", "Home-cooked", "Recovery meal" };
    private static readonly string[] DrinkStarterTags =
        { "Sweet drink", "High sugar", "Sugar-free", "Caffeine", "Alcohol", "Hydration" };

    [Parameter, SupplyParameterFromQuery] public string? Tab { get; set; }

    private string _tab = "meal";
    private bool _remindFullness; // "logging before eating" toggle on the meal form
    // Satisfied is the common case, so the form starts there instead of Unset.
    // Post-meal fullness choices, hungry → too full (excludes Unset and the stray
    // pre-meal "Empty stomach"). Existing entries with other values still display.
    private static readonly Satiety[] SatietyOptions =
        { Satiety.StillHungry, Satiety.Satisfied, Satiety.Full, Satiety.Bloated };

    private static MealEntry NewMeal() => new() { Satiety = Satiety.Satisfied };
    private MealEntry _meal = NewMeal();
    private DrinkEntry _drink = new();
    private string? _mealWarn, _drinkWarn;

    // Nutrition-label scan state.
    private bool _captureSupported;
    private bool _scanBusy;
    private string? _scanMsg;
    private NutritionFacts? _scan;   // values under review
    private PortionAdvice? _plateAdvice;   // day-fit trim advice from a plate estimate
    private double _scanServings = 1;
    private List<double> _itemPct = new();   // per-item "how much I ate" fraction (plate estimate), drives the live total
    private List<MealItemPortion> _pendingMealItems = new();   // plate breakdown to persist with the meal being logged
    private List<MealItemPortion> _mealEditItems = new();      // the editing meal's breakdown (sliders on the edit screen)
    private List<string> _mealComponents = new();   // names of the labels/foods added to the meal being built (multi-scan)
    private string? _mealAutoDesc;                   // last description we auto-filled from components, so typed text wins
    private bool _scanIsEstimate;                   // true = plate estimate, false = label read
    private byte[]? _plateJpeg;                     // plate photo kept in-memory for re-estimate
    private string _plateHint = "";                 // user correction fed back to the estimator
    private string? _plateAutoDesc;                 // last food name the estimator auto-filled, so a
                                                    // re-estimate can replace it without clobbering typed text
    // Drink label-scan state (separate from the meal scan). Drinks scale by ounces
    // drunk ÷ label serving-size ounces, not a manual serving count.
    private NutritionFacts? _drinkScan;
    private double? _drinkScanServingOz;
    private string? _drinkScanMsg;

    private List<MealEntry> _todayMeals = new();
    private List<DrinkEntry> _todayDrinks = new();

    // Daily "fit with your goals" average across meals that carry a star rating.
    private int _ratedMealCount => _todayMeals.Count(m => m.QualityStars is not null);
    private double? AvgStars => _ratedMealCount == 0
        ? null
        : _todayMeals.Where(m => m.QualityStars is not null).Average(m => m.QualityStars!.Value);

    // --- Daily nutrition metrics (viewed day). Totals cover only items that carry
    // macros, so they're labeled with coverage; energy balance is a rough estimate. ---
    private double? _latestWeightLbs;
    private int? _latestBmr;
    private int _dayWorkoutSeconds;
    private bool _viewDayActive;   // viewed day is Workout/High Workload → active-day ranges

    private int MacroMealCount => _todayMeals.Count(m => m.Calories is not null || m.ProteinG is not null);
    private int DayCalories => NutritionMath.Calories(_todayMeals, _todayDrinks);
    private double DayProtein => NutritionMath.Protein(_todayMeals, _todayDrinks);
    private double DaySodium => NutritionMath.Sodium(_todayMeals, _todayDrinks);
    private double DaySugar => NutritionMath.Sugar(_todayMeals, _todayDrinks);
    private bool HasNutritionData => NutritionMath.HasData(_todayMeals, _todayDrinks);

    private int WorkoutKcal   // MET ~5 strength, scaled by body weight
    {
        get
        {
            var lbs = _latestWeightLbs ?? 0;
            if (lbs <= 0 || _dayWorkoutSeconds <= 0) return 0;
            return (int)Math.Round(_dayWorkoutSeconds / 60.0 * 5 * 3.5 * (lbs * 0.453592) / 200.0);
        }
    }
    // Estimated calories out: BMR (Hume, or a rough weight×10 fallback) × light-activity
    // factor, plus the day's workout burn.
    private int? EnergyOut
    {
        get
        {
            var bmr = _latestBmr ?? (_latestWeightLbs is { } w and > 0 ? (int)(w * 10) : (int?)null);
            return bmr is null ? null : (int)Math.Round(bmr.Value * 1.25) + WorkoutKcal;
        }
    }

    // Meals and drinks merged into one chronological list for the Log tab.
    private IEnumerable<(DateTime Time, MealEntry? Meal, DrinkEntry? Drink)> MergedToday() =>
        _todayMeals.Select(m => (m.Time, (MealEntry?)m, (DrinkEntry?)null))
            .Concat(_todayDrinks.Select(d => (d.Time, (MealEntry?)null, (DrinkEntry?)d)))
            .OrderByDescending(x => x.Time);   // newest first — most recent entries on top

    // Saved food/drink names (typeahead libraries) — seed list + everything logged.
    private List<string> _foodLib = new();
    // Food name -> most recent (portion, tags), to prefill on selection.
    /// <summary>The last-logged details of a food, so a repeat reuses them without
    /// re-scanning or a fresh AI call.</summary>
    private record FoodMemory(string? Portion, string? Tags, int? Calories, double? ProteinG,
        double? CarbsG, double? SugarG, double? FatG, int? SodiumMg, double? FiberG, int? Stars);
    private Dictionary<string, FoodMemory> _foodDefaults = new(StringComparer.OrdinalIgnoreCase);
    // Most-recent item breakdown per meal name, so reusing a saved meal restores its components.
    private Dictionary<string, List<MealItemPortion>> _foodItems = new(StringComparer.OrdinalIgnoreCase);

    private static List<MealItemPortion> ParseItems(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        try { return System.Text.Json.JsonSerializer.Deserialize<List<MealItemPortion>>(json) ?? new(); }
        catch (System.Text.Json.JsonException) { return new(); }
    }

    private void SelectFood(string name)
    {
        _meal.Description = name;
        if (_foodDefaults.TryGetValue(name, out var d))
        {
            if (string.IsNullOrWhiteSpace(_meal.PortionNote)) _meal.PortionNote = d.Portion;
            _mealTagBox.Load(CsvField.Split(d.Tags)); // reuse last time's tags (Load resets Stars)
            // Carry macros + star rating forward — a repeat needs no AI call.
            _meal.Calories = d.Calories; _meal.ProteinG = d.ProteinG; _meal.CarbsG = d.CarbsG;
            _meal.SugarG = d.SugarG; _meal.FatG = d.FatG; _meal.SodiumMg = d.SodiumMg; _meal.FiberG = d.FiberG;
            if (_foodItems.TryGetValue(name, out var storedItems) && storedItems.Count > 0)
            {
                // Restore the item breakdown so it's adjustable; default each to ONE serving
                // (the stored macros are per-serving) — drag a slider up if you had more.
                _pendingMealItems = storedItems.Select(x => new MealItemPortion
                {
                    Name = x.Name, Calories = x.Calories, ProteinG = x.ProteinG, CarbsG = x.CarbsG,
                    SugarG = x.SugarG, AddedSugarG = x.AddedSugarG, FatG = x.FatG, SodiumMg = x.SodiumMg,
                    FiberG = x.FiberG, Portion = 1,
                }).ToList();
                _mealComponents = _pendingMealItems.Select(x => x.Name).ToList();
                RecomputeTotals(_pendingMealItems, _meal);   // totals now reflect one serving of each
            }
            else
            {
                _pendingMealItems = new();
                // Seed the build list so a follow-up scan reads as "<this food> + <scan>".
                _mealComponents = new() { name };
            }
            if (d.Stars is not null)
            {
                _mealTagBox.Stars = d.Stars;
                _mealTagBox.StarReason = "from your last log";
            }
        }
    }
    private List<string> _drinkLib = new();
    /// <summary>Last-logged details of a drink so a repeat reuses them. Amount/sugar use
    /// the recent-window mode; macros come from the most recent entry (no re-scan needed).</summary>
    private record DrinkMemory(double? Oz, int? Sugar, string? Tags, int? Calories, double? ProteinG,
        double? CarbsG, double? SugarG, double? FatG, int? SodiumMg, double? FiberG, double? AddedSugarG);
    private Dictionary<string, DrinkMemory> _drinkDefaults = new(StringComparer.OrdinalIgnoreCase);

    private void SelectDrink(string name)
    {
        _drink.Description = name;
        if (_drinkDefaults.TryGetValue(name, out var d))
        {
            // Prefill the MOST COMMON amount for this drink (not the last one) so a
            // one-off outlier can't stick as the default — always visible/editable.
            _drink.Ounces = d.Oz;
            _drink.SugarCount = d.Sugar;
            _drinkTagBox.Load(CsvField.Split(d.Tags));
            // Carry macros from the last time — a repeat needs no scan/AI call.
            _drink.Calories = d.Calories; _drink.ProteinG = d.ProteinG; _drink.CarbsG = d.CarbsG;
            _drink.SugarG = d.SugarG; _drink.FatG = d.FatG; _drink.SodiumMg = d.SodiumMg;
            _drink.FiberG = d.FiberG; _drink.AddedSugarG = d.AddedSugarG;
        }
    }

    private static List<string> Suggest(List<string> lib, string? query)
    {
        var q = (query ?? "").Trim();
        return (q.Length == 0
                ? lib
                : lib.Where(x => x.Contains(q, StringComparison.OrdinalIgnoreCase)))
            .Take(10).ToList();
    }

    // Meals whose item breakdown is expanded read-only in the list (no edit screen needed).
    private readonly HashSet<Guid> _detailMeals = new();
    private void ToggleMealDetails(Guid id)
    {
        if (!_detailMeals.Remove(id)) _detailMeals.Add(id);
    }

    // Inline edit state for today's entries. Editable time lets you fix a late-logged
    // entry (e.g. cereal logged at 10pm that you actually ate at 8am).
    private Guid? _editMealId;
    private MealEntry _mealEdit = new();
    private DateTime _mealEditTime = DateTime.Now;
    private Guid? _editDrinkId;
    private DrinkEntry _drinkEdit = new();
    private DateTime _drinkEditTime = DateTime.Now;

    // ---- Tag selection + AI suggestions ------------------------------------------

    /// <summary>Per-form tag state: selected chips, an AI-proposed new tag awaiting
    /// an explicit accept tap, a short status note, and a busy flag.</summary>
    private sealed class TagBox
    {
        // Case-insensitive so "High Potassium" and "High potassium" can't both stick.
        public readonly HashSet<string> Selected = new(StringComparer.OrdinalIgnoreCase);
        public string? Proposed;
        public string? Note;
        public bool Busy;
        public bool Adding;     // "＋" tapped — inline new-tag input is open
        public string? Draft;   // text in the new-tag input
        public int? Stars;      // AI "fit with goals" score (1-5)
        public string? StarReason;
        public void Toggle(string t) { if (!Selected.Add(t)) Selected.Remove(t); }
        public void Accept() { if (Proposed is { } p) { Selected.Add(p); Proposed = null; } }
        public void Reset() { Selected.Clear(); Proposed = null; Note = null; Busy = false; Adding = false; Draft = null; Stars = null; StarReason = null; }
        public void Load(IEnumerable<string> tags) { Reset(); foreach (var t in tags) Selected.Add(t); }
    }

