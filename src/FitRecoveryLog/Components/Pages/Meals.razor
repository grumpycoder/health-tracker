    /// <summary>One-tap fullness rating for an unrated logged meal (from the reminder).</summary>
    private async Task RateMeal(MealEntry m, Satiety satiety)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.MealEntries.FindAsync(m.Id);
        if (e is not null) { e.Satiety = satiety; await db.SaveChangesAsync(); }
        // Rated before the reminder fired — cancel the pending nudge.
        ReminderNotifier.Cancel(ReminderNotifier.MealRatingNotificationId);
        await LoadToday();
    }

    private async Task SaveMeal()
    {
        if (string.IsNullOrWhiteSpace(_meal.Description)) { _mealWarn = "Enter a food first."; return; }
        _mealWarn = null;
        _meal.Time = DateTime.Now;
        _meal.Tags = CsvField.Join(_mealTagBox.Selected);
        // Logging before eating: leave fullness unrated and schedule a reminder.
        if (_remindFullness) _meal.Satiety = Satiety.Unset;
        var remind = _remindFullness;
        var isSnack = _meal.MealType == MealType.Snack;
        var foodName = _meal.Description;

        await using var db = await DbFactory.CreateDbContextAsync();
        db.MealEntries.Add(_meal);
        await db.SaveChangesAsync();

        if (remind)
            try { await ReminderNotifier.ScheduleMealRatingAsync(foodName, isSnack); } catch { }

        _meal = NewMeal();
        _mealTagBox.Reset();
        _remindFullness = false;
        await LoadToday();
        _ = Toast.Show(remind ? "Meal logged ✓ — I'll remind you to rate it" : "Meal logged ✓");
    }

    private async Task SaveDrink()
    {
        if (string.IsNullOrWhiteSpace(_drink.Description)) { _drinkWarn = "Enter a drink first."; return; }
        _drinkWarn = null;
        _drink.Time = DateTime.Now;
        _drink.Tags = CsvField.Join(_drinkTagBox.Selected);
        await using var db = await DbFactory.CreateDbContextAsync();
        db.DrinkEntries.Add(_drink);
        await db.SaveChangesAsync();

        _drink = new DrinkEntry();
        _drinkTagBox.Reset();
        await LoadToday();
        _ = Toast.Show("Drink logged ✓");
    }

    // The "Log" tab can browse any day; edit/delete work the same everywhere.
    private DateTime _viewDate = DateTime.Now.Date;

    private async Task OnViewDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            _viewDate = d.Date;
            _editMealId = null;
            _editDrinkId = null;
            await LoadToday();
        }
    }

    private async Task LoadToday()
    {
        var start = _viewDate;
        var end = start.AddDays(1);
        await using var db = await DbFactory.CreateDbContextAsync();
        _todayMeals = await db.MealEntries
            .Where(m => m.Time >= start && m.Time < end)
            .OrderBy(m => m.Time).ToListAsync();
        _todayDrinks = await db.DrinkEntries
            .Where(d => d.Time >= start && d.Time < end)
            .OrderBy(d => d.Time).ToListAsync();

        // Build typeahead libraries: seed list + every distinct food/drink logged.
        var mealRows = await db.MealEntries.OrderByDescending(m => m.Time)
            .Select(m => new { m.Description, m.PortionNote, m.Tags }).ToListAsync();
        var loggedFoods = mealRows.Select(m => m.Description).Distinct().ToList();
        // Most recent portion/tags per food name (rows are newest-first).
        _foodDefaults = mealRows
            .Where(m => !string.IsNullOrWhiteSpace(m.Description))
            .GroupBy(m => m.Description.Trim(), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => (g.First().PortionNote, g.First().Tags), StringComparer.OrdinalIgnoreCase);
        _foodLib = CommonFoods.Concat(loggedFoods)
            .Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s).ToList();
        var drinkRows = await db.DrinkEntries
            .OrderByDescending(d => d.Time)
            .Select(d => new { d.Description, d.Ounces, d.SugarCount, d.Tags }).ToListAsync();
        _drinkLib = CommonDrinks.Concat(drinkRows.Select(d => d.Description))
            .Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s).ToList();
        // Most recent ounces/sugar/tags per drink name (rows are newest-first).
        _drinkDefaults = drinkRows
            .Where(d => !string.IsNullOrWhiteSpace(d.Description))
            .GroupBy(d => d.Description.Trim(), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => (g.First().Ounces, g.First().SugarCount, g.First().Tags), StringComparer.OrdinalIgnoreCase);

        // Separate vocabularies: each = its starter tags + custom tags already used
        // on that entry type, so meal and drink chips don't bleed into each other.
        // Exclude the OTHER type's starter tags from used tags, so cross-tagged
        // historical entries (back when the vocabulary was shared) don't bleed in.
        var usedMealTags = (await db.MealEntries.Select(m => m.Tags).ToListAsync()).SelectMany(CsvField.Split)
            .Where(t => !DrinkStarterTags.Contains(t, StringComparer.OrdinalIgnoreCase));
        var usedDrinkTags = (await db.DrinkEntries.Select(d => d.Tags).ToListAsync()).SelectMany(CsvField.Split)
            .Where(t => !MealStarterTags.Contains(t, StringComparer.OrdinalIgnoreCase));
        _mealTagOptions = MealStarterTags.Concat(usedMealTags)
            .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        _drinkTagOptions = DrinkStarterTags.Concat(usedDrinkTags)
            .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    }

    private static string Pretty(string camel) =>
        System.Text.RegularExpressions.Regex.Replace(camel, "(?<=.)([A-Z])", " $1");
}
