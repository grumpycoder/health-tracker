@page "/settings"
@using FitRecoveryLog.Services
@using FitRecoveryLog.Application.Ai
@using FitRecoveryLog.Application.Sync
@using FitRecoveryLog.Infrastructure.Sync
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject CloudSyncService Sync
@inject IAccessTokenProvider Auth
@inject ILlmKeyStore Keys
@inject FitRecoveryLog.Infrastructure.Ai.MistralLlmClient Mistral
@implements IDisposable

<PageTitle>Settings</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <div class="dash-date">Settings</div>
        <div class="dash-date-sub">App configuration</div>
    </header>

    <section class="card">
        <h2>Cloud Sync</h2>
        <p class="muted" style="margin:0 0 0.6rem">
            Sync your data to the cloud so it's available on other devices and (later) a web
            app. Your phone keeps working fully offline — sync runs in the background and
            whenever you tap Sync Now.
        </p>
        @if (Auth.IsSignedIn)
        {
            <p style="margin:0 0 0.5rem">Signed in as <strong>@Auth.Username</strong></p>
            <button class="save-btn" @onclick="SyncNow" disabled="@Sync.IsSyncing">
                @(Sync.IsSyncing ? "Syncing…" : "Sync Now")
            </button>
            <button class="link-btn danger" style="margin-left:0.6rem" @onclick="SignOut">Sign Out</button>
        }
        else
        {
            <button class="save-btn" @onclick="SignIn" disabled="@_syncBusy">
                @(_syncBusy ? "Signing in…" : "Sign In")
            </button>
        }
        @if (_syncMsg is not null)
        {
            <p class="muted" style="margin:0.5rem 0 0">@_syncMsg</p>
        }
        @if (Sync.LastSyncUtc is DateTime last)
        {
            <p class="muted" style="margin:0.3rem 0 0">Last synced: @last.ToLocalTime().ToString("g")</p>
        }
    </section>

    <section class="card">
        <h2>Text size</h2>
        <p class="muted" style="margin:0 0 0.6rem">Make everything bigger or smaller across the app.</p>
        <div class="chip-row">
            @foreach (var opt in TextSizes)
            {
                <button type="button" class="chip @(_textScale == opt.Pct ? "selected" : "")"
                        @onclick="() => SetTextScale(opt.Pct)">@opt.Label</button>
            }
        </div>
    </section>

    <section class="card">
        <h2>AI Analysis (Gemini)</h2>
        <p class="muted" style="margin:0 0 0.6rem">
            Enables the AI analysis on the Insights page. Create a free API key at
            Google AI Studio (aistudio.google.com → Get API key) and paste it here.
            The free tier is plenty — an analysis uses ~2 of its 1,500 daily requests.
        </p>
        <div class="field">
            <label>Gemini API Key</label>
            <input type="password" @bind="_key" placeholder="AIza…" autocomplete="off" />
        </div>
        <button class="save-btn" @onclick="SaveKey">Save Key</button>
        @if (_saved)
        {
            <span class="saved-msg">Saved ✓</span>
        }
        @if (_hasKey)
        {
            <button class="link-btn danger" style="margin-left:0.6rem" @onclick="ClearKey">Remove Key</button>
        }

        <hr style="border:none;border-top:1px solid var(--border);margin:0.9rem 0" />
        <p class="muted" style="margin:0 0 0.4rem;font-size:0.85rem">
            <strong>Fallback: Mistral (optional).</strong> When Gemini is overloaded ("model
            unavailable"), scans/estimates automatically retry on Mistral's Pixtral vision model.
            Create a free API key at console.mistral.ai → API Keys, and paste it here.
        </p>
        <div class="field">
            <label>Mistral API Key</label>
            <input type="password" @bind="_groqKey" placeholder="paste key…" autocomplete="off" />
        </div>
        <button class="save-btn" @onclick="SaveGroqKey">Save Key</button>
        @if (_groqSaved) { <span class="saved-msg">Saved ✓</span> }
        @if (_hasGroqKey)
        {
            <button class="link-btn" style="margin-left:0.6rem" @onclick="TestMistral" disabled="@_mistralTesting">
                @(_mistralTesting ? "Testing…" : "Test")
            </button>
            <button class="link-btn danger" style="margin-left:0.6rem" @onclick="ClearGroqKey">Remove</button>
        }
        @if (_mistralTestMsg is not null)
        {
            <p class="muted" style="margin:0.5rem 0 0;font-size:0.85rem">@_mistralTestMsg</p>
        }
    </section>

    <section class="card">
        <h2>Goals &amp; targets</h2>
        <p class="muted" style="margin:0 0 0.6rem">Coaching goals, macro/hydration targets, and body-measurement
        goals now live on their own page — easier to find and they sync with the web.</p>
        <button class="save-btn" @onclick="@(() => Nav.NavigateTo("goals"))">Open Goals</button>
    </section>

    <section class="card">
        <h2>What Gets Sent to the AI</h2>
        <p style="margin:0 0 0.4rem"><strong>Sent</strong> (full analysis, last 8 weeks): workouts (exercises, sets,
        ratings, comments), meals & drinks, sleep entries, body-measurement numbers (weight, waist, etc.),
        and your coaching goals (from the Goals page).</p>
        <p style="margin:0 0 0.4rem"><strong>Sent</strong> (daily check-in): today's meals & drinks, last night's
        sleep, today's workout, physical workload, the planned day type, the last 7 days of meal names,
        your coaching goals, and <strong>today's notes</strong> (for context — keep private details out of notes).</p>
        <p style="margin:0 0 0.4rem"><strong>Opt-in only:</strong> cessation (substance) progress — toggle on the
        Cessation page, off by default.</p>
        <p style="margin:0 0 0.4rem"><strong>Never sent:</strong> medications, labs, photos, past-day notes,
        clothing-fit notes, or anything identifying.</p>
        <p class="muted" style="margin:0">Heads-up: Google's free tier may use submitted text to improve
        its models. That's why medication and lab data are excluded by design.</p>
    </section>
</div>

@code {
    private string _key = "";
    private bool _saved, _hasKey;
    private string _groqKey = "";
    private bool _groqSaved, _hasGroqKey;
    private bool _mistralTesting;
    private string? _mistralTestMsg;

    // A real 1×1 JPEG so the test exercises the vision path (auth + endpoint + model + image format).
    private const string TinyJpegBase64 =
        "";

    private static readonly (string Label, int Pct)[] TextSizes =
        { ("Normal", 100), ("Large", 120), ("Larger", 140), ("Largest", 160) };
    private int _textScale = 100;

    private bool _syncBusy;
    private string? _syncMsg;

    private void OnSyncState() => InvokeAsync(StateHasChanged);
    public void Dispose() { Auth.StateChanged -= OnSyncState; Sync.StateChanged -= OnSyncState; }

    private async Task SignIn()
    {
        _syncBusy = true; _syncMsg = null;
        var r = await Sync.SyncAsync(allowInteractive: true);
        _syncMsg = r.Success ? $"Synced — sent {r.Pushed}, received {r.Pulled}." : $"Failed: {r.Error}";
        _syncBusy = false;
    }

    private async Task SyncNow()
    {
        _syncMsg = null;
        var r = await Sync.SyncAsync(allowInteractive: true);
        _syncMsg = r.Success ? $"Synced — sent {r.Pushed}, received {r.Pulled}." : $"Failed: {r.Error}";
    }

    private async Task SignOut()
    {
        await Auth.SignOutAsync();
        _syncMsg = "Signed out.";
    }

    protected override async Task OnInitializedAsync()
    {
        Auth.StateChanged += OnSyncState;
        Sync.StateChanged += OnSyncState;
        var existing = await Keys.GetAsync();
        _hasKey = !string.IsNullOrEmpty(existing);
        if (_hasKey) _key = existing!;
        var groq = await Keys.GetAsync("mistral");
        _hasGroqKey = !string.IsNullOrEmpty(groq);
        if (_hasGroqKey) _groqKey = groq!;
        _textScale = Microsoft.Maui.Storage.Preferences.Default.Get("text_scale_pct", 100);
    }

    private async Task SetTextScale(int pct)
    {
        _textScale = pct;
        Microsoft.Maui.Storage.Preferences.Default.Set("text_scale_pct", pct);
        try { await JS.InvokeVoidAsync("textScale.apply", pct); } catch { }
    }

    private async Task SaveKey()
    {
        var k = _key.Trim();
        if (k.Length == 0) return;
        await Keys.SetAsync(k);
        _saved = true;
        _hasKey = true;
    }

    private async Task ClearKey()
    {
        await Keys.SetAsync("");
        _key = "";
        _hasKey = false;
        _saved = false;
    }

    private async Task SaveGroqKey()
    {
        var k = _groqKey.Trim();
        if (k.Length == 0) return;
        await Keys.SetAsync(k, "mistral");
        _groqSaved = true;
        _hasGroqKey = true;
    }

    private async Task ClearGroqKey()
    {
        await Keys.SetAsync("", "mistral");
        _groqKey = "";
        _hasGroqKey = false;
        _groqSaved = false;
    }

    // Ping Mistral directly (a tiny image + JSON prompt) to confirm the key/endpoint/model work,
    // without touching the Gemini key.
    private async Task TestMistral()
    {
        _mistralTesting = true;
        _mistralTestMsg = null;
        try
        {
            var jpeg = Convert.FromBase64String(TinyJpegBase64);
            var json = await Mistral.GenerateJsonAsync(
                "Reply with ONLY this JSON object: {\"ok\": true}", jpeg);
            _mistralTestMsg = string.IsNullOrWhiteSpace(json)
                ? "Mistral responded but returned nothing — check the model name."
                : "✓ Mistral is working — fallback is ready.";
        }
        catch (Exception ex)
        {
            _mistralTestMsg = $"Mistral test failed: {ex.Message}";
        }
        _mistralTesting = false;
    }
}
