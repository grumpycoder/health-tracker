@page "/more"
@inject NavigationManager Nav

<PageTitle>More</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <div class="dash-date">More</div>
        <div class="dash-date-sub">All screens</div>
    </header>

    <section class="card">
        <div class="quick-grid">
            @foreach (var item in Links)
            {
                <button class="quick-btn" @onclick="@(() => Nav.NavigateTo(item.Route))">
                    <span class="quick-emoji">@item.Emoji</span> @item.Label
                </button>
            }
        </div>
    </section>
</div>

@code {
    private static readonly (string Emoji, string Label, string Route)[] Links =
    {
        ("🔍", "Search", "search"),
        ("📆", "Calendar", "calendar"),
        ("⚖️", "Body", "measurements"),
        ("💊", "Meds & Labs", "medication"),
        ("🥗", "Nutrition", "nutrition"),
        ("🍽", "Saved foods", "saved-foods"),
        ("📈", "Trends", "trends"),
        ("🧩", "Insights", "insights"),
        ("📅", "Weekly Review", "weekly-review"),
        ("🔔", "Reminders", "reminders"),
        ("🚭", "Cessation", "cessation"),
        ("🎯", "Goals", "goals"),
        ("⬇️", "Export", "export"),
        ("⚙️", "Settings", "settings"),
    };
}
