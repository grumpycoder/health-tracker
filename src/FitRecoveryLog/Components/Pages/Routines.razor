@page "/routines"
@using FitRecoveryLog.Services
@implements IDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Workout Routines</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <div class="dash-date">Workout Routines</div>
        <div class="dash-date-sub">Reusable workouts you can start anytime</div>
    </header>

    <section class="card">
        <h2>New routine</h2>
        <div class="field">
            <input @bind="_newRoutineName" placeholder="e.g. Morning bodyweight" />
        </div>
        <button class="save-btn" @onclick="AddRoutine">Create Routine</button>
    </section>

    @if (_hasAiKey)
    {
        <section class="card">
            <h2>✨ Suggest a Routine</h2>
            <p class="muted" style="margin:0 0 0.5rem">
                Drafts a routine from your training history — covering muscle groups
                your current workouts under-train, mixing library exercises with a few new ones.
            </p>
            <div class="field">
                <input @bind="_aiHint" placeholder="Optional: e.g. upper body, 20 min, something new" />
            </div>
            <div class="chip-row" style="margin:0 0 0.6rem">
                <button type="button" class="chip @(_aiBodyweightOnly ? "selected" : "")"
                        @onclick="() => _aiBodyweightOnly = true">🏠 Bodyweight only</button>
                <button type="button" class="chip @(!_aiBodyweightOnly ? "selected" : "")"
                        @onclick="() => _aiBodyweightOnly = false">🏋️ Equipment OK</button>
            </div>
            <button class="save-btn" disabled="@_aiBusy" @onclick="SuggestRoutine">
                @(_aiBusy ? "Designing…" : "Generate Draft")
            </button>
            @if (_aiError is not null)
            {
                <span class="warn-msg">@_aiError</span>
            }
        </section>
    }

    @if (_aiDraft is { } draft)
    {
        <section class="card">
            <h2>🤖 @draft.Name <span class="muted" style="font-size:0.8rem">draft — not saved yet</span></h2>
            <p class="muted" style="margin:0.3rem 0 0.6rem">@draft.Rationale</p>
            @if (_aiNote is not null)
            {
                <p class="muted" style="margin:0 0 0.6rem">⚠️ @_aiNote</p>
            }
            <ul class="exercise-list">
                @foreach (var ex in _aiExercises)
                {
                    <li @key="ex">
                        <div class="ex-row">
                            <div>
                                <span class="ex-name">@ex.Name</span>
                                @if (ex.IsNew)
                                {
                                    <span class="badge good">NEW</span>
                                }
                                <span class="ex-target">
                                    @(ex.Measure == "duration" ? $"{ex.DurationSeconds ?? 30}s" : $"{ex.Reps ?? 10} reps") × @ex.Sets
                                    · @(ex.RestSeconds ?? 60)s rest
                                </span>
                                @if (!string.IsNullOrWhiteSpace(ex.Muscles))
                                {
                                    <span class="muted" style="font-size:0.75rem"> @ex.Muscles</span>
                                }
                            </div>
                            <div class="routine-actions">
                                <button class="icon-action" title="How-to video" aria-label="How-to video"
                                        @onclick="() => Exercises.OpenDemo(new ExerciseDefinition { Name = ex.Name })">🎬</button>
                                <button class="icon-action danger" title="Remove from draft" aria-label="Remove"
                                        @onclick="() => _aiExercises.Remove(ex)">🗑</button>
                            </div>
                        </div>
                    </li>
                }
            </ul>
            <div class="routine-actions" style="margin-top:0.7rem">
                <button class="save-btn" disabled="@(_aiExercises.Count == 0)" @onclick="SaveAiDraft">Save Routine</button>
                <button class="link-btn" @onclick="DiscardAiDraft">Discard</button>
            </div>
            <p class="muted" style="font-size:0.75rem;margin:0.5rem 0 0">
                Targets are editable after saving (✏️ on the routine). New exercises join the library on save.
            </p>
        </section>
    }

    @foreach (var r in _routines)
    {
        var expanded = _expandedId == r.Id;
        <section class="card">
            <div class="routine-head" style="cursor:pointer" @onclick="() => Toggle(r.Id)">
                <h2>@(expanded ? "▾" : "▸") @r.Name</h2>
                <div class="routine-actions">
                    <button class="link-btn" @onclick:stopPropagation
                            @onclick="@(() => Nav.NavigateTo($"workout?routineId={r.Id}"))">Start ▶</button>
                </div>
            </div>

            @if (!expanded)
            {
                <p class="muted" style="margin:0.4rem 0 0">@Summary(r)</p>
            }
            else
            {
            <div>
            @if (r.Exercises.Count == 0)
            {
                <p class="muted">No exercises yet.</p>
            }
            else
            {
                <ul class="exercise-list" id="exlist-@r.Id">
                    @foreach (var ex in r.Exercises.OrderBy(e => e.Order))
                    {
                        var def = ex.ExerciseDefinition;
                        var isTime = def?.Measure == ExerciseMeasure.Duration;
                        <li @key="ex.Id">
                            @if (_editId == ex.Id)
                            {
                                <div class="edit-exercise">
                                    <div class="ex-name">@def?.Name</div>
                                    <div class="muted" style="font-size:0.75rem;margin-bottom:0.4rem">
                                        @(isTime ? "Time-based" : "Reps-based") library exercise · editing this routine's targets
                                    </div>
                                    <div class="inline-fields">
                                        <div class="field"><label>Sets</label><input type="number" inputmode="decimal" min="1" @bind="_editDraft.Sets" /></div>
                                        @if (isTime)
                                        {
                                            <div class="field"><label>Time (s)</label><input type="number" inputmode="decimal" min="1" @bind="_editDraft.Duration" /></div>
                                        }
                                        else
                                        {
                                            <div class="field"><label>Reps</label><input type="number" inputmode="decimal" min="1" @bind="_editDraft.Reps" /></div>
                                        }
                                        <div class="field"><label>Rest (s)</label><input type="number" inputmode="decimal" min="0" @bind="_editDraft.Rest" /></div>
                                    </div>
                                    <div class="routine-actions">
                                        <button class="save-btn" @onclick="@(() => SaveEdit(ex))">Save</button>
                                        <button class="link-btn" @onclick="CancelEdit">Cancel</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="ex-row">
                                    <div>
                                        <span class="drag-handle" title="Drag to reorder">⠿</span>
                                        <span class="ex-name">@def?.Name</span>
                                        @if (def?.Name is { } dn && _advice.TryGetValue(dn, out var adv))
                                        {
                                            <span class="badge @AiAdviceStore.BadgeClass(adv.Action)" title="AI suggestion">
                                                @AiAdviceStore.Glyph(adv.Action) @(adv.Target ?? adv.Action)
                                            </span>
                                        }
                                        <span class="ex-target">@FormatTarget(ex, def)</span>
                                    </div>
                                    <div class="routine-actions">
                                        <button class="icon-action" title="Edit" aria-label="Edit" @onclick="@(() => StartEdit(ex))">✏️</button>
                                        <button class="icon-action danger" title="Remove" aria-label="Remove" @onclick="@(() => RemoveExercise(ex))">🗑</button>
                                    </div>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }

            @{
                var d = _draft[r.Id];
                var q = d.Name.Trim();
                var existing = _library.FirstOrDefault(e => string.Equals(e.Name, q, StringComparison.OrdinalIgnoreCase));
                var isExisting = existing.Name is not null;
                var browse = (q.Length == 0
                        ? _library
                        : _library.Where(e => e.Name.Contains(q, StringComparison.OrdinalIgnoreCase)))
                    .OrderBy(e => e.Name).Take(12).ToList();
                var effMeasure = isExisting ? existing.Measure : d.Measure;
            }
            <div class="add-exercise">
                <div class="field">
                    <label>Add Exercise</label>
                    <input value="@d.Name"
                           @oninput="e => d.Name = e.Value?.ToString() ?? string.Empty"
                           placeholder="Type a new exercise, or tap one below" />
                </div>

                @if (browse.Count > 0)
                {
                    <div class="field">
                        <label class="muted">Library — tap to pick</label>
                        <div class="chip-row">
                            @foreach (var lib in browse)
                            {
                                <button type="button"
                                        class="chip @(string.Equals(lib.Name, q, StringComparison.OrdinalIgnoreCase) ? "selected" : "")"
                                        @onclick="() => SelectLibrary(d, lib)">@lib.Name</button>
                            }
                        </div>
                    </div>
                }

                @if (isExisting)
                {
                    <p class="muted" style="margin:0 0 0.5rem">
                        Reusing “@existing.Name” · @(existing.Measure == ExerciseMeasure.Duration ? "time-based" : "reps-based")
                    </p>
                }
                else if (q.Length > 0)
                {
                    <div class="field">
                        <label>Track by <span class="muted">(new exercise)</span></label>
                        <select @bind="d.Measure">
                            <option value="@ExerciseMeasure.Reps">Reps</option>
                            <option value="@ExerciseMeasure.Duration">Time (e.g. planks)</option>
                        </select>
                    </div>
                }

                <div class="inline-fields">
                    <div class="field">
                        <label>Sets</label>
                        <input type="number" inputmode="decimal" min="1" @bind="d.Sets" />
                    </div>
                    @if (effMeasure == ExerciseMeasure.Duration)
                    {
                        <div class="field">
                            <label>Time (s)</label>
                            <input type="number" inputmode="decimal" min="1" @bind="d.Duration" />
                        </div>
                    }
                    else
                    {
                        <div class="field">
                            <label>Reps</label>
                            <input type="number" inputmode="decimal" min="1" @bind="d.Reps" />
                        </div>
                    }
                    <div class="field">
                        <label>Rest (s)</label>
                        <input type="number" inputmode="decimal" min="0" @bind="d.Rest" />
                    </div>
                </div>
                <button class="save-btn" @onclick="@(() => AddExercise(r))">Add Exercise</button>
            </div>

            <div style="margin-top:0.9rem">
                <div class="field">
                    <label>Routine name</label>
                    <input @bind="_renameDraft" />
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center">
                    <button class="link-btn" @onclick="@(() => RenameRoutine(r))">Save Name</button>
                    <button class="link-btn danger" @onclick="@(() => DeleteRoutine(r))">Delete Routine</button>
                </div>
            </div>
            </div>
            }
        </section>
    }
</div>

@code {
    private List<WorkoutRoutine> _routines = new();
    private List<(string Name, ExerciseMeasure Measure)> _library = new();
    private string _newRoutineName = "";
    private readonly Dictionary<Guid, ExerciseDraft> _draft = new();

    // Accordion: only one routine is open at a time to keep the page short.
    private Guid? _expandedId;
    private DotNetObjectReference<Routines>? _selfRef;

    private string _renameDraft = "";

    private void Toggle(Guid id)
    {
        _expandedId = _expandedId == id ? null : id;
        _editId = null;
        _renameDraft = _expandedId is null ? "" : _routines.FirstOrDefault(r => r.Id == id)?.Name ?? "";
    }

    /// <summary>Renames the routine — safe because sessions/exercises reference the
    /// routine's Guid key, never its name; history is unaffected.</summary>
    private async Task RenameRoutine(WorkoutRoutine r)
    {
        var name = _renameDraft.Trim();
        if (string.IsNullOrWhiteSpace(name) || name == r.Name) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.WorkoutRoutines.FindAsync(r.Id);
        if (e is not null) { e.Name = name; await db.SaveChangesAsync(); }
        await Load();
    }

    // (Re)attach drag-and-drop to the expanded routine's list after each render —
    // Blazor recreates the <ul> when the accordion opens or the list re-renders.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _selfRef = DotNetObjectReference.Create(this);
        if (_expandedId is { } id)
        {
            try { await JS.InvokeVoidAsync("exerciseSort.init", $"exlist-{id}", _selfRef); } catch { }
        }
    }

    [JSInvokable]
    public async Task OnReorder(int oldIndex, int newIndex)
    {
        if (_expandedId is not { } routineId || oldIndex == newIndex) return;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var ordered = await db.RoutineExercises
                .Where(e => e.RoutineId == routineId)
                .OrderBy(e => e.Order).ToListAsync();
            if (oldIndex < 0 || oldIndex >= ordered.Count || newIndex < 0 || newIndex >= ordered.Count) return;

            var moved = ordered[oldIndex];
            ordered.RemoveAt(oldIndex);
            ordered.Insert(newIndex, moved);
            for (var i = 0; i < ordered.Count; i++) ordered[i].Order = i;
            await db.SaveChangesAsync();
        }

        await Load();
        StateHasChanged();
    }

    public void Dispose() => _selfRef?.Dispose();

    /// <summary>Collapsed one-liner: exercise names in order.</summary>
    private static string Summary(WorkoutRoutine r) =>
        r.Exercises.Count == 0
            ? "No exercises yet — tap to add"
            : string.Join(" · ", r.Exercises.OrderBy(e => e.Order)
                .Select(e => e.ExerciseDefinition?.Name ?? "?"));

    // Inline edit state: which RoutineExercise is being edited, and its target draft.
    private Guid? _editId;
    private ExerciseDraft _editDraft = new();

    private class ExerciseDraft
    {
        public string Name { get; set; } = "";
        public ExerciseMeasure Measure { get; set; } = ExerciseMeasure.Reps;
        public int Sets { get; set; } = 3;
        public int Reps { get; set; } = 10;
        public int Duration { get; set; } = 30;
        public int Rest { get; set; } = 60;
    }

    // Latest AI per-exercise suggestions (empty until an analysis is run).
    private Dictionary<string, GeminiAnalyzer.ExerciseAdvice> _advice = new(StringComparer.OrdinalIgnoreCase);

    // AI routine generation state.
    private bool _hasAiKey, _aiBusy;
    private bool _aiBodyweightOnly = true;
    private string _aiHint = "";
    private string? _aiError, _aiNote;
    private GeminiAnalyzer.RoutineSuggestion? _aiDraft;
    private List<GeminiAnalyzer.SuggestedExercise> _aiExercises = new();

    protected override async Task OnInitializedAsync()
    {
        _advice = AiAdviceStore.LoadExercises();
        _hasAiKey = !string.IsNullOrEmpty(await GeminiAnalyzer.KeyStore.GetAsync());
        await Load();
    }

    private async Task SuggestRoutine()
    {
        _aiBusy = true;
        _aiError = null;
        StateHasChanged();
        try
        {
            var key = await GeminiAnalyzer.KeyStore.GetAsync()
                ?? throw new InvalidOperationException("No API key set (Settings).");
            string prompt;
            HashSet<string> easy;
            await using (var db = await DbFactory.CreateDbContextAsync())
            {
                prompt = await GeminiAnalyzer.BuildRoutinePromptAsync(db, _aiHint, _aiBodyweightOnly);
                easy = await GeminiAnalyzer.RecentlyEasyExercisesAsync(db);
            }
            _aiDraft = await GeminiAnalyzer.SuggestRoutineAsync(key, prompt)
                ?? throw new InvalidOperationException("Gemini returned nothing usable — try again.");
            // Backstop the Easy rule in code: drop reused exercises rated Easy last time.
            _aiExercises = _aiDraft.Exercises.Where(e => e.IsNew || !easy.Contains(e.Name)).ToList();
            var dropped = _aiDraft.Exercises.Count - _aiExercises.Count;
            _aiNote = dropped > 0 ? $"Removed {dropped} exercise(s) you rated Easy last time." : null;
        }
        catch (Exception ex)
        {
            _aiError = ex.Message;
            _aiDraft = null;
        }
        finally
        {
            _aiBusy = false;
        }
    }

    private void DiscardAiDraft()
    {
        _aiDraft = null;
        _aiExercises.Clear();
    }

    /// <summary>Persist the reviewed draft: pick-or-create each exercise in the
    /// library (case-insensitive), then save the routine with per-exercise targets.</summary>
    private async Task SaveAiDraft()
    {
        if (_aiDraft is null || _aiExercises.Count == 0) return;
        await using var db = await DbFactory.CreateDbContextAsync();

        // Unique routine name (append a number if taken).
        var baseName = _aiDraft.Name.Trim();
        var name = baseName;
        for (var i = 2; await db.WorkoutRoutines.AnyAsync(r => r.Name == name); i++)
            name = $"{baseName} {i}";
        var routine = new WorkoutRoutine { Name = name };
        db.WorkoutRoutines.Add(routine);

        var order = 0;
        var created = new Dictionary<string, ExerciseDefinition>(StringComparer.OrdinalIgnoreCase);
        foreach (var ex in _aiExercises)
        {
            // Pick-or-create, also catching duplicates within this draft.
            var def = created.GetValueOrDefault(ex.Name)
                      ?? await db.ExerciseDefinitions.FirstOrDefaultAsync(e => e.Name == ex.Name);
            if (def is null)
            {
                def = new ExerciseDefinition
                {
                    Name = ex.Name,
                    Measure = ex.Measure == "duration" ? ExerciseMeasure.Duration : ExerciseMeasure.Reps
                };
                db.ExerciseDefinitions.Add(def);
            }
            created[ex.Name] = def;

            var measure = def.Measure; // an existing library exercise keeps its own
            db.RoutineExercises.Add(new RoutineExercise
            {
                RoutineId = routine.Id,
                ExerciseDefinitionId = def.Id,
                Order = order++,
                TargetSets = ex.Sets,
                TargetReps = measure == ExerciseMeasure.Reps ? (ex.Reps ?? 10) : null,
                TargetDurationSeconds = measure == ExerciseMeasure.Duration ? (ex.DurationSeconds ?? 30) : null,
                RestSeconds = ex.RestSeconds ?? 60
            });
        }
        await db.SaveChangesAsync();

        DiscardAiDraft();
        _aiHint = "";
        await Load();
        _expandedId = routine.Id; // open it for review/edits
    }

    private async Task Load()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _routines = await db.WorkoutRoutines
            .Include(r => r.Exercises)
                .ThenInclude(e => e.ExerciseDefinition)
            .OrderBy(r => r.Name)
            .ToListAsync();
        _library = (await db.ExerciseDefinitions.Where(e => !e.Retired).OrderBy(e => e.Name)
                .Select(e => new { e.Name, e.Measure }).ToListAsync())
            .Select(x => (x.Name, x.Measure)).ToList();
        foreach (var r in _routines)
            _draft.TryAdd(r.Id, new ExerciseDraft());
    }

    private void SelectLibrary(ExerciseDraft d, (string Name, ExerciseMeasure Measure) lib)
    {
        d.Name = lib.Name;
        d.Measure = lib.Measure;
    }

    private async Task AddRoutine()
    {
        if (string.IsNullOrWhiteSpace(_newRoutineName)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var routine = new WorkoutRoutine { Name = _newRoutineName.Trim() };
        db.WorkoutRoutines.Add(routine);
        await db.SaveChangesAsync();
        _newRoutineName = "";
        await Load();
        _expandedId = routine.Id; // open the new routine so exercises can be added now
    }

    private async Task DeleteRoutine(WorkoutRoutine r)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        // Detach past workout sessions from this routine (keep their history),
        // otherwise the WorkoutSession.RoutineId FK blocks the delete.
        await db.WorkoutSessions.Where(s => s.RoutineId == r.Id)
            .ExecuteUpdateAsync(u => u.SetProperty(s => s.RoutineId, (Guid?)null));
        // The routine's RoutineExercises cascade at the DB.
        var e = await db.WorkoutRoutines.FindAsync(r.Id);
        if (e is not null)
        {
            db.WorkoutRoutines.Remove(e);
            await db.SaveChangesAsync();
        }
        if (_editId == r.Id) _editId = null;
        await Load();
    }

    private async Task AddExercise(WorkoutRoutine r)
    {
        var d = _draft[r.Id];
        var name = d.Name.Trim();
        if (string.IsNullOrWhiteSpace(name)) return;

        await using var db = await DbFactory.CreateDbContextAsync();

        // Pick-or-create: reuse the library exercise if the name already exists
        // (case-insensitive), otherwise add a new one.
        var def = await db.ExerciseDefinitions.FirstOrDefaultAsync(e => e.Name == name);
        if (def is null)
        {
            def = new ExerciseDefinition { Name = name, Measure = d.Measure };
            db.ExerciseDefinitions.Add(def);
        }

        // The library exercise's measure wins (an existing one keeps its own).
        var measure = def.Measure;
        db.RoutineExercises.Add(new RoutineExercise
        {
            RoutineId = r.Id,
            ExerciseDefinitionId = def.Id,
            Order = r.Exercises.Count,
            TargetSets = d.Sets,
            TargetReps = measure == ExerciseMeasure.Reps ? d.Reps : null,
            TargetDurationSeconds = measure == ExerciseMeasure.Duration ? d.Duration : null,
            RestSeconds = d.Rest
        });
        await db.SaveChangesAsync();

        _draft[r.Id] = new ExerciseDraft();
        await Load();
    }

    private void StartEdit(RoutineExercise ex)
    {
        _editId = ex.Id;
        _editDraft = new ExerciseDraft
        {
            Sets = ex.TargetSets ?? 1,
            Reps = ex.TargetReps ?? 10,
            Duration = ex.TargetDurationSeconds ?? 30,
            Rest = ex.RestSeconds ?? 60
        };
    }

    private void CancelEdit() => _editId = null;

    private async Task SaveEdit(RoutineExercise ex)
    {
        var isTime = ex.ExerciseDefinition?.Measure == ExerciseMeasure.Duration;
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.RoutineExercises.FindAsync(ex.Id);
        if (entity is not null)
        {
            entity.TargetSets = _editDraft.Sets;
            entity.TargetReps = isTime ? null : _editDraft.Reps;
            entity.TargetDurationSeconds = isTime ? _editDraft.Duration : null;
            entity.RestSeconds = _editDraft.Rest;
            await db.SaveChangesAsync();
        }
        _editId = null;
        await Load();
    }

    private async Task RemoveExercise(RoutineExercise ex)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        // Unlink from the routine only — keep the library exercise (and its history).
        var join = await db.RoutineExercises.FindAsync(ex.Id);
        if (join is not null) db.RoutineExercises.Remove(join);
        await db.SaveChangesAsync();

        if (_editId == ex.Id) _editId = null;
        await Load();
    }

    private static string FormatTarget(RoutineExercise ex, ExerciseDefinition? def)
    {
        var parts = new List<string>();
        if (def?.Measure == ExerciseMeasure.Duration && ex.TargetDurationSeconds is not null)
            parts.Add($"{ex.TargetDurationSeconds}s × {ex.TargetSets}");
        else if (ex.TargetReps is not null)
            parts.Add($"{ex.TargetReps} reps × {ex.TargetSets}");
        if (ex.RestSeconds is > 0)
            parts.Add($"{ex.RestSeconds}s rest");
        return string.Join(" · ", parts);
    }
}
