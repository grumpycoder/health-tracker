@page "/"
@using FitRecoveryLog.Services
@implements IDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IHealthService Health
@inject IJSRuntime JS

<PageTitle>Dashboard</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <div class="dash-date">@_today.ToString("dddd")</div>
        <div class="dash-date-sub">@_today.ToString("MMMM d, yyyy")</div>
    </header>

    @if (_steps is not null)
    {
        <section class="card steps-today">
            <span class="quick-emoji">👟</span>
            <span><strong>@_steps.Value.ToString("N0")</strong> steps today</span>
        </section>
    }

    <section class="card">
        <h2>Today's plan</h2>
        <div class="daytype-grid">
            @foreach (var dt in DayTypes)
            {
                <button class="daytype-btn @(_log.DayType == dt ? "selected" : "")"
                        @onclick="() => SetDayType(dt)">
                    @Label(dt)
                </button>
            }
        </div>
    </section>

    @if (_cessationLines.Count > 0)
    {
        <section class="card" style="cursor:pointer" @onclick="@(() => Nav.NavigateTo("cessation"))">
            @foreach (var line in _cessationLines)
            {
                <p style="margin:0 0 0.25rem">@line</p>
            }
            <p class="muted" style="margin:0.2rem 0 0;font-size:0.75rem">Tap for cravings, slips & milestones</p>
        </section>
    }

    <section class="card">
        <h2>Quick log</h2>
        <div class="quick-grid">
            @foreach (var item in QuickLinks)
            {
                @* Cessation logging only matters once a goal exists (More → Cessation to start one). *@
                if (item.Route == "cessation" && _cessationLines.Count == 0) continue;
                <button class="quick-btn" @onclick="@(() => Nav.NavigateTo(item.Route))">
                    <span class="quick-emoji">@item.Emoji</span> @item.Label
                </button>
            }
        </div>
    </section>

    @if (_hasAiKey)
    {
        <section class="card">
            <h2 style="cursor:pointer;display:flex;justify-content:space-between;align-items:center"
                @onclick="ToggleCheckin">
                <span>🤖 How Am I Doing Today?</span>
                <span class="muted">@(_checkinCollapsed ? "▸" : "▾")</span>
            </h2>
            @if (!_checkinCollapsed)
            {
                @if (_daily is null)
                {
                    <button class="save-btn" disabled="@_dailyBusy" @onclick="RunDailyCheck">
                        @(_dailyBusy ? "Checking…" : "Check In")
                    </button>
                }
                else
                {
                    <p style="margin:0 0 0.5rem">
                        <span class="badge @(_daily.Tone == "good" ? "good" : _daily.Tone == "poor" ? "warn" : "")">
                            @(_daily.Tone == "good" ? "😊 Good Day So Far" : _daily.Tone == "poor" ? "😕 Needs Attention" : "😐 Mixed Day")
                        </span>
                    </p>
                    <p style="margin:0 0 0.5rem">@_daily.Synopsis</p>
                    @foreach (var tip in _daily.Tips)
                    {
                        <div class="ai-li"><span class="ai-marker">–</span><span>@tip</span></div>
                    }
                    <div style="margin-top:0.4rem">
                        <button class="link-btn" style="padding:0" disabled="@_dailyBusy" @onclick="RunDailyCheck">
                            @(_dailyBusy ? "Checking…" : "Refresh")
                        </button>
                        <span class="muted" style="font-size:0.75rem;margin-left:0.6rem">as of @_dailyWhen</span>
                    </div>
                }
                @if (_dailyError is not null)
                {
                    <p class="warn-msg" style="display:block;margin:0.5rem 0 0">@_dailyError</p>
                }
            }
        </section>
    }

    @if (_aiActions.Count > 0)
    {
        <section class="card">
            <h2>🤖 This Week's Focus</h2>
            <ul class="timeline">
                @foreach (var a in _aiActions)
                {
                    <li><span class="entry">@a</span></li>
                }
            </ul>
            <p class="muted" style="margin:0.3rem 0 0">From your AI analysis · <a class="link-btn" style="padding:0" @onclick="@(() => Nav.NavigateTo("insights"))">re-run on Insights</a></p>
        </section>
    }

    <section class="card">
        <button class="quick-btn wide" @onclick="@(() => Nav.NavigateTo("trends"))">
            <span class="quick-emoji">📈</span> View Trends
        </button>
        <button class="quick-btn wide" style="margin-top:0.6rem" @onclick="@(() => Nav.NavigateTo("weekly-review"))">
            <span class="quick-emoji">📅</span> Weekly Review
        </button>
        <button class="quick-btn wide" style="margin-top:0.6rem" @onclick="@(() => Nav.NavigateTo("reminders"))">
            <span class="quick-emoji">🔔</span> Reminders
        </button>
        <button class="quick-btn wide" style="margin-top:0.6rem" @onclick="@(() => Nav.NavigateTo("export"))">
            <span class="quick-emoji">⬇️</span> Export Data
        </button>
    </section>

    <section class="card">
        <h2>Notes</h2>
        <textarea class="note" rows="2" placeholder="How are you feeling right now?"
                  @bind="_noteText" @bind:event="oninput"></textarea>
        @if (_hasAiKey)
        {
            <p class="muted" style="font-size:0.75rem;margin:0.3rem 0 0.5rem">
                Today's notes are shared with the AI check-in for context — keep anything private out of them.
            </p>
        }
        <button class="save-btn" @onclick="AddNote">Add Note</button>
        @if (_todayNotes.Count > 0)
        {
            <ul class="timeline" style="margin-top:0.6rem">
                @foreach (var n in _todayNotes)
                {
                    <li>
                        <div class="ex-row" style="width:100%">
                            <div>
                                <span class="time">@n.Time.ToString("h:mm tt")</span>
                                <span class="entry">@n.Text</span>
                            </div>
                            <div class="routine-actions">
                                <button class="icon-action danger" title="Delete" aria-label="Delete" @onclick="() => DeleteNote(n)">🗑</button>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
</div>

@code {
    // Recomputed on load and on app resume so the day rolls over past midnight.
    private DateOnly _today = DateOnly.FromDateTime(DateTime.Now);
    private DotNetObjectReference<Home>? _selfRef;

    private static readonly DayType[] DayTypes =
    {
        DayType.Workout, DayType.Recovery, DayType.ActiveRecovery, DayType.HighWorkload
    };

    private static readonly (string Emoji, string Label, string Route)[] QuickLinks =
    {
        ("🏋️", "Start Workout", "workout"),
        ("⚖️", "Body Measurement", "measurements"),
        ("🍽️", "Meal / Snack", "meals"),
        ("💊", "Medication", "medication"),
        ("😴", "Sleep / Recovery", "sleep"),
        ("🏡", "Physical Workload", "workload"),
        ("🚭", "Craving / Slip", "cessation"),
    };

    private DailyLog _log = new();
    private int? _steps;

    // Timestamped notes, addable any time through the day.
    private string _noteText = "";
    private List<NoteEntry> _todayNotes = new();

    // Top actions from the latest AI analysis (empty until one is run).
    private List<string> _aiActions = new();

    // One-line status per active cessation goal.
    private List<string> _cessationLines = new();

    // Daily AI check-in (cached per calendar day).
    private bool _hasAiKey, _dailyBusy;
    private GeminiAnalyzer.DailyCheck? _daily;
    private string? _dailyWhen, _dailyError;

    // Collapsed state persists across launches.
    private bool _checkinCollapsed = Microsoft.Maui.Storage.Preferences.Default.Get("home_checkin_collapsed", false);

    private void ToggleCheckin()
    {
        _checkinCollapsed = !_checkinCollapsed;
        Microsoft.Maui.Storage.Preferences.Default.Set("home_checkin_collapsed", _checkinCollapsed);
    }

    private async Task RunDailyCheck()
    {
        _dailyBusy = true;
        _dailyError = null;
        StateHasChanged();
        try
        {
            var key = await GeminiAnalyzer.KeyStore.GetAsync()
                ?? throw new InvalidOperationException("No API key set.");
            string prompt;
            await using (var db = await DbFactory.CreateDbContextAsync())
                prompt = await GeminiAnalyzer.BuildDailyPromptAsync(db);
            _daily = await GeminiAnalyzer.DailyCheckAsync(key, prompt);
            _dailyWhen = DateTime.Now.ToString("h:mm tt");
            AiAdviceStore.SaveDaily(_daily, _dailyWhen);
        }
        catch (Exception ex)
        {
            _dailyError = $"Check-in failed: {ex.Message}";
        }
        finally
        {
            _dailyBusy = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _aiActions = AiAdviceStore.LoadActions();
        _hasAiKey = !string.IsNullOrEmpty(await GeminiAnalyzer.KeyStore.GetAsync());
        if (AiAdviceStore.LoadDaily() is { } cached)
        {
            _daily = cached.Check;
            _dailyWhen = cached.When;
        }
        await LoadForToday();

        if (Health.IsAvailable)
        {
            try
            {
                await Health.RequestAuthorizationAsync();
                _steps = await Health.ReadStepsAsync(_today);
            }
            catch { }
        }
    }

    // Load (or start) the plan for the current calendar day, plus its notes.
    private async Task LoadForToday()
    {
        _today = DateOnly.FromDateTime(DateTime.Now);
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.DailyLogs.FirstOrDefaultAsync(x => x.Date == _today);
        _log = existing ?? new DailyLog { Date = _today };
        await LoadNotes(db);
        await LoadCessation(db);
    }

    private async Task LoadCessation(AppDbContext db)
    {
        _cessationLines.Clear();
        var goals = await db.CessationGoals.Where(g => g.Active).OrderBy(g => g.Substance).ToListAsync();
        foreach (var g in goals)
        {
            // Tapering toward a future quit date: show today's allowance progress.
            if (g.Taper && g.TaperStartDate is { } start && _today < g.QuitDate)
            {
                var total = g.QuitDate.DayNumber - start.DayNumber;
                var allow = g.BaselineUnitsPerDay is { } b && total > 0
                    ? (int)Math.Ceiling(b * (g.QuitDate.DayNumber - _today.DayNumber) / (double)total)
                    : 0;
                var used = await db.CessationEvents
                    .Where(e => e.GoalId == g.Id && e.Type == CessationEventType.Slip && e.Time >= _today.ToDateTime(TimeOnly.MinValue))
                    .SumAsync(e => e.Amount ?? 1);
                _cessationLines.Add($"🚭 {g.Substance} — taper {used:0.#}/{allow} today · quit {g.QuitDate:MMM d}");
                continue;
            }

            var daysQuit = _today.DayNumber - g.QuitDate.DayNumber;
            var lastSlip = await db.CessationEvents
                .Where(e => e.GoalId == g.Id && e.Type == CessationEventType.Slip)
                .OrderByDescending(e => e.Time).FirstOrDefaultAsync();
            var since = lastSlip is null ? "no slips ✨"
                : $"{_today.DayNumber - DateOnly.FromDateTime(lastSlip.Time).DayNumber}d since slip";
            var money = "";
            var unitCost = g.CostPerUnit is { } c ? c / (g.UnitsPerPack is { } p && p > 0 ? p : 1) : (double?)null;
            if (g.BaselineUnitsPerDay is { } perDay && unitCost is { } cost && daysQuit > 0)
            {
                var slipped = await db.CessationEvents
                    .Where(e => e.GoalId == g.Id && e.Type == CessationEventType.Slip)
                    .SumAsync(e => e.Amount ?? 1);
                money = $" · {Math.Max(0, daysQuit * perDay * cost - slipped * cost):C0} saved";
            }
            _cessationLines.Add($"🚭 {g.Substance} — {daysQuit}d quit · {since}{money}");
        }
    }

    private async Task LoadNotes(AppDbContext db)
    {
        var start = _today.ToDateTime(TimeOnly.MinValue);
        var end = start.AddDays(1);
        _todayNotes = await db.NoteEntries
            .Where(n => n.Time >= start && n.Time < end)
            .OrderBy(n => n.Time).ToListAsync();
    }

    private async Task AddNote()
    {
        var text = _noteText.Trim();
        if (text.Length == 0) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        db.NoteEntries.Add(new NoteEntry { Time = DateTime.Now, Text = text });
        await db.SaveChangesAsync();
        _noteText = "";
        await LoadNotes(db);
    }

    private async Task DeleteNote(NoteEntry n)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.NoteEntries.FindAsync(n.Id);
        if (e is not null) { db.NoteEntries.Remove(e); await db.SaveChangesAsync(); }
        await LoadNotes(db);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("appLifecycle.onResume", _selfRef); } catch { }
        }
    }

    // Called from JS when the app/page becomes visible again (e.g. resumed after midnight).
    [JSInvokable]
    public async Task OnAppResumed()
    {
        if (_today == DateOnly.FromDateTime(DateTime.Now)) return; // same day, nothing to do
        await LoadForToday();
        if (Health.IsAvailable)
        {
            try { _steps = await Health.ReadStepsAsync(_today); } catch { }
        }
        StateHasChanged();
    }

    public void Dispose() => _selfRef?.Dispose();

    private async Task SetDayType(DayType dt)
    {
        _log.DayType = dt;
        await SaveLog();
    }

    private async Task SaveLog()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.DailyLogs.FirstOrDefaultAsync(x => x.Date == _log.Date);
        if (existing is null)
            db.DailyLogs.Add(_log);
        else
            existing.DayType = _log.DayType;
        await db.SaveChangesAsync();
    }

    private static string Label(DayType dt) => dt switch
    {
        DayType.Workout => "Workout",
        DayType.Recovery => "Recovery",
        DayType.ActiveRecovery => "Active Recovery",
        DayType.HighWorkload => "High Workload",
        _ => dt.ToString()
    };
}
