@using FitRecoveryLog.Data
@using FitRecoveryLog.Services

@if (NutritionMath.HasData(Meals, Drinks) || NutritionMath.WaterOz(Drinks) > 0 || OnAddWater.HasDelegate)
{
    <div>
        @Macro("Protein", NutritionMath.Protein(Meals, Drinks), "g", NutritionGoals.Get(NutritionGoals.Protein))
        @Macro("Carbs", NutritionMath.Carbs(Meals, Drinks), "g", NutritionGoals.Get(NutritionGoals.Carbs))
        @Macro("Fat", NutritionMath.Fat(Meals, Drinks), "g", NutritionGoals.Get(NutritionGoals.Fat))
        @Macro("Fiber", NutritionMath.Fiber(Meals, Drinks), "g", NutritionGoals.Get(NutritionGoals.Fiber))
        @Ceiling("Added sugar", NutritionMath.AddedSugar(Meals, Drinks), "g", NutritionGoals.AddedSugarMax)
        @WaterRow()
    </div>
}

@code {
    [Parameter] public List<MealEntry> Meals { get; set; } = new();
    [Parameter] public List<DrinkEntry> Drinks { get; set; } = new();
    [Parameter] public bool WorkoutDay { get; set; }
    /// <summary>When set, water quick-add buttons show; the arg is ounces to log as a
    /// Water drink (negative = undo the most recent water entry).</summary>
    [Parameter] public EventCallback<int> OnAddWater { get; set; }

    private static RenderFragment Line(string label, string value, GoalStatus status) => @<div style="display:flex;justify-content:space-between;align-items:center;padding:0.2rem 0">
        <span>@label</span>
        <span style="display:flex;align-items:center;gap:0.4rem">
            <span>@value</span>
            <span style="color:@NutritionGoals.Color(status);font-size:0.7rem" title="@status">●</span>
        </span>
    </div>;

    private RenderFragment Macro(string label, double val, string unit, MacroGoal g)
    {
        if (!g.IsSet) return @<text></text>;
        return Line(label, $"{val:0} / {g.Min}–{g.Max} {unit}", NutritionGoals.Status(val, g));
    }

    private RenderFragment Ceiling(string label, double val, string unit, int max)
    {
        if (max <= 0) return @<text></text>;
        return Line(label, $"{val:0} / ≤{max} {unit}", NutritionGoals.CeilingStatus(val, max));
    }

    private RenderFragment WaterRow()
    {
        var g = NutritionGoals.Get(NutritionGoals.Water);
        var waterOz = NutritionMath.WaterOz(Drinks);
        // Only relevant where water is actionable (Home) or already logged.
        if (!OnAddWater.HasDelegate && waterOz <= 0) return @<text></text>;
        if (!g.IsSet) return @<text></text>;
        var target = WorkoutDay ? g.Max : g.Min;                  // ounces needed to "hit" it
        var met = waterOz >= target;
        var goalText = WorkoutDay ? $"{g.Max} (workout day)" : $"{g.Min}–{g.Max}";
        return @<div style="padding:0.2rem 0">
            <div style="display:flex;justify-content:space-between;align-items:center">
                <span>💧 Water</span>
                <span style="display:flex;align-items:center;gap:0.4rem">
                    <span><strong>@waterOz</strong> / @goalText oz</span>
                    <span style="color:@NutritionGoals.Color(met ? GoalStatus.InRange : GoalStatus.Under);font-size:0.7rem">●</span>
                </span>
            </div>
            @if (OnAddWater.HasDelegate)
            {
                <div class="chip-row" style="margin-top:0.3rem">
                    @foreach (var oz in new[] { 8, 12, 16, 24 })
                    {
                        <button type="button" class="chip" @onclick="() => OnAddWater.InvokeAsync(oz)">+@oz</button>
                    }
                    @if (waterOz > 0)
                    {
                        <button type="button" class="chip" title="Undo last water" @onclick="() => OnAddWater.InvokeAsync(-1)">↺</button>
                    }
                </div>
            }
        </div>;
    }
}
