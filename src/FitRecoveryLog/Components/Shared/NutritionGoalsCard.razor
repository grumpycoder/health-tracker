@using FitRecoveryLog.Data
@using FitRecoveryLog.Services

@if (NutritionMath.HasData(Meals, Drinks) || NutritionMath.FluidOz(Drinks) > 0 || OnAddWater.HasDelegate)
{
    <div>
        <p class="muted" style="margin:0 0 0.3rem;font-size:0.72rem">
            @(ActiveDay ? "🏋️ Active-day targets" : "🛌 Rest-day targets") <span style="opacity:0.7">(calories/carbs/water)</span>
            · tap a bar for exact numbers
        </p>
        @{ var cal = NutritionGoals.GetDay(NutritionGoals.Calories, ActiveDay); }
        @Bar("Calories", NutritionMath.Calories(Meals, Drinks), "", cal.Min, cal.Max, false)
        @{ var pro = NutritionGoals.Get(NutritionGoals.Protein); }
        @Bar("Protein", NutritionMath.Protein(Meals, Drinks), " g", pro.Min, pro.Max, false)
        @{ var carb = NutritionGoals.GetDay(NutritionGoals.Carbs, ActiveDay); }
        @Bar("Carbs", NutritionMath.Carbs(Meals, Drinks), " g", carb.Min, carb.Max, false)
        @{ var fat = NutritionGoals.Get(NutritionGoals.Fat); }
        @Bar("Fat", NutritionMath.Fat(Meals, Drinks), " g", fat.Min, fat.Max, false)
        @{ var fib = NutritionGoals.Get(NutritionGoals.Fiber); }
        @Bar("Fiber", NutritionMath.Fiber(Meals, Drinks), " g", fib.Min, fib.Max, false)
        @Bar("Added sugar", NutritionMath.AddedSugar(Meals, Drinks), " g", 0, NutritionGoals.AddedSugarMax, true)
        @FluidRow()
    </div>
}

@code {
    [Parameter] public List<MealEntry> Meals { get; set; } = new();
    [Parameter] public List<DrinkEntry> Drinks { get; set; } = new();
    /// <summary>True on training days (Workout/High Workload) — selects the active-day
    /// ranges for calories/carbs/water instead of the rest-day ranges.</summary>
    [Parameter] public bool ActiveDay { get; set; }
    /// <summary>When set, water quick-add buttons show; the arg is ounces to log as a
    /// Water drink (negative = undo the most recent water entry).</summary>
    [Parameter] public EventCallback<int> OnAddWater { get; set; }

    // Bars whose exact numbers are currently revealed (toggled by tapping).
    private readonly HashSet<string> _show = new();
    private void Toggle(string label) { if (!_show.Add(label)) _show.Remove(label); }

    /// <summary>One goal as a blue→orange gradient bar (fill = progress toward the top
    /// of the range); a tick marks the low end of the range. Tap to reveal the numbers.
    /// For a ceiling (added sugar), low is 0 and high is the cap.</summary>
    private RenderFragment Bar(string label, double value, string unit, int low, int high, bool ceiling)
    {
        if (high <= 0) return @<text></text>;
        var fillPct = (int)Math.Clamp(value / high * 100, 0, 100);
        var lowPct = ceiling ? -1 : (int)Math.Clamp((double)low / high * 100, 0, 100);
        var text = ceiling ? $"{value:0} / ≤{high}{unit}" : $"{value:0} / {low}–{high}{unit}";
        var expanded = _show.Contains(label);
        return @<div style="padding:0.25rem 0;cursor:pointer" @onclick="() => Toggle(label)">
            <div style="display:flex;justify-content:space-between;font-size:0.85rem">
                <span>@label</span>
                <span class="muted" style="font-size:0.78rem">@(expanded ? text : "")</span>
            </div>
            <div style="position:relative;height:9px;border-radius:5px;overflow:hidden;margin-top:0.2rem;background:linear-gradient(to right,#4a72d0,#c47f00)">
                <div style="position:absolute;top:0;bottom:0;left:@(fillPct)%;right:0;background:var(--border)"></div>
                @if (lowPct >= 0)
                {
                    <div style="position:absolute;top:0;bottom:0;left:@(lowPct)%;width:2px;background:rgba(120,120,120,0.85)" title="range start"></div>
                }
            </div>
        </div>;
    }

    private RenderFragment FluidRow()
    {
        var g = NutritionGoals.GetDay(NutritionGoals.Water, ActiveDay);
        var fluidOz = NutritionMath.FluidOz(Drinks);
        if (!OnAddWater.HasDelegate && fluidOz <= 0) return @<text></text>;
        if (!g.IsSet) return @<text></text>;
        return @<div>
            @Bar("💧 Fluids (all drinks)", fluidOz, " oz", g.Min, g.Max, false)
            @if (OnAddWater.HasDelegate)
            {
                <div class="chip-row" style="margin-top:0.1rem">
                    @foreach (var oz in new[] { 8, 12, 16, 24 })
                    {
                        <button type="button" class="chip" @onclick="() => OnAddWater.InvokeAsync(oz)">+@oz</button>
                    }
                    @if (fluidOz > 0)
                    {
                        <button type="button" class="chip" title="Undo last water" @onclick="() => OnAddWater.InvokeAsync(-1)">↺</button>
                    }
                </div>
            }
        </div>;
    }
}
