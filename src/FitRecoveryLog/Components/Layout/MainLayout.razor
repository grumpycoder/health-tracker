@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDbContextFactory<AppDbContext> DbFactory
@inject FitRecoveryLog.Services.ToastService Toast
@inject FitRecoveryLog.Services.AutoBackup AutoBackup

<div class="app-shell">
    @if (Toast.Message is not null)
    {
        <div style="position:fixed;top:0;left:0;right:0;z-index:2000;background:#16a34a;color:#fff;
                    font-weight:600;text-align:center;padding:calc(env(safe-area-inset-top) + 0.6rem) 1rem 0.6rem;">
            @Toast.Message
        </div>
    }
    <article class="content">
        @Body
    </article>

    <nav class="tabbar">
        <NavLink class="tab" href="" Match="NavLinkMatch.All">
            <span class="tab-icon">🏠</span>
            <span class="tab-label">Home</span>
        </NavLink>
        <NavLink class="tab" href="workout">
            <span class="tab-icon">🏋️</span>
            <span class="tab-label">Workout</span>
        </NavLink>
        <NavLink class="tab" href="meals">
            <span class="tab-icon">🍽️</span>
            <span class="tab-label">Meals</span>
        </NavLink>
        <NavLink class="tab" href="sleep">
            <span class="tab-icon">😴</span>
            <span class="tab-label">Sleep</span>
        </NavLink>
        <NavLink class="tab" href="more">
            <span class="tab-icon">☰</span>
            <span class="tab-label">More</span>
        </NavLink>
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        NotificationNav.RouteRequested += OnRouteRequested;
        Nav.LocationChanged += OnLocationChanged;
        Toast.OnChange += OnToastChanged;
        // Cold start from a notification tap: the route was stashed before Blazor loaded.
        if (NotificationNav.Consume() is { } route)
            Nav.NavigateTo(route);
    }

    private Task OnToastChanged() => InvokeAsync(StateHasChanged);

    // Switching screens otherwise keeps the previous page's scroll position.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(async () => { try { await JS.InvokeVoidAsync("scrollContentTop"); } catch { } });

    // Warm tap: hop onto the renderer thread before navigating.
    private void OnRouteRequested(string route) =>
        _ = InvokeAsync(() => Nav.NavigateTo(route));

    protected override async Task OnInitializedAsync()
    {
        // Once per launch: cancel OS notifications whose schedule/setting no longer
        // exists (e.g. a med dropped by a reseed left its daily notification behind).
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var valid = (await db.MedicationSchedules.Select(s => s.NotificationId).ToListAsync())
                .Concat(await db.ReminderSettings.Select(s => s.NotificationId).ToListAsync())
                .Concat(await db.CessationGoals.Select(g => g.NotificationId).ToListAsync())
                .ToHashSet();
            await ReminderNotifier.CancelOrphanedAsync(valid);

            // Reschedule routine reminders, skipping the current period when the
            // task is already done (e.g. a measurement logged this week) so they
            // don't nag after you've completed them.
            foreach (var s in await db.ReminderSettings.ToListAsync())
            {
                if (!s.Active) { ReminderNotifier.Cancel(s.NotificationId); continue; }
                var interval = s.Repeat switch
                {
                    ReminderRepeat.Daily => 1, ReminderRepeat.Weekly => 7,
                    ReminderRepeat.Biweekly => 14, ReminderRepeat.Monthly => 30, _ => 7
                };
                var since = DateOnly.FromDateTime(DateTime.Now.AddDays(-interval));
                var done = s.Key switch
                {
                    "measurement" => await db.BodyMeasurements.AnyAsync(m => m.Date >= since),
                    "progressPhoto" => await db.BodyMeasurements.AnyAsync(m => m.PhotoPath != null && m.Date >= since),
                    "labCheck" => await db.LabResults.AnyAsync(l => l.Date >= since),
                    "weeklyReview" => await db.WeeklyReviews.AnyAsync(w => w.WeekStart >= since),
                    _ => false
                };
                if (done)
                    await ReminderNotifier.ScheduleAsync(s, Label(s.Key), DateTime.Now.AddDays(interval));
                else
                    await ReminderNotifier.ScheduleAsync(s, Label(s.Key));
            }
        }
        catch { /* never block app startup on notification cleanup */ }

        // Local daily snapshot + the export-aware weekly backup reminder.
        await AutoBackup.SnapshotIfDueAsync();
        await AutoBackup.EnsureBackupReminderAsync();
    }

    private static string Label(string key) => key switch
    {
        "measurement" => "Body Measurement",
        "labCheck" => "Lab Check",
        "weeklyReview" => "Weekly Review",
        "progressPhoto" => "Progress Photo",
        _ => key
    };

    public void Dispose()
    {
        NotificationNav.RouteRequested -= OnRouteRequested;
        Nav.LocationChanged -= OnLocationChanged;
        Toast.OnChange -= OnToastChanged;
    }
}
