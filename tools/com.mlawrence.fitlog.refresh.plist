<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Weekly Fit Log signing-cert refresh. Install to ~/Library/LaunchAgents/ and
     load with: launchctl load -w ~/Library/LaunchAgents/com.mlawrence.fitlog.refresh.plist
     Runs Monday 9:00 AM (or next wake if the Mac was asleep). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mlawrence.fitlog.refresh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/YOURNAME/source/HealthTracker/refresh-cert-scheduled.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/YOURNAME/Library/Logs/fitlog-refresh.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOURNAME/Library/Logs/fitlog-refresh.err.log</string>
</dict>
</plist>
