<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily Fit Log signing-cert check. Install to ~/Library/LaunchAgents/ and
     load with: launchctl load -w ~/Library/LaunchAgents/com.mlawrence.fitlog.refresh.plist
     Runs 9:00 AM and 7:00 PM daily (or next wake if the Mac was asleep). The script
     only re-mints when the profile is near expiry, and installs whenever the phone
     is reachable — so it self-heals if the phone was absent at an earlier run. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mlawrence.fitlog.refresh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/YOURNAME/source/HealthTracker/refresh-cert-scheduled.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/YOURNAME/Library/Logs/fitlog-refresh.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOURNAME/Library/Logs/fitlog-refresh.err.log</string>
</dict>
</plist>
